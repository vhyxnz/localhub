{"format":"local-hub-app","version":1,"exportedAt":"2026-08-31T10:03:30.247Z","app":{"packageId":"specter","name":"Specter","version":"1.0.0","group":"Lifestyle","html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#7557e8\">\n  <title>Specter — Personal Journal</title>\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n</head>\n<body>\n  <a class=\"skip-link\" href=\"#entryContent\">Skip to editor</a>\n  <div class=\"app\" id=\"app\">\n    <div class=\"scrim\" id=\"scrim\" hidden></div>\n    <aside class=\"sidebar journals-panel\" id=\"journalsPanel\" aria-label=\"Journals\">\n      <header class=\"brand\"><img src=\"data:image/png;base64,\" alt=\"\"><span>Spect<span>er</span></span></header>\n      <button class=\"primary wide\" id=\"newJournal\">+ New Journal</button>\n      <label class=\"sr-only\" for=\"searchInput\">Search journals and pages</label>\n      <input class=\"search\" id=\"searchInput\" type=\"search\" placeholder=\"Search journals and pages…\" autocomplete=\"off\">\n      <div class=\"search-summary\" id=\"searchSummary\" aria-live=\"polite\"></div>\n      <div class=\"journal-list\" id=\"journalList\"></div>\n      <footer><button class=\"quiet wide left\" id=\"settingsButton\">⚙ Settings</button></footer>\n    </aside>\n\n    <aside class=\"sidebar pages-panel\" id=\"pagesPanel\" aria-label=\"Pages\">\n      <header class=\"panel-header\"><div><strong>Pages</strong><small id=\"pagesSubtitle\"></small></div><button class=\"primary square\" id=\"newPage\" aria-label=\"Create page\">+</button></header>\n      <div class=\"sort-row\"><label for=\"pageSort\">Sort</label><select id=\"pageSort\"><option value=\"updated\">Last edited</option><option value=\"created\">Newest</option><option value=\"title\">Title</option></select></div>\n      <div class=\"pages-list\" id=\"pagesList\"></div>\n    </aside>\n\n    <main class=\"main\">\n      <header class=\"topbar\">\n        <button class=\"quiet square mobile-only\" id=\"journalsToggle\" aria-label=\"Open journals\">☰</button>\n        <strong id=\"currentJournal\">Specter</strong>\n        <div class=\"toolbar\" role=\"toolbar\" aria-label=\"Writing tools\">\n          <span class=\"save-status\" id=\"saveStatus\" aria-live=\"polite\">Saved</span>\n          <button id=\"undoEdit\" aria-label=\"Undo edit\" title=\"Undo (Ctrl+Z)\">↶</button>\n          <button id=\"redoEdit\" aria-label=\"Redo edit\" title=\"Redo (Ctrl+Y)\">↷</button>\n          <button data-format=\"bold\" aria-label=\"Bold\" title=\"Bold (Ctrl+B)\"><b>B</b></button>\n          <button data-format=\"italic\" aria-label=\"Italic\" title=\"Italic (Ctrl+I)\"><i>I</i></button>\n          <button data-format=\"underline\" aria-label=\"Underline\" title=\"Underline (Ctrl+U)\"><u>U</u></button>\n          <button data-format=\"highlight\" aria-label=\"Highlight\" title=\"Highlight (Ctrl+H)\">▰</button>\n          <button data-block=\"h2\" aria-label=\"Heading\" title=\"Heading\">H</button>\n          <button data-block=\"ul\" aria-label=\"Bulleted list\" title=\"Bulleted list\">•≡</button>\n          <button id=\"addLink\" aria-label=\"Add link\" title=\"Add link\">↗</button>\n          <button id=\"renameJournal\" aria-label=\"Rename journal\" title=\"Rename journal\">✎</button>\n          <button id=\"deletePage\" aria-label=\"Delete page\" title=\"Delete page\">⌫</button>\n        </div>\n        <button class=\"quiet square mobile-pages\" id=\"pagesToggle\" aria-label=\"Open pages\">▤</button>\n      </header>\n      <section class=\"editor-area\" id=\"editorArea\">\n        <article class=\"entry\">\n          <label class=\"sr-only\" for=\"entryTitle\">Page title</label>\n          <input class=\"entry-title\" id=\"entryTitle\" placeholder=\"Give this page a title…\">\n          <div class=\"entry-meta\"><span id=\"entryDate\"></span><span id=\"wordCount\">0 words</span></div>\n          <div class=\"entry-content\" id=\"entryContent\" contenteditable=\"true\" role=\"textbox\" aria-multiline=\"true\" data-placeholder=\"Write anything… your thoughts, memories, ideas, plans…\"></div>\n        </article>\n      </section>\n    </main>\n  </div>\n\n  <dialog id=\"settingsDialog\" aria-labelledby=\"settingsTitle\">\n    <form method=\"dialog\">\n      <header class=\"dialog-header\"><h2 id=\"settingsTitle\">Specter Settings</h2><button class=\"quiet square\" value=\"cancel\" aria-label=\"Close settings\">✕</button></header>\n      <section><h3>Appearance</h3><div class=\"form-grid\">\n        <label for=\"themeSelect\">Theme</label><select id=\"themeSelect\"><option value=\"light\">Light</option><option value=\"dark\">Dark</option><option value=\"gray\">Gray</option><option value=\"warm\">Warm</option></select>\n        <label for=\"accentColor\">Accent color</label><input id=\"accentColor\" type=\"color\">\n        <label for=\"fontSelect\">Font</label><select id=\"fontSelect\"><option value=\"Inter\">System</option><option value=\"Georgia\">Georgia</option><option value=\"Arial\">Arial</option><option value=\"Verdana\">Verdana</option><option value=\"Courier New\">Courier New</option></select>\n        <label for=\"fontSize\">Text size</label><select id=\"fontSize\"><option value=\"15\">Small</option><option value=\"17\">Medium</option><option value=\"19\">Large</option><option value=\"22\">Extra large</option></select>\n      </div></section>\n      <section><h3>Data & privacy</h3><p class=\"help\">Journals stay on this device. They are not encrypted; anyone with access to this browser profile may be able to read them.</p><div class=\"button-row\"><button type=\"button\" id=\"exportData\">Export backup</button><button type=\"button\" id=\"importButton\">Import backup</button><button type=\"button\" id=\"exportJournal\">Export journal</button><input id=\"importFile\" type=\"file\" accept=\"application/json,.json\" hidden></div></section>\n      <footer class=\"dialog-actions\"><button type=\"button\" class=\"danger\" id=\"deleteJournal\">Delete journal</button><button class=\"primary\" value=\"default\">Done</button></footer>\n    </form>\n  </dialog>\n\n  <dialog id=\"promptDialog\" aria-labelledby=\"promptTitle\"><form method=\"dialog\"><h2 id=\"promptTitle\">Specter</h2><p id=\"promptMessage\"></p><label class=\"sr-only\" for=\"promptInput\">Value</label><input id=\"promptInput\"><div class=\"dialog-actions\"><button value=\"cancel\">Cancel</button><button class=\"primary\" id=\"promptConfirm\" value=\"default\">Confirm</button></div></form></dialog>\n  <div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"><span id=\"toastText\"></span><button id=\"undoDelete\">Undo</button></div>\n  <script defer src=\"data:text/javascript;base64,\"></script>\n</body>\n</html>\n","icon":"data:image/png;base64,","favorite":false}}