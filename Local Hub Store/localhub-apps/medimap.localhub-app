{"format":"local-hub-app","version":1,"exportedAt":"2026-09-02T11:27:05.725Z","app":{"packageId":"medimap","name":"MediMap","version":"1.0.0","group":"Tools","html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"theme-color\" content=\"#123b66\">\n  <meta name=\"description\" content=\"Find medicines by name, category, gondola, or shelf.\">\n  <link rel=\"manifest\" href=\"data:application/manifest+json;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,Lm9yZ2FuaXplLWFjdGlvbnN7anVzdGlmeS1jb250ZW50OnNwYWNlLWJldHdlZW59Lm9yZ2FuaXplLWFjdGlvbnMgYnV0dG9uOmRpc2FibGVke29wYWNpdHk6LjQ1O2N1cnNvcjpub3QtYWxsb3dlZH0K\">\n  <title>MediMap</title>\n</head>\n<body>\n  <aside class=\"sidebar\">\n    <a class=\"brand\" href=\"#\"><img class=\"brand-logo\" src=\"data:image/png;base64,\" alt=\"MediFind logo\"><span class=\"brand-text\"><strong>MediMap</strong><small id=\"brandCustomName\" hidden></small></span></a>\n    <button class=\"sidebar-toggle\" id=\"sidebarToggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"mainNavigation\" aria-label=\"Open navigation\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg></button>\n    <nav id=\"mainNavigation\" aria-label=\"Main navigation\">\n      <a class=\"nav-item active\" href=\"#inventory\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#search\"></use></svg> Inventory</a>\n      <button class=\"nav-item\" id=\"sidebarAddMedicines\" type=\"button\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg> Add medicines</button>\n      <button class=\"nav-item\" id=\"sidebarShelfGuide\" type=\"button\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#shelves\"></use></svg> Shelf guide</button>\n      <button class=\"nav-item\" id=\"openOrganize\" type=\"button\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#organize\"></use></svg> Organize</button>\n      <button class=\"nav-item\" id=\"openNearExpiry\" type=\"button\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#clock\"></use></svg> Near expiry</button>\n      <button class=\"nav-item\" id=\"openSettings\" type=\"button\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#settings\"></use></svg> Settings</button>\n    </nav>\n    <div class=\"sidebar-note\"><span class=\"status-dot\"></span><div><strong>Stored locally</strong><small>Your catalog works offline.</small><small class=\"app-version\" id=\"sidebarAppVersion\">Version</small></div></div>\n  </aside>\n\n  <main>\n    <header class=\"topbar\">\n      <div><p class=\"eyebrow\">PHARMACY CATALOG</p><h1>Find the right medicine, fast.</h1></div>\n      <div class=\"topbar-actions\"><button class=\"primary\" id=\"openAdd\" type=\"button\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg><span class=\"button-label\">Add medicines</span></button></div>\n    </header>\n\n    <section class=\"search-panel\" id=\"inventory\">\n      <label class=\"search-box\"><span>⌕</span><input id=\"searchInput\" type=\"search\" placeholder=\"Search medicine, category, gondola or shelf…\" autocomplete=\"off\"></label>\n      <div class=\"filter-row\">\n        <div class=\"category-filter-panel\"><button class=\"tool-button category-toggle\" id=\"toggleCategories\" type=\"button\" aria-expanded=\"false\">Categories</button><div class=\"filter-group\" id=\"categoryFilters\" aria-label=\"Filter by category\" hidden></div></div>\n        <div class=\"filter-tools\"><button class=\"tool-button\" id=\"openCategoryGuide\" type=\"button\" aria-label=\"Open category guide\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7h.01\"/></svg>Category guide</button><button class=\"tool-button\" id=\"manageCategories\" type=\"button\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#edit\"></use></svg>Edit categories</button><select id=\"sortSelect\" aria-label=\"Sort medicines\"><option value=\"name-asc\">Name A–Z</option><option value=\"name-desc\">Name Z–A</option><option value=\"location\">Location</option><option value=\"newest\">Newest added</option></select></div>\n      </div>\n    </section>\n\n    <section class=\"content-grid\">\n      <div>\n        <div class=\"section-heading\"><div><h2>Medicine inventory</h2><p id=\"resultCount\">0 medicines</p></div><div class=\"heading-actions\"><div class=\"view-toggle\" aria-label=\"Inventory view\"><button id=\"gridView\" type=\"button\" title=\"Grid view\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#grid\"></use></svg></button><button id=\"listView\" type=\"button\" title=\"List view\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#list\"></use></svg></button></div><button class=\"tool-button\" id=\"boxSelect\" type=\"button\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\" stroke-dasharray=\"3 3\"/><path d=\"m9 12 2 2 4-5\"/></svg>Box select</button><button class=\"text-button\" id=\"selectAll\">Select all</button><button class=\"text-button\" id=\"clearSearch\" hidden>Clear search</button></div></div>\n        <div class=\"bulk-bar\" id=\"bulkBar\" hidden>\n          <div class=\"bulk-heading\"><strong id=\"selectedCount\">0 selected</strong><button class=\"text-button\" id=\"clearSelection\" type=\"button\">Clear</button></div>\n          <div class=\"bulk-actions\">\n            <div class=\"bulk-category bulk-category-editor\"><select id=\"bulkCategory\" aria-label=\"Category for selected medicines\"></select><input id=\"bulkNewCategory\" placeholder=\"New category name\" aria-label=\"New category name\" hidden><button class=\"bulk-action-button\" id=\"assignCategory\" type=\"button\">Assign</button></div>\n            <div class=\"bulk-category\"><input id=\"bulkGondola\" list=\"gondolaList\" placeholder=\"New gondola\" aria-label=\"New gondola for selected medicines\"><button class=\"bulk-action-button\" id=\"moveGondola\" type=\"button\">Move</button></div>\n            <button class=\"danger-button\" id=\"deleteSelected\" type=\"button\">Delete selected</button>\n          </div>\n        </div>\n        <div class=\"selection-surface\" id=\"selectionSurface\"><div class=\"medicine-grid\" id=\"medicineGrid\"></div><div class=\"selection-box\" id=\"selectionBox\" hidden></div></div>\n        <div class=\"empty-state\" id=\"emptyState\" hidden><div class=\"empty-icon\">⌕</div><h3>No medicines found</h3><p>Try another search or add this medicine to your catalog.</p><button class=\"primary\" type=\"button\" data-open-add><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Add medicine</button></div>\n      </div>\n      <aside class=\"shelf-card\" id=\"guide\">\n        <div class=\"shelf-card-head\"><div><span>STORE MAP</span><strong>Quick shelf guide</strong></div><button id=\"manageGondolas\" type=\"button\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Gondola</button></div>\n        <div id=\"shelfGuide\"></div>\n      </aside>\n    </section>\n  </main>\n\n  <dialog id=\"addDialog\">\n    <form method=\"dialog\" id=\"medicineForm\">\n      <div class=\"dialog-head\"><div><p class=\"eyebrow\">UPDATE INVENTORY</p><h2>Add medicines</h2><p>Paste one medicine per line, then assign them all to a location.</p></div><button class=\"icon-button\" value=\"cancel\" aria-label=\"Close\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#close\"></use></svg></button></div>\n      <label class=\"field\"><span>Medicine names <b>· one per line</b></span><textarea id=\"bulkNames\" rows=\"7\" placeholder=\"Paracetamol 500mg&#10;Ibuprofen 200mg&#10;Cetirizine 10mg\" required></textarea><small id=\"lineCount\">0 medicines detected</small></label>\n      <div class=\"form-row\">\n        <label class=\"field\"><span>Gondola / aisle</span><input id=\"gondolaInput\" list=\"gondolaList\" placeholder=\"e.g. G-03\" required><datalist id=\"gondolaList\"></datalist></label>\n        <label class=\"field\"><span>Shelf</span><input id=\"shelfInput\" list=\"shelfList\" placeholder=\"e.g. Shelf B\" required><datalist id=\"shelfList\"></datalist></label>\n      </div>\n      <div class=\"field\"><span>Medicine category</span><select id=\"categoryInput\" aria-label=\"Medicine category\"></select><label class=\"inline-category\" id=\"inlineCategoryField\" hidden><span>New category name</span><input id=\"inlineNewCategory\" placeholder=\"e.g. Respiratory care\"></label></div>\n      <div class=\"dialog-actions\"><button class=\"secondary\" value=\"cancel\" type=\"button\" id=\"cancelAdd\">Cancel</button><button class=\"primary\" type=\"submit\" id=\"saveMedicines\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg><span id=\"saveMedicinesLabel\">Add medicines</span></button></div>\n    </form>\n  </dialog>\n  <dialog id=\"gondolaDialog\">\n    <form id=\"gondolaForm\">\n      <div class=\"dialog-head\"><div><p class=\"eyebrow\">PHARMACY LAYOUT</p><h2>Manage gondolas</h2><p>Create a gondola and assign its shelves line by line.</p></div><button class=\"icon-button\" type=\"button\" id=\"closeGondolas\" aria-label=\"Close\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#close\"></use></svg></button></div>\n      <label class=\"field\"><span>New gondola name</span><input id=\"newGondola\" placeholder=\"e.g. G-05\" required></label>\n      <label class=\"field\"><span>Shelf names <b>· one per line</b></span><textarea id=\"newShelves\" rows=\"4\" placeholder=\"Shelf A&#10;Shelf B&#10;Shelf C\" required></textarea></label>\n      <button class=\"primary full-button\" type=\"submit\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Add gondola and shelves</button>\n      <div class=\"configured-title\"><strong>Configured gondolas</strong><span id=\"gondolaCount\">0 gondolas</span></div>\n      <div class=\"gondola-list\" id=\"gondolaListView\"></div>\n    </form>\n  </dialog>\n  <dialog id=\"categoryDialog\">\n    <form id=\"categoryForm\">\n      <div class=\"dialog-head\"><div><p class=\"eyebrow\">INVENTORY SETTINGS</p><h2>Edit categories</h2><p>Add, rename, or remove the category choices used throughout MediMap.</p></div><button class=\"icon-button\" type=\"button\" id=\"closeCategories\" aria-label=\"Close\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#close\"></use></svg></button></div>\n      <div class=\"new-category-row\"><input id=\"newCategory\" placeholder=\"New category name\" aria-label=\"New category name\"><button class=\"primary\" type=\"submit\">Add category</button></div>\n      <div class=\"category-editor-list\" id=\"categoryEditorList\"></div>\n      <div class=\"dialog-actions\"><button class=\"primary\" type=\"button\" id=\"doneCategories\">Done</button></div>\n    </form>\n  </dialog>\n  <dialog id=\"categoryGuideDialog\" class=\"category-guide-dialog\">\n    <div class=\"category-guide-shell\">\n      <div class=\"dialog-head\"><div><p class=\"eyebrow\">CATEGORY REFERENCE</p><h2>Category guide</h2><p>Search category names and review their descriptions.</p></div><button class=\"icon-button\" type=\"button\" id=\"closeCategoryGuide\" aria-label=\"Close\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button></div>\n      <label class=\"category-guide-search\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"m16 16 4 4\"/></svg><input id=\"categoryGuideSearch\" type=\"search\" placeholder=\"Search categories or descriptions…\" autocomplete=\"off\"></label>\n      <div class=\"category-guide-count\" id=\"categoryGuideCount\"></div>\n      <div class=\"category-guide-list\" id=\"categoryGuideList\"></div>\n      <div class=\"dialog-actions\"><button class=\"primary\" type=\"button\" id=\"doneCategoryGuide\">Done</button></div>\n    </div>\n  </dialog>\n  <dialog id=\"settingsDialog\">\n    <form id=\"settingsForm\">\n      <div class=\"dialog-head\"><div><p class=\"eyebrow\">MEDIMAP</p><h2>Settings</h2><p>Manage display preferences and locally stored pharmacy data.</p></div><button class=\"icon-button\" type=\"button\" id=\"closeSettings\" aria-label=\"Close\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#close\"></use></svg></button></div>\n      <section class=\"settings-section custom-name-section\"><div><strong>Custom pharmacy name</strong><small>Shown below MediMap in the sidebar and mobile header.</small></div><div class=\"custom-name-control\"><input id=\"settingsCustomName\" type=\"text\" maxlength=\"60\" placeholder=\"e.g. Sunrise Pharmacy\" aria-label=\"Custom pharmacy name\"><button class=\"text-button\" id=\"clearCustomName\" type=\"button\">Clear</button></div></section>\n      <section class=\"settings-section\"><div><strong>Default inventory view</strong><small>Choose how medicines appear when MediMap opens.</small></div><select id=\"settingsView\" aria-label=\"Default inventory view\"><option value=\"grid\">Grid view</option><option value=\"list\">List view</option></select></section>\n      <section class=\"settings-section data-transfer-section\"><div><strong>Import or transfer data</strong><small>Download the Excel format, import inventory, or transfer a complete MediMap backup.</small></div><div class=\"data-transfer-actions\"><a class=\"secondary template-link\" href=\"data:application/octet-stream;base64,\" download><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v11M8 11l4 4 4-4M5 20h14\"/></svg><span>Download Template</span></a><label class=\"secondary import-button\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 20V9M8 13l4-4 4 4M5 4h14\"/></svg><span>Import Excel / Data</span><input id=\"excelFile\" type=\"file\" accept=\".xlsx,.xls,.json,application/json\" hidden></label><button class=\"secondary\" id=\"exportAppData\" type=\"button\"><svg class=\"ui-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v10M8 10l4 4 4-4M5 19h14M18 5a8 8 0 0 0-12 1\"/></svg><span>Export Data</span></button></div></section>\n      <section class=\"settings-section data-summary\"><div><strong>Local data</strong><small>Stored only on this device and available offline.</small></div><div class=\"settings-stats\"><span><b id=\"settingsMedicineCount\">0</b> medicines</span><span><b id=\"settingsGondolaCount\">0</b> gondolas</span><span><b id=\"settingsCategoryCount\">0</b> categories</span></div></section>\n      <section class=\"format-panel\"><div><strong>Format app data</strong><p>Permanently erase all medicines, generic names, expiry dates, gondolas, shelves, and custom categories from this device.</p></div><button class=\"danger-button\" id=\"formatData\" type=\"button\">Format data</button></section>\n      <div class=\"dialog-actions settings-footer\"><span class=\"app-version\" id=\"settingsAppVersion\">Version</span><button class=\"primary\" type=\"button\" id=\"doneSettings\">Done</button></div>\n    </form>\n  </dialog>\n  <dialog id=\"organizeDialog\" class=\"wide-dialog\">\n    <div class=\"organize-shell\">\n      <div class=\"dialog-head\"><div><p class=\"eyebrow\">SHELF PLANNER</p><h2>Organize gondola</h2><p>Type a medicine, press Enter, then enter its expiry as MM/YYYY.</p></div><button class=\"icon-button\" type=\"button\" id=\"closeOrganize\" aria-label=\"Close\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#close\"></use></svg></button></div>\n      <div class=\"organize-toolbar\"><label><span>Gondola</span><select id=\"organizeGondola\" aria-label=\"Gondola to organize\"></select></label><div class=\"organize-hint\"><i></i><span id=\"organizeHint\">Select a blank shelf cell to begin</span></div></div>\n      <div class=\"organize-layout\">\n        <section class=\"organize-board\"><div class=\"organize-section-title\"><strong>Shelf inventory</strong><small>Medicine and expiry, one row at a time</small></div><div class=\"organize-table-wrap\" id=\"organizeGrid\"></div></section>\n        <aside class=\"organize-medicine-panel\"><div class=\"organize-section-title\"><strong>Medicine list</strong><small>Choose a medicine after selecting a cell</small></div><input id=\"organizeSearch\" type=\"search\" placeholder=\"Search medicines…\"><div class=\"organize-medicine-list\" id=\"organizeMedicineList\"></div></aside>\n      </div>\n      <datalist id=\"organizeMedicineOptions\"></datalist>\n      <div class=\"dialog-actions organize-actions\"><button class=\"secondary\" type=\"button\" id=\"exportOrganize\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#download\"></use></svg>Export arrangement</button><button class=\"primary\" type=\"button\" id=\"doneOrganize\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#check\"></use></svg>Done organizing</button></div>\n    </div>\n  </dialog>\n  <dialog id=\"nearExpiryDialog\" class=\"near-expiry-dialog\">\n    <div class=\"near-expiry-shell\">\n      <div class=\"dialog-head\"><div><p class=\"eyebrow\">EXPIRY REPORT</p><h2>Near expiry medicines</h2><p>Review upcoming expiries by gondola or select a specific month and year.</p></div><button class=\"icon-button\" type=\"button\" id=\"closeNearExpiry\" aria-label=\"Close\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#close\"></use></svg></button></div>\n      <div class=\"near-expiry-filters\"><label><span>Month</span><select id=\"nearExpiryMonth\"><option value=\"\">Near expiry</option><option value=\"01\">January</option><option value=\"02\">February</option><option value=\"03\">March</option><option value=\"04\">April</option><option value=\"05\">May</option><option value=\"06\">June</option><option value=\"07\">July</option><option value=\"08\">August</option><option value=\"09\">September</option><option value=\"10\">October</option><option value=\"11\">November</option><option value=\"12\">December</option></select></label><label><span>Year</span><select id=\"nearExpiryYear\"><option value=\"\">All years</option></select></label></div>\n      <div class=\"near-expiry-summary\" id=\"nearExpirySummary\"></div>\n      <div class=\"near-expiry-table-wrap\"><table class=\"near-expiry-table\"><thead><tr><th>Medicine</th><th>Shelf</th><th>Expiry</th><th>Status</th><th>Action</th></tr></thead><tbody id=\"nearExpiryBody\"></tbody></table><div class=\"near-expiry-empty\" id=\"nearExpiryEmpty\" hidden>No medicines match this expiry period.</div></div>\n      <div class=\"dialog-actions\"><button class=\"primary\" type=\"button\" id=\"doneNearExpiry\">Done</button></div>\n    </div>\n  </dialog>\n  <dialog id=\"expiryDialog\">\n    <form id=\"expiryForm\">\n      <div class=\"dialog-head\"><div><p class=\"eyebrow\">EXPIRY TRACKING</p><h2 id=\"expiryTitle\">Set expiry dates</h2><p>Enter MM/YYYY. Separate multiple expiry batches with commas.</p></div><button class=\"icon-button\" type=\"button\" id=\"closeExpiry\" aria-label=\"Close\"><svg class=\"ui-icon\"><use href=\"data:image/svg+xml;base64,#close\"></use></svg></button></div>\n      <div class=\"expiry-summary\"><span id=\"expiryLocation\">Gondola</span><strong id=\"expiryProgress\">0 of 0 completed</strong></div>\n      <div class=\"expiry-list\" id=\"expiryList\"></div>\n      <div class=\"dialog-actions\"><button class=\"secondary\" type=\"button\" id=\"cancelExpiry\">Cancel</button><button class=\"primary\" type=\"submit\">Save expiry dates</button></div>\n    </form>\n  </dialog>\n  <div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n  <script src=\"data:text/javascript;base64,\"></script>\n  <script src=\"data:text/javascript;base64,\"></script>\n</body>\n</html>\n","icon":"data:image/png;base64,","favorite":false}}