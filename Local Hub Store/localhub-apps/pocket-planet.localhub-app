{"format":"local-hub-app","version":1,"exportedAt":"2026-08-31T08:09:55.243Z","app":{"packageId":"pocket-planet","name":"Pocket Planet","group":"Lifestyle","html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"theme-color\" content=\"#071310\" />\n  <meta name=\"description\" content=\"Grow a tiny procedural world from stone to starlit civilization.\" />\n  <title>Pocket Planet</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\" />\n</head>\n<body>\n  <main class=\"app-shell\">\n    <header class=\"topbar\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Pocket Planet home\">\n        <span class=\"brand-mark\"><i></i></span>\n        <span>POCKET PLANET</span>\n      </a>\n      <div class=\"planet-name\"><span class=\"signal\"></span><span id=\"planetName\">AURELIA-7</span></div>\n      <button class=\"icon-button\" id=\"soundButton\" aria-label=\"Toggle ambient sound\" title=\"Toggle ambient sound\">\n        <span class=\"sound-bars\"><i></i><i></i><i></i></span>\n      </button>\n    </header>\n\n    <section class=\"world-view\" aria-label=\"Interactive planet simulation\">\n      <canvas id=\"spaceCanvas\"></canvas>\n      <div class=\"orbit orbit-one\"></div>\n      <div class=\"orbit orbit-two\"></div>\n\n      <aside class=\"stage-readout\">\n        <div class=\"eyebrow\"><span>ERA</span><b id=\"eraNumber\">01</b></div>\n        <h1 id=\"eraTitle\">PRIMORDIAL</h1>\n        <p id=\"eraDescription\">Oceans gather in the lowlands.<br>The first soil waits in silence.</p>\n      </aside>\n\n      <aside class=\"stats-card\">\n        <div class=\"stat\"><span>AGE</span><strong id=\"ageValue\">0.2<small> GYR</small></strong></div>\n        <div class=\"stat\"><span>BIOSPHERE</span><strong id=\"bioValue\">0<small>%</small></strong></div>\n        <div class=\"stat\"><span>SETTLEMENTS</span><strong id=\"cityValue\">0</strong></div>\n      </aside>\n\n      <div class=\"drag-hint\" id=\"dragHint\"><span>↔</span> DRAG TO ORBIT · SCROLL TO ZOOM</div>\n    </section>\n\n    <footer class=\"control-deck\">\n      <div class=\"seed-control\">\n        <label for=\"seedInput\">WORLD SEED</label>\n        <div class=\"seed-row\">\n          <input id=\"seedInput\" maxlength=\"18\" value=\"AURELIA-7\" spellcheck=\"false\" aria-label=\"World seed\" />\n          <button id=\"generateButton\" class=\"generate-button\"><span>↻</span> GENERATE</button>\n        </div>\n      </div>\n\n      <div class=\"timeline-wrap\">\n        <div class=\"timeline-labels\"><span>PLANETARY TIME</span><output id=\"timeOutput\">0%</output></div>\n        <input id=\"timeSlider\" type=\"range\" min=\"0\" max=\"100\" value=\"0\" aria-label=\"Planetary time\" />\n        <div class=\"milestones\" aria-hidden=\"true\">\n          <span class=\"active\">STONE</span><span>BIOMES</span><span>LIFE</span><span>CITIES</span><span>NETWORK</span>\n        </div>\n      </div>\n\n      <div class=\"play-control\">\n        <button id=\"playButton\" class=\"play-button\" aria-label=\"Pause evolution\"><span class=\"pause-icon\"></span></button>\n        <div><span>EVOLUTION</span><strong id=\"playStatus\">RUNNING</strong></div>\n      </div>\n    </footer>\n  </main>\n  <script src=\"data:text/javascript;base64,\"></script>\n</body>\n</html>\n","icon":"","favorite":false}}