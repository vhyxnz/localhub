{"format":"local-hub-app","version":1,"exportedAt":"2026-08-31T08:09:55.202Z","app":{"packageId":"desktop-civilization","name":"Desktop Civilization","group":"Games","html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"theme-color\" content=\"#eef0e5\" />\n  <meta name=\"description\" content=\"A tiny civilization quietly growing across your desktop.\" />\n  <title>Desktop Civilization</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\" />\n  <link rel=\"stylesheet\" href=\"data:text/css;base64,\" />\n  <style>.time-controls{display:flex;align-items:center;gap:4px}.section-title .skip{padding:6px;background:#edf0e7;color:#52655a}.section-title .skip:active{transform:translateY(1px)}@media(max-width:520px){.section-title .skip[data-years=\"1\"]{display:none}.section-title button{padding:5px 6px}}</style>\n</head>\n<body>\n  <main class=\"app-shell\">\n    <header class=\"topbar\">\n      <div class=\"brand\">\n        <span class=\"brand-mark\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n        <div><h1 id=\"villageName\">Desktop Civilization</h1><p id=\"tierLabel\">Camp · A little world that carries on without you.</p></div>\n      </div>\n      <div class=\"world-status\"><span class=\"pulse\"></span><span id=\"era\">Dawn of Settlement</span><b>Year <span id=\"year\">1</span></b></div>\n    </header>\n\n    <section class=\"world-card\" aria-label=\"Living miniature civilization\">\n      <canvas id=\"world\" aria-label=\"Animated tiny village simulation\"></canvas>\n      <div class=\"weather\"><span id=\"weatherIcon\">☀</span><span id=\"weatherText\">Clear skies</span><small id=\"temperature\">19°C</small></div>\n      <div class=\"hint\" id=\"hint\">Click the land to inspire a new path</div>\n      <div class=\"event-toast\" id=\"eventToast\" role=\"status\"></div>\n      <div class=\"zoom-controls\" aria-label=\"View controls\">\n        <button id=\"zoomIn\" aria-label=\"Zoom in\">+</button><button id=\"zoomOut\" aria-label=\"Zoom out\">−</button>\n      </div>\n      <aside class=\"inspector\" id=\"inspector\"><button id=\"closeInspector\" aria-label=\"Close\">×</button><small id=\"inspectType\">Villager</small><h2 id=\"inspectName\">Mara</h2><p id=\"inspectDetail\">Farmer · Walking home</p><div id=\"inspectMeta\"></div></aside>\n    </section>\n\n    <section class=\"resource-bar\" aria-label=\"Village resources\">\n      <span>Food <b id=\"food\">80</b></span><span>Wood <b id=\"wood\">55</b></span><span>Stone <b id=\"stone\">24</b></span><span>Coins <b id=\"coins\">18</b></span><span class=\"next-year\">Next year <i><em id=\"yearProgress\"></em></i></span>\n    </section>\n\n    <section class=\"dashboard\">\n      <div class=\"stats\">\n        <article><span>Population</span><strong id=\"population\">12</strong><small id=\"popTrend\">↑ 2 this year</small></article>\n        <article><span>Homes</span><strong id=\"homes\">4</strong><small>Warm & occupied</small></article>\n        <article><span>Harvest</span><strong id=\"harvest\">68%</strong><small id=\"harvestNote\">A promising season</small></article>\n        <article><span>Happiness</span><strong id=\"happiness\">87%</strong><small>Life is gentle here</small></article>\n      </div>\n      <aside class=\"chronicle\">\n        <div class=\"section-title\"><span>Village chronicle</span><div class=\"time-controls\"><button class=\"speed active\" data-speed=\"1\">1×</button><button class=\"speed\" data-speed=\"2\">2×</button><button class=\"speed\" data-speed=\"5\">5×</button><button class=\"skip\" data-years=\"1\">+1 yr</button><button class=\"skip\" data-years=\"5\">+5 yrs</button><button class=\"skip\" data-years=\"10\">+10 yrs</button><button id=\"pauseBtn\" aria-pressed=\"false\">Pause</button></div></div>\n        <div class=\"chronicle-list\" id=\"chronicleList\"></div>\n      </aside>\n    </section>\n  </main>\n  <div class=\"decision\" id=\"decision\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"decisionTitle\"><div class=\"decision-card\"><small>THE COUNCIL ASKS</small><h2 id=\"decisionTitle\">A choice for the village</h2><p id=\"decisionText\"></p><div id=\"decisionChoices\"></div></div></div>\n  <script src=\"data:text/javascript;base64,\"></script>\n</body>\n</html>\n","icon":"","favorite":false}}