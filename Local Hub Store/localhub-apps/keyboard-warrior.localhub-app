{"format":"local-hub-app","version":1,"exportedAt":"2026-08-31T08:09:55.225Z","app":{"packageId":"keyboard-warrior","name":"Keyboard Warrior","group":"Games","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n    <meta name=\"theme-color\" content=\"#0d0f14\">\n    <meta name=\"application-name\" content=\"Keyboard Warrior\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\">\n    <meta name=\"apple-mobile-web-app-title\" content=\"Keyboard Warrior\">\n    <link rel=\"manifest\" href=\"data:application/manifest+json;base64,\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"data:image/png;base64,\">\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"data:image/png;base64,\">\n    <title>Keyboard Warrior Simulator</title>\n\n    <script>\n        /* Apply the saved palette before first paint to prevent an accent flash. */\n        (function() {\n            try {\n                const saved = localStorage.getItem(\"kw_accent\");\n                if (!saved || !/^#[0-9A-Fa-f]{6}$/.test(saved)) return;\n\n                function mix(hex, target, amount) {\n                    const from = hex.match(/[0-9a-f]{2}/gi).map(function(part) { return parseInt(part, 16); });\n                    const to = target.match(/[0-9a-f]{2}/gi).map(function(part) { return parseInt(part, 16); });\n                    return \"#\" + from.map(function(channel, index) {\n                        return Math.round(channel + (to[index] - channel) * amount)\n                            .toString(16)\n                            .padStart(2, \"0\");\n                    }).join(\"\");\n                }\n\n                const rootStyle = document.documentElement.style;\n                rootStyle.setProperty(\"--accent\", saved);\n                rootStyle.setProperty(\"--accent-soft\", mix(saved, \"#ffffff\", .24));\n                rootStyle.setProperty(\"--accent-deep\", mix(saved, \"#000000\", .34));\n                rootStyle.setProperty(\"--accent2\", mix(saved, \"#ffb15c\", .28));\n            } catch(error) {}\n        })();\n    </script>\n\n    <style>\n        * {\n            box-sizing: border-box;\n            -webkit-tap-highlight-color: transparent;\n        }\n\n        :root {\n            --bg: #0d0f14;\n            --panel: #171a22;\n            --panel2: #20242e;\n            --text: #f5f7fa;\n            --muted: #9ba3b4;\n            --accent: #ff4d6d;\n            --accent2: #ff7a59;\n            --accent-soft: #ff7a86;\n            --accent-deep: #b32243;\n            --logo-pink: #ff3d91;\n            --green: #42d392;\n            --red: #ff4d5f;\n            --yellow: #ffc857;\n            --border: #303541;\n        }\n\n        /* LIGHT MODE */\n        body.light-mode {\n            --bg: #f4f6f9;\n            --panel: #ffffff;\n            --panel2: #eef1f5;\n            --text: #171a22;\n            --muted: #667085;\n            --border: #d9dee7;\n        }\n        body.light-mode .bottom-nav { background: rgba(255,255,255,.97); }\n        body.light-mode .typing-area { color: var(--text); }\n        body.light-mode select { color: var(--text); }\n        .accent-control { display:flex; align-items:center; gap:12px; }\n        .accent-control input[type=\"color\"] {\n            width:52px; height:42px; padding:3px; border-radius:10px;\n            border:1px solid var(--border); background:var(--panel2); cursor:pointer;\n        }\n        .theme-toggle { display:flex; gap:8px; }\n        .theme-option {\n            flex:1; padding:12px; border-radius:12px;\n            border:1px solid var(--border); background:var(--panel2);\n            color:var(--text); font-weight:800;\n        }\n        .theme-option.selected {\n            border-color:var(--accent);\n            background:rgba(255,77,109,.10);\n            color:var(--accent);\n        }\n        .export-status {\n            color:var(--green); font-size:12px; font-weight:800;\n            margin-top:8px; min-height:15px;\n        }\n\n        html,\n        body {\n            margin: 0;\n            min-height: 100%;\n            background: var(--bg);\n        }\n\n        body {\n            color: var(--text);\n            font-family: Arial, Helvetica, sans-serif;\n            overflow-x: hidden;\n        }\n\n        button,\n        textarea,\n        select {\n            font: inherit;\n        }\n\n        button {\n            cursor: pointer;\n        }\n\n        button:focus-visible,\n        textarea:focus-visible,\n        input:focus-visible,\n        select:focus-visible {\n            outline: 3px solid var(--yellow);\n            outline-offset: 3px;\n        }\n\n        .sr-only {\n            position: absolute;\n            width: 1px;\n            height: 1px;\n            padding: 0;\n            margin: -1px;\n            overflow: hidden;\n            clip: rect(0, 0, 0, 0);\n            white-space: nowrap;\n            border: 1px solid color-mix(in srgb, var(--accent-soft) 72%, white 28%);\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: .01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: .01ms !important;\n                scroll-behavior: auto !important;\n            }\n        }\n\n        .app {\n            width: 100%;\n            max-width: 520px;\n            min-height: 100vh;\n            min-height: 100dvh;\n            margin: auto;\n            padding-bottom: calc(78px + env(safe-area-inset-bottom));\n            position: relative;\n        }\n\n        .screen {\n            display: none;\n            min-height: calc(100vh - 78px);\n            min-height: calc(100dvh - 78px - env(safe-area-inset-bottom));\n            padding:\n                calc(24px + env(safe-area-inset-top))\n                calc(18px + env(safe-area-inset-right))\n                24px\n                calc(18px + env(safe-area-inset-left));\n            animation: fadeIn .2s ease;\n        }\n\n        .screen.active {\n            display: block;\n        }\n\n        @keyframes fadeIn {\n            from {\n                opacity: 0;\n                transform: translateY(5px);\n            }\n\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n\n\n\n        /* Larger premium Home PLAY button */\n        #homeScreen .home-play {\n            z-index: 1;\n            width: min(92%, 350px);\n            min-height: 76px;\n            margin: 12px auto 0;\n            padding: 0 28px;\n            border: 0;\n            border-radius: 21px;\n\n            /* Strong gaming-style gradient */\n            background: linear-gradient(\n                135deg,\n                var(--accent-deep) 0%,\n                var(--accent) 44%,\n                color-mix(in srgb, var(--accent-soft) 58%, var(--logo-pink) 42%) 68%,\n                var(--logo-pink) 100%\n            );\n            background-size: 160% 160%;\n\n            color: #ffffff;\n            font-size: 25px;\n            font-weight: 1000;\n            letter-spacing: 2.5px;\n            text-transform: uppercase;\n\n            /* Depth + glow */\n            box-shadow:\n                0 9px 0 color-mix(in srgb, var(--accent-deep) 68%, black 32%),\n                0 17px 34px color-mix(in srgb, var(--accent) 32%, transparent),\n                10px 13px 30px color-mix(in srgb, var(--logo-pink) 20%, transparent),\n                inset 0 1px 0 rgba(255,255,255,.28);\n\n            text-shadow:\n                0 2px 0 rgba(0, 0, 0, .22);\n\n            position: relative;\n            overflow: hidden;\n            transform: translateZ(0);\n            transition:\n                transform .16s ease,\n                box-shadow .16s ease,\n                filter .16s ease,\n                background-position .35s ease;\n        }\n\n        /* Gloss highlight across the button */\n        #homeScreen .home-play::before {\n            z-index: 0;\n            content: \"\";\n            position: absolute;\n            left: -70%;\n            top: 0;\n            width: 55%;\n            height: 100%;\n            background: linear-gradient(\n                90deg,\n                transparent,\n                rgba(255,255,255,.22),\n                transparent\n            );\n            transform: skewX(-20deg);\n            pointer-events: none;\n            transition: left .5s ease;\n        }\n\n        #homeScreen .home-play::after {\n            content: \"\";\n            position: absolute;\n            inset: 5px;\n            border: 1px solid rgba(255,255,255,.16);\n            border-radius: 16px;\n            pointer-events: none;\n        }\n\n        #homeScreen .home-play:hover {\n            transform: translateY(-3px) scale(1.018);\n            filter: brightness(1.08);\n            background-position: 100% 50%;\n            box-shadow:\n                0 10px 0 color-mix(in srgb, var(--accent-deep) 68%, black 32%),\n                0 22px 42px color-mix(in srgb, var(--accent) 42%, transparent),\n                12px 17px 36px color-mix(in srgb, var(--logo-pink) 28%, transparent),\n                inset 0 1px 0 rgba(255,255,255,.32);\n        }\n\n        #homeScreen .home-play:hover::before { left: 120%; }\n\n        #homeScreen .home-play:active {\n            transform: translateY(5px) scale(.98);\n            box-shadow:\n                0 3px 0 color-mix(in srgb, var(--accent-deep) 72%, black 28%),\n                0 8px 18px color-mix(in srgb, var(--accent) 25%, transparent),\n                inset 0 1px 0 rgba(255,255,255,.22);\n        }\n\n        /* HOME — mascot + title visual */\n        .home {\n            display: none;\n            min-height: calc(100vh - 78px);\n            padding: 18px 18px 30px;\n            align-items: center;\n            justify-content: center;\n            text-align: center;\n        }\n\n        .home.active {\n            display: flex;\n        }\n\n        #homeScreen .home-reference {\n            width: 100%;\n            max-width: 390px;\n            margin: 0 auto;\n        }\n\n        #homeScreen .home-hero-visual {\n            width: 100%;\n            margin: 0 auto 12px;\n        }\n\n        #homeScreen .home-mascot {\n            width: min(86vw, 335px);\n            margin: 0 auto -4px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        #homeScreen .home-mascot img {\n            width: 100%;\n            height: auto;\n            display: block;\n            object-fit: contain;\n        }\n\n        #homeScreen .home-title-logo {\n            width: 100%;\n            max-width: 380px;\n            margin: -2px auto 0;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        #homeScreen .home-title-logo img {\n            width: 100%;\n            height: auto;\n            display: block;\n            object-fit: contain;\n        }\n\n        #homeScreen .home-play {\n            display: block;\n            width: 100%;\n            max-width: 320px;\n            margin: 0 auto;\n        }\n\n        #homeScreen .home-view-stats {\n            display: block;\n            width: 100%;\n            max-width: 320px;\n            margin: 14px auto 0;\n            padding: 15px 18px;\n            border-radius: 16px;\n            border: 1px solid var(--border);\n            background: transparent;\n            color: var(--text);\n            font-weight: 900;\n            font-size: 16px;\n        }\n\n        #homeScreen .home-view-stats:active {\n            transform: scale(.98);\n        }\n\n        #homeScreen .home-stats-icon {\n            display: inline-block;\n            margin-right: 8px;\n            font-size: 19px;\n            vertical-align: -1px;\n        }\n\n        @media(max-width:380px) {\n            #homeScreen {\n                padding: 12px 14px 24px;\n            }\n\n            #homeScreen .home-reference {\n                max-width: 350px;\n            }\n\n            #homeScreen .home-mascot {\n                width: min(88vw, 300px);\n            }\n\n            #homeScreen .home-hero-visual {\n                margin-bottom: 8px;\n            }\n        }\n\n\n        /* GENERAL */\n\n        .page-title {\n            margin: 4px 0 7px;\n            font-size: 27px;\n            font-weight: 900;\n        }\n\n        .page-subtitle {\n            color: var(--muted);\n            line-height: 1.4;\n            margin: 0 0 24px;\n        }\n\n        /* MODE */\n\n        .mode-card {\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 20px;\n            padding: 18px;\n            margin-bottom: 18px;\n        }\n\n        .mode-card h2 {\n            font-size: 19px;\n            margin: 0 0 5px;\n        }\n\n        .mode-card > p {\n            color: var(--muted);\n            font-size: 14px;\n            margin: 0 0 15px;\n        }\n\n        .mode-options {\n            display: grid;\n            gap: 10px;\n        }\n\n        .option {\n            width: 100%;\n            text-align: left;\n            background: var(--panel2);\n            border: 2px solid transparent;\n            color: var(--text);\n            padding: 15px;\n            border-radius: 15px;\n        }\n\n        .option.selected {\n            border-color: var(--accent);\n            background: rgba(255,77,109,.09);\n        }\n\n        .option strong {\n            display: block;\n            margin-bottom: 5px;\n            font-size: 16px;\n        }\n\n        .option span {\n            display: block;\n            color: var(--muted);\n            font-size: 13px;\n            line-height: 1.4;\n        }\n\n        .special-mode-carousel {\n            display: grid;\n            grid-template-columns: 42px minmax(0, 1fr) 42px;\n            gap: 9px;\n            align-items: center;\n        }\n\n        .special-mode-stage {\n            min-width: 0;\n            min-height: 190px;\n            display: flex;\n        }\n\n        .special-mode-slide {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            min-height: 190px;\n            padding: 20px 16px;\n            text-align: center;\n            justify-content: center;\n            animation: specialModeIn .18s ease;\n        }\n\n        .special-mode-slide.special-mode-hidden { display: none; }\n\n        .special-mode-slide .special-mode-symbol {\n            display: block;\n            margin-bottom: 12px;\n            color: var(--accent);\n            font-size: 46px;\n            line-height: 1;\n            filter: drop-shadow(0 7px 13px color-mix(in srgb, var(--accent) 35%, transparent));\n        }\n\n        .special-mode-slide strong {\n            margin-bottom: 8px;\n            font-size: 20px;\n        }\n\n        .special-mode-slide > span:last-child {\n            max-width: 270px;\n            margin: 0 auto;\n            font-size: 13px;\n            line-height: 1.5;\n        }\n\n        .special-arrow {\n            min-width: 42px;\n            height: 56px;\n            border: 1px solid var(--border);\n            border-radius: 14px;\n            background: var(--panel2);\n            color: var(--text);\n            font-size: 34px;\n            font-weight: 900;\n            line-height: 1;\n        }\n\n        .special-arrow:active { transform: scale(.94); }\n\n        .special-mode-position {\n            margin-top: 9px;\n            color: var(--muted);\n            font-size: 10px;\n            font-weight: 900;\n            letter-spacing: 1.2px;\n            text-align: center;\n        }\n\n        @keyframes specialModeIn {\n            from { opacity: 0; transform: translateX(8px) scale(.98); }\n            to { opacity: 1; transform: translateX(0) scale(1); }\n        }\n\n        .start-game-btn {\n            width: 100%;\n            border: 0;\n            background: var(--accent);\n            color: white;\n            padding: 16px;\n            border-radius: 15px;\n            font-weight: 900;\n            font-size: 16px;\n        }\n\n        /* SUDDEN DEATH / COMBO / CHAOS */\n\n        .stat-value.combo-hot {\n            color: var(--yellow);\n        }\n\n        .curse-hint, .suddendeath-hint {\n            width: 100%;\n            clear: both;\n            position: relative;\n            z-index: 1;\n            margin: 14px 0 16px;\n            padding: 11px 13px;\n            border: 1px solid color-mix(in srgb, var(--yellow) 45%, var(--border));\n            border-radius: 12px;\n            background: color-mix(in srgb, var(--yellow) 9%, var(--panel));\n            color: var(--yellow);\n            font-size: 12px;\n            font-weight: 900;\n            line-height: 1.45;\n            text-align: left;\n            overflow-wrap: anywhere;\n            box-shadow: 0 6px 18px rgba(0, 0, 0, .16);\n        }\n\n        #curseRuleHint {\n            border-color: color-mix(in srgb, var(--red) 52%, var(--border));\n            background: color-mix(in srgb, var(--red) 10%, var(--panel));\n            color: color-mix(in srgb, var(--red) 72%, white);\n        }\n\n        @media (max-width: 380px) {\n            .curse-hint, .suddendeath-hint {\n                padding: 10px 11px;\n                font-size: 11px;\n                line-height: 1.5;\n            }\n        }\n\n        @keyframes curseShake {\n            10%, 90% { transform: translateX(-2px); }\n            20%, 80% { transform: translateX(4px); }\n            30%, 50%, 70% { transform: translateX(-7px); }\n            40%, 60% { transform: translateX(7px); }\n        }\n\n        .curse-shake {\n            animation: curseShake .4s ease;\n        }\n\n        @keyframes curseJolt {\n            0% { transform: translateY(0) rotate(0); }\n            30% { transform: translateY(-6px) rotate(-1deg); }\n            60% { transform: translateY(4px) rotate(1deg); }\n            100% { transform: translateY(0) rotate(0); }\n        }\n\n        .curse-jolt {\n            animation: curseJolt .3s ease;\n        }\n\n        .curse-glitch {\n            color: var(--red) !important;\n            filter: blur(.3px);\n        }\n\n        .curse-mirror { transform: scaleX(-1) rotate(-2deg); color: var(--yellow); }\n        .curse-blackout { color: transparent !important; text-shadow: 0 0 14px var(--red); user-select: none; }\n        .curse-input-blind { color: transparent !important; text-shadow: 0 0 8px var(--accent); }\n        .curse-tilt { transform: rotate(3deg) scale(.97); filter: saturate(1.8); }\n\n        @keyframes cursePulse {\n            0%, 100% { filter: invert(0) hue-rotate(0); }\n            35% { filter: invert(1) hue-rotate(160deg); }\n            70% { filter: contrast(2.2) hue-rotate(300deg); }\n        }\n        .curse-pulse { animation: cursePulse .65s steps(3); }\n\n        .boss-curse-card {\n            border-color: var(--red) !important;\n            box-shadow: 0 0 0 1px color-mix(in srgb, var(--red) 45%, transparent), 0 0 28px color-mix(in srgb, var(--red) 24%, transparent);\n        }\n        .boss-curse-card::before {\n            content: \"☠ BOSS CURSE\";\n            display: block;\n            margin: -5px 0 10px;\n            color: var(--red);\n            font-size: 10px;\n            font-weight: 1000;\n            letter-spacing: 1.3px;\n        }\n\n        .curse-flash::after {\n            content: \"\";\n            position: fixed;\n            inset: 0;\n            background: color-mix(in srgb, var(--red) 18%, transparent);\n            pointer-events: none;\n            z-index: 999;\n            animation: curseFlashFade .4s ease forwards;\n        }\n\n        @keyframes curseFlashFade {\n            from { opacity: 1; }\n            to { opacity: 0; }\n        }\n\n        /* ROAST BATTLE (2 PLAYER) */\n\n        .roast-pass-card {\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 20px;\n            padding: 32px 20px;\n            text-align: center;\n            margin-bottom: 18px;\n        }\n\n        .roast-pass-card .roast-player-tag {\n            display: inline-block;\n            padding: 8px 18px;\n            border-radius: 999px;\n            background: rgba(255,77,109,.14);\n            color: var(--accent);\n            font-weight: 900;\n            letter-spacing: 1.5px;\n            margin-bottom: 14px;\n        }\n\n        .roast-pass-card p {\n            color: var(--muted);\n            font-size: 14px;\n            margin: 0;\n        }\n\n        .roast-score-row {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 12px;\n            margin: 16px 0;\n        }\n\n        .roast-score-box {\n            background: var(--panel2);\n            border: 1px solid var(--border);\n            border-radius: 15px;\n            padding: 16px;\n            text-align: center;\n        }\n\n        .roast-score-box.winner {\n            border-color: var(--green);\n        }\n\n        .roast-score-box .roast-score-label {\n            font-size: 12px;\n            font-weight: 800;\n            color: var(--muted);\n            margin-bottom: 6px;\n        }\n\n        .roast-score-box .roast-score-value {\n            font-size: 18px;\n            font-weight: 900;\n        }\n\n        .roast-winner-banner {\n            text-align: center;\n            font-weight: 900;\n            letter-spacing: 1.5px;\n            color: var(--green);\n            margin-bottom: 8px;\n        }\n\n        /* MIRROR MATCH */\n        #mirrorMatchScreen {\n            padding: 10px;\n            min-height: calc(100vh - 78px);\n        }\n        .mirror-arena {\n            position: relative;\n            display: grid;\n            grid-template-rows: 1fr auto 1fr;\n            gap: 8px;\n            min-height: calc(100vh - 112px);\n        }\n        .mirror-player {\n            position: relative;\n            display: flex;\n            flex-direction: column;\n            min-height: 0;\n            padding: 10px;\n            border: 2px solid var(--border);\n            border-radius: 18px;\n            background: var(--panel);\n            overflow: hidden;\n        }\n        .mirror-player.leading { border-color: var(--green); }\n        .mirror-player.cursed { border-color: var(--red); }\n        /* Face-to-face layout: with the device lying flat between two players,\n           the top panel (Player 1) is flipped 180deg on its own wrapper so that\n           each player can read their own phrase/input/keyboard right-side up\n           from their own side of the device. The wrapper (not the panel itself)\n           carries the rotation so it doesn't fight with the shake/glitch/flip\n           chaos effects, which animate transform on the panel directly. The\n           bottom panel (Player 2) stays in the default orientation.\n        */\n        .mirror-face-flip {\n            display: flex;\n            min-height: 0;\n            transform: rotate(180deg);\n        }\n        .mirror-face-flip .mirror-player { width: 100%; }\n        .mirror-player-head { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:5px; }\n        .mirror-player-name { color:var(--accent); font-size:13px; font-weight:1000; letter-spacing:1px; }\n        .mirror-player-status { color:var(--muted); font-size:10px; font-weight:900; }\n        .mirror-phrase {\n            margin-bottom: 6px;\n            color: var(--text);\n            font-size: 12px;\n            font-weight: 800;\n            line-height: 1.3;\n            overflow-wrap: anywhere;\n        }\n        .mirror-input {\n            width: 100%;\n            flex: 1;\n            min-height: 40px;\n            padding: 8px;\n            border: 1px solid var(--border);\n            border-radius: 12px;\n            background: var(--panel2);\n            color: var(--text);\n            font-size: 14px;\n            line-height: 1.35;\n            resize: none;\n        }\n        .mirror-keyboard { display:flex; flex-direction:column; gap:4px; margin-top:5px; touch-action:none; }\n        .mirror-keyboard-row { display:flex; gap:4px; }\n        .mirror-key {\n            flex:1; min-width:0; min-height:34px; padding:3px 0; border:1px solid var(--border); border-radius:6px;\n            background:var(--panel2); color:var(--text); font-size:12px; font-weight:900; touch-action:none;\n        }\n        .mirror-key.space { flex:3; }\n        .mirror-key.back { flex:2; color:var(--red); }\n        .mirror-progress { height:7px; margin-top:6px; border-radius:999px; background:var(--panel2); overflow:hidden; }\n        .mirror-progress-bar { width:0; height:100%; border-radius:inherit; background:var(--accent); transition:width .12s ease; }\n        .mirror-divider { display:flex; align-items:center; gap:8px; }\n        .mirror-divider::before, .mirror-divider::after { content:\"\"; height:1px; flex:1; background:var(--border); }\n        .mirror-vs { color:var(--yellow); font-size:12px; font-weight:1000; }\n        .mirror-countdown {\n            position:absolute; inset:0; z-index:10; display:flex; align-items:center; justify-content:center;\n            border-radius:18px; background:rgba(9,11,16,.82); color:white; font-size:70px; font-weight:1000;\n        }\n        .mirror-countdown.hidden { display:none; }\n        .mirror-quit { position:absolute; z-index:12; top:7px; right:7px; padding:6px 9px; border-radius:9px; border:1px solid var(--red); background:var(--panel); color:var(--red); font-size:9px; font-weight:900; }\n        .mirror-loser-shake { animation:curseShake .35s ease; }\n        .mirror-loser-blind .mirror-input { color:transparent; text-shadow:0 0 7px var(--red); }\n        .mirror-loser-flip .mirror-input { transform:scaleX(-1); }\n        .mirror-loser-glitch { filter:hue-rotate(160deg) contrast(1.8); transform:rotate(-1deg); }\n\n        /* FREESTYLE */\n        .freestyle-card {\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 20px;\n            padding: 18px;\n            margin-bottom: 18px;\n        }\n        .freestyle-editor {\n            position: relative;\n            min-height: 190px;\n        }\n        .freestyle-highlight,\n        .freestyle-input {\n            position: absolute;\n            inset: 0;\n            width: 100%;\n            min-height: 190px;\n            box-sizing: border-box;\n            padding: 16px;\n            border-radius: 18px;\n            font: 17px/1.5 Arial, sans-serif;\n            white-space: pre-wrap;\n            overflow: auto;\n        }\n        .freestyle-highlight {\n            background: var(--panel);\n            border: 2px solid var(--border);\n            color: var(--text);\n            pointer-events: none;\n            word-wrap: break-word;\n        }\n        .freestyle-highlight .misspelled {\n            background: rgba(255, 77, 109, .28);\n            color: var(--red);\n            border-bottom: 3px solid var(--red);\n            border-radius: 3px;\n        }\n        .freestyle-input {\n            background: transparent;\n            color: transparent;\n            caret-color: var(--accent);\n            border: 2px solid var(--border);\n            outline: none;\n            resize: none;\n            z-index: 2;\n        }\n        .freestyle-input:focus { border-color: var(--accent); }\n        .freestyle-input::selection { background: rgba(255,255,255,.18); color: transparent; }\n        .freestyle-label { color: var(--muted); font-size: 13px; font-weight: 800; margin-bottom: 10px; }\n\n        /* GAME */\n\n        .game-top {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            gap: 10px;\n            margin-bottom: 14px;\n        }\n\n        .badge {\n            background: var(--panel2);\n            border: 1px solid var(--border);\n            padding: 8px 11px;\n            border-radius: 10px;\n            color: var(--muted);\n            font-size: 12px;\n            font-weight: 800;\n        }\n\n        .restart-btn {\n            background: transparent;\n            border: 1px solid var(--border);\n            color: var(--text);\n            padding: 8px 11px;\n            border-radius: 10px;\n            font-size: 12px;\n        }\n\n        .game-actions {\n            display: flex !important;\n            align-items: center;\n            justify-content: flex-end;\n            gap: 8px;\n            flex-shrink: 0;\n            white-space: nowrap;\n        }\n\n        .game-actions .restart-btn {\n            display: inline-flex !important;\n            align-items: center;\n            justify-content: center;\n            min-width: 72px;\n            min-height: 38px;\n            white-space: nowrap;\n            flex-shrink: 0;\n        }\n\n        .quit-btn {\n            color: var(--red);\n            border-color: var(--red);\n        }\n\n        .phrase-card {\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 20px;\n            padding: 20px;\n            margin-bottom: 14px;\n        }\n\n        .phrase-label {\n            color: var(--muted);\n            font-size: 12px;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            margin-bottom: 12px;\n        }\n\n        .phrase {\n            font-size: 21px;\n            font-weight: 700;\n            line-height: 1.55;\n            word-break: normal;\n            overflow-wrap: normal;\n        }\n\n        .word {\n            display: inline-block;\n            white-space: nowrap;\n            margin-right: 5px;\n            border-radius: 5px;\n        }\n\n        .word.reverse-phrase {\n            display: inline;\n            margin-right: 0;\n            white-space: normal;\n            overflow-wrap: anywhere;\n            word-break: normal;\n        }\n\n        .word.correct {\n            color: var(--green);\n        }\n\n        .word.wrong {\n            color: white;\n            background: var(--red);\n            padding: 0 3px;\n        }\n\n        .word.current {\n            text-decoration: underline;\n            text-decoration-color: var(--yellow);\n            text-decoration-thickness: 3px;\n        }\n\n        .typing-area {\n            width: 100%;\n            min-height: 125px;\n            resize: none;\n            background: var(--panel);\n            color: white;\n            border: 2px solid var(--border);\n            border-radius: 18px;\n            padding: 16px;\n            font-size: 17px;\n            line-height: 1.5;\n            outline: none;\n        }\n\n        .typing-area:focus {\n            border-color: var(--accent);\n        }\n\n        .typing-area:disabled {\n            opacity: .6;\n        }\n\n        .progress {\n            height: 7px;\n            background: var(--panel2);\n            border-radius: 20px;\n            overflow: hidden;\n            margin: 14px 0;\n        }\n\n        .progress-bar {\n            height: 100%;\n            width: 0%;\n            background: linear-gradient(90deg, var(--accent), var(--accent2));\n            transition: width .1s linear;\n        }\n\n        .stats-row {\n            display: grid;\n            grid-template-columns: repeat(3,1fr);\n            gap: 8px;\n        }\n\n        .stat {\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 14px;\n            padding: 12px 8px;\n            text-align: center;\n        }\n\n        .stat-value {\n            font-size: 18px;\n            font-weight: 900;\n        }\n\n        .stat-label {\n            color: var(--muted);\n            font-size: 11px;\n            margin-top: 4px;\n        }\n\n        /* RESULTS */\n\n        .result-box {\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 22px;\n            padding: 22px;\n            text-align: center;\n            margin-bottom: 16px;\n        }\n\n        .result-score {\n            font-size: 50px;\n            font-weight: 900;\n            margin: 10px 0;\n        }\n\n        .result-penalty {\n            display: none;\n            margin: -2px auto 14px;\n            padding: 9px 12px;\n            border: 1px solid rgba(255, 200, 87, .35);\n            border-radius: 11px;\n            background: rgba(255, 200, 87, .08);\n            color: var(--yellow);\n            font-size: 12px;\n            font-weight: 900;\n            line-height: 1.35;\n        }\n\n        .comment-box {\n            background: var(--panel2);\n            border-left: 4px solid var(--accent);\n            padding: 16px;\n            border-radius: 12px;\n            text-align: left;\n            line-height: 1.5;\n            margin-top: 18px;\n        }\n\n        .result-stats {\n            display: grid;\n            grid-template-columns: repeat(2,1fr);\n            gap: 10px;\n            margin-top: 15px;\n        }\n\n        .result-stat {\n            background: var(--panel2);\n            padding: 14px;\n            border-radius: 14px;\n        }\n\n        .result-stat strong {\n            display: block;\n            font-size: 20px;\n        }\n\n        .result-stat span {\n            color: var(--muted);\n            font-size: 12px;\n        }\n\n        .action-btn {\n            width: 100%;\n            padding: 15px;\n            border-radius: 14px;\n            border: 0;\n            background: var(--accent);\n            color: white;\n            font-weight: 900;\n            margin-bottom: 10px;\n        }\n\n        .secondary-btn {\n            background: var(--panel2);\n            border: 1px solid var(--border);\n        }\n\n        /* STATS */\n\n        .stat-card {\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 18px;\n            padding: 18px;\n            margin-bottom: 12px;\n        }\n\n        .overall-stats-grid {\n            display: grid;\n            grid-template-columns: repeat(2, minmax(0, 1fr));\n            gap: 9px;\n            margin-bottom: 12px;\n        }\n\n        .overall-stats-grid .stat-card {\n            min-width: 0;\n            margin: 0;\n            padding: 12px 13px;\n            border-radius: 14px;\n        }\n\n        .overall-stats-grid .stat-card h3 {\n            min-height: 26px;\n            font-size: 11px;\n            line-height: 1.2;\n            color: var(--muted);\n            text-transform: uppercase;\n            letter-spacing: .45px;\n        }\n\n        .overall-stats-grid .big-stat {\n            font-size: 26px;\n            line-height: 1.05;\n        }\n\n        .overall-stats-grid .muted {\n            display: none;\n        }\n\n        .stat-card h3 {\n            margin: 0 0 5px;\n        }\n\n        .big-stat {\n            font-size: 34px;\n            font-weight: 900;\n        }\n\n        .muted {\n            color: var(--muted);\n        }\n\n        .mode-stat-section {\n            margin-top: 25px;\n        }\n\n        .mode-stat-section h2 {\n            font-size: 19px;\n            margin: 0 0 12px;\n        }\n\n        #languageStatsContainer {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 8px;\n            margin-bottom: 20px;\n        }\n\n        #languageStatsContainer .mode-stat-card {\n            min-width: 0;\n            margin: 0;\n            padding: 12px 13px;\n        }\n\n        #languageStatsContainer .mode-stat-header {\n            display: flex;\n            margin-bottom: 8px;\n        }\n\n        #languageStatsContainer .mode-stat-header span {\n            display: inline-block;\n            margin-top: 0;\n            padding: 3px 6px;\n        }\n\n        #languageStatsContainer .mode-stat-grid {\n            gap: 4px;\n        }\n\n        #languageStatsContainer .mode-stat-value {\n            padding: 8px 4px;\n        }\n\n        #languageStatsContainer .mode-stat-value strong {\n            font-size: 16px;\n        }\n\n        #languageStatsContainer .mode-stat-value span {\n            font-size: 8px;\n        }\n\n        .language-stat-foot {\n            margin-top: 8px;\n            font-size: 10px;\n            line-height: 1.35;\n        }\n\n        .mode-details {\n            margin-bottom: 9px;\n            border: 1px solid var(--border);\n            border-radius: 14px;\n            background: var(--panel);\n            overflow: hidden;\n        }\n\n        .mode-details summary {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 13px 14px;\n            cursor: pointer;\n            font-weight: 900;\n            list-style: none;\n        }\n\n        .mode-summary-title { display: flex; align-items: center; gap: 8px; }\n        .mode-summary-count {\n            color: var(--muted);\n            font-size: 10px;\n            font-weight: 800;\n        }\n\n        .mode-details summary::-webkit-details-marker { display: none; }\n        .mode-details summary::after { content: \"+\"; color: var(--accent); font-size: 20px; }\n        .mode-details[open] summary::after { content: \"−\"; }\n\n        .mode-table {\n            padding: 0 9px 9px;\n        }\n\n        .mode-table-row {\n            display: grid;\n            grid-template-columns: minmax(100px, 1.35fr) repeat(3, minmax(42px, .55fr));\n            gap: 5px;\n            align-items: center;\n        }\n\n        .mode-group-title {\n            margin: 4px 2px 0;\n            padding: 8px 2px 6px;\n            color: var(--accent);\n            font-size: 9px;\n            font-weight: 1000;\n            letter-spacing: .8px;\n            text-transform: uppercase;\n        }\n\n        .mode-column-head {\n            display: grid;\n            grid-template-columns: minmax(100px, 1.35fr) repeat(3, minmax(42px, .55fr));\n            gap: 5px;\n            padding: 5px 3px;\n            color: var(--muted);\n            font-size: 8px;\n            font-weight: 900;\n            text-align: center;\n        }\n        .mode-column-head span:first-child { text-align: left; }\n\n        .mode-table-row {\n            padding: 8px 3px;\n            border-top: 1px solid var(--border);\n            font-size: 11px;\n            text-align: center;\n        }\n\n        .mode-table-row strong {\n            overflow: hidden;\n            font-size: 10px;\n            line-height: 1.2;\n            text-align: left;\n            text-overflow: ellipsis;\n        }\n\n        .mode-row-name { min-width: 0; text-align: left; }\n        .mode-row-name strong { display: block; color: var(--text); }\n        .mode-row-name small {\n            display: block;\n            margin-top: 2px;\n            color: var(--muted);\n            font-size: 8px;\n            font-weight: 800;\n        }\n        .mode-row-metric strong { display: block; font-size: 11px; text-align: center; }\n        .mode-row-metric small { display: block; margin-top: 2px; color: var(--muted); font-size: 7px; }\n        .mode-empty {\n            padding: 9px 3px;\n            border-top: 1px solid var(--border);\n            color: var(--muted);\n            font-size: 10px;\n        }\n\n        .mode-stat-card {\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 17px;\n            padding: 15px;\n            margin-bottom: 10px;\n        }\n\n        .mode-stat-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 12px;\n        }\n\n        .mode-stat-header strong {\n            font-size: 15px;\n        }\n\n        .mode-stat-header span {\n            font-size: 11px;\n            color: var(--muted);\n            background: var(--panel2);\n            padding: 5px 8px;\n            border-radius: 7px;\n        }\n\n        .mode-stat-grid {\n            display: grid;\n            grid-template-columns: repeat(3,1fr);\n            gap: 7px;\n        }\n\n        .mode-stat-value {\n            background: var(--panel2);\n            border-radius: 10px;\n            padding: 10px 5px;\n            text-align: center;\n        }\n\n        .mode-stat-value strong {\n            display: block;\n            font-size: 17px;\n        }\n\n        .mode-stat-value span {\n            display: block;\n            color: var(--muted);\n            font-size: 9px;\n            margin-top: 3px;\n        }\n\n        /* SHARE */\n\n        .share-card {\n            background: linear-gradient(\n                135deg,\n                rgba(255,77,109,.12),\n                rgba(255,122,89,.08)\n            );\n            border: 1px solid rgba(255,77,109,.3);\n            border-radius: 18px;\n            padding: 16px;\n            margin-bottom: 15px;\n        }\n\n        .share-card-title {\n            font-weight: 900;\n            margin-bottom: 6px;\n        }\n\n        .share-preview {\n            color: var(--muted);\n            font-size: 13px;\n            line-height: 1.45;\n            white-space: pre-line;\n            margin-bottom: 13px;\n            max-height: 58px;\n            overflow: hidden;\n        }\n\n        .share-btn {\n            width: 100%;\n            min-height: 48px;\n            border: 0;\n            border-radius: 13px;\n            padding: 14px;\n            color: white;\n            background: linear-gradient(135deg,var(--accent),var(--accent2));\n            font-weight: 900;\n            position: relative;\n            z-index: 5;\n        }\n\n        /* IMAGE PREVIEW */\n\n        .image-preview-card {\n            display: none;\n            margin-bottom: 15px;\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 18px;\n            padding: 12px;\n        }\n\n        .image-preview-card.show {\n            display: block;\n        }\n\n        .image-preview-card img {\n            display: block;\n            width: 100%;\n            border-radius: 12px;\n        }\n\n        /* SETTINGS */\n\n        .setting {\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 17px;\n            padding: 17px;\n            margin-bottom: 12px;\n        }\n\n        .setting-title {\n            font-weight: 900;\n            margin-bottom: 5px;\n        }\n\n        .setting-description {\n            color: var(--muted);\n            font-size: 13px;\n            margin-bottom: 12px;\n        }\n\n        .version-setting {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 16px;\n        }\n\n        .version-setting .setting-title { margin: 0; }\n\n        .version-badge {\n            flex: 0 0 auto;\n            padding: 7px 11px;\n            border: 1px solid color-mix(in srgb, var(--accent) 36%, var(--border));\n            border-radius: 999px;\n            background: color-mix(in srgb, var(--accent) 10%, transparent);\n            color: var(--accent);\n            font-size: 12px;\n            font-weight: 1000;\n            letter-spacing: .5px;\n        }\n\n        .danger-setting {\n            border-color: color-mix(in srgb, var(--red) 42%, var(--border));\n            background: linear-gradient(145deg, color-mix(in srgb, var(--red) 8%, transparent), transparent), var(--panel);\n        }\n\n        .danger-setting .setting-title { color: var(--red); }\n\n        .danger-btn {\n            width: 100%;\n            min-height: 46px;\n            border: 1px solid color-mix(in srgb, var(--red) 68%, transparent);\n            border-radius: 13px;\n            background: color-mix(in srgb, var(--red) 10%, transparent);\n            color: var(--red);\n            font-weight: 1000;\n        }\n\n        .danger-btn:hover { background: color-mix(in srgb, var(--red) 17%, transparent); }\n\n        .reset-warning {\n            margin: 16px 0;\n            padding: 13px 14px;\n            border: 1px solid color-mix(in srgb, var(--red) 38%, var(--border));\n            border-radius: 13px;\n            background: color-mix(in srgb, var(--red) 8%, transparent);\n            color: #ffd7dc;\n            font-size: 13px;\n            line-height: 1.45;\n        }\n\n        .reset-actions { display: grid; gap: 9px; }\n        .confirm-reset-btn { background: var(--red); box-shadow: 0 9px 24px rgba(255,77,95,.2); }\n\n        select {\n            width: 100%;\n            padding: 13px;\n            border-radius: 12px;\n            background: var(--panel2);\n            border: 1px solid var(--border);\n            color: white;\n        }\n\n        /* SHARE POPUP */\n\n        .share-overlay {\n            position: fixed;\n            inset: 0;\n            z-index: 99999;\n            background: rgba(0,0,0,.8);\n            display: none;\n            align-items: center;\n            justify-content: center;\n            padding: 20px;\n        }\n\n        .share-overlay.show {\n            display: flex;\n        }\n\n        .share-popup {\n            width: 100%;\n            max-width: 430px;\n            max-height: 90vh;\n            overflow-y: auto;\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 22px;\n            padding: 20px;\n            box-shadow: 0 20px 60px rgba(0,0,0,.5);\n        }\n\n        .share-popup h2 {\n            margin: 0 0 14px;\n        }\n\n        .popup-image {\n            width: 100%;\n            display: block;\n            border-radius: 14px;\n            margin-bottom: 12px;\n        }\n\n        .popup-btn {\n            width: 100%;\n            padding: 14px;\n            border-radius: 13px;\n            border: 0;\n            margin-top: 10px;\n            font-weight: 900;\n            color: white;\n            background: var(--accent);\n        }\n\n        .popup-close {\n            background: var(--panel2);\n            border: 1px solid var(--border);\n        }\n\n        /* RANK INFO */\n\n        .rank-info-btn {\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            width: 20px;\n            height: 20px;\n            margin-left: 8px;\n            border-radius: 50%;\n            border: 1px solid var(--border);\n            background: var(--panel2);\n            color: var(--muted);\n            font-size: 12px;\n            font-weight: 900;\n            line-height: 1;\n            padding: 0;\n            vertical-align: middle;\n        }\n\n        .rank-info-btn:active {\n            transform: scale(.92);\n        }\n\n        .info-overlay {\n            position: fixed;\n            inset: 0;\n            z-index: 99999;\n            background: rgba(0,0,0,.8);\n            display: none;\n            align-items: center;\n            justify-content: center;\n            padding: 20px;\n        }\n\n        .info-overlay.show {\n            display: flex;\n        }\n\n        .info-popup {\n            width: 100%;\n            max-width: 430px;\n            max-height: 85vh;\n            overflow-y: auto;\n            background: var(--panel);\n            border: 1px solid var(--border);\n            border-radius: 22px;\n            padding: 20px;\n            box-shadow: 0 20px 60px rgba(0,0,0,.5);\n        }\n\n        .info-popup h2 {\n            margin: 0 0 4px;\n        }\n\n        .info-popup-subtitle {\n            color: var(--muted);\n            font-size: 13px;\n            margin: 0 0 16px;\n        }\n\n        .rank-info-progress {\n            background: var(--panel2);\n            border: 1px solid var(--border);\n            border-radius: 14px;\n            padding: 12px 14px;\n            font-size: 13px;\n            font-weight: 700;\n            margin-bottom: 16px;\n        }\n\n        .rank-row {\n            border: 1px solid var(--border);\n            border-radius: 14px;\n            padding: 12px 14px;\n            margin-bottom: 10px;\n        }\n\n        .rank-row.current {\n            border-color: var(--accent);\n            background: rgba(255,77,109,.08);\n        }\n\n        .rank-row-top {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 8px;\n        }\n\n        .rank-row-name {\n            font-weight: 900;\n            font-size: 14px;\n            letter-spacing: .3px;\n        }\n\n        .rank-row-tag {\n            flex-shrink: 0;\n            font-size: 10px;\n            font-weight: 900;\n            letter-spacing: .5px;\n            color: var(--accent);\n            border: 1px solid var(--accent);\n            border-radius: 20px;\n            padding: 3px 8px;\n        }\n\n        .rank-row-req {\n            color: var(--muted);\n            font-size: 12px;\n            margin-top: 4px;\n        }\n\n        /* NAV */\n\n        .bottom-nav {\n            position: fixed;\n            z-index: 100;\n            bottom: 0;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 100%;\n            max-width: 520px;\n            height: calc(70px + env(safe-area-inset-bottom));\n            background: rgba(20,22,29,.97);\n            border-top: 1px solid var(--border);\n            display: grid;\n            grid-template-columns: repeat(3,1fr);\n            padding: 7px 8px;\n            padding-bottom: calc(7px + env(safe-area-inset-bottom));\n        }\n\n        .nav-btn {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            border: 0;\n            background: transparent;\n            color: var(--muted);\n            border-radius: 12px;\n            font-size: 12px;\n            font-weight: 800;\n        }\n\n        .nav-btn.active {\n            background: rgba(255,77,109,.1);\n            color: var(--accent);\n        }\n\n        .nav-icon {\n            display: grid;\n            width: 24px;\n            height: 24px;\n            place-items: center;\n            font-size: 20px;\n            line-height: 1;\n            margin-bottom: 3px;\n        }\n\n        body.welcome .bottom-nav,\n        body.game-active .bottom-nav,\n        body.result-active .bottom-nav {\n            display: none;\n        }\n\n        @media(max-width:380px) {\n            .phrase {\n                font-size: 18px;\n            }\n\n            .home h1 {\n                font-size: 28px;\n            }\n        }\n\n        /* =========================================================\n           HOME SCREEN ONLY — reference design\n           No other screen is styled by these rules.\n        ========================================================= */\n\n        #homeScreen.home {\n            padding: 22px 20px 30px;\n        }\n\n        #homeScreen .home-reference {\n            width: 100%;\n            max-width: 360px;\n            margin: 0 auto;\n            text-align: center;\n        }\n\n        #homeScreen .logo {\n            width: 245px;\n            height: 245px;\n            margin: 0 auto -4px;\n            border-radius: 0;\n            background: transparent;\n            box-shadow: none;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        #homeScreen .logo img {\n            width: 100%;\n            height: 100%;\n            object-fit: contain;\n            display: block;\n        }\n\n        #homeScreen .home-title {\n            margin: 0;\n            font-size: 37px;\n            line-height: .92;\n            font-weight: 950;\n            font-style: italic;\n            letter-spacing: -1.5px;\n            text-transform: uppercase;\n        }\n\n        #homeScreen .home-title span {\n            display: block;\n        }\n\n        #homeScreen .home-title span:first-child {\n            color: #f5f7fa;\n        }\n\n        #homeScreen .home-title span:last-child {\n            color: #ff4d5f;\n        }\n\n        #homeScreen .home-simulator {\n            margin-top: 12px;\n            margin-bottom: 28px;\n            color: var(--accent);\n            font-size: 13px;\n            font-weight: 900;\n            letter-spacing: 7px;\n        }\n\n        #homeScreen .home-play {\n            display: block;\n            margin: 0 auto;\n            max-width: 320px;\n        }\n\n        #homeScreen .home-view-stats {\n            display: block;\n            width: 100%;\n            max-width: 320px;\n            margin: 14px auto 0;\n            padding: 15px 18px;\n            border-radius: 16px;\n            border: 1px solid var(--border);\n            background: transparent;\n            color: var(--text);\n            font-weight: 900;\n            font-size: 16px;\n        }\n\n        #homeScreen .home-view-stats:active {\n            transform: scale(.98);\n        }\n\n        #homeScreen .home-stats-icon {\n            display: inline-block;\n            margin-right: 8px;\n            font-size: 19px;\n            vertical-align: -1px;\n        }\n\n        @media(max-width:380px) {\n            #homeScreen .logo {\n                width: 215px;\n                height: 215px;\n            }\n\n            #homeScreen .home-title {\n                font-size: 32px;\n            }\n\n            #homeScreen .home-simulator {\n                margin-bottom: 22px;\n            }\n        }\n\n\n\n        /* =========================================================\n           CUSTOM PLAYER PROFILE\n        ========================================================= */\n\n        .profile-card {\n            display: flex;\n            align-items: center;\n            gap: 16px;\n            padding: 18px;\n            margin: 0 0 14px;\n            border-radius: 22px;\n            border: 1px solid var(--border);\n            background: linear-gradient(135deg, rgba(255,255,255,.055), rgba(255,255,255,.025));\n            box-shadow: 0 14px 35px rgba(0,0,0,.18);\n        }\n\n        .profile-avatar {\n            position: relative;\n            width: 68px;\n            height: 68px;\n            flex: 0 0 68px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 20px;\n            background: var(--accent);\n            color: #fff;\n            font-size: 21px;\n            font-weight: 1000;\n            letter-spacing: 1px;\n            box-shadow: 0 8px 24px rgba(0,0,0,.22);\n            padding: 0;\n            border: 0;\n            cursor: pointer;\n        }\n\n        .profile-avatar img {\n            display: none;\n            width: 100%;\n            height: 100%;\n            border-radius: inherit;\n            object-fit: cover;\n        }\n\n        .profile-avatar.has-image img { display: block; }\n        .profile-avatar.has-image .avatar-fallback { display: none; }\n\n        .avatar-edit-badge {\n            position: absolute;\n            right: -5px;\n            bottom: -5px;\n            display: grid;\n            width: 25px;\n            height: 25px;\n            place-items: center;\n            border: 3px solid var(--panel);\n            border-radius: 50%;\n            background: var(--text);\n            color: var(--bg);\n            font-size: 12px;\n            font-weight: 1000;\n            box-shadow: 0 4px 12px rgba(0,0,0,.3);\n        }\n\n        .avatar-reset-btn {\n            display: none;\n            margin-top: 10px;\n            padding: 0;\n            border: 0;\n            background: transparent;\n            color: var(--accent);\n            font-size: 11px;\n            font-weight: 900;\n        }\n        .avatar-select-btn {\n            margin-top: 10px;\n            margin-right: 12px;\n            padding: 0;\n            border: 0;\n            background: transparent;\n            color: var(--accent);\n            font-size: 11px;\n            font-weight: 900;\n        }\n\n        .avatar-picker-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 10px;\n            margin: 16px 0;\n        }\n        .avatar-choice {\n            min-height: 82px;\n            border: 2px solid var(--border);\n            border-radius: 18px;\n            background: var(--panel2);\n            color: var(--text);\n            font-size: 36px;\n        }\n        .avatar-choice:active { transform: scale(.96); }\n        .avatar-picker-actions { display:grid; gap:9px; }\n        .avatar-custom-btn {\n            width:100%; padding:13px; border:0; border-radius:12px;\n            background:var(--accent); color:white; font-weight:900;\n        }\n        .nav-icon svg { display:block; width:23px; height:23px; margin:auto; fill:currentColor; }\n\n        .avatar-reset-btn.show { display: inline-block; }\n\n        .profile-info {\n            min-width: 0;\n            text-align: left;\n        }\n\n        .profile-kicker {\n            color: var(--muted);\n            font-size: 10px;\n            font-weight: 900;\n            letter-spacing: 1.5px;\n            margin-bottom: 5px;\n        }\n\n        .profile-name {\n            color: var(--text);\n            font-size: 23px;\n            line-height: 1.1;\n            font-weight: 1000;\n            overflow: hidden;\n            text-overflow: ellipsis;\n            white-space: nowrap;\n        }\n\n        .profile-rank {\n            color: var(--accent);\n            font-size: 12px;\n            font-weight: 900;\n            letter-spacing: .7px;\n            margin-top: 5px;\n        }\n\n        .profile-editor {\n            padding: 16px;\n            margin: 0 0 16px;\n            border-radius: 18px;\n            border: 1px solid var(--border);\n            background: var(--panel);\n        }\n\n        .profile-editor label {\n            display: block;\n            margin-bottom: 9px;\n            color: var(--muted);\n            font-size: 11px;\n            font-weight: 900;\n            letter-spacing: 1.2px;\n        }\n\n        .profile-name-row {\n            display: flex;\n            gap: 9px;\n        }\n\n        #profileNameInput {\n            min-width: 0;\n            flex: 1;\n            background: var(--bg);\n            color: var(--text);\n            border: 1px solid var(--border);\n            border-radius: 13px;\n            padding: 13px 14px;\n            font-size: 15px;\n            font-weight: 700;\n            outline: none;\n        }\n\n        #profileNameInput:focus {\n            border-color: var(--accent);\n        }\n\n        .profile-save-btn {\n            flex: 0 0 auto;\n            min-width: 76px;\n            border: 0;\n            border-radius: 13px;\n            background: var(--accent);\n            color: #fff;\n            font-weight: 1000;\n            padding: 0 15px;\n        }\n\n        .profile-save-btn:active {\n            transform: scale(.97);\n        }\n\n        .profile-hint {\n            margin-top: 8px;\n            font-size: 11px;\n        }\n\n\n\n\n        /* HOME: single combined Keyboard Warrior logo */\n        #homeScreen .single-logo {\n            width: min(92vw, 560px);\n            margin: 0 auto 24px;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n        }\n        #homeScreen .home-full-logo {\n            display: block;\n            width: 100%;\n            max-height: 300px;\n            object-fit: contain;\n            border-radius: 18px;\n        }\n        #homeScreen .home-mascot,\n        #homeScreen .home-title-logo,\n        #homeScreen .home-title,\n        #homeScreen .home-simulator {\n            display: none !important;\n        }\n        .no-mercy-overtime {\n            color: #ff3344 !important;\n            text-shadow: 0 0 12px rgba(255,51,68,.55);\n        }\n        .no-mercy-limit {\n            font-size: .72em;\n            opacity: .8;\n            margin-left: 4px;\n        }\n\n        .no-mercy-rule-hint {\n            margin: 0 0 12px;\n            padding: 10px 12px;\n            border: 1px solid rgba(255, 51, 68, .35);\n            border-radius: 10px;\n            color: #ff6975;\n            background: rgba(255, 51, 68, .07);\n            font-size: .82rem;\n            line-height: 1.35;\n        }\n        /* =========================================================\n           2026 UI POLISH\n        ========================================================= */\n        :root {\n            --panel-glass: rgba(23, 26, 34, .88);\n            --soft-shadow: 0 14px 40px rgba(0, 0, 0, .22);\n            --tight-shadow: 0 8px 22px rgba(0, 0, 0, .18);\n        }\n\n        html { color-scheme: dark; }\n\n        body {\n            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n            background:\n                radial-gradient(circle at 50% -15%, color-mix(in srgb, var(--accent) 17%, transparent), transparent 34%),\n                var(--bg);\n        }\n\n        button, .option, .stat-card, .mode-stat-card, .setting, .mode-details {\n            transition: transform .16s ease, border-color .16s ease, background .16s ease, box-shadow .16s ease;\n        }\n\n        button:not(:disabled):active { transform: translateY(1px) scale(.985); }\n\n        .screen {\n            padding: 22px 18px 28px;\n        }\n\n        .page-title {\n            margin-top: 2px;\n            font-size: clamp(27px, 8vw, 34px);\n            line-height: 1.05;\n            letter-spacing: -.8px;\n        }\n\n        .page-title::after {\n            content: \"\";\n            display: block;\n            width: 34px;\n            height: 4px;\n            margin-top: 10px;\n            border-radius: 10px;\n            background: linear-gradient(90deg, var(--accent), var(--accent2));\n        }\n\n        .page-subtitle {\n            max-width: 430px;\n            margin-bottom: 20px;\n            font-size: 14px;\n        }\n\n        .mode-card, .freestyle-card, .phrase-card, .result-box,\n        .stat-card, .setting, .profile-editor, .profile-card,\n        .mode-stat-card, .mode-details, .share-card {\n            background: linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.012)), var(--panel-glass);\n            border-color: color-mix(in srgb, var(--border) 82%, white 18%);\n            box-shadow: var(--tight-shadow);\n        }\n\n        .mode-card {\n            padding: 16px;\n            margin-bottom: 13px;\n            border-radius: 18px;\n        }\n\n        #modeScreen .mode-card:first-of-type .mode-options {\n            grid-template-columns: repeat(2, minmax(0, 1fr));\n        }\n\n        .option {\n            position: relative;\n            padding: 14px 15px;\n            border: 1px solid var(--border);\n            background: rgba(255,255,255,.025);\n        }\n\n        .option:hover {\n            border-color: color-mix(in srgb, var(--accent) 45%, var(--border));\n            transform: translateY(-1px);\n        }\n\n        .option.selected {\n            padding-right: 42px;\n            border-color: var(--accent);\n            background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 17%, transparent), rgba(255,255,255,.025));\n            box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 25%, transparent), 0 10px 25px color-mix(in srgb, var(--accent) 12%, transparent);\n        }\n\n        .option.selected::after {\n            content: \"✓\";\n            position: absolute;\n            top: 12px;\n            right: 12px;\n            display: grid;\n            width: 23px;\n            height: 23px;\n            place-items: center;\n            border-radius: 50%;\n            background: var(--accent);\n            color: #fff;\n            font-size: 12px;\n            font-weight: 1000;\n        }\n\n        .start-game-btn, .action-btn, .share-btn, .profile-save-btn, .popup-btn {\n            background: linear-gradient(135deg, var(--accent), var(--accent2));\n            box-shadow: 0 9px 24px color-mix(in srgb, var(--accent) 23%, transparent);\n            letter-spacing: .35px;\n        }\n\n        .start-game-btn {\n            min-height: 54px;\n            border-radius: 17px;\n        }\n\n        .secondary-btn, .popup-close {\n            background: var(--panel2);\n            box-shadow: none;\n        }\n\n        .game-top { margin-bottom: 15px; }\n\n        .badge {\n            padding: 8px 11px;\n            border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);\n            border-radius: 999px;\n            background: color-mix(in srgb, var(--accent) 12%, transparent);\n            color: var(--accent);\n            font-size: 11px;\n            font-weight: 1000;\n            letter-spacing: .8px;\n        }\n\n        .phrase-card {\n            position: relative;\n            overflow: hidden;\n            padding: 19px;\n        }\n\n        .phrase-card::before {\n            content: \"\";\n            position: absolute;\n            inset: 0 auto 0 0;\n            width: 3px;\n            background: linear-gradient(var(--accent), var(--accent2));\n        }\n\n        .typing-area {\n            min-height: 116px;\n            border-width: 1px;\n            background: rgba(8, 10, 15, .68);\n            box-shadow: inset 0 1px 0 rgba(255,255,255,.025);\n        }\n\n        .typing-area:focus {\n            border-color: var(--accent);\n            box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent);\n        }\n\n        .progress { height: 8px; background: rgba(255,255,255,.055); }\n        .progress-bar { background: linear-gradient(90deg, var(--accent), var(--accent2)); }\n\n        .stats-row { gap: 8px; }\n        .stat {\n            border: 1px solid var(--border);\n            border-radius: 13px;\n            background: rgba(255,255,255,.025);\n        }\n\n        .result-box { overflow: hidden; }\n        .result-score {\n            background: linear-gradient(135deg, var(--text), color-mix(in srgb, var(--accent) 58%, white));\n            -webkit-background-clip: text;\n            background-clip: text;\n            color: transparent;\n            letter-spacing: -2px;\n        }\n\n        .result-stat, .mode-stat-value {\n            border: 1px solid rgba(255,255,255,.035);\n        }\n\n        .overall-stats-grid .stat-card {\n            position: relative;\n            overflow: hidden;\n        }\n\n        .overall-stats-grid .stat-card::after {\n            content: \"\";\n            position: absolute;\n            right: -18px;\n            bottom: -24px;\n            width: 58px;\n            height: 58px;\n            border-radius: 50%;\n            background: color-mix(in srgb, var(--accent) 10%, transparent);\n        }\n\n        .mode-details summary:hover { background: rgba(255,255,255,.025); }\n\n        .setting-title { font-size: 15px; }\n        select, #profileNameInput {\n            border-color: color-mix(in srgb, var(--border) 85%, white 15%);\n            background: rgba(8,10,15,.58);\n        }\n\n        .bottom-nav {\n            height: 72px;\n            background: rgba(13,15,20,.82);\n            border-top-color: rgba(255,255,255,.08);\n            box-shadow: 0 -10px 35px rgba(0,0,0,.28);\n            backdrop-filter: blur(18px);\n            -webkit-backdrop-filter: blur(18px);\n        }\n\n        .nav-btn { position: relative; }\n        .nav-btn.active {\n            background: color-mix(in srgb, var(--accent) 13%, transparent);\n            box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 14%, transparent);\n        }\n\n        @media (max-width: 380px) {\n            .screen { padding-inline: 14px; }\n            .option { padding: 13px; }\n            .option.selected { padding-right: 38px; }\n            .option span { font-size: 12px; }\n            .phrase-card { padding: 16px; }\n        }\n\n    </style>\n</head>\n\n<body class=\"welcome\">\n\n<div class=\"app\">\n\n    <!-- HOME -->\n\n    <section id=\"homeScreen\" class=\"home active\">\n        <div class=\"home-reference\">\n\n            <div class=\"home-hero-visual single-logo\">\n                <img\n                        class=\"home-full-logo\"\n                        src=\"data:image/png;base64,\"\n                        alt=\"Keyboard Warrior\">\n            </div>\n\n            <button\n                    type=\"button\"\n                    class=\"play-btn home-play\"\n                    onclick=\"openModeScreen()\">\n                PLAY ▶\n            </button>\n\n            <button\n                    type=\"button\"\n                    class=\"home-view-stats\"\n                    onclick=\"navigate('stats')\">\n                <span class=\"home-stats-icon\">▥</span>\n                VIEW STATS\n            </button>\n\n        </div>\n    </section>\n\n\n    <!-- MODE -->\n\n    <section id=\"modeScreen\" class=\"screen\">\n\n        <div class=\"page-title\">\n            Choose Your Battle\n        </div>\n\n        <p class=\"page-subtitle\">\n            Pick your attitude and level of mercy — or go completely Freestyle.\n        </p>\n\n        <div class=\"mode-card\">\n\n            <h2>Attitude</h2>\n\n            <p>How should the game talk to you?</p>\n\n            <div class=\"mode-options\">\n\n                <button\n                        type=\"button\"\n                        class=\"option selected\"\n                        aria-pressed=\"true\"\n                        id=\"friendlyOption\"\n                        onclick=\"selectAttitude('friendly')\">\n\n                    <strong>Friendly</strong>\n\n                    <span>\n                    Encouraging comments and wholesome internet energy.\n                </span>\n\n                </button>\n\n                <button\n                        type=\"button\"\n                        class=\"option\"\n                        aria-pressed=\"false\"\n                        id=\"almightyOption\"\n                        onclick=\"selectAttitude('almighty')\">\n\n                    <strong>Almighty</strong>\n\n                    <span>\n                    Harsh commentary, chaotic trash talk and absolutely no sympathy.\n                </span>\n\n                </button>\n\n            </div>\n\n        </div>\n\n\n        <div class=\"mode-card\">\n\n            <h2>Difficulty</h2>\n\n            <p>How much mercy does your keyboard get?</p>\n\n            <div class=\"mode-options\">\n\n                <button\n                        type=\"button\"\n                        class=\"option selected\"\n                        aria-pressed=\"true\"\n                        id=\"easyOption\"\n                        onclick=\"selectDifficulty('easy')\">\n\n                    <strong>Easy</strong>\n\n                    <span>\n                    You can use Backspace and fix your mistakes.\n                </span>\n\n                </button>\n\n                <button\n                        type=\"button\"\n                        class=\"option\"\n                        aria-pressed=\"false\"\n                        id=\"mediumOption\"\n                        onclick=\"selectDifficulty('medium')\">\n\n                    <strong>Medium</strong>\n\n                    <span>\n                    Backspace is disabled. Type it and live with it.\n                </span>\n\n                </button>\n\n                <button\n                        type=\"button\"\n                        class=\"option\"\n                        aria-pressed=\"false\"\n                        id=\"noMercyOption\"\n                        onclick=\"selectDifficulty('nomercy')\">\n\n                    <strong>No Mercy</strong>\n\n                    <span>\n                    No Backspace. Tight time limit based on phrase length. Miss the deadline and your score drops, but you can still finish.\n                </span>\n\n                </button>\n\n            </div>\n\n        </div>\n\n\n        <div class=\"mode-card\">\n\n            <h2>Special Modes</h2>\n\n            <p>Different rules, different kind of fun.</p>\n\n            <div class=\"special-mode-carousel\" aria-label=\"Special mode chooser\">\n\n                <button type=\"button\" class=\"special-arrow\" onclick=\"moveSpecialMode(-1)\" aria-label=\"Previous special mode\">‹</button>\n\n                <div class=\"special-mode-stage\">\n\n                <button\n                        type=\"button\"\n                        class=\"option special-mode-slide\"\n                        aria-pressed=\"false\"\n                        id=\"freestyleOption\"\n                        onclick=\"selectFreestyle()\">\n                    <span class=\"special-mode-symbol\" aria-hidden=\"true\">✍</span>\n                    <strong>Freestyle</strong>\n                    <span>No fixed phrase. No difficulty. Your writing, your rules.</span>\n                </button>\n\n                <button\n                        type=\"button\"\n                        class=\"option special-mode-slide special-mode-hidden\"\n                        aria-pressed=\"false\"\n                        id=\"suddenDeathOption\"\n                        onclick=\"selectDifficulty('suddendeath')\">\n                    <span class=\"special-mode-symbol\" aria-hidden=\"true\">☠</span>\n                    <strong>Sudden Death</strong>\n                    <span>No Backspace. One mistake and the round ends instantly. No second chances.</span>\n                </button>\n\n                <button\n                        type=\"button\"\n                        class=\"option special-mode-slide special-mode-hidden\"\n                        aria-pressed=\"false\"\n                        id=\"comboOption\"\n                        onclick=\"selectDifficulty('combo')\">\n                    <span class=\"special-mode-symbol\" aria-hidden=\"true\">🔥</span>\n                    <strong>Combo</strong>\n                    <span>No Backspace. One mistake breaks your streak instantly. Chain correct words to build a combo that carries between rounds.</span>\n                </button>\n\n                <button type=\"button\" class=\"option special-mode-slide special-mode-hidden\" aria-pressed=\"false\" id=\"madlibsOption\" onclick=\"selectDifficulty('madlibs')\">\n                    <span class=\"special-mode-symbol\" aria-hidden=\"true\">🎭</span>\n                    <strong>Mad Libs Mode</strong>\n                    <span>Replace the blanks with your wildest words. Speed and absurdity both count.</span>\n                </button>\n\n                <button type=\"button\" class=\"option special-mode-slide special-mode-hidden\" aria-pressed=\"false\" id=\"reverseOption\" onclick=\"selectDifficulty('reverse')\">\n                    <span class=\"special-mode-symbol\" aria-hidden=\"true\">⇄</span>\n                    <strong>Reverse Typer</strong>\n                    <span>The phrase appears backwards. Untangle it and type the original forwards.</span>\n                </button>\n\n                </div>\n\n                <button type=\"button\" class=\"special-arrow\" onclick=\"moveSpecialMode(1)\" aria-label=\"Next special mode\">›</button>\n\n            </div>\n\n            <div class=\"special-mode-position\" id=\"specialModePosition\" aria-live=\"polite\">1 / 5</div>\n\n        </div>\n\n\n        <div class=\"mode-card\">\n\n            <h2>Chaos Mode</h2>\n\n            <p>Three ways to lose your mind: survive curses, trade rounds in Roast Battle, or race simultaneously in Mirror Match.</p>\n\n            <div class=\"mode-options\">\n\n                <button\n                        type=\"button\"\n                        class=\"option\"\n                        id=\"chaosOption\"\n                        onclick=\"openChaosScreen()\">\n                    <strong>Enter Chaos Mode</strong>\n                    <span>Choose Curse Mode, Roast Battle, or the split-screen Mirror Match.</span>\n                </button>\n\n            </div>\n\n        </div>\n\n\n        <button\n                type=\"button\"\n                class=\"start-game-btn\"\n                onclick=\"startSelectedMode()\">\n            START BATTLE\n        </button>\n\n    </section>\n\n\n    <!-- CHAOS MODE SELECT -->\n\n    <section id=\"chaosScreen\" class=\"screen\">\n\n        <div class=\"page-title\">\n            Chaos Mode\n        </div>\n\n        <p class=\"page-subtitle\">\n            Pick your poison.\n        </p>\n\n        <div class=\"mode-card\">\n\n            <h2>Curse Mode</h2>\n\n            <p>No Backspace. Rapid curses can stack, and every fifth phrase becomes a Boss Curse chaining shake, scramble and jolt back-to-back.</p>\n\n            <button\n                    type=\"button\"\n                    class=\"action-btn\"\n                    onclick=\"startCurseMode()\">\n                START CURSED ROUND\n            </button>\n\n        </div>\n\n        <div class=\"mode-card\">\n\n            <h2>Roast Battle</h2>\n\n            <p>Pass the device between two players. Same phrase, same clock, Almighty attitude only. Whoever loses gets roasted on screen for everyone to see.</p>\n\n            <button\n                    type=\"button\"\n                    class=\"action-btn\"\n                    onclick=\"startRoastBattle()\">\n                START ROAST BATTLE\n            </button>\n\n        </div>\n\n        <div class=\"mode-card\">\n\n            <h2>⇅ Mirror Match</h2>\n\n            <p>Two players race on the same split screen with the exact same phrase. Finish first and unleash instant curses on your opponent's remaining input.</p>\n\n            <button type=\"button\" class=\"action-btn\" onclick=\"startMirrorMatch()\">\n                START MIRROR MATCH\n            </button>\n\n        </div>\n\n        <button\n                type=\"button\"\n                class=\"action-btn secondary-btn\"\n                onclick=\"showModeScreen()\">\n            BACK\n        </button>\n\n    </section>\n\n\n    <!-- MIRROR MATCH — SIMULTANEOUS SPLIT SCREEN -->\n\n    <section id=\"mirrorMatchScreen\" class=\"screen\">\n        <div class=\"mirror-arena\">\n            <button type=\"button\" class=\"mirror-quit\" onclick=\"quitMirrorMatch()\">QUIT</button>\n            <div class=\"mirror-countdown\" id=\"mirrorCountdown\">3</div>\n\n            <div class=\"mirror-face-flip\">\n                <div class=\"mirror-player\" id=\"mirrorPlayer1Panel\">\n                    <div class=\"mirror-player-head\">\n                        <span class=\"mirror-player-name\">PLAYER 1</span>\n                        <span class=\"mirror-player-status\" id=\"mirrorPlayer1Status\">GET READY</span>\n                    </div>\n                    <div class=\"mirror-phrase\" id=\"mirrorPhrase1\"></div>\n                    <textarea class=\"mirror-input\" id=\"mirrorInput1\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\" placeholder=\"Player 1 types here...\"></textarea>\n                    <div class=\"mirror-keyboard\" id=\"mirrorKeyboard1\" aria-label=\"Player 1 touch keyboard\"></div>\n                    <div class=\"mirror-progress\"><div class=\"mirror-progress-bar\" id=\"mirrorProgress1\"></div></div>\n                </div>\n            </div>\n\n            <div class=\"mirror-divider\"><span class=\"mirror-vs\">LIVE VS</span></div>\n\n            <div class=\"mirror-player\" id=\"mirrorPlayer2Panel\">\n                <div class=\"mirror-player-head\">\n                    <span class=\"mirror-player-name\">PLAYER 2</span>\n                    <span class=\"mirror-player-status\" id=\"mirrorPlayer2Status\">GET READY</span>\n                </div>\n                <div class=\"mirror-phrase\" id=\"mirrorPhrase2\"></div>\n                <textarea class=\"mirror-input\" id=\"mirrorInput2\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\" placeholder=\"Player 2 types here...\"></textarea>\n                <div class=\"mirror-keyboard\" id=\"mirrorKeyboard2\" aria-label=\"Player 2 touch keyboard\"></div>\n                <div class=\"mirror-progress\"><div class=\"mirror-progress-bar\" id=\"mirrorProgress2\"></div></div>\n            </div>\n        </div>\n    </section>\n\n\n    <!-- MIRROR MATCH RESULTS -->\n\n    <section id=\"mirrorResultScreen\" class=\"screen\">\n        <div class=\"page-title\">Mirror Match Complete</div>\n        <p class=\"page-subtitle\">One player finished. The other survived the fallout.</p>\n        <div class=\"result-box\">\n            <div class=\"roast-winner-banner\" id=\"mirrorWinnerLabel\">PLAYER 1 WINS</div>\n            <div class=\"roast-score-row\">\n                <div class=\"roast-score-box\" id=\"mirrorP1Box\"><div class=\"roast-score-label\">PLAYER 1</div><div class=\"roast-score-value\" id=\"mirrorP1Score\">0.0s</div></div>\n                <div class=\"roast-score-box\" id=\"mirrorP2Box\"><div class=\"roast-score-label\">PLAYER 2</div><div class=\"roast-score-value\" id=\"mirrorP2Score\">0.0s</div></div>\n            </div>\n            <div class=\"comment-box\" id=\"mirrorComment\"></div>\n        </div>\n        <button type=\"button\" class=\"action-btn\" onclick=\"startMirrorMatch()\">REMATCH</button>\n        <button type=\"button\" class=\"action-btn secondary-btn\" onclick=\"quitMirrorMatch()\">BACK TO CHAOS</button>\n    </section>\n\n\n    <!-- ROAST BATTLE — PASS DEVICE -->\n\n    <section id=\"roastPassScreen\" class=\"screen\">\n\n        <div class=\"page-title\">\n            Roast Battle\n        </div>\n\n        <p class=\"page-subtitle\">\n            Pass the device to the next player.\n        </p>\n\n        <div class=\"roast-pass-card\">\n            <div class=\"roast-player-tag\" id=\"roastPassPlayer\">PLAYER 1</div>\n            <p id=\"roastPassMessage\">Get ready. Same phrase rules apply — type it as fast and clean as you can.</p>\n        </div>\n\n        <button\n                type=\"button\"\n                class=\"action-btn\"\n                id=\"roastPassAction\">\n            I'M READY\n        </button>\n\n        <button\n                type=\"button\"\n                class=\"action-btn secondary-btn\"\n                onclick=\"quitRoastBattle()\">\n            QUIT ROAST BATTLE\n        </button>\n\n    </section>\n\n\n    <!-- ROAST BATTLE — RESULTS -->\n\n    <section id=\"roastResultScreen\" class=\"screen\">\n\n        <div class=\"page-title\">\n            Roast Battle Complete\n        </div>\n\n        <p class=\"page-subtitle\">\n            Here's how it went down.\n        </p>\n\n        <div class=\"result-box\">\n\n            <div class=\"roast-winner-banner\" id=\"roastWinnerLabel\">PLAYER 1 WINS</div>\n\n            <div class=\"roast-score-row\">\n                <div class=\"roast-score-box\" id=\"roastP1Box\">\n                    <div class=\"roast-score-label\">PLAYER 1</div>\n                    <div class=\"roast-score-value\" id=\"roastP1Score\">0% • 0 WPM</div>\n                </div>\n                <div class=\"roast-score-box\" id=\"roastP2Box\">\n                    <div class=\"roast-score-label\">PLAYER 2</div>\n                    <div class=\"roast-score-value\" id=\"roastP2Score\">0% • 0 WPM</div>\n                </div>\n            </div>\n\n            <div class=\"comment-box\" id=\"roastComment\"></div>\n\n        </div>\n\n        <button\n                type=\"button\"\n                class=\"action-btn\"\n                onclick=\"restartRoastBattle()\">\n            REMATCH\n        </button>\n\n        <button\n                type=\"button\"\n                class=\"action-btn secondary-btn\"\n                onclick=\"showModeScreen()\">\n            CHANGE MODES\n        </button>\n\n    </section>\n\n\n    <!-- GAME -->\n\n    <section id=\"gameScreen\" class=\"screen\">\n\n        <div class=\"game-top\">\n\n            <div\n                    class=\"badge\"\n                    id=\"gameAttitude\">\n                FRIENDLY\n            </div>\n\n            <div class=\"game-actions\" aria-label=\"Round controls\">\n                <button\n                        type=\"button\"\n                        class=\"restart-btn\"\n                        onclick=\"restartGame()\">\n                    RESTART\n                </button>\n\n                <button\n                        type=\"button\"\n                        class=\"restart-btn quit-btn\"\n                        id=\"quitGameBtn\"\n                        onclick=\"quitGame()\">\n                    QUIT\n                </button>\n            </div>\n\n        </div>\n\n\n        <div class=\"phrase-card\">\n\n            <div class=\"phrase-label\">\n                Type this\n            </div>\n\n            <div\n                    class=\"phrase\"\n                    id=\"phraseDisplay\">\n            </div>\n\n        </div>\n\n\n        <textarea\n                id=\"typingInput\"\n                class=\"typing-area\"\n                autocomplete=\"off\"\n                autocorrect=\"off\"\n                autocapitalize=\"off\"\n                spellcheck=\"false\"\n                placeholder=\"Start typing here...\"\n        ></textarea>\n\n\n        <div class=\"progress\">\n            <div\n                    class=\"progress-bar\"\n                    id=\"progressBar\">\n            </div>\n        </div>\n\n\n        <div class=\"stats-row\">\n\n            <div class=\"stat\">\n                <div class=\"stat-value\" id=\"liveTime\">0.0</div>\n                <div class=\"stat-label\">SECONDS</div>\n            </div>\n\n            <div class=\"stat\">\n                <div class=\"stat-value\" id=\"liveCorrect\">0</div>\n                <div class=\"stat-label\">CORRECT</div>\n            </div>\n\n            <div class=\"stat\">\n                <div class=\"stat-value\" id=\"liveMistakes\">0</div>\n                <div class=\"stat-label\">CHAR ERRORS</div>\n            </div>\n\n            <div class=\"stat\" id=\"liveComboStat\" style=\"display:none;\">\n                <div class=\"stat-value\" id=\"liveCombo\">0x</div>\n                <div class=\"stat-label\">COMBO</div>\n            </div>\n\n        </div>\n\n        <div class=\"curse-hint\" id=\"curseRuleHint\" style=\"display:none;\">⚡ CURSE MODE: rapid curses can stack. No Backspace. No safe moments.</div>\n        <div class=\"suddendeath-hint\" id=\"suddenDeathRuleHint\" style=\"display:none;\">💀 SUDDEN DEATH: one mistake ends the round. No Backspace.</div>\n        <div class=\"suddendeath-hint\" id=\"comboRuleHint\" style=\"display:none;\">🔥 COMBO: no Backspace. One mistake breaks your streak instantly.</div>\n        <div class=\"suddendeath-hint\" id=\"madlibsRuleHint\" style=\"display:none;\">🎭 MAD LIBS: type the whole sentence and replace every [blank]. Make it weird.</div>\n        <div class=\"suddendeath-hint\" id=\"reverseRuleHint\" style=\"display:none;\">🧠 REVERSE TYPER: read backwards, type forwards. Your brain has been warned.</div>\n        <button type=\"button\" class=\"action-btn\" id=\"madlibsFinishBtn\" onclick=\"finishMadLibs()\" style=\"display:none;\">GRADE MY CHAOS</button>\n\n        <button\n                type=\"button\"\n                class=\"action-btn freestyle-end-btn\"\n                id=\"freestyleEndBtn\"\n                onclick=\"finishFreestyle()\"\n                style=\"display:none;\">\n            END SESSION\n        </button>\n    </section>\n\n\n    <!-- FREESTYLE -->\n\n    <section id=\"freestyleScreen\" class=\"screen\">\n\n        <div class=\"game-top\">\n            <div class=\"badge\">FREESTYLE</div>\n            <button type=\"button\" class=\"restart-btn\" onclick=\"restartFreestyle()\">Restart</button>\n        </div>\n\n        <div class=\"freestyle-card\">\n            <div class=\"phrase-label\">Write anything</div>\n            <div class=\"freestyle-label\">Suspected spelling mistakes will be highlighted.</div>\n\n            <div class=\"freestyle-editor\">\n                <div id=\"freestyleHighlight\" class=\"freestyle-highlight\" aria-hidden=\"true\"></div>\n                <textarea id=\"freestyleInput\" class=\"freestyle-input\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"sentences\" spellcheck=\"false\" placeholder=\"Start writing here...\"></textarea>\n            </div>\n        </div>\n\n        <div class=\"stats-row\">\n            <div class=\"stat\"><div class=\"stat-value\" id=\"freestyleTime\">0.0</div><div class=\"stat-label\">SECONDS</div></div>\n            <div class=\"stat\"><div class=\"stat-value\" id=\"freestyleWords\">0</div><div class=\"stat-label\">WORDS</div></div>\n            <div class=\"stat\"><div class=\"stat-value\" id=\"freestyleMisspellings\">0</div><div class=\"stat-label\">HIGHLIGHTS</div></div>\n        </div>\n\n        <button type=\"button\" class=\"action-btn\" onclick=\"finishFreestyle()\">END SESSION</button>\n        <button type=\"button\" class=\"action-btn secondary-btn\" onclick=\"showModeScreen()\">CHANGE MODES</button>\n\n    </section>\n\n\n    <!-- FREESTYLE RESULTS -->\n\n    <section id=\"freestyleResultScreen\" class=\"screen\">\n        <div class=\"page-title\">Freestyle Complete</div>\n        <p class=\"page-subtitle\">A standalone writing session. Nothing here affects your Keyboard Warrior stats.</p>\n\n        <div class=\"result-box\">\n            <div class=\"result-stats\">\n                <div class=\"result-stat\"><strong id=\"freestyleResultTime\">0.0s</strong><span>TIME</span></div>\n                <div class=\"result-stat\"><strong id=\"freestyleResultWords\">0</strong><span>WORDS</span></div>\n                <div class=\"result-stat\"><strong id=\"freestyleResultMisspellings\">0</strong><span>HIGHLIGHTS</span></div>\n            </div>\n\n            <div class=\"comment-box\" id=\"freestyleComment\"></div>\n        </div>\n\n        <button type=\"button\" class=\"action-btn\" onclick=\"restartFreestyle()\">WRITE AGAIN</button>\n        <button type=\"button\" class=\"action-btn secondary-btn\" onclick=\"showModeScreen()\">CHANGE MODES</button>\n    </section>\n\n\n    <!-- RESULTS -->\n\n    <section id=\"resultScreen\" class=\"screen\">\n\n        <div class=\"page-title\">\n            Round Complete\n        </div>\n\n        <p class=\"page-subtitle\">\n            The battle is over. Here is your damage report.\n        </p>\n\n\n        <div class=\"result-box\">\n\n            <div class=\"muted\" id=\"resultScoreLabel\">\n                ACCURACY\n            </div>\n\n            <div\n                    class=\"result-score\"\n                    id=\"resultAccuracy\">\n                0%\n            </div>\n\n            <div class=\"result-penalty\" id=\"resultPenalty\"></div>\n\n            <div class=\"sr-only\" id=\"resultAnnouncement\" aria-live=\"assertive\"></div>\n\n\n            <div class=\"result-stats\">\n\n                <div class=\"result-stat\">\n                    <strong id=\"resultTime\">0.0s</strong>\n                    <span>TIME</span>\n                </div>\n\n                <div class=\"result-stat\">\n                    <strong id=\"resultCorrect\">0</strong>\n                    <span>WRONG WORDS</span>\n                </div>\n\n                <div class=\"result-stat\">\n                    <strong id=\"resultMistakes\">0</strong>\n                    <span>CHARACTER ERRORS</span>\n                </div>\n\n                <div class=\"result-stat\">\n                    <strong id=\"resultWpm\">0</strong>\n                    <span>WPM</span>\n                </div>\n\n            </div>\n\n\n            <div\n                    class=\"comment-box\"\n                    id=\"roundComment\">\n            </div>\n\n        </div>\n\n        <button type=\"button\" class=\"action-btn\" id=\"brainBrokeShareBtn\" onclick=\"shareBrainBrokeCard()\" style=\"display:none;\">SHARE BRAIN BROKE CARD</button>\n\n\n        <button\n                type=\"button\"\n                class=\"action-btn\"\n                onclick=\"nextRound()\">\n            NEXT ROUND\n        </button>\n\n\n        <button\n                type=\"button\"\n                class=\"action-btn secondary-btn\"\n                onclick=\"restartGame()\">\n            RESTART\n        </button>\n\n\n        <button\n                type=\"button\"\n                class=\"action-btn secondary-btn\"\n                onclick=\"showModeScreen()\">\n            CHANGE MODES\n        </button>\n\n    </section>\n\n\n    <!-- STATS -->\n\n    <section id=\"statsScreen\" class=\"screen\">\n\n        <div class=\"page-title\">\n            Profile\n        </div>\n\n        <p class=\"page-subtitle\">\n            Your keyboard warrior record.\n        </p>\n\n\n        <div class=\"profile-card\">\n\n            <button\n                    type=\"button\"\n                    class=\"profile-avatar\"\n                    id=\"profileAvatarButton\"\n                    onclick=\"chooseProfileAvatar()\"\n                    aria-label=\"Change profile avatar\">\n                <img id=\"profileAvatarImage\" alt=\"Player avatar\">\n                <span class=\"avatar-fallback\">KW</span>\n                <span class=\"avatar-edit-badge\" aria-hidden=\"true\">✎</span>\n            </button>\n\n            <div class=\"profile-info\">\n\n                <div class=\"profile-kicker\">\n                    KEYBOARD WARRIOR PROFILE\n                </div>\n\n                <div\n                        class=\"profile-name\"\n                        id=\"profileNameDisplay\">\n                    YOUR NAME\n                </div>\n\n                <div\n                        class=\"profile-rank\"\n                        id=\"profileRankDisplay\">\n                    <span id=\"profileRankText\">UNTESTED WARRIOR</span>\n                    <button\n                            type=\"button\"\n                            class=\"rank-info-btn\"\n                            onclick=\"openRankInfo()\"\n                            aria-label=\"How ranks work\">\n                        i\n                    </button>\n                </div>\n\n            </div>\n\n        </div>\n\n        <div class=\"profile-editor\">\n\n            <input\n                    type=\"file\"\n                    id=\"profileAvatarInput\"\n                    accept=\"image/png,image/jpeg,image/webp\"\n                    hidden\n                    onchange=\"saveProfileAvatar(this.files[0])\">\n\n            <label for=\"profileNameInput\">\n                PLAYER NAME\n            </label>\n\n            <div class=\"profile-name-row\">\n\n                <input\n                        type=\"text\"\n                        id=\"profileNameInput\"\n                        maxlength=\"24\"\n                        autocomplete=\"nickname\"\n                        placeholder=\"Enter your warrior name\">\n\n                <button\n                        type=\"button\"\n                        class=\"profile-save-btn\"\n                        onclick=\"saveProfileName()\">\n                    SAVE\n                </button>\n\n            </div>\n\n            <div class=\"muted profile-hint\">\n                Tap the avatar to choose a warrior icon or upload a photo. It also appears on exported profile cards.\n            </div>\n\n            <button type=\"button\" class=\"avatar-select-btn\" onclick=\"chooseProfileAvatar()\">CHOOSE AVATAR</button>\n            <button type=\"button\" class=\"avatar-reset-btn\" id=\"avatarResetButton\" onclick=\"resetProfileAvatar()\">\n                RESET AVATAR\n            </button>\n\n        </div>\n\n\n        <div class=\"overall-stats-grid\">\n\n        <div class=\"stat-card\">\n\n            <h3>Overall Rounds</h3>\n\n            <div\n                    class=\"big-stat\"\n                    id=\"totalRounds\">\n                0\n            </div>\n\n            <div class=\"muted\">\n                Total battles completed\n            </div>\n\n        </div>\n\n\n        <div class=\"stat-card\">\n\n            <h3>Overall Best Score</h3>\n\n            <div\n                    class=\"big-stat\"\n                    id=\"bestAccuracy\">\n                0%\n            </div>\n\n            <div class=\"muted\">\n                Your cleanest performance\n            </div>\n\n        </div>\n\n\n        <div class=\"stat-card\">\n\n            <h3>Overall Best WPM</h3>\n\n            <div\n                    class=\"big-stat\"\n                    id=\"bestWpm\">\n                0\n            </div>\n\n            <div class=\"muted\">\n                Fastest typing speed\n            </div>\n\n        </div>\n\n\n        <div class=\"stat-card\">\n\n            <h3>Total Character Errors</h3>\n\n            <div\n                    class=\"big-stat\"\n                    id=\"totalMistakes\">\n                0\n            </div>\n\n            <div class=\"muted\">\n                Insertions, deletions and substitutions recorded\n            </div>\n\n        </div>\n\n        </div>\n\n\n        <div class=\"mode-stat-section\">\n\n            <h2>Stats By Language</h2>\n\n            <div id=\"languageStatsContainer\"></div>\n\n            <h2>Stats By Language &amp; Mode</h2>\n\n            <div id=\"modeStatsContainer\"></div>\n\n        </div>\n\n        <div class=\"share-card\">\n            <div class=\"share-card-title\">Keyboard Warrior Profile Card</div>\n            <div class=\"share-preview\" id=\"sharePreview\">\n                Complete a round to generate your profile card.\n            </div>\n            <button\n                    type=\"button\"\n                    class=\"share-btn\"\n                    id=\"shareStatsButton\"\n                    onclick=\"shareStats()\">\n                GENERATE &amp; EXPORT CARD\n            </button>\n        </div>\n\n        <div class=\"image-preview-card\" id=\"imagePreviewCard\">\n            <img id=\"imagePreview\" alt=\"Keyboard Warrior profile card\">\n        </div>\n\n    </section>\n\n\n    <!-- SETTINGS -->\n\n    <section id=\"settingsScreen\" class=\"screen\">\n\n        <div class=\"page-title\">\n            Settings\n        </div>\n\n        <p class=\"page-subtitle\">\n            Customize your keyboard warfare experience.\n        </p>\n\n\n        <div class=\"setting\">\n\n            <div class=\"setting-title\">\n                Language\n            </div>\n\n            <div class=\"setting-description\">\n                Only typing phrases will change language. The rest of the app stays in English.\n            </div>\n\n            <select\n                    id=\"languageSelect\"\n                    onchange=\"changeLanguage(this.value)\">\n\n                <option value=\"english\">English</option>\n                <option value=\"filipino\">Filipino</option>\n\n            </select>\n\n        </div>\n\n\n        <div class=\"setting\">\n\n            <div class=\"setting-title\">\n                Accent Color\n            </div>\n\n            <div class=\"setting-description\">\n                Personalize the app's accent color.\n            </div>\n\n            <div class=\"accent-control\">\n                <input type=\"color\" id=\"accentColorPicker\" value=\"#ff4d6d\"\n                       onchange=\"changeAccentColor(this.value)\"\n                       aria-label=\"Choose accent color\">\n                <span class=\"muted\" id=\"accentColorValue\">#FF4D6D</span>\n            </div>\n\n        </div>\n\n\n        <div class=\"setting\">\n\n            <div class=\"setting-title\">\n                Current Attitude\n            </div>\n\n            <div\n                    class=\"setting-description\"\n                    id=\"currentAttitudeText\">\n                Friendly\n            </div>\n\n        </div>\n\n\n        <div class=\"setting\">\n\n            <div class=\"setting-title\">\n                Current Difficulty\n            </div>\n\n            <div\n                    class=\"setting-description\"\n                    id=\"currentDifficultyText\">\n                Easy\n            </div>\n\n        </div>\n\n        <div class=\"setting version-setting\">\n            <div>\n                <div class=\"setting-title\">App Version</div>\n                <div class=\"setting-description\" style=\"margin:4px 0 0;\">Keyboard Warrior Simulator</div>\n            </div>\n            <div class=\"version-badge\" id=\"appVersion\">v1.2.1</div>\n        </div>\n\n        <div class=\"setting danger-setting\">\n            <div class=\"setting-title\">Danger Zone</div>\n            <div class=\"setting-description\">\n                Permanently erase all stats, profile data and preferences stored on this device.\n            </div>\n            <button type=\"button\" class=\"danger-btn\" onclick=\"openResetDataDialog()\">\n                RESET ALL DATA\n            </button>\n        </div>\n\n    </section>\n\n</div>\n\n\n<!-- SHARE IMAGE POPUP -->\n\n<div\n        class=\"share-overlay\"\n        id=\"shareOverlay\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"shareDialogTitle\">\n\n    <div class=\"share-popup\">\n\n        <h2 id=\"shareDialogTitle\">\n            Keyboard Warrior Card\n        </h2>\n\n        <img\n                id=\"sharePopupImage\"\n                class=\"popup-image\"\n                alt=\"Generated Keyboard Warrior result card\">\n\n        <div class=\"export-status\">\n            High-resolution PNG • 1080 × 1350 • Ready for Photos / Gallery\n        </div>\n\n\n        <button\n                type=\"button\"\n                class=\"popup-btn\"\n                onclick=\"exportGeneratedImage()\">\n            SAVE TO PHOTOS / GALLERY\n        </button>\n\n        <div\n                class=\"export-status\"\n                id=\"exportStatus\"\n                aria-live=\"polite\">\n        </div>\n\n\n        <button\n                type=\"button\"\n                class=\"popup-btn popup-close\"\n                onclick=\"closeSharePopup()\">\n            CLOSE\n        </button>\n\n    </div>\n\n</div>\n\n\n<!-- RANK SYSTEM INFO POPUP -->\n\n<div\n        class=\"info-overlay\"\n        id=\"rankInfoOverlay\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"rankDialogTitle\">\n\n    <div class=\"info-popup\">\n\n        <h2 id=\"rankDialogTitle\">\n            Rank System\n        </h2>\n\n        <p class=\"info-popup-subtitle\">\n            Ranks are based on total rounds played and your average recorded score. No Mercy uses its time-adjusted ranked score.\n        </p>\n\n        <div\n                class=\"rank-info-progress\"\n                id=\"rankInfoProgress\">\n        </div>\n\n        <div id=\"rankInfoList\"></div>\n\n        <button\n                type=\"button\"\n                class=\"popup-btn popup-close\"\n                onclick=\"closeRankInfo()\">\n            CLOSE\n        </button>\n\n    </div>\n\n</div>\n\n<!-- RESET DATA CONFIRMATION -->\n\n<div\n        class=\"info-overlay\"\n        id=\"resetDataOverlay\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"resetDataTitle\">\n    <div class=\"info-popup\">\n        <h2 id=\"resetDataTitle\">Reset all data?</h2>\n        <p class=\"info-popup-subtitle\">This action is permanent and cannot be undone.</p>\n        <div class=\"reset-warning\">\n            This will erase your rounds, scores, ranks, English and Filipino records, profile name, avatar, language, and appearance preferences.\n        </div>\n        <div class=\"reset-actions\">\n            <button type=\"button\" class=\"popup-btn confirm-reset-btn\" onclick=\"confirmResetAllData()\">\n                YES, DELETE EVERYTHING\n            </button>\n            <button type=\"button\" class=\"popup-btn popup-close\" onclick=\"closeResetDataDialog()\">\n                CANCEL\n            </button>\n        </div>\n    </div>\n</div>\n\n\n<!-- AVATAR PICKER -->\n\n<div class=\"info-overlay\" id=\"avatarPickerOverlay\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"avatarPickerTitle\">\n    <div class=\"info-popup\">\n        <h2 id=\"avatarPickerTitle\">Choose Your Avatar</h2>\n        <p class=\"info-popup-subtitle\">Pick a warrior or upload your own photo.</p>\n        <div class=\"avatar-picker-grid\">\n            <button type=\"button\" class=\"avatar-choice\" onclick=\"selectPresetAvatar('🥷','#5b21b6','#ec4899')\" aria-label=\"Ninja avatar\">🥷</button>\n            <button type=\"button\" class=\"avatar-choice\" onclick=\"selectPresetAvatar('🤖','#0f766e','#22d3ee')\" aria-label=\"Robot avatar\">🤖</button>\n            <button type=\"button\" class=\"avatar-choice\" onclick=\"selectPresetAvatar('💀','#1f2937','#ef4444')\" aria-label=\"Skull avatar\">💀</button>\n            <button type=\"button\" class=\"avatar-choice\" onclick=\"selectPresetAvatar('🔥','#b91c1c','#f59e0b')\" aria-label=\"Fire avatar\">🔥</button>\n            <button type=\"button\" class=\"avatar-choice\" onclick=\"selectPresetAvatar('🧙','#312e81','#a855f7')\" aria-label=\"Wizard avatar\">🧙</button>\n            <button type=\"button\" class=\"avatar-choice\" onclick=\"selectPresetAvatar('👾','#4c1d95','#22c55e')\" aria-label=\"Alien avatar\">👾</button>\n        </div>\n        <div class=\"avatar-picker-actions\">\n            <button type=\"button\" class=\"avatar-custom-btn\" onclick=\"chooseCustomAvatar()\">UPLOAD CUSTOM PHOTO</button>\n            <button type=\"button\" class=\"popup-btn popup-close\" onclick=\"closeAvatarPicker()\">CANCEL</button>\n        </div>\n    </div>\n</div>\n\n\n<!-- NAVIGATION -->\n\n<nav class=\"bottom-nav\">\n\n    <button\n            type=\"button\"\n            class=\"nav-btn active\"\n            id=\"navHome\"\n            onclick=\"navigate('home')\">\n\n        <span class=\"nav-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M12 3 2 12h3v9h6v-6h2v6h6v-9h3L12 3Z\"/></svg>\n        </span>\n        Home\n\n    </button>\n\n\n    <button\n            type=\"button\"\n            class=\"nav-btn\"\n            id=\"navStats\"\n            onclick=\"navigate('stats')\">\n\n        <span class=\"nav-icon\">✦</span>\n        Profile\n\n    </button>\n\n\n    <button\n            type=\"button\"\n            class=\"nav-btn\"\n            id=\"navSettings\"\n            onclick=\"navigate('settings')\">\n\n        <span class=\"nav-icon\">⚙</span>\n        Settings\n\n    </button>\n\n</nav>\n\n\n<script>\n\n    /* =========================================================\n       GAME STATE\n    ========================================================= */\n\n    let attitude = \"friendly\";\n    let difficulty = \"easy\";\n    let selectedMode = \"battle\";\n    let freestyleStartTime = 0;\n    let freestyleTimerInterval = null;\n    let language = \"english\";\n    let theme = \"dark\";\n    let accentColor = \"#ff4d6d\";\n    let profileName = \"YOUR NAME\";\n    let profileAvatarData = \"\";\n    const APP_VERSION = \"1.4.0\";\n\n    let currentPhrase = \"\";\n    let currentPhraseWords = [];\n    let phraseIndex = 0;\n\n    let started = false;\n    let finished = false;\n\n    let startTime = 0;\n    let timerInterval = null;\n    let noMercyTimeLimit = 0;\n    let noMercyOvertime = false;\n\n    let mistakeCount = 0;\n    let correctCount = 0;\n    let currentErrorCount = 0;\n    let wrongWordCount = 0;\n    let typedKeystrokes = 0;\n    let incorrectKeystrokes = 0;\n    let previousInputValue = \"\";\n    const phraseQueues = {};\n    let currentMadLibTemplate = \"\";\n    let lastReverseResult = null;\n\n    const madLibTemplates = {\n        english: [\n            \"My [adjective] keyboard challenged a [noun] to a duel and won using [ridiculous weapon].\",\n            \"I blamed my [noun] for the lag, then summoned [famous person or creature] with a [weird object].\",\n            \"The group chat banned me after I posted [absurd activity] while dressed as [silly character].\",\n            \"Breaking news: a [adjective] gamer defeated the internet using only [food] and [strange skill].\"\n        ],\n        filipino: [\n            \"Hinamon ng [pang-uri] kong keyboard ang isang [bagay] gamit ang [nakakatawang sandata].\",\n            \"Sinisi ko ang [bagay] sa lag, tapos lumitaw si [tao o nilalang] na may dalang [kakaibang bagay].\",\n            \"Na-ban ako sa group chat dahil nag-post ako ng [absurdong gawain] habang nakasuot bilang [nakakatawang karakter].\",\n            \"Breaking news: tinalo ng [pang-uri] gamer ang internet gamit lang ang [pagkain] at [kakaibang talento].\"\n        ]\n    };\n\n    /* ---- COMBO MODE ---- */\n    let comboStreak = 0;\n    let maxComboThisSession = 0;\n    let comboWordsCompleted = 0;\n    let bestComboEver = 0;\n\n    /* ---- CURSE MODE (CHAOS) ---- */\n    let curseTimeout = null;\n    let cursePhraseCount = 0;\n    let bossCurseActive = false;\n\n    /* ---- MIRROR MATCH (CHAOS, SIMULTANEOUS 2 PLAYER) ---- */\n    let mirrorMatchPhrase = \"\";\n    let mirrorMatchStartTime = 0;\n    let mirrorMatchWinner = null;\n    let mirrorMatchResults = [null, null];\n    let mirrorChaosInterval = null;\n    let mirrorCountdownTimeout = null;\n\n    /* ---- ROAST BATTLE (CHAOS, 2 PLAYER) ---- */\n    let roastBattleActive = false;\n    let roastBattlePlayer = 1;\n    let roastBattleP1Result = null;\n    let roastBattlePhraseIndex = null;\n    let preRoastAttitude = null;\n    let preRoastDifficulty = null;\n\n\n    /* =========================================================\n       STATS\n    ========================================================= */\n\n    function createDefaultModeStats() {\n        return {\n            rounds: 0,\n            bestAccuracy: 0,\n            bestRankedScore: 0,\n            bestWpm: 0,\n            bestCombo: 0,\n            totalMistakes: 0,\n            totalTime: 0\n        };\n    }\n\n    function createDefaultLanguageStats() {\n        return {\n            rounds: 0,\n            bestAccuracy: 0,\n            bestWpm: 0,\n            totalMistakes: 0,\n            totalAccuracy: 0,\n            totalTime: 0\n        };\n    }\n\n    let languageStats = {\n        english: createDefaultLanguageStats(),\n        filipino: createDefaultLanguageStats()\n    };\n\n    let modeStats = {\n        friendly_easy: createDefaultModeStats(),\n        friendly_medium: createDefaultModeStats(),\n        friendly_nomercy: createDefaultModeStats(),\n        almighty_easy: createDefaultModeStats(),\n        almighty_medium: createDefaultModeStats(),\n        almighty_nomercy: createDefaultModeStats()\n    };\n\n    let roundsPlayed = 0;\n    let bestAccuracy = 0;\n    let bestWpm = 0;\n    let totalMistakes = 0;\n    let totalAccuracy = 0; // sum of every round's accuracy %, used to compute the average for ranking\n\n    function getModeStatsKey(lang, mode, level) {\n        return lang + \"_\" + mode + \"_\" + level;\n    }\n\n    function getNextPhraseIndex(lang, mode) {\n        const available = phrases[lang][mode];\n        const key = lang + \"_\" + mode;\n        if (!phraseQueues[key] || phraseQueues[key].length === 0) {\n            phraseQueues[key] = available.map(function(_, index) { return index; });\n            for (let i = phraseQueues[key].length - 1; i > 0; i--) {\n                const j = Math.floor(Math.random() * (i + 1));\n                const temp = phraseQueues[key][i];\n                phraseQueues[key][i] = phraseQueues[key][j];\n                phraseQueues[key][j] = temp;\n            }\n        }\n        return phraseQueues[key].pop();\n    }\n\n\n    const freestylePhrases = {\n        english: [\n    \"You really typed all that just to be wrong. Impressive.\",\n    \"Bro, the confidence is doing all the heavy lifting because the skill clearly isn't.\",\n    \"Keep explaining. Every extra sentence makes this more embarrassing.\",\n    \"You didn't lose because of lag. You lost because that was your best.\",\n    \"Imagine being this loud and still having nothing to say.\",\n    \"That wasn't a comeback. That was a longer way of admitting you lost.\",\n    \"You're not being underestimated. You're being correctly rated.\",\n    \"I would explain it again, but watching you miss the point is honestly funnier.\",\n    \"You type like the keyboard personally offended you.\",\n    \"The funniest part is that you genuinely thought that was a good play.\",\n    \"Take your time. We can all see the scoreboard while you think of an excuse.\",\n    \"You don't need a new setup. You need a new strategy.\",\n    \"You're arguing with the facts like they're going to get tired and surrender.\",\n    \"That confidence would be scary if it came with evidence.\",\n    \"Bro brought tournament energy to a tutorial lobby.\",\n    \"Keep coping. At this point, it's part of the entertainment.\",\n    \"You didn't cook. You left the stove on and walked away.\",\n    \"That's a bold take for someone currently losing to a sentence.\",\n    \"Your trash talk has better WPM than your actual typing.\",\n    \"You have unlimited excuses and somehow still no answer.\",\n    \"This is less of a comeback and more of a live demonstration of denial.\",\n    \"Bro is fighting the keyboard, the timer, and reality at the same time.\",\n    \"You said 'trust me' like that was supposed to replace being correct.\",\n    \"The scoreboard isn't toxic. It's just honest.\",\n    \"At this point, I'm not even roasting you. You're doing the work yourself.\",\n    \"Holy shit, that was bad.\",\n    \"Stop fucking whining and type the damn phrase.\",\n    \"That excuse is fucking ancient. Try something new.\",\n    \"You're talking like a champion and performing like a warm-up bot.\",\n    \"Keep talking shit. Maybe your WPM will eventually catch up.\"\n        ],\n        filipino: [\n    \"Bro, ang haba ng tinype mo para lang mapatunayan na mali ka. Impressive.\",\n    \"Sobrang lakas ng confidence mo, pero saan banda yung skill?\",\n    \"Sige, explain mo pa. Mas lalo lang nagiging embarrassing bawat sentence.\",\n    \"Hindi lag ang dahilan. Yun na talaga ang best mo.\",\n    \"Ang ingay mo para sa taong wala namang maipakitang punto.\",\n    \"Hindi yan comeback. Mahabang paraan lang yan para umaming talo ka.\",\n    \"Hindi ka minamaliit. Tama lang ang rating sa performance mo.\",\n    \"I-explain ko ulit sana, pero mas nakakatawa kang panoorin habang hindi mo gets.\",\n    \"Parang personal na nakaaway ng keyboard mo yung sentence.\",\n    \"Ang pinakamaganda dito, seryoso kang naniwala na magandang play yun.\",\n    \"Take your time. Nandito lang kami habang gumagawa ka ng bagong excuse.\",\n    \"Hindi bagong setup ang kailangan mo. Bagong strategy.\",\n    \"Nakikipag-away ka sa facts na parang mapapagod silang sumagot.\",\n    \"Nakakatakot sana yung confidence mo kung may evidence lang.\",\n    \"Bro, tournament energy sa tutorial lobby.\",\n    \"Sige lang sa cope. Part na yan ng entertainment.\",\n    \"Hindi ka nagluto. Iniwan mo lang yung kalan na bukas.\",\n    \"Ang tapang ng take mo para sa taong natatalo ng isang sentence.\",\n    \"Mas mabilis pa trash talk mo kaysa actual typing mo.\",\n    \"Unlimited ang excuses mo pero wala pa ring matinong sagot.\",\n    \"Bro, kalaban mo na yung keyboard, timer, at reality sabay-sabay.\",\n    \"Sabi mo 'trust me' na parang kapalit yun ng pagiging tama.\",\n    \"Hindi toxic ang scoreboard. Honest lang siya.\",\n    \"Hindi na kita kailangan i-roast. Ikaw na mismo gumagawa ng trabaho.\",\n    \"Putangina, anong performance yan?\",\n    \"Tigil sa iyak at i-type mo yung damn phrase.\",\n    \"Ang luma na ng excuse mo. Humanap ka naman ng bago.\",\n    \"Champion ang trash talk, warm-up bot ang performance.\",\n    \"Mas mabilis pa mag trash talk kaysa actual typing.\",\n    \"Ang tapang mo sa chat pero talo ka sa isang sentence.\"\n        ]\n    };\n\n    /* =========================================================\n       PHRASES\n    ========================================================= */\n\n    const phrases = {\n\n        english: {\n\n            friendly: [\n\n                \"I respectfully disagree with your opinion.\",\n                \"Maybe we can discuss this without starting a war.\",\n                \"Have a great day and please stay hydrated.\",\n                \"I think your point is interesting.\",\n                \"Let us solve this like reasonable people.\",\n                \"That is actually a pretty good argument.\",\n                \"I understand where you are coming from.\",\n                \"We can disagree and still be friends.\",\n                \"Please remember that everyone makes mistakes.\",\n                \"I hope your day gets better from here.\",\n                \"You make a fair point.\",\n                \"Let us keep the conversation respectful.\",\n                \"I came here to type, not to fight.\",\n                \"Your opinion has been respectfully received.\",\n                \"There is no need to turn this into a battlefield.\",\n                \"Maybe both of us are slightly wrong.\",\n                \"I shall now calmly explain my position.\",\n                \"Congratulations on having a different opinion.\",\n                \"I disagree, but I will survive somehow.\",\n                \"Let us settle this with facts and snacks.\",\n                \"Perhaps we should take a moment to understand each other's perspective before continuing this discussion.\",\n                \"I do not completely agree with what you said, but I appreciate that you took the time to explain your point.\",\n                \"We can have different opinions without turning every conversation into an argument that lasts for the entire afternoon.\",\n                \"Before we start attacking each other's opinions, maybe we should actually read what the other person is saying.\",\n                \"I think this discussion would be much more productive if we focused on the topic instead of attacking the people involved.\"\n\n            ],\n\n            almighty: [\n\n                \"Your argument has less structure than a broken shopping cart.\",\n                \"I have seen loading screens with better reasoning.\",\n                \"Please reconsider your life choices before pressing send.\",\n                \"That opinion arrived with confidence and absolutely no evidence.\",\n                \"Your keyboard deserves compensation for what you just typed.\",\n                \"I would explain it again, but I left my crayons at home.\",\n                \"You typed all of that just to accomplish absolutely nothing.\",\n                \"That argument belongs in a museum of terrible decisions.\",\n                \"Congratulations, you have discovered a new level of nonsense.\",\n                \"Your confidence is impressive considering the evidence.\",\n                \"I would roast you, but your argument already did the job.\",\n                \"Please return to the internet after installing common sense.\",\n                \"That take is so cold it somehow became completely irrelevant.\",\n                \"You brought an entire keyboard to a battle and still lost.\",\n                \"I have questions, but unfortunately none of them can save this argument.\",\n                \"That sentence should probably be reported to the grammar department.\",\n                \"You are typing with the confidence of someone who never checks facts.\",\n                \"The internet has officially seen enough.\",\n                \"That argument has more holes than a cheap umbrella.\",\n                \"Please stop typing before your keyboard files a complaint.\",\n                \"You somehow managed to write an entire paragraph while providing absolutely nothing that supports your argument.\",\n                \"I would carefully explain why your argument makes no sense, but apparently the evidence has already left the building.\",\n                \"You have written so many words that I almost forgot the original point, which unfortunately was not very convincing either.\",\n                \"That argument is impressive in the same way a shopping cart with one broken wheel is impressive because somehow it still moves forward.\",\n                \"You entered this discussion with maximum confidence and minimum evidence, which is honestly a fascinating combination.\",\n                \"I have read the entire thing twice and somehow your conclusion still has less stability than a chair missing three legs.\",\n                \"You talk shit like a champion and type like you just discovered a keyboard.\",\n                \"That was fucking slow. The timer is more disappointed than I am.\",\n                \"You are not winning this argument with that typing speed, bro.\",\n                \"Stop coping. Your mistakes are right there on the screen.\",\n                \"You got cooked by a sentence and still want to talk trash.\",\n                \"That was a garbage round. Clean it up and run it again.\",\n                \"You cannot call yourself a keyboard warrior while losing to basic words.\",\n                \"Your fingers are throwing harder than your mouth ever could.\",\n                \"Less whining, more typing. The clock is not waiting for you.\",\n                \"You have the confidence of a top fragger and the mechanics of a bot.\",\n                \"You're not even wrong in an interesting way. You're just confidently wrong.\",\n                \"Keep typing. Maybe eventually the argument will accidentally make sense.\",\n                \"That excuse has been used so many times it deserves a retirement.\",\n                \"You have the confidence of someone who never checks the scoreboard.\",\n                \"This isn't ragebait anymore. You're just making yourself mad.\",\n                \"You're talking like a champion and performing like a warm-up bot.\"\n            ]\n\n        },\n\n        filipino: {\n\n            friendly: [\n\n                \"Magalang akong hindi sumasang ayon sa iyong opinyon.\",\n                \"Baka puwede natin itong pag usapan nang maayos at walang personalan.\",\n                \"Magandang araw at sana ay hydrated ka kahit mahaba ang naging diskusyon natin.\",\n                \"Naiintindihan ko kung saan ka nanggagaling at nirerespeto ko ang iyong pananaw.\",\n                \"Magkaiba man tayo ng opinyon, hindi ibig sabihin na kailangan nating mag away.\",\n                \"Subukan nating ayusin ito nang mahinahon at pakinggan muna ang bawat panig.\",\n                \"May punto ka rin naman, pero may ilang bagay na sa tingin ko ay kailangan nating linawin.\",\n                \"Hindi kailangang maging away ang simpleng diskusyon dahil puwede naman tayong mag usap nang maayos.\",\n                \"Lahat tayo ay nagkakamali minsan kaya mas mabuting matuto tayo kaysa magturuan.\",\n                \"Sana maging maganda ang araw mo at sana ay maging maayos din ang susunod nating pag uusap.\",\n                \"Respeto lang tayo sa isa't isa dahil hindi naman kailangang manalo ang isang tao para magkaroon ng magandang usapan.\",\n                \"Puwede tayong hindi magkasundo at manatiling magalang dahil bahagi naman talaga ng buhay ang pagkakaroon ng magkakaibang pananaw.\",\n                \"Hindi ako galit, gusto ko lang ipaliwanag kung bakit iba ang pananaw ko tungkol sa pinag uusapan natin.\",\n                \"Makinig muna tayo sa isa't isa bago mag reply para mas maintindihan natin kung ano talaga ang punto ng bawat isa.\",\n                \"Siguro pareho tayong may konting mali kaya mas mabuting tingnan natin ang facts kaysa magpatuloy sa walang katapusang argumento.\",\n                \"Sa tingin ko mas magiging maayos ang usapan natin kung pareho tayong makikinig at hindi agad magagalit kapag may narinig tayong opinyong hindi natin gusto.\",\n                \"Hindi naman kailangan na pareho tayo ng pananaw para maging maayos ang isang conversation dahil puwede tayong mag disagree nang hindi nagiging personal ang lahat.\",\n                \"Mas gusto kong pag usapan natin ito nang mahinahon dahil baka pareho lang tayong may gustong ipaliwanag at kailangan lang talaga nating makinig sa isa't isa.\",\n                \"Kung may mali sa sinabi ko, sabihin mo lang nang maayos at susubukan kong intindihin ang punto mo bago ako magbigay ng sagot.\",\n                \"Baka mas magandang mag focus tayo sa facts at sa mismong topic kaysa mag aksaya ng oras sa pagsisigawan at pagsasabi ng masasakit na salita.\"\n\n            ],\n\n            almighty: [\n\n                \"Ang argumento mo ay parang sirang payong dahil puro butas at wala namang proteksyon laban sa facts.\",\n                \"May confidence ka pero nasaan ang ebidensya dahil parang nawala ito bago mo pa sinimulan ang argumentong ito.\",\n                \"Nag type ka nang mahaba para wala ring patutunguhan at mukhang pagod lang ang keyboard mo.\",\n                \"Mas maayos pa ang logic ng loading screen kaysa sa paliwanag na ilang minuto mong pinag isipan.\",\n                \"Parang kailangan muna ng keyboard mo ng counseling pagkatapos nitong mabasang argumento.\",\n                \"Bago ka mag send, baka gusto mong mag isip muna nang kaunti para hindi ka na ulit magpaliwanag ng bagay na walang basehan.\",\n                \"Ang tapang ng opinyon mo para sa isang argumentong halos walang ebidensya at puro confidence lamang.\",\n                \"Congratulations dahil naka unlock ka ng bagong level ng kalokohan na hindi ko akalaing posible pang makita sa internet.\",\n                \"May keyboard ka nga pero mukhang naiwan mo naman ang common sense bago ka nagsimulang mag type.\",\n                \"Hindi ko alam kung argument ba ito o random thoughts na biglang pinindot ang send button bago mo nabasa ulit.\",\n                \"Ang haba ng sinabi mo pero pagkatapos kong basahin lahat ay wala pa rin akong makita na malinaw na punto.\",\n                \"Mukhang kailangan mong mag update ng common sense bago ka bumalik dito para ipagtanggol ang napakahina mong argumento.\",\n                \"Ang confidence mo ay kahanga hanga kahit wala itong kasamang sapat na ebidensya para suportahan ang sinasabi mo.\",\n                \"Pwede bang huminga muna bago ka mag type ulit dahil baka pati keyboard mo ay napapagod na sa dami ng walang saysay na salita.\",\n                \"Kung debate ito, mukhang nanalo na ang autocorrect dahil mas malinaw pa ang mga suggestion nito kaysa sa argumento mo.\",\n                \"May tanong ako pero baka hindi kayanin ng argumento mo kaya mas mabuting ayusin mo muna ang logic bago ka magpatuloy.\",\n                \"Ang opinyon mo ay parang expired na resibo dahil mukhang matagal nang walang halaga pero pilit mo pa ring ipinapakita.\",\n                \"Please stop typing bago mag resign ang keyboard mo dahil mukhang ayaw na nitong maging bahagi ng argumentong ito.\",\n                \"Mas maraming butas ang argumento mo kaysa sa lumang medyas at kahit anong paliwanag mo ay hindi nito maaayos ang problema.\",\n                \"Nandito na tayo sa internet nang ilang minuto at hanggang ngayon ay wala pa ring sense ang pinipilit mong ipagtanggol.\",\n                \"Nag effort ka talagang gumawa ng mahabang paliwanag pero sa dulo ay parang wala pa rin itong malinaw na punto na puwedeng suportahan ng kahit anong evidence.\",\n                \"Kung ang goal mo ay manalo sa argumentong ito, baka kailangan mong magsimula sa facts dahil hindi sapat ang confidence para gawing tama ang isang maling statement.\",\n                \"Binasa ko nang dalawang beses ang buong sinabi mo at hanggang ngayon ay hindi ko pa rin makita kung saan nagsisimula ang logic at kung saan nagtatapos ang random thoughts.\",\n                \"Mukhang buong internet ang pinag isipan mo bago ka nag type pero nakalimutan mong isama ang pinakamahalagang bahagi na tinatawag na evidence.\",\n                \"Ang haba ng paragraph mo pero parang mas lalo lamang lumalim ang problema dahil bawat bagong sentence ay nagdadagdag ng panibagong butas sa argumento.\",\n                \"Kung keyboard warrior ang gusto mong maging, kailangan mo munang matutong suportahan ang sinasabi mo dahil hindi kayang ipanalo ng mabilis na typing ang isang argumentong walang basehan.\",\n                \"Ang lakas mong mag shit-talk pero parang first day mo pa lang sa keyboard.\",\n                \"Putangina, sobrang bagal nun. Pati timer napagod kakahintay.\",\n                \"Hindi mo mapapanalo sa trash talk ang round kung ganyan kabagal ang typing mo.\",\n                \"Wag kang mag cope. Nandiyan mismo sa screen ang mga mali mo.\",\n                \"Niluto ka ng isang sentence tapos gusto mo pa ring mag yabang.\",\n                \"Basura yung round na yun. Ayusin mo at ulitin mo.\",\n                \"Hindi ka keyboard warrior kung basic words pa lang talo ka na.\",\n                \"Mas malakas pa mag-throw ang fingers mo kaysa sa trash talk mo.\",\n                \"Less iyak, more typing. Hindi ka hihintayin ng timer.\",\n                \"Ang confidence mo pang top fragger pero ang mechanics mo pang bot.\",\n                \"Hindi ka man lang interestingly wrong. Confidently wrong lang talaga.\",\n                \"Sige, type ka pa. Baka sakaling biglang magkaroon ng sense.\",\n                \"Paulit-ulit na yang excuse mo. Pwede na siyang mag-retire.\",\n                \"Confidence pang champion kahit hindi tinitingnan ang scoreboard.\",\n                \"Hindi na ragebait yan. Ikaw na mismo ang naiirita sa sarili mo.\",\n                \"Champion ang trash talk, warm-up bot ang performance.\"\n            ]\n\n        }\n\n    };\n\n\n    /* =========================================================\n       COMMENTS\n    ========================================================= */\n\n    const comments = {\n\n        friendly: {\n\n            excellent: [\n                \"Excellent work. You were accurate and quick — that was a very clean round.\",\n                \"Great job. You kept the mistakes low and finished in a strong time.\",\n                \"That was smooth. Your accuracy and pace were both impressive.\",\n                \"Very nice typing. You stayed accurate without sacrificing too much speed.\",\n                \"You handled that really well. Good control, good pace, and a clean finish.\",\n                \"That was a strong performance. Your timing shows your typing is getting more confident.\",\n                \"Excellent balance between accuracy and speed. Keep building on that.\",\n                \"Clean round. You were focused, accurate, and reasonably fast.\"\n            ],\n\n            good: [\n                \"Pretty good. Your accuracy was solid, and your time was respectable too.\",\n                \"Nice job. A few mistakes happened, but your pace kept the round moving.\",\n                \"Good round. You were accurate enough and kept a decent rhythm.\",\n                \"You're getting there. Your typing was fairly clean, and your time was not bad.\",\n                \"Solid effort. Keep the accuracy you have now and gradually push your speed.\",\n                \"Nice balance overall. A little more speed would make this even stronger.\",\n                \"You kept things under control. With a bit more practice, that time can come down.\",\n                \"Good work. The mistakes weren't the whole story — your pace was part of the result too.\"\n            ],\n\n            bad: [\n                \"It was a rough round, but finishing is still progress. Work on both accuracy and pace.\",\n                \"A little messy today. Slow down enough to stay accurate, then build your speed back up.\",\n                \"Your accuracy and time both have room to improve, but that's exactly what practice is for.\",\n                \"That round took more time than you'd want. Focus on a steady rhythm instead of rushing.\",\n                \"Some mistakes got in the way, and the pace was also holding you back. Keep practicing.\",\n                \"Don't worry about one rough result. Aim for cleaner words first, then gradually get faster.\",\n                \"Your result shows that both precision and timing need attention. Take it one round at a time.\",\n                \"Not your cleanest round, but you can improve it. Try to keep a consistent pace while watching your accuracy.\"\n            ]\n\n        },\n\n        almighty: {\n\n            excellent: [\n                \"Finally. Accurate, fast, and efficient. That is what competent typing looks like.\",\n                \"Acceptable. You managed both accuracy and time without embarrassing yourself.\",\n                \"Surprisingly strong. Your mistakes were low and your pace was actually respectable.\",\n                \"That was efficient. Keep that accuracy and maintain the speed.\",\n                \"For once, your fingers understood the assignment. Good accuracy, good time.\",\n                \"You actually balanced speed and precision. Don't get comfortable — do it again.\",\n                \"A strong round. The time was respectable and the accuracy was where it needed to be.\",\n                \"Not bad. You were quick enough and accurate enough to earn a rare compliment.\"\n            ],\n\n            good: [\n                \"Acceptable. Your accuracy was decent, but your time still has room for improvement.\",\n                \"You survived, but don't confuse surviving with mastering it. Pick up the pace.\",\n                \"Technically competent. Your mistakes were manageable, but the clock was not impressed.\",\n                \"Not terrible. Your accuracy kept you afloat, but your speed needs work.\",\n                \"Decent result. Now stop admiring the accuracy and start attacking the timer.\",\n                \"You did enough to pass, not enough to brag. Improve the pace while keeping the mistakes down.\",\n                \"The result is acceptable. Your next problem is time — you need to type faster without falling apart.\",\n                \"Fine. But if you want to call yourself a keyboard warrior, that pace needs to improve.\"\n            ],\n\n            bad: [\n                \"That was ugly. You had accuracy problems and the time did you no favors either.\",\n                \"Your keyboard deserves an apology. Too many problems, too much time, and not enough control.\",\n                \"That performance was slow and messy. Fix the accuracy, then learn to move faster.\",\n                \"You spent far too long producing that result. Accuracy and speed both need serious work.\",\n                \"The mistakes were bad, but the clock was just as unforgiving. You need both precision and pace.\",\n                \"That was not a typing test. That was a prolonged struggle with a keyboard.\",\n                \"Your result is proof that slowing down does not automatically make you accurate. You need control and speed.\",\n                \"You finished. Congratulations. Unfortunately, the time and accuracy both exposed the problem.\",\n                \"That pace was painful to watch, and the mistakes made it worse. Practice until both improve.\",\n                \"If this was supposed to be efficient, it failed. Cut the mistakes and stop wasting the clock.\"\n            ]\n\n        }\n\n    };\n\n\n    /* =========================================================\n       NAVIGATION\n    ========================================================= */\n\n    function hideAllScreens() {\n\n        document\n            .querySelectorAll(\".screen,.home\")\n            .forEach(function(screen) {\n                screen.classList.remove(\"active\");\n            });\n\n    }\n\n    function showScreen(id) {\n\n        hideAllScreens();\n\n        const screen =\n            document.getElementById(id);\n\n        if (screen) {\n            screen.classList.add(\"active\");\n        }\n\n    }\n\n    function navigate(page) {\n\n        stopTimer();\n\n        document.body.className = \"\";\n\n        if (page === \"home\") {\n            showScreen(\"homeScreen\");\n            updateNavigation(\"home\");\n        }\n\n        if (page === \"mode\") {\n            showScreen(\"modeScreen\");\n            return;\n        }\n\n        if (page === \"stats\") {\n            showScreen(\"statsScreen\");\n            updateStatsDisplay();\n            updateNavigation(\"stats\");\n        }\n\n        if (page === \"settings\") {\n            showScreen(\"settingsScreen\");\n            updateSettingsDisplay();\n            updateNavigation(\"settings\");\n        }\n\n    }\n\n    function updateNavigation(page) {\n\n        document\n            .querySelectorAll(\".nav-btn\")\n            .forEach(function(btn) {\n                btn.classList.remove(\"active\");\n            });\n\n        if (page === \"home\") {\n            document.getElementById(\"navHome\")\n                .classList.add(\"active\");\n        }\n\n        if (page === \"stats\") {\n            document.getElementById(\"navStats\")\n                .classList.add(\"active\");\n        }\n\n        if (page === \"settings\") {\n            document.getElementById(\"navSettings\")\n                .classList.add(\"active\");\n        }\n\n    }\n\n\n    /* =========================================================\n       MODE SELECTION\n    ========================================================= */\n\n    function selectFreestyle() {\n        // Freestyle is a difficulty option under the selected attitude.\n        selectDifficulty(\"freestyle\");\n    }\n\n    const specialModeOrder = [\n        { value: \"freestyle\", id: \"freestyleOption\", name: \"Freestyle\" },\n        { value: \"suddendeath\", id: \"suddenDeathOption\", name: \"Sudden Death\" },\n        { value: \"combo\", id: \"comboOption\", name: \"Combo\" },\n        { value: \"madlibs\", id: \"madlibsOption\", name: \"Mad Libs\" },\n        { value: \"reverse\", id: \"reverseOption\", name: \"Reverse Typer\" }\n    ];\n    let specialModeIndex = 0;\n\n    function showSpecialMode(index, selectShownMode) {\n        specialModeIndex = (index + specialModeOrder.length) % specialModeOrder.length;\n        specialModeOrder.forEach(function(item, itemIndex) {\n            const slide = document.getElementById(item.id);\n            if (slide) slide.classList.toggle(\"special-mode-hidden\", itemIndex !== specialModeIndex);\n        });\n        const position = document.getElementById(\"specialModePosition\");\n        if (position) {\n            position.textContent = (specialModeIndex + 1) + \" / \" + specialModeOrder.length + \" · \" + specialModeOrder[specialModeIndex].name;\n        }\n        if (selectShownMode) selectDifficulty(specialModeOrder[specialModeIndex].value);\n    }\n\n    function moveSpecialMode(direction) {\n        showSpecialMode(specialModeIndex + direction, true);\n    }\n\n    function selectDifficulty(value) {\n\n        selectedMode = value === \"freestyle\" ? \"freestyle\" : \"battle\";\n        difficulty = value;\n\n        if (value === \"combo\") {\n            // Entering Combo mode fresh from the menu resets the streak.\n            comboStreak = 0;\n            maxComboThisSession = 0;\n            comboWordsCompleted = 0;\n        }\n\n        [\n            \"easyOption\",\"mediumOption\",\"noMercyOption\",\"freestyleOption\",\n            \"suddenDeathOption\",\"comboOption\",\"madlibsOption\",\"reverseOption\"\n        ].forEach(function(id) {\n            const el = document.getElementById(id);\n            if (el) {\n                el.classList.remove(\"selected\");\n                el.setAttribute(\"aria-pressed\", \"false\");\n            }\n        });\n\n        const idsByValue = {\n            freestyle: \"freestyleOption\",\n            easy: \"easyOption\",\n            medium: \"mediumOption\",\n            nomercy: \"noMercyOption\",\n            suddendeath: \"suddenDeathOption\",\n            combo: \"comboOption\",\n            madlibs: \"madlibsOption\",\n            reverse: \"reverseOption\"\n        };\n        const selected = document.getElementById(idsByValue[value]);\n        if (selected) {\n            selected.classList.add(\"selected\");\n            selected.setAttribute(\"aria-pressed\", \"true\");\n        }\n\n        const specialIndex = specialModeOrder.findIndex(function(item) { return item.value === value; });\n        if (specialIndex !== -1 && specialIndex !== specialModeIndex) showSpecialMode(specialIndex, false);\n\n        updateSettingsDisplay();\n    }\n\n    function openChaosScreen() {\n        stopTimer();\n        stopFreestyleTimer();\n        document.body.className = \"\";\n        hideAllScreens();\n        const screen = document.getElementById(\"chaosScreen\");\n        if (screen) screen.classList.add(\"active\");\n    }\n\n    function openModeScreen() {\n        // HOME -> MODE SELECTION\n        // Do not route through navigate(\"mode\") because the original\n        // navigate() function only handles home/stats/settings.\n        stopTimer();\n        stopFreestyleTimer();\n\n        document.body.className = \"\";\n\n        hideAllScreens();\n\n        const mode = document.getElementById(\"modeScreen\");\n        if (mode) {\n            mode.classList.add(\"active\");\n        }\n\n        // Reset the battle setup without starting the game.\n        started = false;\n        finished = false;\n\n        const typingInput = document.getElementById(\"typingInput\");\n        if (typingInput) {\n            typingInput.value = \"\";\n            typingInput.disabled = false;\n        }\n\n        const freestyleInput = document.getElementById(\"freestyleInput\");\n        if (freestyleInput) {\n            freestyleInput.value = \"\";\n            freestyleInput.disabled = false;\n        }\n\n        const freestyleEndBtn = document.getElementById(\"freestyleEndBtn\");\n        if (freestyleEndBtn) freestyleEndBtn.style.display = \"none\";\n\n        updateSettingsDisplay();\n    }\n\n    function selectAttitude(value) {\n\n        selectedMode = \"battle\";\n        attitude = value;\n\n        document\n            .getElementById(\"friendlyOption\")\n            .classList.toggle(\n                \"selected\",\n                value === \"friendly\"\n            );\n        document.getElementById(\"friendlyOption\")\n            .setAttribute(\"aria-pressed\", String(value === \"friendly\"));\n\n        document\n            .getElementById(\"almightyOption\")\n            .classList.toggle(\n                \"selected\",\n                value === \"almighty\"\n            );\n        document.getElementById(\"almightyOption\")\n            .setAttribute(\"aria-pressed\", String(value === \"almighty\"));\n\n        document.getElementById(\"freestyleOption\").classList.remove(\"selected\");\n        document.getElementById(\"freestyleOption\").setAttribute(\"aria-pressed\", \"false\");\n        updateSettingsDisplay();\n\n    }\n\n    /* =========================================================\n       FREESTYLE MODE — LIMITLESS\n    ========================================================= */\n\n    let freestyleTargetWords = [];\n    let freestyleCursor = -1;\n\n    function buildFreestylePhrasePool() {\n        return (freestylePhrases[language] || []).slice();\n    }\n\n    function appendFreestylePhrase() {\n        const pool = buildFreestylePhrasePool();\n        if (!pool.length) return;\n        let index = Math.floor(Math.random() * pool.length);\n        if (pool.length > 1 && index === freestyleCursor) index = (index + 1) % pool.length;\n        freestyleCursor = index;\n        freestyleTargetWords.push(...pool[index].trim().split(/\\s+/).filter(Boolean));\n    }\n\n    function startFreestyle() {\n        stopTimer();\n        freestyleTargetWords = [];\n        freestyleCursor = -1;\n        for (let i = 0; i < 4; i++) appendFreestylePhrase();\n\n        started = false;\n        finished = false;\n        document.body.className = \"game-active\";\n        showScreen(\"gameScreen\");\n\n        const input = document.getElementById(\"typingInput\");\n        input.value = \"\";\n        input.disabled = false;\n        document.getElementById(\"gameAttitude\").textContent =\n            (attitude === \"friendly\" ? \"FRIENDLY\" : \"ALMIGHTY\") + \" • FREESTYLE\";\n        const label = document.querySelector(\"#gameScreen .phrase-label\");\n        if (label) label.textContent = \"Keep typing — endless mode\";\n        /* Render the first freestyle phrase immediately.\n           Do not wait for the first keystroke. */\n        currentPhraseWords = freestyleTargetWords.slice();\n        renderPhrase();\n\n        document.getElementById(\"liveTime\").textContent = \"0.0\";\n        document.getElementById(\"liveCorrect\").textContent = \"0\";\n        document.getElementById(\"liveMistakes\").textContent = \"0\";\n        document.getElementById(\"progressBar\").style.width = \"100%\";\n        const freestyleEndBtn = document.getElementById(\"freestyleEndBtn\");\n        if (freestyleEndBtn) freestyleEndBtn.style.display = \"block\";\n        setTimeout(() => {\n            currentPhraseWords = freestyleTargetWords.slice();\n            renderPhrase();\n            input.focus();\n        }, 120);\n    }\n\n    function renderLimitlessPhrase() {\n        currentPhraseWords = freestyleTargetWords.slice();\n        renderPhrase();\n    }\n\n    function updateFreestyleTimer() {\n        if (!started || finished) return;\n        document.getElementById(\"liveTime\").textContent =\n            ((Date.now() - startTime) / 1000).toFixed(1);\n    }\n\n    function stopFreestyleTimer() {\n        if (timerInterval !== null) {\n            clearInterval(timerInterval);\n            timerInterval = null;\n        }\n    }\n\n    const commentShuffleBags = {};\n    const lastCommentByGroup = {};\n\n    function chooseVariedComment(group, options) {\n        if (!options || !options.length) return \"\";\n\n        if (!commentShuffleBags[group] || !commentShuffleBags[group].length) {\n            const bag = options.slice();\n            for (let i = bag.length - 1; i > 0; i--) {\n                const j = Math.floor(Math.random() * (i + 1));\n                const temp = bag[i];\n                bag[i] = bag[j];\n                bag[j] = temp;\n            }\n\n            if (\n                bag.length > 1 &&\n                bag[bag.length - 1] === lastCommentByGroup[group]\n            ) {\n                const temp = bag[bag.length - 1];\n                bag[bag.length - 1] = bag[0];\n                bag[0] = temp;\n            }\n            commentShuffleBags[group] = bag;\n        }\n\n        const chosen = commentShuffleBags[group].pop();\n        lastCommentByGroup[group] = chosen;\n        return chosen;\n    }\n\n\n    function getFreestyleComment(accuracy, mistakes, elapsed, wpm) {\n        const friendly = [\n            \"Keep practicing — you are doing great. Every session is making you better.\",\n            \"Nice work. Keep typing, keep practicing, and you will get even faster.\",\n            \"You're improving one session at a time. Keep going — you've got this.\",\n            \"Good effort! Don't worry about a few mistakes. Keep practicing and stay consistent.\",\n            \"You're getting there. Keep your fingers moving and your confidence up.\",\n            \"Another session completed! Keep practicing and you'll be surprised how much you improve.\",\n            \"Keep going! Your speed and accuracy will come with more practice.\",\n            \"That was a solid effort. Take what you learned and come back even stronger.\",\n            \"Practice makes progress. Keep typing and keep believing in yourself.\",\n            \"You're doing better than you think. One more session, one more improvement.\"\n        ];\n\n        const almighty = [\n            \"Yeah, keep practicing, because you are so bad at it. Maybe eventually your fingers will cooperate.\",\n            \"Keep practicing. Your keyboard has suffered enough, but apparently you haven't learned yet.\",\n            \"Another session survived. Now practice until that embarrassing performance becomes acceptable.\",\n            \"Keep going. At this rate, your keyboard is going to start typing for you out of pity.\",\n            \"You clearly need more practice. Good thing the session ended before things got even worse.\",\n            \"That was rough. Keep practicing — competence is apparently going to take a while.\",\n            \"Congratulations, you finished. Now do it again until your typing stops looking like a struggle.\",\n            \"Keep practicing. Speed, accuracy, and basic keyboard dignity are still waiting for you.\",\n            \"Well, at least you tried. Now practice until 'trying' turns into actually being good.\",\n            \"Don't celebrate yet. You still have plenty of room to improve, so get back to practicing.\"\n        ];\n\n        const pool = attitude === \"almighty\" ? almighty : friendly;\n        return chooseVariedComment(\"freestyle-\" + attitude, pool);\n    }\n\n    function finishFreestyle() {\n        // Freestyle sessions have their own result screen and their own\n        // Friendly/Almighty comment. They must not use the regular battle result.\n        finished = true;\n        stopTimer();\n        stopFreestyleTimer();\n\n        const input = document.getElementById(\"typingInput\");\n        const value = input ? input.value : \"\";\n        const tokens = value.trim() ? value.trim().split(/\\s+/) : [];\n\n        let correctWords = 0;\n        tokens.forEach(function(word, i) {\n            if (word === freestyleTargetWords[i]) correctWords++;\n        });\n\n        const mistakes = Math.max(0, tokens.length - correctWords);\n        const elapsed = startTime > 0\n            ? (Date.now() - startTime) / 1000\n            : 0;\n\n        const minutes = elapsed > 0 ? elapsed / 60 : 0;\n        const wpm = minutes > 0\n            ? Math.round(correctWords / minutes)\n            : 0;\n\n        const accuracy = tokens.length\n            ? Math.round(correctWords / tokens.length * 100)\n            : 0;\n\n        // Populate the dedicated Freestyle result screen.\n        const timeEl = document.getElementById(\"freestyleResultTime\");\n        const wordsEl = document.getElementById(\"freestyleResultWords\");\n        const mistakesEl = document.getElementById(\"freestyleResultMisspellings\");\n        const commentEl = document.getElementById(\"freestyleComment\");\n\n        if (timeEl) timeEl.textContent = elapsed.toFixed(1) + \"s\";\n        if (wordsEl) wordsEl.textContent = correctWords;\n        if (mistakesEl) mistakesEl.textContent = mistakes;\n\n        if (commentEl) {\n            commentEl.textContent =\n                getFreestyleComment(accuracy, mistakes, elapsed, wpm);\n        }\n\n        if (input) input.disabled = true;\n\n        const freestyleEndBtn =\n            document.getElementById(\"freestyleEndBtn\");\n        if (freestyleEndBtn) {\n            freestyleEndBtn.style.display = \"none\";\n        }\n\n        document.body.className = \"result-active\";\n\n        // IMPORTANT: show Freestyle results, not the regular battle results.\n        showScreen(\"freestyleResultScreen\");\n    }\n\n    function restartFreestyle() { startFreestyle(); }\n\n    /* =========================================================\n       GAME\n    ========================================================= */\n\n    function getNoMercyTimeLimit(text) {\n        // Tighter No Mercy timing:\n        // roughly 1 second per 3 characters, with a small minimum\n        // and a hard maximum for very long phrases.\n        const length = (text || \"\").trim().length;\n\n        if (length <= 0) return 8;\n\n        return Math.max(\n            8,\n            Math.min(40, Math.ceil(length / 5))\n        );\n    }\n\n    function formatCountdown(seconds) {\n        const total = Math.max(0, Math.ceil(seconds));\n        const minutes = Math.floor(total / 60);\n        const secs = total % 60;\n        return String(minutes).padStart(2, \"0\") + \":\" + String(secs).padStart(2, \"0\");\n    }\n\n    function startGame() {\n\n        if (difficulty === \"freestyle\") { startFreestyle(); return; }\n\n        const regularActions = document.querySelector(\"#gameScreen .game-actions\");\n        if (regularActions) regularActions.style.display = \"flex\";\n        const freestyleEndBtn = document.getElementById(\"freestyleEndBtn\");\n        if (freestyleEndBtn) freestyleEndBtn.style.display = \"none\";\n\n        const available =\n            phrases[language][attitude];\n\n        phraseIndex = getNextPhraseIndex(language, attitude);\n\n        preparePhrase();\n\n        document.body.className =\n            \"game-active\";\n\n        showScreen(\"gameScreen\");\n\n        setTimeout(function() {\n            document\n                .getElementById(\"typingInput\")\n                .focus();\n        },100);\n\n    }\n\n    function preparePhrase() {\n\n        stopTimer();\n\n        started = false;\n        finished = false;\n\n        mistakeCount = 0;\n        correctCount = 0;\n        currentErrorCount = 0;\n        typedKeystrokes = 0;\n        incorrectKeystrokes = 0;\n        previousInputValue = \"\";\n        comboWordsCompleted = 0;\n\n        if (difficulty === \"madlibs\") {\n            const templates = madLibTemplates[language] || madLibTemplates.english;\n            currentMadLibTemplate = templates[Math.floor(Math.random() * templates.length)];\n            currentPhrase = currentMadLibTemplate;\n        } else {\n            currentPhrase = phrases[language][attitude][phraseIndex];\n        }\n\n        currentPhraseWords =\n            currentPhrase.split(\" \");\n\n        if (difficulty === \"curse\") {\n            cursePhraseCount++;\n            bossCurseActive = cursePhraseCount % 5 === 0;\n        } else {\n            bossCurseActive = false;\n        }\n\n        noMercyTimeLimit = difficulty === \"nomercy\"\n            ? getNoMercyTimeLimit(currentPhrase)\n            : 0;\n        noMercyOvertime = false;\n\n        renderPhrase();\n\n        const input =\n            document.getElementById(\"typingInput\");\n\n        input.value = \"\";\n        input.disabled = false;\n\n        document.getElementById(\"liveTime\")\n            .textContent = difficulty === \"nomercy\"\n                ? formatCountdown(noMercyTimeLimit)\n                : \"0.0\";\n\n        const liveTimeLabel = document.querySelector(\"#gameScreen .stats-row .stat:first-child .stat-label\");\n        if (liveTimeLabel) {\n            liveTimeLabel.innerHTML = difficulty === \"nomercy\"\n                ? 'TIME LEFT <span class=\"no-mercy-limit\">' + noMercyTimeLimit + 's</span>'\n                : \"SECONDS\";\n        }\n\n        document.getElementById(\"liveCorrect\")\n            .textContent = \"0\";\n\n        document.getElementById(\"liveMistakes\")\n            .textContent = \"0\";\n\n        document.getElementById(\"progressBar\")\n            .style.width = \"0%\";\n\n        document.getElementById(\"gameAttitude\")\n            .textContent =\n                attitude === \"friendly\"\n                    ? \"FRIENDLY\"\n                    : \"ALMIGHTY\";\n\n        const phraseLabel = document.querySelector(\"#gameScreen .phrase-label\");\n        if (phraseLabel) phraseLabel.textContent = difficulty === \"madlibs\"\n            ? \"Replace every blank\"\n            : difficulty === \"reverse\" ? \"Decode this — type it forwards\" : \"Type this\";\n\n        const noMercyHint = document.getElementById(\"noMercyRuleHint\");\n        if (noMercyHint) {\n            noMercyHint.style.display = difficulty === \"nomercy\" ? \"block\" : \"none\";\n        }\n\n        const curseHint = document.getElementById(\"curseRuleHint\");\n        if (curseHint) {\n            curseHint.style.display = difficulty === \"curse\" ? \"block\" : \"none\";\n            curseHint.textContent = bossCurseActive\n                ? \"☠ BOSS CURSE: shake, scramble and jolt will chain rapid-fire. No Backspace.\"\n                : \"⚡ CURSE MODE: rapid curses can stack. Boss round in \" + (5 - (cursePhraseCount % 5)) + \" phrase\" + ((5 - (cursePhraseCount % 5)) === 1 ? \"\" : \"s\") + \".\";\n        }\n\n        const phraseCard = document.querySelector(\"#gameScreen .phrase-card\");\n        if (phraseCard) phraseCard.classList.toggle(\"boss-curse-card\", bossCurseActive);\n        if (bossCurseActive) {\n            const attitudeBadge = document.getElementById(\"gameAttitude\");\n            if (attitudeBadge) attitudeBadge.textContent = \"☠ BOSS CURSE · ROUND \" + cursePhraseCount;\n            if (phraseLabel) phraseLabel.textContent = \"Boss phrase\";\n        }\n\n        const suddenDeathHint = document.getElementById(\"suddenDeathRuleHint\");\n        if (suddenDeathHint) suddenDeathHint.style.display = difficulty === \"suddendeath\" ? \"block\" : \"none\";\n\n        const comboHint = document.getElementById(\"comboRuleHint\");\n        if (comboHint) comboHint.style.display = difficulty === \"combo\" ? \"block\" : \"none\";\n\n        const madlibsHint = document.getElementById(\"madlibsRuleHint\");\n        if (madlibsHint) madlibsHint.style.display = difficulty === \"madlibs\" ? \"block\" : \"none\";\n        const reverseHint = document.getElementById(\"reverseRuleHint\");\n        if (reverseHint) reverseHint.style.display = difficulty === \"reverse\" ? \"block\" : \"none\";\n        const madlibsFinish = document.getElementById(\"madlibsFinishBtn\");\n        if (madlibsFinish) madlibsFinish.style.display = difficulty === \"madlibs\" ? \"block\" : \"none\";\n        const brainShare = document.getElementById(\"brainBrokeShareBtn\");\n        if (brainShare) brainShare.style.display = \"none\";\n        input.placeholder = difficulty === \"madlibs\"\n            ? \"Retype the sentence with your own words in the blanks...\"\n            : difficulty === \"reverse\" ? \"Type the decoded phrase forwards...\" : \"Start typing here...\";\n\n        const comboStat = document.getElementById(\"liveComboStat\");\n        if (comboStat) comboStat.style.display = difficulty === \"combo\" ? \"flex\" : \"none\";\n        const comboValue = document.getElementById(\"liveCombo\");\n        if (comboValue) comboValue.textContent = comboStreak + \"x\";\n\n        const freestyleEndBtn = document.getElementById(\"freestyleEndBtn\");\n        if (freestyleEndBtn) freestyleEndBtn.style.display = \"none\";\n\n    }\n\n    function renderPhrase() {\n\n        const container =\n            document.getElementById(\n                \"phraseDisplay\"\n            );\n\n        container.innerHTML = \"\";\n\n        if (difficulty === \"reverse\") {\n            const span = document.createElement(\"span\");\n            span.className = \"word reverse-phrase\";\n            span.textContent = Array.from(currentPhrase).reverse().join(\"\");\n            container.appendChild(span);\n            return;\n        }\n\n        if (difficulty === \"madlibs\") {\n            currentMadLibTemplate.split(/(\\[[^\\]]+\\])/g).forEach(function(part) {\n                const span = document.createElement(\"span\");\n                span.textContent = part;\n                if (/^\\[.*\\]$/.test(part)) {\n                    span.style.color = \"var(--yellow)\";\n                    span.style.textDecoration = \"underline\";\n                }\n                container.appendChild(span);\n            });\n            return;\n        }\n\n        currentPhraseWords.forEach(\n            function(word,index) {\n\n                const span =\n                    document.createElement(\"span\");\n\n                span.className = \"word\";\n                span.id = \"word-\" + index;\n                span.textContent = word;\n\n                container.appendChild(span);\n\n            }\n        );\n\n    }\n\n\n    /* =========================================================\n       TYPING\n    ========================================================= */\n\n    const typingInput =\n        document.getElementById(\"typingInput\");\n\n    function isForwardOnlyMode() {\n        return [\"medium\", \"nomercy\", \"suddendeath\", \"curse\", \"combo\"].indexOf(difficulty) !== -1;\n    }\n\n    function keepNoMercyCaretAtEnd() {\n        if (!isForwardOnlyMode()) return;\n\n        const end = typingInput.value.length;\n        if (\n            typingInput.selectionStart === end &&\n            typingInput.selectionEnd === end\n        ) return;\n\n        try {\n            typingInput.setSelectionRange(end, end);\n        } catch(error) {}\n    }\n\n    // Every no-backspace mode is genuinely forward-only: mouse/touch cursor\n    // placement, selections, Delete, cut, undo, and keyboard navigation\n    // cannot be used as alternate ways to revise earlier text.\n    typingInput.addEventListener(\"pointerdown\", function(event) {\n        if (!isForwardOnlyMode()) return;\n        event.preventDefault();\n        typingInput.focus();\n        keepNoMercyCaretAtEnd();\n    });\n\n    typingInput.addEventListener(\"click\", keepNoMercyCaretAtEnd);\n    typingInput.addEventListener(\"select\", keepNoMercyCaretAtEnd);\n    typingInput.addEventListener(\"focus\", keepNoMercyCaretAtEnd);\n\n    typingInput.addEventListener(\"beforeinput\", function(event) {\n        if (!isForwardOnlyMode()) return;\n\n        const inputType = event.inputType || \"\";\n        const end = typingInput.value.length;\n        const revisesHistory = inputType === \"historyUndo\" || inputType === \"historyRedo\";\n        const replacesSelection = typingInput.selectionStart !== end || typingInput.selectionEnd !== end;\n        if (inputType.indexOf(\"delete\") === 0 || revisesHistory || replacesSelection) {\n            event.preventDefault();\n            keepNoMercyCaretAtEnd();\n            return;\n        }\n\n        keepNoMercyCaretAtEnd();\n    });\n\n    typingInput.addEventListener(\n        \"keydown\",\n        function(event) {\n\n            if (isForwardOnlyMode()) {\n                const navigationKeys = [\n                    \"ArrowLeft\", \"ArrowRight\", \"ArrowUp\", \"ArrowDown\",\n                    \"Home\", \"End\", \"PageUp\", \"PageDown\"\n                ];\n                const selectsAll = (event.ctrlKey || event.metaKey) &&\n                    event.key.toLowerCase() === \"a\";\n                const editsHistory = (event.ctrlKey || event.metaKey) &&\n                    [\"x\", \"z\", \"y\"].indexOf(event.key.toLowerCase()) !== -1;\n\n                if (\n                    event.key === \"Backspace\" ||\n                    event.key === \"Delete\" ||\n                    navigationKeys.indexOf(event.key) !== -1 ||\n                    selectsAll || editsHistory\n                ) {\n                    event.preventDefault();\n                    keepNoMercyCaretAtEnd();\n                    return;\n                }\n\n                keepNoMercyCaretAtEnd();\n            }\n\n        }\n    );\n\n    typingInput.addEventListener(\"cut\", function(event) {\n        if (!isForwardOnlyMode()) return;\n        event.preventDefault();\n        keepNoMercyCaretAtEnd();\n    });\n\n    typingInput.addEventListener(\n        \"input\",\n        function() {\n            if (finished) return;\n            const value = typingInput.value;\n\n            if (difficulty === \"freestyle\") {\n                if (value.length > 0 && !started) {\n                    started = true;\n                    startTime = Date.now();\n                    timerInterval = setInterval(updateFreestyleTimer, 50);\n                }\n                updateLimitlessTyping(value);\n                return;\n            }\n\n            if (difficulty === \"madlibs\") {\n                if (value.length > 0 && !started) {\n                    started = true;\n                    startTime = Date.now();\n                    timerInterval = setInterval(updateTimer, 50);\n                }\n                document.getElementById(\"progressBar\").style.width = Math.min(100, value.length / Math.max(1, currentMadLibTemplate.length) * 100) + \"%\";\n                document.getElementById(\"liveCorrect\").textContent = (value.trim().match(/\\S+/g) || []).length;\n                document.getElementById(\"liveMistakes\").textContent = \"—\";\n                return;\n            }\n\n            if (value.length > 0 && !started) {\n                started = true;\n                startTime = Date.now();\n                timerInterval = setInterval(updateTimer, 50);\n                if (difficulty === \"curse\") scheduleCurse();\n            }\n\n            // Sudden Death: the instant a typed character diverges from the\n            // phrase, the round is over. Checked before anything else so a\n            // mistake can never sneak through to the normal flow.\n            if (difficulty === \"suddendeath\") {\n                const expectedPrefix = currentPhrase.slice(0, value.length);\n                if (value !== expectedPrefix) {\n                    handleSuddenDeathMistake(value);\n                    return;\n                }\n            }\n\n            recordTypedKeystrokes(previousInputValue, value);\n            updateTyping(value);\n            previousInputValue = value;\n\n            // Finish when the user reaches the final word. Mistakes should not\n            // prevent the round from ending. Whitespace is only a separator.\n            const typedWords = value.trim() ? value.trim().split(/\\s+/) : [];\n            const expectedCount = currentPhraseWords.length;\n            const lastExpected = currentPhraseWords[expectedCount - 1] || \"\";\n            const lastTyped = typedWords[expectedCount - 1] || \"\";\n\n            if (\n                typedWords.length === expectedCount &&\n                lastTyped.length >= lastExpected.length\n            ) {\n                if (roastBattleActive) {\n                    finishRoastBattleTurn();\n                } else {\n                    finishRound();\n                }\n            }\n        }\n    );\n\n    function recordTypedKeystrokes(previousValue, value) {\n        if (value.length <= previousValue.length) return;\n\n        let prefixLength = 0;\n        while (\n            prefixLength < previousValue.length &&\n            previousValue[prefixLength] === value[prefixLength]\n        ) {\n            prefixLength++;\n        }\n\n        const insertedCount = value.length - previousValue.length;\n        const inserted = value.slice(prefixLength, prefixLength + insertedCount);\n        for (let i = 0; i < inserted.length; i++) {\n            typedKeystrokes++;\n        }\n    }\n\n    function editDistance(source, target) {\n        const sourceLength = source.length;\n        const targetLength = target.length;\n        let previousRow = Array.from({ length: targetLength + 1 }, function(_, index) {\n            return index;\n        });\n\n        for (let i = 1; i <= sourceLength; i++) {\n            const currentRow = [i];\n            for (let j = 1; j <= targetLength; j++) {\n                const substitutionCost = source[i - 1] === target[j - 1] ? 0 : 1;\n                currentRow[j] = Math.min(\n                    currentRow[j - 1] + 1,\n                    previousRow[j] + 1,\n                    previousRow[j - 1] + substitutionCost\n                );\n            }\n            previousRow = currentRow;\n        }\n\n        return previousRow[targetLength];\n    }\n\n    function updateTyping(value) {\n        const expected = currentPhraseWords;\n        const tokens = value.trim() ? value.trim().split(/\\s+/) : [];\n        let correctChars = 0;\n        let mistakes = 0;\n\n        expected.forEach(function(word, index) {\n            const typed = tokens[index];\n            const element = document.getElementById(\"word-\" + index);\n            if (element) element.classList.remove(\"correct\", \"wrong\", \"current\");\n            if (typed === undefined) return;\n\n            if (typed === word) {\n                correctChars += word.length;\n                if (element) element.classList.add(\"correct\");\n            } else {\n                mistakes++;\n                if (element) element.classList.add(\"wrong\");\n            }\n        });\n\n        // Whitespace is a separator, not part of the word comparison.\n        const activeIndex = Math.max(0, tokens.length - 1);\n        if (tokens.length && !/\\s$/.test(value)) {\n            const el = document.getElementById(\"word-\" + activeIndex);\n            const expectedWord = expected[activeIndex] || \"\";\n            const typedWord = tokens[activeIndex] || \"\";\n            if (el && expectedWord.startsWith(typedWord) && typedWord !== expectedWord) {\n                el.classList.remove(\"wrong\");\n                el.classList.add(\"current\");\n                mistakes = Math.max(0, mistakes - 1);\n            }\n        }\n\n        const expectedPrefix = currentPhrase.slice(0, value.length);\n        const liveCharacterErrors = editDistance(value, expectedPrefix);\n\n        correctCount = Math.max(0, value.length - liveCharacterErrors);\n        currentErrorCount = liveCharacterErrors;\n        wrongWordCount = mistakes;\n        mistakeCount = liveCharacterErrors;\n        document.getElementById(\"liveCorrect\").textContent = correctChars;\n        document.getElementById(\"liveMistakes\").textContent = currentErrorCount;\n        document.getElementById(\"progressBar\").style.width =\n            Math.min(tokens.length / expected.length * 100, 100) + \"%\";\n\n        if (difficulty === \"combo\") {\n            updateComboStreak(tokens, expected, value);\n        }\n    }\n\n    /* =========================================================\n       COMBO MODE\n    ========================================================= */\n\n    function updateComboStreak(tokens, expected, value) {\n        // A word only \"counts\" once it's finalized — either the user has\n        // moved past it (typed a space) or it's the very last word and the\n        // round is finishing. Trailing partial words are not judged yet.\n        const hasTrailingSpace = /\\s$/.test(value);\n        const finalizedCount = hasTrailingSpace ? tokens.length : tokens.length - 1;\n\n        for (let i = comboWordsCompleted; i < finalizedCount && i < expected.length; i++) {\n            if (tokens[i] === expected[i]) {\n                comboStreak++;\n                if (comboStreak > maxComboThisSession) maxComboThisSession = comboStreak;\n                if (comboStreak > bestComboEver) bestComboEver = comboStreak;\n            } else {\n                comboStreak = 0;\n            }\n        }\n\n        comboWordsCompleted = Math.max(comboWordsCompleted, Math.max(0, finalizedCount));\n\n        // Combo Mode is unforgiving: a mistake anywhere in the word you're\n        // currently typing breaks the streak instantly — you don't get to\n        // finish the word first. There's no fixing it either, since\n        // Backspace is disabled in Combo Mode.\n        if (!hasTrailingSpace && tokens.length > 0) {\n            const activeIndex = tokens.length - 1;\n            const typedSoFar = tokens[activeIndex] || \"\";\n            const expectedWord = expected[activeIndex] || \"\";\n            if (typedSoFar.length > 0 && !expectedWord.startsWith(typedSoFar)) {\n                comboStreak = 0;\n            }\n        }\n\n        const comboEl = document.getElementById(\"liveCombo\");\n        if (comboEl) {\n            comboEl.textContent = comboStreak + \"x\";\n            comboEl.classList.toggle(\"combo-hot\", comboStreak >= 5);\n        }\n    }\n\n    // Judges the final word of a phrase against the combo streak. Called\n    // once from finishRound() since updateTyping() only judges finalized\n    // (space-separated) words, and the last word never gets a trailing space.\n    function finalizeComboForRound() {\n        if (difficulty !== \"combo\") return;\n        const typedWords = typingInput.value.trim() ? typingInput.value.trim().split(/\\s+/) : [];\n        const lastIndex = currentPhraseWords.length - 1;\n        if (comboWordsCompleted <= lastIndex) {\n            if (typedWords[lastIndex] === currentPhraseWords[lastIndex]) {\n                comboStreak++;\n                if (comboStreak > maxComboThisSession) maxComboThisSession = comboStreak;\n                if (comboStreak > bestComboEver) bestComboEver = comboStreak;\n            } else {\n                comboStreak = 0;\n            }\n            comboWordsCompleted = currentPhraseWords.length;\n        }\n    }\n\n    function updateLimitlessTyping(value) {\n        const tokens = value.trim() ? value.trim().split(/\\s+/) : [];\n        while (freestyleTargetWords.length - tokens.length < 12) appendFreestylePhrase();\n        renderLimitlessPhrase();\n        updateTyping(value);\n    }\n\n    function updateLiveStats(value) {\n\n        document.getElementById(\"liveCorrect\")\n            .textContent = correctCount;\n\n        document.getElementById(\"liveMistakes\")\n            .textContent = mistakeCount;\n\n        const progress =\n            Math.min(\n                (\n                    value.length /\n                    currentPhrase.length\n                ) * 100,\n                100\n            );\n\n        document.getElementById(\"progressBar\")\n            .style.width =\n                progress + \"%\";\n\n    }\n\n\n    /* =========================================================\n       CURSE MODE (CHAOS)\n    ========================================================= */\n\n    function startCurseMode() {\n        cursePhraseCount = 0;\n        bossCurseActive = false;\n        difficulty = \"curse\";\n        selectedMode = \"battle\";\n        startGame();\n    }\n\n    function scheduleCurse() {\n        if (curseTimeout !== null) {\n            clearTimeout(curseTimeout);\n            curseTimeout = null;\n        }\n        if (difficulty !== \"curse\" || finished) return;\n\n        // Curse Mode attacks often enough that players must type through the\n        // disruption instead of simply waiting for each effect to end.\n        const delay = 700 + Math.random() * 1100;\n        curseTimeout = setTimeout(triggerRandomCurse, delay);\n    }\n\n    function triggerRandomCurse() {\n        if (difficulty !== \"curse\" || finished || !started) {\n            scheduleCurse();\n            return;\n        }\n\n        if (bossCurseActive) {\n            triggerBossCurse();\n            scheduleCurse();\n            return;\n        }\n\n        const effects = [\n            curseShake, curseScramble, curseJolt, curseMirror,\n            curseBlackout, curseBlindInput, curseTilt, curseColorPulse\n        ];\n        const firstIndex = Math.floor(Math.random() * effects.length);\n        effects[firstIndex]();\n\n        // Roughly one third of strikes stack a second, different curse.\n        if (Math.random() < .36) {\n            let secondIndex;\n            do { secondIndex = Math.floor(Math.random() * effects.length); }\n            while (secondIndex === firstIndex);\n            setTimeout(function() {\n                if (difficulty === \"curse\" && !finished) effects[secondIndex]();\n            }, 120);\n        }\n        scheduleCurse();\n    }\n\n    function triggerBossCurse() {\n        curseShake();\n        setTimeout(function() {\n            if (difficulty === \"curse\" && bossCurseActive && !finished) curseScramble();\n        }, 120);\n        setTimeout(function() {\n            if (difficulty === \"curse\" && bossCurseActive && !finished) curseJolt();\n        }, 240);\n    }\n\n    function curseShake() {\n        const app = document.querySelector(\".app\");\n        if (!app) return;\n        app.classList.add(\"curse-shake\");\n        setTimeout(function() { app.classList.remove(\"curse-shake\"); }, 400);\n    }\n\n    function curseJolt() {\n        const input = document.getElementById(\"typingInput\");\n        if (!input) return;\n        input.classList.add(\"curse-jolt\");\n        setTimeout(function() { input.classList.remove(\"curse-jolt\"); }, 300);\n    }\n\n    function curseScramble() {\n        const display = document.getElementById(\"phraseDisplay\");\n        if (!display || finished) return;\n\n        const scrambled = currentPhraseWords.map(function(word) {\n            const letters = word.split(\"\");\n            for (let i = letters.length - 1; i > 0; i--) {\n                const j = Math.floor(Math.random() * (i + 1));\n                const temp = letters[i];\n                letters[i] = letters[j];\n                letters[j] = temp;\n            }\n            return letters.join(\"\");\n        });\n\n        display.querySelectorAll(\".word\").forEach(function(el, index) {\n            if (scrambled[index]) el.textContent = scrambled[index];\n            el.classList.add(\"curse-glitch\");\n        });\n\n        setTimeout(function() {\n            if (finished) return;\n            renderPhrase();\n            updateTyping(typingInput.value);\n        }, 850);\n    }\n\n    function curseMirror() {\n        const display = document.getElementById(\"phraseDisplay\");\n        if (!display) return;\n        display.classList.add(\"curse-mirror\");\n        setTimeout(function() { display.classList.remove(\"curse-mirror\"); }, 900);\n    }\n\n    function curseBlackout() {\n        const display = document.getElementById(\"phraseDisplay\");\n        if (!display) return;\n        display.classList.add(\"curse-blackout\");\n        setTimeout(function() { display.classList.remove(\"curse-blackout\"); }, 720);\n    }\n\n    function curseBlindInput() {\n        const input = document.getElementById(\"typingInput\");\n        if (!input) return;\n        input.classList.add(\"curse-input-blind\");\n        setTimeout(function() { input.classList.remove(\"curse-input-blind\"); }, 760);\n    }\n\n    function curseTilt() {\n        const card = document.querySelector(\"#gameScreen .phrase-card\");\n        if (!card) return;\n        card.classList.add(\"curse-tilt\");\n        setTimeout(function() { card.classList.remove(\"curse-tilt\"); }, 800);\n    }\n\n    function curseColorPulse() {\n        const screen = document.getElementById(\"gameScreen\");\n        if (!screen) return;\n        screen.classList.remove(\"curse-pulse\");\n        void screen.offsetWidth;\n        screen.classList.add(\"curse-pulse\");\n        setTimeout(function() { screen.classList.remove(\"curse-pulse\"); }, 700);\n    }\n\n\n    /* =========================================================\n       MIRROR MATCH (CHAOS, SIMULTANEOUS 2 PLAYER)\n    ========================================================= */\n\n    function clearMirrorMatchTimers() {\n        if (mirrorChaosInterval !== null) {\n            clearInterval(mirrorChaosInterval);\n            mirrorChaosInterval = null;\n        }\n        if (mirrorCountdownTimeout !== null) {\n            clearTimeout(mirrorCountdownTimeout);\n            mirrorCountdownTimeout = null;\n        }\n        [1, 2].forEach(function(player) {\n            const panel = document.getElementById(\"mirrorPlayer\" + player + \"Panel\");\n            if (panel) panel.classList.remove(\"cursed\", \"leading\", \"mirror-loser-shake\", \"mirror-loser-blind\", \"mirror-loser-flip\", \"mirror-loser-glitch\");\n        });\n    }\n\n    function buildMirrorKeyboard(player) {\n        const keyboard = document.getElementById(\"mirrorKeyboard\" + player);\n        if (!keyboard || keyboard.childElementCount) return;\n        const rows = [\n            Array.from(\"qwertyuiop\"),\n            Array.from(\"asdfghjkl\"),\n            Array.from(\"zxcvbnm\"),\n            [\"'\", \",\", \".\", \"?\", \"!\", \":\", \"-\", \"SPACE\", \"BACK\"]\n        ];\n        rows.forEach(function(rowKeys) {\n            const row = document.createElement(\"div\");\n            row.className = \"mirror-keyboard-row\";\n            rowKeys.forEach(function(key) {\n                const button = document.createElement(\"button\");\n                button.type = \"button\";\n                button.className = \"mirror-key\" + (key === \"SPACE\" ? \" space\" : key === \"BACK\" ? \" back\" : \"\");\n                button.textContent = key === \"SPACE\" ? \"SPACE\" : key === \"BACK\" ? \"⌫\" : key.toUpperCase();\n                button.setAttribute(\"aria-label\", key === \"BACK\" ? \"Backspace\" : key);\n                button.addEventListener(\"pointerdown\", function(event) {\n                    event.preventDefault();\n                    mirrorTapKey(player, key);\n                });\n                row.appendChild(button);\n            });\n            keyboard.appendChild(row);\n        });\n    }\n\n    function mirrorTapKey(player, key) {\n        const input = document.getElementById(\"mirrorInput\" + player);\n        if (!input || input.disabled || mirrorMatchResults[player - 1]) return;\n        if (key === \"BACK\") {\n            input.value = input.value.slice(0, -1);\n        } else if (key === \"SPACE\") {\n            input.value += \" \";\n        } else {\n            const expected = mirrorMatchPhrase[input.value.length] || \"\";\n            const apostropheMatch = key === \"'\" && /['’]/.test(expected);\n            const dashMatch = key === \"-\" && /[-–—]/.test(expected);\n            input.value += expected && (expected.toLowerCase() === key.toLowerCase() || apostropheMatch || dashMatch) ? expected : key;\n        }\n        updateMirrorPlayer(player);\n    }\n\n    function startMirrorMatch() {\n        stopTimer();\n        clearMirrorMatchTimers();\n        mirrorMatchWinner = null;\n        mirrorMatchResults = [null, null];\n        mirrorMatchStartTime = 0;\n\n        const available = phrases[language][attitude] || phrases.english.friendly;\n        const index = getNextPhraseIndex(language, attitude);\n        mirrorMatchPhrase = available[index];\n\n        [1, 2].forEach(function(player) {\n            const phrase = document.getElementById(\"mirrorPhrase\" + player);\n            const input = document.getElementById(\"mirrorInput\" + player);\n            const progress = document.getElementById(\"mirrorProgress\" + player);\n            const status = document.getElementById(\"mirrorPlayer\" + player + \"Status\");\n            if (phrase) phrase.textContent = mirrorMatchPhrase;\n            buildMirrorKeyboard(player);\n            if (input) {\n                input.value = \"\";\n                input.disabled = true;\n                input.oninput = function() { updateMirrorPlayer(player); };\n            }\n            if (progress) progress.style.width = \"0%\";\n            if (status) status.textContent = \"GET READY\";\n        });\n\n        document.body.className = \"game-active\";\n        showScreen(\"mirrorMatchScreen\");\n\n        const countdown = document.getElementById(\"mirrorCountdown\");\n        if (countdown) countdown.classList.remove(\"hidden\");\n        let count = 3;\n        function tick() {\n            if (!document.getElementById(\"mirrorMatchScreen\").classList.contains(\"active\")) return;\n            if (count > 0) {\n                if (countdown) countdown.textContent = count;\n                count--;\n                mirrorCountdownTimeout = setTimeout(tick, 700);\n                return;\n            }\n            if (countdown) countdown.textContent = \"GO!\";\n            mirrorMatchStartTime = Date.now();\n            [1, 2].forEach(function(player) {\n                const input = document.getElementById(\"mirrorInput\" + player);\n                const status = document.getElementById(\"mirrorPlayer\" + player + \"Status\");\n                if (input) input.disabled = false;\n                if (status) status.textContent = \"RACING\";\n            });\n            mirrorCountdownTimeout = setTimeout(function() {\n                if (countdown) countdown.classList.add(\"hidden\");\n            }, 400);\n        }\n        tick();\n    }\n\n    function updateMirrorPlayer(player) {\n        if (!mirrorMatchStartTime || mirrorMatchResults[player - 1]) return;\n        const input = document.getElementById(\"mirrorInput\" + player);\n        const progress = document.getElementById(\"mirrorProgress\" + player);\n        const status = document.getElementById(\"mirrorPlayer\" + player + \"Status\");\n        if (!input) return;\n\n        const value = input.value;\n        let correctPrefix = 0;\n        while (correctPrefix < value.length && correctPrefix < mirrorMatchPhrase.length && value[correctPrefix] === mirrorMatchPhrase[correctPrefix]) correctPrefix++;\n        const percent = mirrorMatchPhrase.length ? Math.round(correctPrefix / mirrorMatchPhrase.length * 100) : 0;\n        if (progress) progress.style.width = percent + \"%\";\n        if (status) status.textContent = percent + \"%\";\n\n        if (value === mirrorMatchPhrase) finishMirrorPlayer(player);\n    }\n\n    function finishMirrorPlayer(player) {\n        const elapsed = Math.max(.1, (Date.now() - mirrorMatchStartTime) / 1000);\n        const wpm = Math.round((mirrorMatchPhrase.length / 5) / (elapsed / 60));\n        mirrorMatchResults[player - 1] = { time: elapsed, wpm: wpm };\n        const input = document.getElementById(\"mirrorInput\" + player);\n        const panel = document.getElementById(\"mirrorPlayer\" + player + \"Panel\");\n        const status = document.getElementById(\"mirrorPlayer\" + player + \"Status\");\n        if (input) input.disabled = true;\n        if (status) status.textContent = \"FINISHED · \" + elapsed.toFixed(1) + \"s\";\n\n        if (mirrorMatchWinner === null) {\n            mirrorMatchWinner = player;\n            if (panel) panel.classList.add(\"leading\");\n            const loser = player === 1 ? 2 : 1;\n            const loserPanel = document.getElementById(\"mirrorPlayer\" + loser + \"Panel\");\n            const loserStatus = document.getElementById(\"mirrorPlayer\" + loser + \"Status\");\n            if (loserPanel) loserPanel.classList.add(\"cursed\");\n            if (loserStatus) loserStatus.textContent = \"CURSED — KEEP TYPING\";\n            startMirrorLoserChaos(loser);\n        }\n\n        if (mirrorMatchResults[0] && mirrorMatchResults[1]) showMirrorMatchResults();\n    }\n\n    function startMirrorLoserChaos(loser) {\n        if (mirrorChaosInterval !== null) clearInterval(mirrorChaosInterval);\n        const classNames = [\"mirror-loser-shake\", \"mirror-loser-blind\", \"mirror-loser-flip\", \"mirror-loser-glitch\"];\n        function strike() {\n            if (mirrorMatchResults[loser - 1]) return;\n            const panel = document.getElementById(\"mirrorPlayer\" + loser + \"Panel\");\n            if (!panel) return;\n            const effect = classNames[Math.floor(Math.random() * classNames.length)];\n            panel.classList.remove(effect);\n            void panel.offsetWidth;\n            panel.classList.add(effect);\n            setTimeout(function() { if (panel) panel.classList.remove(effect); }, 360);\n        }\n        strike();\n        mirrorChaosInterval = setInterval(strike, 470);\n    }\n\n    function showMirrorMatchResults() {\n        clearMirrorMatchTimers();\n        const p1 = mirrorMatchResults[0];\n        const p2 = mirrorMatchResults[1];\n        const winner = mirrorMatchWinner || (p1.time <= p2.time ? 1 : 2);\n        document.getElementById(\"mirrorWinnerLabel\").textContent = \"PLAYER \" + winner + \" WINS\";\n        document.getElementById(\"mirrorP1Score\").textContent = p1.time.toFixed(1) + \"s · \" + p1.wpm + \" WPM\";\n        document.getElementById(\"mirrorP2Score\").textContent = p2.time.toFixed(1) + \"s · \" + p2.wpm + \" WPM\";\n        document.getElementById(\"mirrorP1Box\").classList.toggle(\"winner\", winner === 1);\n        document.getElementById(\"mirrorP2Box\").classList.toggle(\"winner\", winner === 2);\n        const loser = winner === 1 ? 2 : 1;\n        document.getElementById(\"mirrorComment\").textContent = \"Player \" + winner + \" broke the mirror first. Player \" + loser + \" finished under a full curse barrage.\";\n        document.body.className = \"result-active\";\n        showScreen(\"mirrorResultScreen\");\n    }\n\n    function quitMirrorMatch() {\n        clearMirrorMatchTimers();\n        mirrorMatchStartTime = 0;\n        document.body.className = \"\";\n        showScreen(\"chaosScreen\");\n    }\n\n\n    /* =========================================================\n       TIMER\n    ========================================================= */\n\n    function updateTimer() {\n        if (!started || finished) return;\n\n        const elapsed = (Date.now() - startTime) / 1000;\n        const liveTime = document.getElementById(\"liveTime\");\n        const liveTimeLabel = document.querySelector(\"#gameScreen .stats-row .stat:first-child .stat-label\");\n\n        if (difficulty === \"nomercy\") {\n            const remaining = noMercyTimeLimit - elapsed;\n\n            if (remaining > 0) {\n                noMercyOvertime = false;\n                if (liveTime) liveTime.textContent = formatCountdown(remaining);\n                if (liveTime) liveTime.classList.remove(\"no-mercy-overtime\");\n                if (liveTimeLabel) liveTimeLabel.textContent = \"TIME LEFT\";\n            } else {\n                // IMPORTANT: No Mercy does NOT auto-end. The user can still finish.\n                noMercyOvertime = true;\n                const overtime = Math.abs(remaining);\n                if (liveTime) {\n                    liveTime.textContent = \"+\" + formatCountdown(overtime);\n                    liveTime.classList.add(\"no-mercy-overtime\");\n                }\n                if (liveTimeLabel) liveTimeLabel.textContent = \"OVERTIME\";\n            }\n            return;\n        }\n\n        if (liveTime) liveTime.textContent = elapsed.toFixed(1);\n    }\n\n    function stopTimer() {\n\n        if (timerInterval !== null) {\n\n            clearInterval(timerInterval);\n\n            timerInterval = null;\n\n        }\n\n        if (curseTimeout !== null) {\n            clearTimeout(curseTimeout);\n            curseTimeout = null;\n        }\n\n        const curseDisplay = document.getElementById(\"phraseDisplay\");\n        const curseInput = document.getElementById(\"typingInput\");\n        const curseCard = document.querySelector(\"#gameScreen .phrase-card\");\n        const curseScreen = document.getElementById(\"gameScreen\");\n        const curseApp = document.querySelector(\".app\");\n        if (curseDisplay) curseDisplay.classList.remove(\"curse-mirror\", \"curse-blackout\", \"curse-glitch\");\n        if (curseInput) curseInput.classList.remove(\"curse-input-blind\", \"curse-jolt\");\n        if (curseCard) curseCard.classList.remove(\"curse-tilt\");\n        if (curseCard) curseCard.classList.remove(\"boss-curse-card\");\n        if (curseScreen) curseScreen.classList.remove(\"curse-pulse\");\n        if (curseApp) curseApp.classList.remove(\"curse-shake\");\n\n    }\n\n\n    /* =========================================================\n       SUDDEN DEATH\n    ========================================================= */\n\n    const suddenDeathLinesFriendly = [\n        \"One typo and it's over — that's Sudden Death for you. Shake it off and try again!\",\n        \"So close! Sudden Death shows no mercy, but every attempt sharpens your fingers.\",\n        \"Eliminated! Sudden Death is brutal by design. You'll get further next time.\",\n        \"That's the rule — one mistake, game over. Take a breath and go again.\"\n    ];\n\n    const suddenDeathLinesAlmighty = [\n        \"ELIMINATED. One mistake, zero mercy, and your keyboard has never looked more disappointed.\",\n        \"And just like that, you're dead. Sudden Death does not care about your feelings.\",\n        \"That's it. One typo and your run is over. Almighty does not do participation trophies.\",\n        \"You lasted exactly as long as your accuracy did — not very long.\",\n        \"Sudden Death said 'one mistake' and you said 'hold my keyboard.' Bold. Wrong. But bold.\"\n    ];\n\n    function handleSuddenDeathMistake(value) {\n        if (finished) return;\n\n        finished = true;\n        stopTimer();\n\n        const input = document.getElementById(\"typingInput\");\n        if (input) input.disabled = true;\n\n        const elapsed = started ? (Date.now() - startTime) / 1000 : 0;\n\n        // Find exactly how far the player got before the fatal keystroke.\n        let survivedChars = 0;\n        const len = Math.min(value.length, currentPhrase.length);\n        while (survivedChars < len && value[survivedChars] === currentPhrase[survivedChars]) {\n            survivedChars++;\n        }\n        const progressPercent = currentPhrase.length > 0\n            ? Math.round((survivedChars / currentPhrase.length) * 100)\n            : 0;\n\n        roundsPlayed++;\n        totalMistakes += 1;\n        totalAccuracy += progressPercent;\n        bestAccuracy = Math.max(bestAccuracy, progressPercent);\n\n        const key = getModeStatsKey(language, attitude, \"suddendeath\");\n        if (!modeStats[key]) modeStats[key] = createDefaultModeStats();\n        modeStats[key].rounds++;\n        modeStats[key].totalMistakes += 1;\n        modeStats[key].totalTime += elapsed;\n        modeStats[key].bestAccuracy = Math.max(modeStats[key].bestAccuracy, progressPercent);\n\n        const currentLanguageStats = languageStats[language] || createDefaultLanguageStats();\n        currentLanguageStats.rounds++;\n        currentLanguageStats.bestAccuracy = Math.max(currentLanguageStats.bestAccuracy, progressPercent);\n        currentLanguageStats.totalMistakes += 1;\n        currentLanguageStats.totalAccuracy += progressPercent;\n        currentLanguageStats.totalTime += elapsed;\n        languageStats[language] = currentLanguageStats;\n\n        saveStats();\n\n        const resultScoreLabel = document.getElementById(\"resultScoreLabel\");\n        if (resultScoreLabel) resultScoreLabel.textContent = \"ELIMINATED AT\";\n\n        document.getElementById(\"resultAccuracy\").textContent = progressPercent + \"%\";\n\n        const resultPenalty = document.getElementById(\"resultPenalty\");\n        if (resultPenalty) {\n            resultPenalty.style.display = \"none\";\n            resultPenalty.textContent = \"\";\n        }\n\n        document.getElementById(\"resultTime\").textContent = elapsed.toFixed(1) + \"s\";\n        document.getElementById(\"resultCorrect\").textContent = 1;\n        document.getElementById(\"resultMistakes\").textContent = 1;\n        document.getElementById(\"resultWpm\").textContent = 0;\n\n        const lines = attitude === \"almighty\" ? suddenDeathLinesAlmighty : suddenDeathLinesFriendly;\n        const line = lines[Math.floor(Math.random() * lines.length)];\n        document.getElementById(\"roundComment\").textContent =\n            line + \" You made it \" + progressPercent + \"% through the phrase.\";\n\n        document.body.className = \"result-active\";\n        showScreen(\"resultScreen\");\n\n        const announcement = document.getElementById(\"resultAnnouncement\");\n        if (announcement) {\n            announcement.textContent = \"Eliminated. You reached \" + progressPercent + \" percent through the phrase before the fatal mistake.\";\n        }\n    }\n\n\n    /* =========================================================\n       FINISH ROUND\n    ========================================================= */\n\n    function finishRound() {\n\n        if (finished) {\n            return;\n        }\n\n        finished = true;\n\n        stopTimer();\n\n        finalizeComboForRound();\n\n        document.getElementById(\"typingInput\")\n            .disabled = true;\n\n        const elapsed =\n            started\n                ? (\n                    Date.now() -\n                    startTime\n                ) / 1000\n                : 0;\n\n        /*\n         * Accuracy is based on actual characters typed\n         * correctly. Correcting a mistake in Easy mode\n         * does not erase the fact that a mistake occurred.\n         */\n\n        const typedValue = typingInput.value.trim();\n        const typedWords = typedValue ? typedValue.split(/\\s+/) : [];\n        const characterErrors = editDistance(typedValue, currentPhrase);\n        const accuracyBase = Math.max(typedValue.length, currentPhrase.length);\n        const accuracy = accuracyBase > 0\n            ? Math.max(0, Math.round((accuracyBase - characterErrors) / accuracyBase * 100))\n            : 0;\n        wrongWordCount = editDistance(typedWords, currentPhraseWords);\n        mistakeCount = characterErrors;\n        incorrectKeystrokes = characterErrors;\n        const minutes = elapsed > 0 ? elapsed / 60 : 0;\n        const rawWpm = minutes > 0 ? Math.round((typedValue.length / 5) / minutes) : 0;\n        const wpm = Math.max(0, Math.round(rawWpm * (accuracy / 100)));\n        correctCount = Math.max(0, currentPhrase.length - characterErrors);\n        const previousBestAccuracy = bestAccuracy;\n        const previousBestWpm = bestWpm;\n\n        // Always preserve the real accuracy. No Mercy applies a separate,\n        // gradual overtime adjustment that is shown underneath it.\n        let displayScore = accuracy;\n        let penaltyPercent = 0;\n        if (difficulty === \"nomercy\" && noMercyTimeLimit > 0 && elapsed > noMercyTimeLimit) {\n            const overtime = elapsed - noMercyTimeLimit;\n            const penaltyFactor = Math.min(0.50, 0.05 + overtime * 0.03);\n            penaltyPercent = Math.round(penaltyFactor * 100);\n            displayScore = Math.max(0, Math.round(accuracy * (1 - penaltyFactor)));\n        }\n        const recordedScore = difficulty === \"nomercy\" ? displayScore : accuracy;\n        roundsPlayed++;\n        totalMistakes += mistakeCount;\n        totalAccuracy += recordedScore;\n\n        bestAccuracy =\n            Math.max(bestAccuracy,recordedScore);\n\n        bestWpm =\n            Math.max(bestWpm,wpm);\n\n        const key = getModeStatsKey(language, attitude, difficulty);\n\n        if (!modeStats[key]) {\n            modeStats[key] =\n                createDefaultModeStats();\n        }\n\n        modeStats[key].rounds++;\n        modeStats[key].totalMistakes +=\n            mistakeCount;\n\n        modeStats[key].totalTime +=\n            elapsed;\n\n        if (difficulty === \"nomercy\") {\n            modeStats[key].bestRankedScore = Math.max(\n                modeStats[key].bestRankedScore || 0,\n                recordedScore\n            );\n        } else {\n            modeStats[key].bestAccuracy = Math.max(\n                modeStats[key].bestAccuracy,\n                recordedScore\n            );\n        }\n\n        modeStats[key].bestWpm =\n            Math.max(\n                modeStats[key].bestWpm,\n                wpm\n            );\n\n        if (difficulty === \"combo\") {\n            modeStats[key].bestCombo = Math.max(\n                modeStats[key].bestCombo || 0,\n                maxComboThisSession\n            );\n        }\n\n        const currentLanguageStats = languageStats[language] || createDefaultLanguageStats();\n        currentLanguageStats.rounds++;\n        currentLanguageStats.bestAccuracy = Math.max(currentLanguageStats.bestAccuracy, recordedScore);\n        currentLanguageStats.bestWpm = Math.max(currentLanguageStats.bestWpm, wpm);\n        currentLanguageStats.totalMistakes += mistakeCount;\n        currentLanguageStats.totalAccuracy += recordedScore;\n        currentLanguageStats.totalTime += elapsed;\n        languageStats[language] = currentLanguageStats;\n\n        saveStats();\n\n        document.getElementById(\"resultAccuracy\")\n            .textContent =\n                accuracy + \"%\";\n\n        const resultScoreLabel = document.getElementById(\"resultScoreLabel\");\n        if (resultScoreLabel) {\n            resultScoreLabel.textContent = \"ACCURACY\";\n        }\n\n        const resultPenalty = document.getElementById(\"resultPenalty\");\n        if (resultPenalty) {\n            if (difficulty === \"nomercy\" && noMercyOvertime) {\n                resultPenalty.style.display = \"block\";\n                resultPenalty.textContent =\n                    \"−\" + penaltyPercent + \"% OVERTIME PENALTY · NO MERCY SCORE: \" + displayScore + \"%\";\n            } else {\n                resultPenalty.style.display = \"none\";\n                resultPenalty.textContent = \"\";\n            }\n        }\n\n        document.getElementById(\"resultTime\")\n            .textContent =\n                elapsed.toFixed(1) + \"s\";\n\n        document.getElementById(\"resultCorrect\")\n            .textContent =\n                wrongWordCount;\n\n        document.getElementById(\"resultMistakes\")\n            .textContent =\n                mistakeCount;\n\n        document.getElementById(\"resultWpm\")\n            .textContent =\n                wpm;\n\n        const correctResultLabel = document.querySelector(\"#resultCorrect + span\");\n        const mistakeResultLabel = document.querySelector(\"#resultMistakes + span\");\n        if (correctResultLabel) correctResultLabel.textContent = \"WRONG WORDS\";\n        if (mistakeResultLabel) mistakeResultLabel.textContent = \"CHARACTER ERRORS\";\n\n        let roundCommentText =\n            getComment(\n                accuracy,\n                mistakeCount,\n                elapsed,\n                wpm\n            );\n\n        if (difficulty === \"nomercy\") {\n            const timeVerdict = getNoMercyTimeVerdict(elapsed, noMercyTimeLimit);\n            if (timeVerdict) {\n                roundCommentText += \" \" + timeVerdict;\n            }\n        }\n\n        if (difficulty === \"combo\") {\n            roundCommentText += comboStreak > 0\n                ? \" 🔥 Combo standing at \" + comboStreak + \"x (session best \" + maxComboThisSession + \"x). Keep it alive next round.\"\n                : \" Combo broken — back to 0x. Start chaining clean words again.\";\n        }\n\n        const achievements = [];\n        if (difficulty === \"combo\" && maxComboThisSession > 0 && maxComboThisSession === bestComboEver) {\n            achievements.push(\"New best combo: \" + maxComboThisSession + \"x!\");\n        }\n        if (recordedScore > previousBestAccuracy) {\n            achievements.push(\n                difficulty === \"nomercy\"\n                    ? \"New No Mercy score best: \" + recordedScore + \"%!\"\n                    : \"New accuracy best: \" + recordedScore + \"%!\"\n            );\n        }\n        if (wpm > previousBestWpm) achievements.push(\"New speed best: \" + wpm + \" WPM!\");\n        if (achievements.length) roundCommentText = achievements.join(\" \") + \" \" + roundCommentText;\n\n        document.getElementById(\"roundComment\")\n            .textContent =\n                roundCommentText;\n\n        document.body.className =\n            \"result-active\";\n\n        showScreen(\"resultScreen\");\n\n        const announcement = document.getElementById(\"resultAnnouncement\");\n        if (announcement) {\n            announcement.textContent = \"Round complete. \" + accuracy + \" percent accuracy, \" + wpm + \" words per minute, \" + mistakeCount + \" character errors across \" + wrongWordCount + \" incorrect words.\" +\n                (difficulty === \"nomercy\" && noMercyOvertime\n                    ? \" Overtime penalty \" + penaltyPercent + \" percent. No Mercy score \" + displayScore + \" percent.\"\n                    : \"\");\n        }\n\n        if (difficulty === \"reverse\") {\n            lastReverseResult = { accuracy: accuracy, wpm: wpm, time: elapsed.toFixed(1), phrase: currentPhrase };\n            const brainShare = document.getElementById(\"brainBrokeShareBtn\");\n            if (brainShare) brainShare.style.display = \"block\";\n            document.getElementById(\"roundComment\").textContent += \" Brain officially broke: \" + wpm + \" WPM while decoding backwards.\";\n        }\n\n    }\n\n    function escapeRegExp(value) {\n        return value.replace(/[.*+?^$()|[\\]\\\\{}]/g, \"\\\\$&\");\n    }\n\n    function getMadLibFillIns(template, answer) {\n        const parts = template.split(/(\\[[^\\]]+\\])/g);\n        let pattern = \"^\";\n        let blankCount = 0;\n        parts.forEach(function(part) {\n            if (/^\\[.*\\]$/.test(part)) {\n                pattern += \"(.+?)\";\n                blankCount++;\n            } else {\n                pattern += escapeRegExp(part).replace(/\\s+/g, \"\\\\s+\");\n            }\n        });\n        pattern += \"$\";\n        const match = answer.match(new RegExp(pattern, \"iu\"));\n        return match ? match.slice(1, blankCount + 1).map(function(fill) { return fill.trim(); }) : [];\n    }\n\n    function scoreMadLibFillQuality(fill) {\n        const words = fill.toLowerCase().match(/[\\p{L}\\p{N}']+/gu) || [];\n        if (!words.length) return 0;\n        const keyboardMash = /(qwert|asd|zxcv|hjkl|lkj|poi|qaz|wsx|edc|rfv|tgb|yhn|ujm|1234)/i;\n        let validWords = 0;\n        words.forEach(function(word) {\n            const letters = word.replace(/[^\\p{L}]/gu, \"\");\n            if (letters.length < 2 || keyboardMash.test(letters) || /(.)\\1\\1/i.test(letters)) return;\n            const uniqueRatio = new Set(Array.from(letters)).size / letters.length;\n            const vowels = (letters.match(/[aeiouáéíóú]/gi) || []).length;\n            const vowelRatio = vowels / letters.length;\n            const consonantPile = /[^aeiouáéíóú\\W\\d_]{4,}/i.test(letters);\n            if (vowelRatio >= .18 && vowelRatio <= .80 && !consonantPile && uniqueRatio >= .38) validWords++;\n        });\n        return Math.round(validWords / words.length * 100);\n    }\n\n    function finishMadLibs() {\n        if (finished) return;\n        const answer = typingInput.value.trim();\n        if (!answer) { typingInput.focus(); return; }\n        finished = true;\n        stopTimer();\n        typingInput.disabled = true;\n        const elapsed = started ? (Date.now() - startTime) / 1000 : 0;\n        const expectedBlankCount = (currentMadLibTemplate.match(/\\[[^\\]]+\\]/g) || []).length;\n        const capturedFills = getMadLibFillIns(currentMadLibTemplate, answer);\n        const fixedParts = currentMadLibTemplate.split(/\\[[^\\]]+\\]/g).map(function(part) { return part.trim(); }).filter(Boolean);\n        let structureHits = 0;\n        fixedParts.forEach(function(part) {\n            const sample = part.replace(/[^\\p{L}\\p{N}\\s]/gu, \"\").trim().split(/\\s+/).slice(0, 2).join(\" \");\n            if (sample && new RegExp(escapeRegExp(sample), \"i\").test(answer)) structureHits++;\n        });\n        const speedWpm = elapsed > 0 ? Math.round((answer.length / 5) / (elapsed / 60)) : 0;\n        const fillQualities = capturedFills.map(scoreMadLibFillQuality);\n        const fillQuality = capturedFills.length === expectedBlankCount && fillQualities.length\n            ? Math.round(fillQualities.reduce(function(sum, score) { return sum + score; }, 0) / fillQualities.length)\n            : 0;\n        const weakestFillQuality = fillQualities.length ? Math.min.apply(null, fillQualities) : 0;\n        const fillText = capturedFills.join(\" \");\n        const unusual = (fillText.match(/\\b[\\p{L}\\p{N}']{8,}\\b/gu) || []).length;\n        const diversity = new Set(fillText.toLowerCase().match(/[\\p{L}\\p{N}']+/gu) || []).size;\n        const creativity = Math.min(100, 25 + unusual * 12 + Math.min(45, diversity * 7));\n        const absurdity = Math.round(creativity * (fillQuality / 100));\n        const structure = capturedFills.length === expectedBlankCount\n            ? 100\n            : (fixedParts.length ? Math.round(structureHits / fixedParts.length * 100) : 0);\n        let finalScore = Math.round(structure * .40 + absurdity * .40 + Math.min(100, speedWpm) * .20 * (fillQuality / 100));\n        if (weakestFillQuality < 50) finalScore = Math.min(finalScore, 30);\n        else if (fillQuality < 80) finalScore = Math.min(finalScore, 60);\n        const fills = capturedFills.join(\", \") || \"those keyboard noises\";\n        const almighty = [\n            \"You chose \" + fills + \". Somewhere, a dictionary just filed a restraining order.\",\n            \"That story had the structural integrity of wet bread. The chaos, unfortunately, was elite.\",\n            \"Almighty verdict: \" + fills + \" should never have met in one sentence, yet here we are.\"\n        ];\n        const friendly = [\n            \"That sentence took a glorious detour through nonsense town.\",\n            \"Wild choices. The blanks never knew what hit them.\",\n            \"You turned a typing test into accidental literature.\"\n        ];\n        roundsPlayed++;\n        totalAccuracy += finalScore;\n        bestAccuracy = Math.max(bestAccuracy, finalScore);\n        bestWpm = Math.max(bestWpm, speedWpm);\n        const key = getModeStatsKey(language, attitude, \"madlibs\");\n        if (!modeStats[key]) modeStats[key] = createDefaultModeStats();\n        modeStats[key].rounds++;\n        modeStats[key].bestAccuracy = Math.max(modeStats[key].bestAccuracy, finalScore);\n        modeStats[key].bestWpm = Math.max(modeStats[key].bestWpm, speedWpm);\n        modeStats[key].totalTime += elapsed;\n        const currentLanguageStats = languageStats[language] || createDefaultLanguageStats();\n        currentLanguageStats.rounds++;\n        currentLanguageStats.bestAccuracy = Math.max(currentLanguageStats.bestAccuracy, finalScore);\n        currentLanguageStats.bestWpm = Math.max(currentLanguageStats.bestWpm, speedWpm);\n        currentLanguageStats.totalAccuracy += finalScore;\n        currentLanguageStats.totalTime += elapsed;\n        languageStats[language] = currentLanguageStats;\n        saveStats();\n        document.getElementById(\"resultScoreLabel\").textContent = \"CHAOS SCORE\";\n        document.getElementById(\"resultAccuracy\").textContent = finalScore + \"%\";\n        document.getElementById(\"resultTime\").textContent = elapsed.toFixed(1) + \"s\";\n        document.getElementById(\"resultCorrect\").textContent = structure + \"%\";\n        document.getElementById(\"resultMistakes\").textContent = absurdity + \"%\";\n        document.getElementById(\"resultWpm\").textContent = speedWpm;\n        document.querySelector(\"#resultCorrect + span\").textContent = \"STRUCTURE\";\n        document.querySelector(\"#resultMistakes + span\").textContent = \"ABSURDITY\";\n        const penalty = document.getElementById(\"resultPenalty\");\n        penalty.style.display = \"block\";\n        penalty.textContent = \"40% structure · 40% absurdity · 20% speed · Fill quality: \" + fillQuality + \"%\";\n        const lines = attitude === \"almighty\" ? almighty : friendly;\n        document.getElementById(\"roundComment\").textContent = lines[Math.floor(Math.random() * lines.length)];\n        document.getElementById(\"brainBrokeShareBtn\").style.display = \"none\";\n        document.body.className = \"result-active\";\n        showScreen(\"resultScreen\");\n    }\n\n    function shareBrainBrokeCard() {\n        if (!lastReverseResult) return;\n        const canvas = document.createElement(\"canvas\");\n        canvas.width = 1080; canvas.height = 1080;\n        const ctx = canvas.getContext(\"2d\");\n        const cardAccent = /^#[0-9A-Fa-f]{6}$/.test(accentColor) ? accentColor : \"#ff4d6d\";\n        const glow = ctx.createLinearGradient(0, 0, 1080, 1080);\n        glow.addColorStop(0, \"#090b10\"); glow.addColorStop(.58, \"#171a22\"); glow.addColorStop(1, \"#0d0f14\");\n        ctx.fillStyle = glow; ctx.fillRect(0, 0, 1080, 1080);\n\n        const aura = ctx.createRadialGradient(900, 80, 0, 900, 80, 520);\n        aura.addColorStop(0, cardAccent + \"77\"); aura.addColorStop(1, \"transparent\");\n        ctx.fillStyle = aura; ctx.fillRect(350, 0, 730, 620);\n\n        ctx.fillStyle = cardAccent;\n        roundRect(ctx, 60, 55, 245, 46, 23); ctx.fill();\n        ctx.textAlign = \"center\"; ctx.fillStyle = \"#fff\";\n        ctx.font = \"900 18px Arial\"; ctx.fillText(\"REVERSE TYPER\", 182, 85);\n\n        ctx.textAlign = \"left\";\n        ctx.font = \"1000 66px Arial\"; ctx.fillText(\"MY BRAIN BROKE\", 60, 180);\n        ctx.fillStyle = \"rgba(255,255,255,.68)\";\n        ctx.font = \"800 22px Arial\";\n        ctx.fillText(lastReverseResult.time + \" SECONDS OF SUCCESSFUL DECODING\", 63, 220);\n\n        function resultTile(x, label, value, suffix) {\n            ctx.fillStyle = \"rgba(255,255,255,.065)\";\n            roundRect(ctx, x, 275, 460, 220, 28); ctx.fill();\n            ctx.strokeStyle = \"rgba(255,255,255,.11)\"; ctx.lineWidth = 2; ctx.stroke();\n            ctx.fillStyle = cardAccent; ctx.font = \"900 18px Arial\"; ctx.textAlign = \"left\";\n            ctx.fillText(label, x + 32, 320);\n            ctx.fillStyle = \"#fff\"; ctx.font = \"1000 112px Arial\";\n            ctx.fillText(String(value), x + 30, 435);\n            ctx.fillStyle = \"rgba(255,255,255,.62)\"; ctx.font = \"900 25px Arial\";\n            ctx.fillText(suffix, x + 305, 433);\n        }\n        resultTile(60, \"DECODING SPEED\", lastReverseResult.wpm, \"WPM\");\n        resultTile(560, \"ACCURACY\", lastReverseResult.accuracy, \"%\");\n\n        ctx.fillStyle = \"rgba(255,255,255,.06)\";\n        roundRect(ctx, 60, 535, 960, 300, 28); ctx.fill();\n        ctx.strokeStyle = cardAccent + \"88\"; ctx.lineWidth = 2; ctx.stroke();\n        ctx.fillStyle = cardAccent; ctx.textAlign = \"left\";\n        ctx.font = \"900 18px Arial\"; ctx.fillText(\"PHRASE DECODED\", 95, 582);\n        ctx.fillStyle = \"#fff\"; ctx.font = \"800 34px Arial\";\n        let phraseLines = wrapCanvasText(ctx, \"“\" + lastReverseResult.phrase + \"”\", 880);\n        if (phraseLines.length > 5) {\n            phraseLines = phraseLines.slice(0, 5);\n            phraseLines[4] = phraseLines[4].replace(/[.,!?]?”?$/, \"\") + \"…”\";\n        }\n        phraseLines.forEach(function(line, index) {\n            ctx.fillText(line, 95, 640 + index * 43);\n        });\n\n        ctx.save(); ctx.translate(540, 905); ctx.scale(-1, 1);\n        ctx.textAlign = \"center\"; ctx.fillStyle = cardAccent;\n        ctx.font = \"1000 35px Arial\"; ctx.fillText(\"KEYBOARD WARRIOR\", 0, 0); ctx.restore();\n        ctx.textAlign = \"center\"; ctx.fillStyle = \"#fff\";\n        ctx.font = \"900 26px Arial\";\n        ctx.fillText(\"I READ BACKWARDS. I TYPED FORWARDS. I SURVIVED.\", 540, 965);\n        ctx.fillStyle = \"rgba(255,255,255,.48)\"; ctx.font = \"800 17px Arial\";\n        ctx.fillText(\"SHARE THE MENTAL DAMAGE\", 540, 1015);\n\n        generatedCanvas = canvas;\n        generatedImageData = canvas.toDataURL(\"image/png\");\n        document.getElementById(\"sharePopupImage\").src = generatedImageData;\n        document.getElementById(\"shareOverlay\").classList.add(\"show\");\n    }\n\n\n    /* =========================================================\n       COMMENTS\n    ========================================================= */\n\n    function getComment(accuracy, mistakes, elapsed, wpm) {\n\n        // Results deliberately judge BOTH precision and pace.\n        // Time is part of the analysis itself, not just an afterthought.\n        const time = Number(elapsed) || 0;\n        const speed = Number(wpm) || 0;\n        const acc = Number(accuracy) || 0;\n        const mins = Math.floor(time / 60);\n        const secs = Math.floor(time % 60);\n        const timeText = mins > 0\n            ? mins + \"m \" + String(secs).padStart(2, \"0\") + \"s\"\n            : time.toFixed(1) + \"s\";\n\n        let pace;\n        if (speed >= 55 || time <= 25) pace = \"veryFast\";\n        else if (speed >= 40 || time <= 40) pace = \"fast\";\n        else if (speed >= 25 || time <= 70) pace = \"steady\";\n        else pace = \"slow\";\n\n        let precision;\n        if (acc >= 97 && mistakes <= 1) precision = \"excellent\";\n        else if (acc >= 90) precision = \"good\";\n        else if (acc >= 75) precision = \"mixed\";\n        else precision = \"rough\";\n\n        const friendly = {\n            excellent: {\n                veryFast: [\n                    \"Excellent balance — you were highly accurate and finished in \" + timeText + \". That is both clean and quick.\",\n                    \"Fantastic round. You kept the typing accurate while moving at a very strong pace: \" + timeText + \".\",\n                    \"That was polished typing: very few errors, strong control, and a \" + timeText + \" finish.\"\n                ],\n                fast: [\n                    \"Really nice work. Your accuracy stayed high and you completed the phrase in \" + timeText + \".\",\n                    \"Great balance between precision and speed. \" + timeText + \" is a solid finish with that accuracy.\",\n                    \"You stayed in control without becoming too slow. \" + timeText + \" and excellent accuracy make this a strong round.\"\n                ],\n                steady: [\n                    \"Very accurate work. You took \" + timeText + \", so the next step is gently building more speed without losing that control.\",\n                    \"Clean typing and a steady \" + timeText + \" finish. You have the accuracy — now work on making the pace a little quicker.\",\n                    \"Your precision was excellent. At \" + timeText + \", you can challenge yourself to shave a few seconds off next time.\"\n                ],\n                slow: [\n                    \"Your accuracy was excellent, and that matters. You finished in \" + timeText + \", so the next goal is improving speed while keeping the same control.\",\n                    \"Very clean typing. The \" + timeText + \" finish was slower than it needed to be, but your accuracy gives you a great base to build from.\",\n                    \"You proved you can type accurately. Now let us work on pace: \" + timeText + \" can come down with practice.\"\n                ]\n            },\n            good: {\n                veryFast: [\n                    \"Strong pace at \" + timeText + \". A little more attention to precision would make that speed even more impressive.\",\n                    \"You moved quickly and finished in \" + timeText + \". Keep that speed, and tighten up the small errors next round.\",\n                    \"That was fast. \" + timeText + \" is excellent pace; now aim for the same speed with even cleaner typing.\"\n                ],\n                fast: [\n                    \"Good round. You finished in \" + timeText + \" with solid accuracy — a little more consistency could make it excellent.\",\n                    \"Nice pace at \" + timeText + \". You are close to a really polished performance; keep balancing speed and accuracy.\",\n                    \"A solid combination of speed and accuracy. \" + timeText + \" is a good benchmark to improve from.\"\n                ],\n                steady: [\n                    \"A steady \" + timeText + \" finish with good accuracy. You are on the right track; now try to make the same performance a little faster.\",\n                    \"Good control. The \" + timeText + \" pace was reasonable, and you have room to increase speed without rushing.\",\n                    \"You kept things fairly accurate and finished in \" + timeText + \". Next goal: smoother, faster typing with the same control.\"\n                ],\n                slow: [\n                    \"Your accuracy was good, but the \" + timeText + \" finish shows that pace is your biggest opportunity right now.\",\n                    \"Nice precision, but the clock was not quite as kind. At \" + timeText + \", try to build speed gradually rather than rushing.\",\n                    \"You handled the words well. Now challenge yourself to reduce that \" + timeText + \" time while keeping the accuracy.\"\n                ]\n            },\n            mixed: {\n                veryFast: [\n                    \"You were moving at a great pace — \" + timeText + \" — but the speed came with some accuracy loss. Slow down just enough to stay cleaner.\",\n                    \"Fast finish at \" + timeText + \", but accuracy needs to catch up. Your speed is there; now add control.\",\n                    \"The clock liked this round more than your accuracy did. \" + timeText + \" is quick, so focus on making that speed cleaner.\"\n                ],\n                fast: [\n                    \"Good speed at \" + timeText + \", but accuracy needs more consistency. Aim for a better balance next round.\",\n                    \"You finished in \" + timeText + \" with mixed precision. The pace is promising; cleaner typing will make it much stronger.\",\n                    \"The speed is developing. At \" + timeText + \", focus on reducing the errors without giving up too much pace.\"\n                ],\n                steady: [\n                    \"You finished in \" + timeText + \", but both accuracy and pace have room to improve. Focus on smoother typing rather than simply typing harder.\",\n                    \"A workable \" + timeText + \" finish, but the performance was inconsistent. Try to slow down slightly, get cleaner, then build speed again.\",\n                    \"This round was a mix of good moments and rough spots. \" + timeText + \" gives you a clear target: cleaner and a little faster.\"\n                ],\n                slow: [\n                    \"Accuracy and pace both need attention here. You took \" + timeText + \", so work on becoming more confident and consistent before pushing speed.\",\n                    \"The \" + timeText + \" finish gave you plenty of time, but the accuracy still slipped. Try a calmer, more deliberate rhythm next round.\",\n                    \"There is room on both sides: fewer errors and a better pace than \" + timeText + \". Practice will help both improve together.\"\n                ]\n            },\n            rough: {\n                veryFast: [\n                    \"You finished in \" + timeText + \", which is fast, but too much accuracy was sacrificed. Speed is useful only when the typing stays controlled.\",\n                    \"Fast does not automatically mean good. \" + timeText + \" is impressive pace, but the accuracy needs serious cleanup.\",\n                    \"You attacked the clock and lost control. \" + timeText + \" is quick, so keep the speed and learn to stop the errors.\"\n                ],\n                fast: [\n                    \"You finished in \" + timeText + \", but the accuracy was too rough. Keep the pace and tighten the execution.\",\n                    \"The clock was respectable at \" + timeText + \", but the mistakes cost you. Aim for a cleaner version at a similar time.\",\n                    \"Decent pace, messy execution. \" + timeText + \" proves you can move; now prove you can control the movement.\"\n                ],\n                steady: [\n                    \"You took \" + timeText + \" and still lost too much accuracy. Slow down enough to establish control, then build speed back up.\",\n                    \"This was neither clean nor especially quick. At \" + timeText + \", focus first on consistency, then start chasing faster times.\",\n                    \"The \" + timeText + \" finish gives you room to improve on both accuracy and pace. A steadier rhythm should help.\"\n                ],\n                slow: [\n                    \"Too many errors and too much time. \" + timeText + \" is not a pace you should settle for. Practice until the typing becomes cleaner and faster.\",\n                    \"You had \" + timeText + \" to complete the phrase and still gave away too much accuracy. Work on control first, then speed.\",\n                    \"This needs work on both fronts: fewer mistakes and a faster finish than \" + timeText + \". Keep practicing.\"\n                ]\n            }\n        };\n\n        const almighty = {\n            excellent: {\n                veryFast: [\n                    \"Now THAT is a round. \" + timeText + \" with elite accuracy. Keep the standard high.\",\n                    \"Clean, fast, and controlled. \" + timeText + \". Finally, a performance worth acknowledging.\",\n                    \"Excellent. You respected both the phrase and the clock: \" + timeText + \" with almost no waste.\"\n                ],\n                fast: [\n                    \"Strong work. \" + timeText + \" and excellent accuracy. That is the minimum level worth being proud of.\",\n                    \"Good. You were accurate and fast at \" + timeText + \". Do not get comfortable — beat it next round.\",\n                    \"That was disciplined typing. \" + timeText + \" with clean execution. Keep pushing the ceiling higher.\"\n                ],\n                steady: [\n                    \"Accurate, but \" + timeText + \" is slower than your potential. Clean is good. Clean and fast is better.\",\n                    \"You avoided the mistakes, but the clock still has plenty to complain about: \" + timeText + \". Move faster next time.\",\n                    \"Precision is handled. Pace is not. \" + timeText + \" — now cut it down without losing control.\"\n                ],\n                slow: [\n                    \"Accurate does not excuse slow. \" + timeText + \" is far too comfortable. Keep the precision and eliminate the wasted time.\",\n                    \"The typing was clean, but the clock exposed the weakness: \" + timeText + \". Speed up.\",\n                    \"Good accuracy. Poor urgency. \" + timeText + \" is not an acceptable ceiling.\"\n                ]\n            },\n            good: {\n                veryFast: [\n                    \"Fast at \" + timeText + \", but not clean enough. Stop throwing accuracy away just to impress the clock.\",\n                    \"The pace is strong — \" + timeText + \" — but the execution needs tightening. Speed without control is sloppy.\",\n                    \"You moved quickly, but you left accuracy behind. Keep the \" + timeText + \" pace and fix the weak spots.\"\n                ],\n                fast: [\n                    \"Acceptable. \" + timeText + \" with decent accuracy. Not bad, not exceptional. Raise the standard.\",\n                    \"A respectable \" + timeText + \" finish, but you still left performance on the table. Clean it up and go faster.\",\n                    \"You are getting there. \" + timeText + \" is workable, but the next round should be cleaner and quicker.\"\n                ],\n                steady: [\n                    \"Decent accuracy, mediocre pace. \" + timeText + \" tells you exactly what needs work.\",\n                    \"You survived the phrase, but \" + timeText + \" is hardly intimidating. Keep the accuracy and start cutting seconds.\",\n                    \"Good enough to pass, not good enough to brag about. \" + timeText + \" needs improvement.\"\n                ],\n                slow: [\n                    \"Your accuracy is doing the heavy lifting while your speed takes a vacation. \" + timeText + \" is too slow.\",\n                    \"Decent precision, weak pace. \" + timeText + \" is the problem. Fix the clock, not just the mistakes.\",\n                    \"You spent too long getting an acceptable result. \" + timeText + \" needs to come down.\"\n                ]\n            },\n            mixed: {\n                veryFast: [\n                    \"You rushed. \" + timeText + \" is fast, but the accuracy paid for it. Learn control.\",\n                    \"Impressive clock, unimpressive discipline. \" + timeText + \" means nothing if the typing is this messy.\",\n                    \"You chased speed and lost precision. Keep the pace, lose the chaos.\"\n                ],\n                fast: [\n                    \"You have speed, but not enough control. \" + timeText + \" is useful only if you stop donating accuracy.\",\n                    \"Fast enough to matter, messy enough to hurt. \" + timeText + \" needs a cleaner execution.\",\n                    \"The clock is fine. The accuracy is not. Fix the balance.\"\n                ],\n                steady: [\n                    \"Neither clean nor quick enough. \" + timeText + \" is mediocre, and the accuracy is not saving it.\",\n                    \"You spent \" + timeText + \" on a performance that still lacks consistency. Slow down enough to control it, then speed up.\",\n                    \"This is what happens when neither accuracy nor pace is under control. Fix both.\"\n                ],\n                slow: [\n                    \"Too slow and too inconsistent. \" + timeText + \" is a warning, not an achievement.\",\n                    \"You took \" + timeText + \" and still produced too many weak words. That is inefficient typing.\",\n                    \"The clock was generous and the result was still rough. \" + timeText + \" needs a serious reduction.\"\n                ]\n            },\n            rough: {\n                veryFast: [\n                    \"Stop calling that speed. \" + timeText + \" means nothing when the accuracy collapses. Control yourself.\",\n                    \"You were fast and careless. \" + timeText + \" is not an excuse for that many errors.\",\n                    \"Congratulations, you reached the finish line quickly and damaged the phrase on the way there. Fix it.\"\n                ],\n                fast: [\n                    \"You finished in \" + timeText + \", but the execution was sloppy. Speed is not permission to type badly.\",\n                    \"Decent clock, poor discipline. \" + timeText + \" could have been useful if you had controlled the typing.\",\n                    \"You have enough speed. What you lack is accuracy. Stop rushing and start controlling the keyboard.\"\n                ],\n                steady: [\n                    \"Messy and only moderately paced. \" + timeText + \" is not impressive. Clean it up.\",\n                    \"You spent \" + timeText + \" producing too many errors. That is inefficient. Practice until the movement becomes automatic.\",\n                    \"Neither speed nor accuracy is carrying this round. \" + timeText + \" is simply not good enough.\"\n                ],\n                slow: [\n                    \"What the fuck was that? Too slow. Too many errors. \" + timeText + \" is unacceptable. Fix the fundamentals before you chase speed.\",\n                    \"You had \" + timeText + \" and still produced a rough result. That is not a time problem alone — it is a control problem.\",\n                    \"A long time and a poor result. \" + timeText + \" is the first number you need to destroy, but do it without adding more mistakes.\"\n                ]\n            }\n        };\n\n        const bank = attitude === \"almighty\" ? almighty : friendly;\n        const options = bank[precision][pace];\n        const closingBanks = {\n            friendly: {\n                excellent: [\n                    \"That control is worth protecting.\",\n                    \"You made the difficult part look comfortable.\",\n                    \"That is a great benchmark for your next attempt.\",\n                    \"Your rhythm looked confident from start to finish.\"\n                ],\n                good: [\n                    \"You are close to turning solid rounds into excellent ones.\",\n                    \"A cleaner rhythm could unlock the next level.\",\n                    \"There is a strong foundation here to build on.\",\n                    \"One focused adjustment could make a noticeable difference.\"\n                ],\n                mixed: [\n                    \"Aim for an even rhythm instead of forcing the pace.\",\n                    \"A calmer first few words may steady the whole attempt.\",\n                    \"Find the tempo you can control, then build from there.\",\n                    \"Consistency is the clearest next target.\"\n                ],\n                rough: [\n                    \"Reset, relax your hands, and treat the next round as a fresh start.\",\n                    \"Accuracy first will give your speed something reliable to build on.\",\n                    \"Short, deliberate practice will help more than rushing another attempt.\",\n                    \"The next round only needs to be a little cleaner than this one.\"\n                ]\n            },\n            almighty: {\n                excellent: [\n                    \"Now prove it was not a lucky round.\",\n                    \"That is the standard. Defend it.\",\n                    \"Good. Give the leaderboard something to worry about.\",\n                    \"Finally, the keyboard looked like it was in capable hands.\"\n                ],\n                good: [\n                    \"Close is not elite, so clean up the remaining weakness.\",\n                    \"There is potential here. Potential does not earn bragging rights.\",\n                    \"Decent foundation. Stop leaving easy points behind.\",\n                    \"Do it again, only sharper this time.\"\n                ],\n                mixed: [\n                    \"Pick a tempo you can actually control.\",\n                    \"The keyboard is not the problem here. Discipline is.\",\n                    \"Less panic, more precision.\",\n                    \"Get the fundamentals under control before showing off.\"\n                ],\n                rough: [\n                    \"Start with control, because chaos clearly is not working.\",\n                    \"The rematch cannot possibly be allowed to look like that.\",\n                    \"Take a breath, reset your hands, and try typing on purpose.\",\n                    \"Consider that round a warning from the keyboard.\"\n                ]\n            }\n        };\n        const base = chooseVariedComment(\n            \"round-base-\" + attitude + \"-\" + precision + \"-\" + pace,\n            options\n        );\n        const closing = chooseVariedComment(\n            \"round-closing-\" + attitude + \"-\" + precision,\n            closingBanks[attitude][precision]\n        );\n        return base + \" \" + closing;\n    }\n\n    /* =========================================================\n       NO MERCY — TIME CONSTRAINT VERDICT\n       A short line appended to the round comment specifically\n       calling out whether the player beat the countdown or not.\n    ========================================================= */\n\n    function getNoMercyTimeVerdict(elapsed, timeLimit) {\n\n        if (!timeLimit || timeLimit <= 0) return \"\";\n\n        const overtime = elapsed - timeLimit;\n\n        if (overtime <= 0) {\n            const margin = Math.abs(overtime).toFixed(1);\n            const friendlyLines = [\n                \"On top of that, you beat the No Mercy clock with \" + margin + \"s to spare.\",\n                \"And you did it within the time limit, finishing with \" + margin + \"s left on the clock.\",\n                \"You also stayed inside the No Mercy limit, closing it out \" + margin + \"s early.\"\n            ];\n            const almightyLines = [\n                \"At least the clock has nothing to complain about — \" + margin + \"s under the limit.\",\n                \"You beat the timer with \" + margin + \"s left. Now do the same with the accuracy.\",\n                \"Time constraint: respected, with \" + margin + \"s to spare. Small mercy.\"\n            ];\n            const lines = attitude === \"almighty\" ? almightyLines : friendlyLines;\n            return chooseVariedComment(\"no-mercy-under-\" + attitude, lines);\n        }\n\n        const overFormatted = overtime.toFixed(1);\n        const friendlyLines = [\n            \"One thing to work on: you went \" + overFormatted + \"s past the No Mercy limit, which cost you some score.\",\n            \"You finished the phrase, but \" + overFormatted + \"s over the time limit brought the score down.\",\n            \"The clock ran out \" + overFormatted + \"s before you did — that overtime is what dragged the score.\"\n        ];\n        const almightyLines = [\n            \"The clock beat you by \" + overFormatted + \"s. No Mercy means no mercy for the score, either.\",\n            \"You blew past the limit by \" + overFormatted + \"s. That overtime is exactly why the score took a hit.\",\n            \"Finishing \" + overFormatted + \"s late is still finishing late. Fix the pace, not just the words.\"\n        ];\n        const lines = attitude === \"almighty\" ? almightyLines : friendlyLines;\n        return chooseVariedComment(\"no-mercy-over-\" + attitude, lines);\n    }\n\n    /* =========================================================\n       NEXT / RESTART\n    ========================================================= */\n\n    function nextRound() {\n\n        if (difficulty === \"freestyle\") {\n            startFreestyle();\n            return;\n        }\n\n        if (difficulty === \"madlibs\") {\n            preparePhrase();\n            document.body.className = \"game-active\";\n            showScreen(\"gameScreen\");\n            setTimeout(function() { typingInput.focus(); }, 100);\n            return;\n        }\n\n        const available =\n            phrases[language][attitude];\n\n        if (available.length > 1) {\n\n            let nextIndex;\n\n            do {\n\n                nextIndex =\n                    Math.floor(\n                        Math.random() *\n                        available.length\n                    );\n\n            } while (\n                nextIndex === phraseIndex\n            );\n\n            phraseIndex = nextIndex;\n\n        } else {\n\n            phraseIndex = 0;\n\n        }\n\n        preparePhrase();\n\n        document.body.className =\n            \"game-active\";\n\n        showScreen(\"gameScreen\");\n\n        setTimeout(function() {\n\n            document\n                .getElementById(\"typingInput\")\n                .focus();\n\n        },100);\n\n    }\n\n    function restartGame() {\n\n        if (difficulty === \"freestyle\") { startFreestyle(); return; }\n        if (difficulty === \"madlibs\") {\n            preparePhrase();\n            document.body.className = \"game-active\";\n            showScreen(\"gameScreen\");\n            setTimeout(function() { typingInput.focus(); }, 100);\n            return;\n        }\n\n        const available =\n            phrases[language][attitude];\n\n        phraseIndex =\n            Math.floor(\n                Math.random() *\n                available.length\n            );\n\n        preparePhrase();\n\n        document.body.className =\n            \"game-active\";\n\n        showScreen(\"gameScreen\");\n\n        setTimeout(function() {\n\n            document\n                .getElementById(\"typingInput\")\n                .focus();\n\n        },100);\n\n    }\n\n    function quitGame() {\n        // Quit the current regular round and return directly to Home.\n        stopTimer();\n        stopFreestyleTimer();\n        restoreFromChaos();\n\n        started = false;\n        finished = false;\n        mistakeCount = 0;\n        correctCount = 0;\n        startTime = 0;\n\n        const input = document.getElementById(\"typingInput\");\n        if (input) {\n            input.disabled = false;\n            input.value = \"\";\n        }\n\n        const freestyleInput = document.getElementById(\"freestyleInput\");\n        if (freestyleInput) {\n            freestyleInput.disabled = false;\n            freestyleInput.value = \"\";\n        }\n\n        const endBtn = document.getElementById(\"freestyleEndBtn\");\n        if (endBtn) endBtn.style.display = \"none\";\n\n        document.body.className = \"welcome\";\n        showScreen(\"homeScreen\");\n        updateNavigation(\"home\");\n    }\n\n    function showModeScreen() {\n        stopTimer();\n        stopFreestyleTimer();\n        restoreFromChaos();\n\n        started = false;\n        finished = false;\n\n        const input = document.getElementById(\"typingInput\");\n        if (input) {\n            input.disabled = false;\n            input.value = \"\";\n        }\n\n        const freestyleEndBtn = document.getElementById(\"freestyleEndBtn\");\n        if (freestyleEndBtn) freestyleEndBtn.style.display = \"none\";\n\n        const freestyleInput = document.getElementById(\"freestyleInput\");\n        if (freestyleInput) {\n            freestyleInput.disabled = false;\n            freestyleInput.value = \"\";\n        }\n\n        const timeEl = document.getElementById(\"liveTime\");\n        const correctEl = document.getElementById(\"liveCorrect\");\n        const mistakesEl = document.getElementById(\"liveMistakes\");\n        if (timeEl) timeEl.textContent = \"0.0\";\n        if (correctEl) correctEl.textContent = \"0\";\n        if (mistakesEl) mistakesEl.textContent = \"0\";\n\n        document.body.className = \"\";\n        showScreen(\"modeScreen\");\n    }\n\n    // Undoes the temporary attitude/difficulty override Chaos modes apply,\n    // restoring whatever the player had selected before entering them.\n    function restoreFromChaos() {\n        roastBattleActive = false;\n        roastBattlePhraseIndex = null;\n        if (preRoastAttitude !== null) {\n            attitude = preRoastAttitude;\n            preRoastAttitude = null;\n        }\n        if (preRoastDifficulty !== null) {\n            difficulty = preRoastDifficulty;\n            preRoastDifficulty = null;\n        }\n    }\n\n\n    /* =========================================================\n       ROAST BATTLE (CHAOS, 2 PLAYER)\n    ========================================================= */\n\n    const roastBattleLines = [\n        \"PLAYER {n}, that performance called and it wants an apology.\",\n        \"PLAYER {n} just got outtyped and outclassed. Take the L.\",\n        \"PLAYER {n}, your keyboard has seen better days, and so have you.\",\n        \"PLAYER {n} brought a typo to a typing fight.\",\n        \"PLAYER {n}, that was not a round. That was a cry for help.\",\n        \"PLAYER {n} lost to a sentence. Let that sink in.\",\n        \"PLAYER {n}, the scoreboard isn't being mean. It's just being honest.\"\n    ];\n\n    function startRoastBattle() {\n        preRoastAttitude = attitude;\n        preRoastDifficulty = difficulty;\n\n        roastBattleActive = true;\n        roastBattlePlayer = 1;\n        roastBattleP1Result = null;\n        roastBattlePhraseIndex = null;\n\n        attitude = \"almighty\";\n        difficulty = \"medium\";\n\n        showRoastPassScreen(1);\n    }\n\n    function restartRoastBattle() {\n        roastBattlePlayer = 1;\n        roastBattleP1Result = null;\n        roastBattlePhraseIndex = null;\n        showRoastPassScreen(1);\n    }\n\n    function quitRoastBattle() {\n        stopTimer();\n        restoreFromChaos();\n        showModeScreen();\n    }\n\n    function showRoastPassScreen(playerNum) {\n        document.body.className = \"\";\n        showScreen(\"roastPassScreen\");\n\n        const tag = document.getElementById(\"roastPassPlayer\");\n        if (tag) tag.textContent = \"PLAYER \" + playerNum;\n\n        const message = document.getElementById(\"roastPassMessage\");\n        if (message) {\n            message.textContent = playerNum === 1\n                ? \"Get ready, Player 1. Same phrase rules apply — type it as fast and clean as you can.\"\n                : \"Pass the device to Player 2. Same phrase rules, same clock. No pressure.\";\n        }\n\n        const action = document.getElementById(\"roastPassAction\");\n        if (action) {\n            action.onclick = function() { beginRoastPlayerRound(playerNum); };\n        }\n    }\n\n    function beginRoastPlayerRound(playerNum) {\n        roastBattlePlayer = playerNum;\n\n        if (playerNum === 1 || roastBattlePhraseIndex === null) {\n            roastBattlePhraseIndex = getNextPhraseIndex(language, \"almighty\");\n        }\n        phraseIndex = roastBattlePhraseIndex;\n        preparePhrase();\n\n        const attitudeBadge = document.getElementById(\"gameAttitude\");\n        if (attitudeBadge) attitudeBadge.textContent = \"PLAYER \" + playerNum + \" • ROAST BATTLE\";\n\n        document.body.className = \"game-active\";\n        showScreen(\"gameScreen\");\n\n        setTimeout(function() {\n            const input = document.getElementById(\"typingInput\");\n            if (input) input.focus();\n        }, 100);\n    }\n\n    function computeRoundResult() {\n        const elapsed = started ? (Date.now() - startTime) / 1000 : 0;\n        const typedValue = typingInput.value.trim();\n        const characterErrors = editDistance(typedValue, currentPhrase);\n        const accuracyBase = Math.max(typedValue.length, currentPhrase.length);\n        const accuracy = accuracyBase > 0\n            ? Math.max(0, Math.round((accuracyBase - characterErrors) / accuracyBase * 100))\n            : 0;\n        const minutes = elapsed > 0 ? elapsed / 60 : 0;\n        const rawWpm = minutes > 0 ? Math.round((typedValue.length / 5) / minutes) : 0;\n        const wpm = Math.max(0, Math.round(rawWpm * (accuracy / 100)));\n\n        return { elapsed: elapsed, accuracy: accuracy, wpm: wpm, mistakes: characterErrors };\n    }\n\n    function finishRoastBattleTurn() {\n        if (finished) return;\n        finished = true;\n        stopTimer();\n\n        const input = document.getElementById(\"typingInput\");\n        if (input) input.disabled = true;\n\n        const result = computeRoundResult();\n\n        if (roastBattlePlayer === 1) {\n            roastBattleP1Result = result;\n            showRoastPassScreen(2);\n        } else {\n            showRoastBattleResults(roastBattleP1Result, result);\n        }\n    }\n\n    function showRoastBattleResults(p1, p2) {\n        let winner;\n        if (p1.accuracy === p2.accuracy) {\n            winner = p2.wpm > p1.wpm ? 2 : 1;\n        } else {\n            winner = p1.accuracy > p2.accuracy ? 1 : 2;\n        }\n        const loser = winner === 1 ? 2 : 1;\n        const loserResult = loser === 1 ? p1 : p2;\n\n        const winnerLabel = document.getElementById(\"roastWinnerLabel\");\n        if (winnerLabel) winnerLabel.textContent = \"PLAYER \" + winner + \" WINS\";\n\n        const p1Box = document.getElementById(\"roastP1Box\");\n        const p2Box = document.getElementById(\"roastP2Box\");\n        if (p1Box) p1Box.classList.toggle(\"winner\", winner === 1);\n        if (p2Box) p2Box.classList.toggle(\"winner\", winner === 2);\n\n        const p1ScoreEl = document.getElementById(\"roastP1Score\");\n        if (p1ScoreEl) p1ScoreEl.textContent = p1.accuracy + \"% • \" + p1.wpm + \" WPM\";\n\n        const p2ScoreEl = document.getElementById(\"roastP2Score\");\n        if (p2ScoreEl) p2ScoreEl.textContent = p2.accuracy + \"% • \" + p2.wpm + \" WPM\";\n\n        const line = roastBattleLines[Math.floor(Math.random() * roastBattleLines.length)]\n            .replace(\"{n}\", loser);\n        const commentEl = document.getElementById(\"roastComment\");\n        if (commentEl) {\n            commentEl.textContent = line + \" (\" + loserResult.accuracy + \"% accuracy, \" + loserResult.wpm + \" WPM)\";\n        }\n\n        document.body.className = \"result-active\";\n        showScreen(\"roastResultScreen\");\n    }\n\n\n    /* =========================================================\n       LANGUAGE\n    ========================================================= */\n\n    function changeLanguage(value) {\n\n        language = value;\n\n        try {\n            localStorage.setItem(\n                \"kw_language\",\n                language\n            );\n\n            localStorage.setItem(\n                \"kw_profile_name\",\n                profileName\n            );\n        } catch(error) {}\n\n        updateSettingsDisplay();\n\n    }\n\n\n    /* =========================================================\n       SETTINGS\n    ========================================================= */\n\n    function applyTheme() {\n        /* Keyboard Warrior is permanently dark mode. */\n        theme = \"dark\";\n        document.body.classList.remove(\"light-mode\");\n\n        try {\n            localStorage.setItem(\"kw_theme\", \"dark\");\n        } catch(error) {}\n    }\n\n    function setTheme() {\n        /* Kept as a compatibility function for older saved pages. */\n        theme = \"dark\";\n        applyTheme();\n        updateSettingsDisplay();\n    }\n\n    function mixAccent(hex, target, amount) {\n        const source = hex.match(/[0-9a-f]{2}/gi).map(function(part) { return parseInt(part, 16); });\n        const destination = target.match(/[0-9a-f]{2}/gi).map(function(part) { return parseInt(part, 16); });\n        return \"#\" + source.map(function(channel, index) {\n            return Math.round(channel + (destination[index] - channel) * amount)\n                .toString(16)\n                .padStart(2, \"0\");\n        }).join(\"\");\n    }\n\n    function applyAccentColor(value) {\n        document.documentElement.style.setProperty(\"--accent\", value);\n        document.documentElement.style.setProperty(\"--accent-soft\", mixAccent(value, \"#ffffff\", .24));\n        document.documentElement.style.setProperty(\"--accent-deep\", mixAccent(value, \"#000000\", .34));\n        document.documentElement.style.setProperty(\"--accent2\", mixAccent(value, \"#ffb15c\", .28));\n    }\n\n    function changeAccentColor(value) {\n        if (!/^#[0-9A-Fa-f]{6}$/.test(value)) return;\n        accentColor = value;\n        applyAccentColor(accentColor);\n        try { localStorage.setItem(\"kw_accent\", accentColor); } catch(error) {}\n        updateSettingsDisplay();\n    }\n\n    function updateSettingsDisplay() {\n\n        const attitudeText =\n            document.getElementById(\n                \"currentAttitudeText\"\n            );\n\n        const difficultyText =\n            document.getElementById(\n                \"currentDifficultyText\"\n            );\n\n        if (attitudeText) {\n\n            attitudeText.textContent =\n                attitude === \"friendly\"\n                    ? \"Friendly\"\n                    : \"Almighty\";\n\n        }\n\n        if (difficultyText) {\n\n            if (difficulty === \"easy\") {\n                difficultyText.textContent =\n                    \"Easy\";\n            }\n\n            if (difficulty === \"medium\") {\n                difficultyText.textContent =\n                    \"Medium\";\n            }\n\n            if (difficulty === \"nomercy\") {\n                difficultyText.textContent =\n                    \"No Mercy\";\n            }\n\n            if (difficulty === \"freestyle\") {\n                difficultyText.textContent =\n                    \"Freestyle\";\n            }\n\n            if (difficulty === \"madlibs\") difficultyText.textContent = \"Mad Libs\";\n            if (difficulty === \"reverse\") difficultyText.textContent = \"Reverse Typer\";\n\n        }\n\n        const languageSelect =\n            document.getElementById(\n                \"languageSelect\"\n            );\n\n        if (languageSelect) {\n            languageSelect.value =\n                language;\n        }\n\n        const accentPicker = document.getElementById(\"accentColorPicker\");\n        const accentValue = document.getElementById(\"accentColorValue\");\n        const appVersion = document.getElementById(\"appVersion\");\n\n        if (accentPicker) accentPicker.value = accentColor;\n        if (accentValue) accentValue.textContent = accentColor.toUpperCase();\n        if (appVersion) appVersion.textContent = \"v\" + APP_VERSION;\n\n    }\n\n\n\n    function saveProfileName() {\n\n        const input = document.getElementById(\"profileNameInput\");\n        if (!input) return;\n\n        const cleaned = input.value\n            .replace(/\\s+/g, \" \")\n            .trim()\n            .slice(0, 24);\n\n        profileName = cleaned || \"YOUR NAME\";\n\n        try {\n            localStorage.setItem(\"kw_profile_name\", profileName);\n        } catch(error) {}\n\n        updateProfileDisplay();\n        updateSharePreview();\n\n        input.value = profileName === \"YOUR NAME\" ? \"\" : profileName;\n    }\n\n    function chooseProfileAvatar() {\n        const overlay = document.getElementById(\"avatarPickerOverlay\");\n        if (overlay) overlay.classList.add(\"show\");\n    }\n\n    function closeAvatarPicker() {\n        const overlay = document.getElementById(\"avatarPickerOverlay\");\n        if (overlay) overlay.classList.remove(\"show\");\n    }\n\n    function chooseCustomAvatar() {\n        closeAvatarPicker();\n        const input = document.getElementById(\"profileAvatarInput\");\n        if (input) input.click();\n    }\n\n    function selectPresetAvatar(symbol, colorA, colorB) {\n        const canvas = document.createElement(\"canvas\");\n        canvas.width = 256;\n        canvas.height = 256;\n        const context = canvas.getContext(\"2d\");\n        const gradient = context.createLinearGradient(0, 0, 256, 256);\n        gradient.addColorStop(0, colorA);\n        gradient.addColorStop(1, colorB);\n        context.fillStyle = gradient;\n        context.fillRect(0, 0, 256, 256);\n        context.fillStyle = \"rgba(255,255,255,.13)\";\n        context.beginPath();\n        context.arc(205, 45, 85, 0, Math.PI * 2);\n        context.fill();\n        context.textAlign = \"center\";\n        context.textBaseline = \"middle\";\n        context.font = \"145px 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif\";\n        context.fillText(symbol, 128, 137);\n        profileAvatarData = canvas.toDataURL(\"image/png\");\n        try { localStorage.setItem(\"kw_profile_avatar\", profileAvatarData); } catch(error) {}\n        closeAvatarPicker();\n        updateProfileDisplay();\n        updateSharePreview();\n    }\n\n    function saveProfileAvatar(file) {\n        if (!file || !/^image\\/(png|jpeg|webp)$/.test(file.type)) return;\n\n        const reader = new FileReader();\n        reader.onload = function() {\n            const image = new Image();\n            image.onload = function() {\n                const size = 256;\n                const canvas = document.createElement(\"canvas\");\n                const context = canvas.getContext(\"2d\");\n                canvas.width = size;\n                canvas.height = size;\n\n                const sourceSize = Math.min(image.naturalWidth, image.naturalHeight);\n                const sourceX = (image.naturalWidth - sourceSize) / 2;\n                const sourceY = (image.naturalHeight - sourceSize) / 2;\n                context.drawImage(image, sourceX, sourceY, sourceSize, sourceSize, 0, 0, size, size);\n\n                profileAvatarData = canvas.toDataURL(\"image/webp\", .86);\n                try { localStorage.setItem(\"kw_profile_avatar\", profileAvatarData); } catch(error) {}\n                updateProfileDisplay();\n                updateSharePreview();\n\n                const input = document.getElementById(\"profileAvatarInput\");\n                if (input) input.value = \"\";\n            };\n            image.src = reader.result;\n        };\n        reader.readAsDataURL(file);\n    }\n\n    function resetProfileAvatar() {\n        profileAvatarData = \"\";\n        try { localStorage.removeItem(\"kw_profile_avatar\"); } catch(error) {}\n        updateProfileDisplay();\n        updateSharePreview();\n    }\n\n    function updateProfileDisplay() {\n\n        const nameEl = document.getElementById(\"profileNameDisplay\");\n        const rankEl = document.getElementById(\"profileRankText\");\n        const input = document.getElementById(\"profileNameInput\");\n        const avatarButton = document.getElementById(\"profileAvatarButton\");\n        const avatarImage = document.getElementById(\"profileAvatarImage\");\n        const avatarReset = document.getElementById(\"avatarResetButton\");\n\n        if (nameEl) {\n            nameEl.textContent = profileName || \"YOUR NAME\";\n        }\n\n        if (rankEl) {\n            rankEl.textContent = getWarriorRank();\n        }\n\n        if (input && document.activeElement !== input) {\n            input.value =\n                profileName === \"YOUR NAME\"\n                    ? \"\"\n                    : profileName;\n        }\n\n        if (avatarButton && avatarImage) {\n            avatarButton.classList.toggle(\"has-image\", Boolean(profileAvatarData));\n            avatarImage.src = profileAvatarData || \"\";\n        }\n\n        if (avatarReset) avatarReset.classList.toggle(\"show\", Boolean(profileAvatarData));\n\n    }\n\n\n    /* =========================================================\n       STORAGE\n    ========================================================= */\n\n    function saveStats() {\n\n        try {\n\n            localStorage.setItem(\n                \"kw_rounds\",\n                String(roundsPlayed)\n            );\n\n            localStorage.setItem(\n                \"kw_best_accuracy\",\n                String(bestAccuracy)\n            );\n\n            localStorage.setItem(\n                \"kw_best_wpm\",\n                String(bestWpm)\n            );\n\n            localStorage.setItem(\n                \"kw_total_mistakes\",\n                String(totalMistakes)\n            );\n\n            localStorage.setItem(\n                \"kw_total_accuracy\",\n                String(totalAccuracy)\n            );\n\n            localStorage.setItem(\n                \"kw_mode_stats\",\n                JSON.stringify(modeStats)\n            );\n\n            localStorage.setItem(\n                \"kw_best_combo\",\n                String(bestComboEver)\n            );\n\n            localStorage.setItem(\n                \"kw_language_stats\",\n                JSON.stringify(languageStats)\n            );\n\n            localStorage.setItem(\n                \"kw_language\",\n                language\n            );\n\n            localStorage.setItem(\"kw_theme\", \"dark\");\n\n            localStorage.setItem(\n                \"kw_accent\",\n                accentColor\n            );\n\n        } catch(error) {}\n\n    }\n\n    function loadStats() {\n\n        try {\n\n            roundsPlayed =\n                parseInt(\n                    localStorage.getItem(\n                        \"kw_rounds\"\n                    )\n                ) || 0;\n\n            bestAccuracy =\n                parseInt(\n                    localStorage.getItem(\n                        \"kw_best_accuracy\"\n                    )\n                ) || 0;\n\n            bestWpm =\n                parseInt(\n                    localStorage.getItem(\n                        \"kw_best_wpm\"\n                    )\n                ) || 0;\n\n            totalMistakes =\n                parseInt(\n                    localStorage.getItem(\n                        \"kw_total_mistakes\"\n                    )\n                ) || 0;\n\n            const savedTotalAccuracy =\n                localStorage.getItem(\n                    \"kw_total_accuracy\"\n                );\n\n            // Older saves won't have kw_total_accuracy yet. Back-fill a\n            // reasonable estimate from bestAccuracy so returning players\n            // aren't dropped straight to the bottom rank.\n            totalAccuracy =\n                savedTotalAccuracy !== null\n                    ? (parseInt(savedTotalAccuracy) || 0)\n                    : bestAccuracy * roundsPlayed;\n\n            const savedModeStats =\n                localStorage.getItem(\n                    \"kw_mode_stats\"\n                );\n\n            if (savedModeStats) {\n\n                const parsed =\n                    JSON.parse(savedModeStats);\n\n                const savedLanguageForMigration = localStorage.getItem(\"kw_language\") === \"filipino\"\n                    ? \"filipino\"\n                    : \"english\";\n\n                Object.keys(parsed).forEach(function(key) {\n                    const migratedKey = /^(english|filipino)_/.test(key)\n                        ? key\n                        : savedLanguageForMigration + \"_\" + key;\n                    modeStats[migratedKey] = {\n                        ...createDefaultModeStats(),\n                        ...parsed[key]\n                    };\n                });\n\n            }\n\n            bestComboEver =\n                parseInt(\n                    localStorage.getItem(\"kw_best_combo\")\n                ) || 0;\n\n            const savedLanguageStats = localStorage.getItem(\"kw_language_stats\");\n            if (savedLanguageStats) {\n                const parsedLanguageStats = JSON.parse(savedLanguageStats);\n                [\"english\", \"filipino\"].forEach(function(lang) {\n                    if (parsedLanguageStats[lang]) {\n                        languageStats[lang] = {\n                            ...createDefaultLanguageStats(),\n                            ...parsedLanguageStats[lang]\n                        };\n                    }\n                });\n            } else if (roundsPlayed > 0) {\n                const migrationLanguage = localStorage.getItem(\"kw_language\") === \"filipino\"\n                    ? \"filipino\"\n                    : \"english\";\n                languageStats[migrationLanguage] = {\n                    ...createDefaultLanguageStats(),\n                    rounds: roundsPlayed,\n                    bestAccuracy: bestAccuracy,\n                    bestWpm: bestWpm,\n                    totalMistakes: totalMistakes,\n                    totalAccuracy: totalAccuracy\n                };\n            }\n\n            const savedProfileName =\n                localStorage.getItem(\n                    \"kw_profile_name\"\n                );\n\n            if (savedProfileName) {\n                profileName =\n                    savedProfileName\n                        .replace(/\\s+/g, \" \")\n                        .trim()\n                        .slice(0, 24) || \"YOUR NAME\";\n            }\n\n            const savedProfileAvatar = localStorage.getItem(\"kw_profile_avatar\");\n            if (savedProfileAvatar && /^data:image\\/(webp|png|jpeg);base64,/.test(savedProfileAvatar)) {\n                profileAvatarData = savedProfileAvatar;\n            }\n\n            const savedLanguage =\n                localStorage.getItem(\n                    \"kw_language\"\n                );\n\n            if (\n                savedLanguage === \"english\" ||\n                savedLanguage === \"filipino\"\n            ) {\n                language =\n                    savedLanguage;\n            }\n\n            /* Appearance is permanently dark. */\n            theme = \"dark\";\n\n            const savedAccent = localStorage.getItem(\"kw_accent\");\n            if (savedAccent && /^#[0-9A-Fa-f]{6}$/.test(savedAccent)) {\n                accentColor = savedAccent;\n            }\n\n        } catch(error) {}\n\n    }\n\n\n    /* =========================================================\n       STATS DISPLAY\n    ========================================================= */\n\n    function formatModeName(mode,level) {\n\n        const attitudeName =\n            mode === \"friendly\"\n                ? \"Friendly\"\n                : \"Almighty\";\n\n        let difficultyName;\n\n        if (level === \"easy\") {\n            difficultyName = \"Easy\";\n        } else if (level === \"medium\") {\n            difficultyName = \"Medium\";\n        } else if (level === \"nomercy\") {\n            difficultyName = \"No Mercy\";\n        } else if (level === \"suddendeath\") {\n            difficultyName = \"Sudden Death\";\n        } else if (level === \"combo\") {\n            difficultyName = \"Combo\";\n        } else if (level === \"curse\") {\n            difficultyName = \"Curse Mode\";\n        } else if (level === \"madlibs\") {\n            difficultyName = \"Mad Libs\";\n        } else if (level === \"reverse\") {\n            difficultyName = \"Reverse Typer\";\n        } else {\n            difficultyName = level;\n        }\n\n        return (\n            attitudeName +\n            \" — \" +\n            difficultyName\n        );\n\n    }\n\n    function createModeStatsCard(lang,mode,level) {\n\n        const key = getModeStatsKey(lang, mode, level);\n\n        const data =\n            modeStats[key] ||\n            createDefaultModeStats();\n\n        const averageTime =\n            data.rounds > 0\n                ? (\n                    data.totalTime /\n                    data.rounds\n                ).toFixed(1) + \"s\"\n                : \"0.0s\";\n        const bestModeScore = level === \"nomercy\"\n            ? (data.bestRankedScore || 0)\n            : data.bestAccuracy;\n\n        return `\n\n            <div class=\"mode-stat-card\">\n\n                <div class=\"mode-stat-header\">\n\n                    <strong>\n                        ${formatModeName(mode,level)}\n                    </strong>\n\n                    <span>\n                        ${data.rounds} rounds\n                    </span>\n\n                </div>\n\n                <div class=\"mode-stat-grid\">\n\n                    <div class=\"mode-stat-value\">\n                        <strong>\n                            ${bestModeScore}%\n                        </strong>\n                        <span>${level === \"nomercy\" ? \"BEST RANKED SCORE\" : \"BEST ACCURACY\"}</span>\n                    </div>\n\n                    <div class=\"mode-stat-value\">\n                        <strong>\n                            ${data.bestWpm}\n                        </strong>\n                        <span>BEST WPM</span>\n                    </div>\n\n                    <div class=\"mode-stat-value\">\n                        <strong>\n                            ${data.totalMistakes}\n                        </strong>\n                        <span>CHARACTER ERRORS</span>\n                    </div>\n\n                </div>\n\n                <div\n                    class=\"muted\"\n                    style=\"font-size:11px;margin-top:10px;\">\n                    Average time: ${averageTime}\n                </div>\n\n            </div>\n        `;\n\n    }\n\n    function createLanguageStatsCard(lang) {\n        const data = languageStats[lang] || createDefaultLanguageStats();\n        const averageAccuracy = data.rounds > 0\n            ? Math.round(data.totalAccuracy / data.rounds) + \"%\"\n            : \"0%\";\n        const averageTime = data.rounds > 0\n            ? (data.totalTime / data.rounds).toFixed(1) + \"s\"\n            : \"0.0s\";\n        const title = lang === \"english\" ? \"English\" : \"Filipino\";\n\n        return `\n            <div class=\"mode-stat-card\">\n                <div class=\"mode-stat-header\"><strong>${title}</strong><span>${data.rounds} rounds</span></div>\n                <div class=\"mode-stat-grid\">\n                    <div class=\"mode-stat-value\"><strong>${data.bestAccuracy}%</strong><span>BEST SCORE</span></div>\n                    <div class=\"mode-stat-value\"><strong>${data.bestWpm}</strong><span>BEST WPM</span></div>\n                    <div class=\"mode-stat-value\"><strong>${averageAccuracy}</strong><span>AVG ACCURACY</span></div>\n                </div>\n                <div class=\"muted language-stat-foot\">${data.totalMistakes} errors &middot; ${averageTime} average round</div>\n            </div>`;\n    }\n\n    function createModeStatsRow(lang, mode, level) {\n        const data = modeStats[getModeStatsKey(lang, mode, level)] || createDefaultModeStats();\n        const averageTime = data.rounds > 0 ? (data.totalTime / data.rounds).toFixed(1) + \"s\" : \"—\";\n        const bestModeScore = level === \"nomercy\"\n            ? (data.bestRankedScore || 0)\n            : data.bestAccuracy;\n        const shortName = formatModeName(mode, level).split(\" — \")[1] || level;\n        return `\n            <div class=\"mode-table-row\">\n                <div class=\"mode-row-name\"><strong>${shortName}</strong><small>${data.rounds ? \"PLAYED\" : \"NO ROUNDS YET\"}</small></div>\n                <div class=\"mode-row-metric\"><strong>${data.rounds}</strong><small>${averageTime} AVG</small></div>\n                <div class=\"mode-row-metric\"><strong>${bestModeScore}%</strong><small>SCORE</small></div>\n                <div class=\"mode-row-metric\"><strong>${data.bestWpm}</strong><small>WPM · ${data.totalMistakes} ERR</small></div>\n            </div>`;\n    }\n\n    function createAttitudeModeGroup(lang, mode) {\n        const title = mode === \"friendly\" ? \"Friendly\" : \"Almighty\";\n        const levels = [\"easy\", \"medium\", \"nomercy\", \"suddendeath\", \"combo\", \"curse\", \"madlibs\", \"reverse\"];\n        const playedLevels = levels.filter(function(level) {\n            const data = modeStats[getModeStatsKey(lang, mode, level)] || createDefaultModeStats();\n            return data.rounds > 0;\n        });\n        return `\n            <div class=\"mode-group-title\">${title}</div>\n            ${playedLevels.length\n                ? `<div class=\"mode-column-head\"><span>MODE</span><span>ROUNDS</span><span>BEST</span><span>SPEED</span></div>` +\n                    playedLevels.map(function(level) { return createModeStatsRow(lang, mode, level); }).join(\"\")\n                : `<div class=\"mode-empty\">No ${title.toLowerCase()} rounds recorded.</div>`}`;\n    }\n\n    function createLanguageModeDetails(lang) {\n        const title = lang === \"english\" ? \"English modes\" : \"Filipino modes\";\n        const modeRounds = Object.keys(modeStats).reduce(function(total, key) {\n            return key.indexOf(lang + \"_\") === 0 ? total + (modeStats[key].rounds || 0) : total;\n        }, 0);\n        return `\n            <details class=\"mode-details\">\n                <summary><span class=\"mode-summary-title\">${title}<span class=\"mode-summary-count\">${modeRounds} rounds</span></span></summary>\n                <div class=\"mode-table\">\n                    ${createAttitudeModeGroup(lang, \"friendly\")}\n                    ${createAttitudeModeGroup(lang, \"almighty\")}\n                </div>\n            </details>`;\n    }\n\n    function updateStatsDisplay() {\n\n        updateProfileDisplay();\n\n        document.getElementById(\"totalRounds\")\n            .textContent = roundsPlayed;\n\n        document.getElementById(\"bestAccuracy\")\n            .textContent =\n                bestAccuracy + \"%\";\n\n        document.getElementById(\"bestWpm\")\n            .textContent = bestWpm;\n\n        document.getElementById(\"totalMistakes\")\n            .textContent = totalMistakes;\n\n        document.getElementById(\"languageStatsContainer\").innerHTML =\n            createLanguageStatsCard(\"english\") + createLanguageStatsCard(\"filipino\");\n\n        document.getElementById(\"modeStatsContainer\").innerHTML =\n            createLanguageModeDetails(\"english\") +\n            createLanguageModeDetails(\"filipino\");\n\n        updateSharePreview();\n\n    }\n\n\n    /* =========================================================\n       PROFILE CARD RANK\n    ========================================================= */\n\n    function getAverageAccuracy() {\n        return roundsPlayed > 0\n            ? totalAccuracy / roundsPlayed\n            : 0;\n    }\n\n    /*\n     * Single source of truth for rank requirements, ordered from\n     * highest to lowest. Used by getWarriorRank() AND by the rank\n     * info popup, so the two can never drift out of sync.\n     */\n    const RANK_TIERS = [\n        { name: \"KEYBOARD OVERLORD\",         rounds: 30, accuracy: 90 },\n        { name: \"INTERNET MENACE\",           rounds: 20, accuracy: 80 },\n        { name: \"COMMENT SECTION CHAMPION\",  rounds: 12, accuracy: 70 },\n        { name: \"CERTIFIED KEYBOARD WARRIOR\",rounds: 6,  accuracy: 60 },\n        { name: \"COMMENT SECTION WARRIOR\",   rounds: 3,  accuracy: 45 }\n    ];\n\n    /*\n     * Rank now rewards volume AND consistency, not a single lucky\n     * best-ever round: it takes both enough rounds played and a\n     * high enough average recorded score across all of them.\n     */\n    function getWarriorRank() {\n\n        if (roundsPlayed === 0) {\n            return \"UNTESTED WARRIOR\";\n        }\n\n        const avgAccuracy = getAverageAccuracy();\n\n        for (let i = 0; i < RANK_TIERS.length; i++) {\n            const tier = RANK_TIERS[i];\n            if (roundsPlayed >= tier.rounds && avgAccuracy >= tier.accuracy) {\n                return tier.name;\n            }\n        }\n\n        return \"KEYBOARD ROOKIE\";\n\n    }\n\n\n    /* =========================================================\n       RANK SYSTEM INFO POPUP\n    ========================================================= */\n\n    function openRankInfo() {\n        renderRankInfo();\n        const overlay = document.getElementById(\"rankInfoOverlay\");\n        if (overlay) overlay.classList.add(\"show\");\n    }\n\n    function closeRankInfo() {\n        const overlay = document.getElementById(\"rankInfoOverlay\");\n        if (overlay) overlay.classList.remove(\"show\");\n    }\n\n    function openResetDataDialog() {\n        const overlay = document.getElementById(\"resetDataOverlay\");\n        if (overlay) overlay.classList.add(\"show\");\n    }\n\n    function closeResetDataDialog() {\n        const overlay = document.getElementById(\"resetDataOverlay\");\n        if (overlay) overlay.classList.remove(\"show\");\n    }\n\n    function confirmResetAllData() {\n        try {\n            Object.keys(localStorage).forEach(function(key) {\n                if (key.indexOf(\"kw_\") === 0) localStorage.removeItem(key);\n            });\n        } catch(error) {}\n\n        window.location.reload();\n    }\n\n    function renderRankInfo() {\n\n        const avgAccuracy = getAverageAccuracy();\n        const currentRank = getWarriorRank();\n\n        // Progress note: how far from the next rank up.\n        const progressEl = document.getElementById(\"rankInfoProgress\");\n        if (progressEl) {\n\n            let nextTier = null;\n\n            if (currentRank === \"KEYBOARD OVERLORD\") {\n                nextTier = null;\n            } else if (currentRank === \"UNTESTED WARRIOR\" || currentRank === \"KEYBOARD ROOKIE\") {\n                nextTier = RANK_TIERS[RANK_TIERS.length - 1];\n            } else {\n                const idx = RANK_TIERS.findIndex(function(t) { return t.name === currentRank; });\n                nextTier = idx > 0 ? RANK_TIERS[idx - 1] : null;\n            }\n\n            if (roundsPlayed === 0) {\n                progressEl.textContent =\n                    \"Play your first round to start ranking up.\";\n            } else if (!nextTier) {\n                progressEl.textContent =\n                    \"You've hit the top rank: KEYBOARD OVERLORD. Keep your average score up to hold it.\";\n            } else {\n                const roundsNeeded = Math.max(0, nextTier.rounds - roundsPlayed);\n                const accuracyNeeded = Math.max(0, nextTier.accuracy - avgAccuracy);\n\n                const needs = [];\n                if (roundsNeeded > 0) {\n                    needs.push(roundsNeeded + \" more round\" + (roundsNeeded === 1 ? \"\" : \"s\"));\n                }\n                if (accuracyNeeded > 0.5) {\n                    needs.push(accuracyNeeded.toFixed(0) + \"% more average score\");\n                }\n\n                progressEl.textContent = needs.length\n                    ? \"Next rank: \" + nextTier.name + \" — need \" + needs.join(\" and \") + \".\"\n                    : \"Next rank: \" + nextTier.name + \" — you qualify. Play one more round to lock it in.\";\n            }\n        }\n\n        // Full rank ladder, highest to lowest.\n        const listEl = document.getElementById(\"rankInfoList\");\n        if (!listEl) return;\n\n        let html = \"\";\n\n        RANK_TIERS.forEach(function(tier) {\n            const isCurrent = tier.name === currentRank;\n            html +=\n                '<div class=\"rank-row' + (isCurrent ? ' current' : '') + '\">' +\n                    '<div class=\"rank-row-top\">' +\n                        '<span class=\"rank-row-name\">' + tier.name + '</span>' +\n                        (isCurrent ? '<span class=\"rank-row-tag\">YOUR RANK</span>' : '') +\n                    '</div>' +\n                    '<div class=\"rank-row-req\">' +\n                        tier.rounds + '+ rounds played &middot; ' + tier.accuracy + '%+ average score' +\n                    '</div>' +\n                '</div>';\n        });\n\n        const rookieCurrent = currentRank === \"KEYBOARD ROOKIE\" || currentRank === \"UNTESTED WARRIOR\";\n        html +=\n            '<div class=\"rank-row' + (rookieCurrent ? ' current' : '') + '\">' +\n                '<div class=\"rank-row-top\">' +\n                    '<span class=\"rank-row-name\">KEYBOARD ROOKIE</span>' +\n                    (rookieCurrent ? '<span class=\"rank-row-tag\">YOUR RANK</span>' : '') +\n                '</div>' +\n                '<div class=\"rank-row-req\">Starting rank for every warrior.</div>' +\n            '</div>';\n\n        listEl.innerHTML = html;\n    }\n\n\n    /* =========================================================\n       PROFILE CARD COMMENT\n    ========================================================= */\n\n    function getProfileComment() {\n\n        if (roundsPlayed === 0) {\n\n            return \"No battles completed yet. Enter the battlefield.\";\n\n        }\n\n        if (\n            bestAccuracy >= 98 &&\n            bestWpm >= 80\n        ) {\n\n            return attitude === \"almighty\"\n                ? \"Absolutely disgusting typing speed. The comment section is not ready.\"\n                : \"Outstanding typing. Your keyboard is extremely proud.\";\n\n        }\n\n        if (bestAccuracy >= 95) {\n\n            return attitude === \"almighty\"\n                ? \"Almost flawless. Unfortunately, I still found something to complain about.\"\n                : \"Excellent accuracy. Keep sharpening those fingers.\";\n\n        }\n\n        if (bestAccuracy >= 80) {\n\n            return attitude === \"almighty\"\n                ? \"Acceptable performance. You may continue your keyboard warfare.\"\n                : \"Solid performance. A little more practice and you will be even faster.\";\n\n        }\n\n        if (bestAccuracy >= 60) {\n\n            return attitude === \"almighty\"\n                ? \"Your keyboard has filed a formal complaint.\"\n                : \"You survived. Keep practicing and you will improve.\";\n\n        }\n\n        return attitude === \"almighty\"\n            ? \"That was not typing. That was keyboard vandalism.\"\n            : \"Everyone starts somewhere. Keep typing and improve.\";\n\n    }\n\n\n    /* =========================================================\n       SHARE TEXT PREVIEW\n    ========================================================= */\n\n    function generateShareText() {\n\n        return (\n            \"KEYBOARD WARRIOR SIMULATOR\\n\\n\" +\n            \"PLAYER: \" + profileName + \"\\n\" +\n            getWarriorRank() +\n            \"\\n\" +\n            attitude.toUpperCase() +\n            \" • \" +\n            difficulty.toUpperCase() +\n            \"\\n\\n\" +\n            \"BEST SCORE: \" +\n            bestAccuracy +\n            \"%\\n\" +\n            \"BEST WPM: \" +\n            bestWpm +\n            \"\\n\" +\n            \"ROUNDS: \" +\n            roundsPlayed +\n            \"\\n\" +\n            \"CHARACTER ERRORS: \" +\n            totalMistakes +\n            \"\\n\\n\" +\n            getProfileComment()\n        );\n\n    }\n\n    function updateSharePreview() {\n\n        const preview =\n            document.getElementById(\n                \"sharePreview\"\n            );\n\n        if (preview) {\n            preview.textContent =\n                generateShareText();\n        }\n\n    }\n\n\n\n    /* =========================================================\n       CANVAS PROFILE CARD\n    ========================================================= */\n\n    function roundRect(\n        ctx,\n        x,\n        y,\n        width,\n        height,\n        radius\n    ) {\n\n        const r =\n            Math.min(\n                radius,\n                width / 2,\n                height / 2\n            );\n\n        ctx.beginPath();\n\n        ctx.moveTo(\n            x + r,\n            y\n        );\n\n        ctx.arcTo(\n            x + width,\n            y,\n            x + width,\n            y + height,\n            r\n        );\n\n        ctx.arcTo(\n            x + width,\n            y + height,\n            x,\n            y + height,\n            r\n        );\n\n        ctx.arcTo(\n            x,\n            y + height,\n            x,\n            y,\n            r\n        );\n\n        ctx.arcTo(\n            x,\n            y,\n            x + width,\n            y,\n            r\n        );\n\n        ctx.closePath();\n\n    }\n\n\n    function drawKeyboardKey(\n        ctx,\n        x,\n        y,\n        width,\n        height,\n        label\n    ) {\n\n        ctx.fillStyle =\n            \"rgba(255,255,255,.07)\";\n\n        roundRect(\n            ctx,\n            x,\n            y,\n            width,\n            height,\n            7\n        );\n\n        ctx.fill();\n\n        ctx.strokeStyle =\n            \"rgba(255,255,255,.13)\";\n\n        ctx.lineWidth = 1;\n\n        ctx.stroke();\n\n        ctx.fillStyle =\n            \"rgba(255,255,255,.55)\";\n\n        ctx.font =\n            \"bold 11px Arial\";\n\n        ctx.textAlign =\n            \"center\";\n\n        ctx.textBaseline =\n            \"middle\";\n\n        ctx.fillText(\n            label,\n            x + width / 2,\n            y + height / 2\n        );\n\n    }\n\n\n    function wrapCanvasText(\n        ctx,\n        text,\n        maxWidth\n    ) {\n\n        const words =\n            text.split(\" \");\n\n        const lines = [];\n        let line = \"\";\n\n        for (\n            let i = 0;\n            i < words.length;\n            i++\n        ) {\n\n            const test =\n                line\n                    ? line + \" \" + words[i]\n                    : words[i];\n\n            if (\n                ctx.measureText(test).width >\n                    maxWidth &&\n                line\n            ) {\n\n                lines.push(line);\n\n                line =\n                    words[i];\n\n            } else {\n\n                line =\n                    test;\n\n            }\n\n        }\n\n        if (line) {\n            lines.push(line);\n        }\n\n        return lines;\n\n    }\n\n\n    function getModeColor() {\n\n        if (attitude === \"almighty\") {\n            return \"#ff4d6d\";\n        }\n\n        return \"#42d392\";\n\n    }\n\n\n    function createProfileCard() {\n        const canvas = document.createElement(\"canvas\");\n        const width = 1080;\n        const height = 1350;\n        canvas.width = width;\n        canvas.height = height;\n\n        const ctx = canvas.getContext(\"2d\");\n        const accent = /^#[0-9A-Fa-f]{6}$/.test(accentColor) ? accentColor : \"#ff4d6d\";\n        const white = \"#f8f9fc\";\n        const muted = \"#9299aa\";\n        const panel = \"rgba(255,255,255,.055)\";\n        const border = \"rgba(255,255,255,.105)\";\n        const english = languageStats.english || createDefaultLanguageStats();\n        const filipino = languageStats.filipino || createDefaultLanguageStats();\n        const activeLanguage = language === \"filipino\" ? filipino : english;\n        const activeMode = modeStats[getModeStatsKey(language, attitude, difficulty)] || createDefaultModeStats();\n        const activeModeBest = difficulty === \"nomercy\"\n            ? (activeMode.bestRankedScore || 0)\n            : activeMode.bestAccuracy;\n\n        function panelRect(x, y, w, h, radius) {\n            ctx.fillStyle = panel;\n            roundRect(ctx, x, y, w, h, radius);\n            ctx.fill();\n            ctx.strokeStyle = border;\n            ctx.lineWidth = 2;\n            ctx.stroke();\n        }\n\n        function fitText(text, maxWidth, startSize, weight) {\n            let size = startSize;\n            do {\n                ctx.font = (weight || 900) + \" \" + size + \"px Arial\";\n                if (ctx.measureText(text).width <= maxWidth) return size;\n                size -= 2;\n            } while (size > 22);\n            return size;\n        }\n\n        function label(text, x, y) {\n            ctx.fillStyle = muted;\n            ctx.font = \"800 17px Arial\";\n            ctx.letterSpacing = \"1px\";\n            ctx.fillText(text, x, y);\n        }\n\n        function value(text, x, y, size, color) {\n            ctx.fillStyle = color || white;\n            ctx.font = \"900 \" + size + \"px Arial\";\n            ctx.fillText(String(text), x, y);\n        }\n\n        /* BACKGROUND */\n        const bg = ctx.createLinearGradient(0, 0, width, height);\n        bg.addColorStop(0, \"#090b10\");\n        bg.addColorStop(.55, \"#12151d\");\n        bg.addColorStop(1, \"#0b0d12\");\n        ctx.fillStyle = bg;\n        ctx.fillRect(0, 0, width, height);\n\n        const glowA = ctx.createRadialGradient(920, 80, 0, 920, 80, 520);\n        glowA.addColorStop(0, accent + \"66\");\n        glowA.addColorStop(1, \"transparent\");\n        ctx.fillStyle = glowA;\n        ctx.fillRect(360, 0, 720, 620);\n\n        const glowB = ctx.createRadialGradient(30, 1130, 0, 30, 1130, 420);\n        glowB.addColorStop(0, accent + \"28\");\n        glowB.addColorStop(1, \"transparent\");\n        ctx.fillStyle = glowB;\n        ctx.fillRect(0, 700, 520, 650);\n\n        ctx.fillStyle = \"rgba(255,255,255,.022)\";\n        for (let x = 30; x < width; x += 40) {\n            for (let y = 30; y < height; y += 40) ctx.fillRect(x, y, 2, 2);\n        }\n\n        /* BRAND HEADER */\n        const avatarSource = document.getElementById(\"profileAvatarImage\");\n        if (profileAvatarData && avatarSource && avatarSource.complete && avatarSource.naturalWidth) {\n            ctx.save();\n            roundRect(ctx, 60, 58, 112, 112, 30);\n            ctx.clip();\n            ctx.drawImage(avatarSource, 60, 58, 112, 112);\n            ctx.restore();\n            ctx.strokeStyle = accent;\n            ctx.lineWidth = 5;\n            roundRect(ctx, 60, 58, 112, 112, 30);\n            ctx.stroke();\n        } else {\n            const brandGradient = ctx.createLinearGradient(58, 58, 170, 170);\n            brandGradient.addColorStop(0, accent);\n            brandGradient.addColorStop(1, \"#ff7a59\");\n            ctx.fillStyle = brandGradient;\n            roundRect(ctx, 60, 58, 112, 112, 30);\n            ctx.fill();\n            ctx.fillStyle = white;\n            ctx.textAlign = \"center\";\n            ctx.textBaseline = \"middle\";\n            ctx.font = \"1000 37px Arial\";\n            ctx.fillText(\"KW\", 116, 116);\n        }\n\n        ctx.textAlign = \"left\";\n        ctx.textBaseline = \"alphabetic\";\n        ctx.fillStyle = white;\n        ctx.font = \"1000 39px Arial\";\n        ctx.fillText(\"KEYBOARD WARRIOR\", 205, 102);\n        ctx.fillStyle = muted;\n        ctx.font = \"800 18px Arial\";\n        ctx.fillText(\"PLAYER CARD  •  TYPE FAST. ARGUE RESPONSIBLY.\", 207, 137);\n\n        ctx.fillStyle = accent + \"24\";\n        roundRect(ctx, 825, 84, 195, 48, 24);\n        ctx.fill();\n        ctx.strokeStyle = accent + \"88\";\n        ctx.stroke();\n        ctx.textAlign = \"center\";\n        ctx.fillStyle = accent;\n        ctx.font = \"900 17px Arial\";\n        ctx.fillText(language === \"filipino\" ? \"FILIPINO\" : \"ENGLISH\", 922, 115);\n        ctx.textAlign = \"left\";\n\n        /* PLAYER + RANK HERO */\n        panelRect(60, 202, 960, 245, 30);\n        label(\"WARRIOR IDENTITY\", 95, 247);\n        const safeName = profileName || \"YOUR NAME\";\n        fitText(safeName, 650, 58, 1000);\n        ctx.fillStyle = white;\n        ctx.fillText(safeName, 95, 314);\n\n        ctx.fillStyle = accent;\n        fitText(getWarriorRank(), 680, 34, 900);\n        ctx.fillText(getWarriorRank(), 95, 370);\n\n        ctx.fillStyle = \"rgba(255,255,255,.07)\";\n        roundRect(ctx, 760, 245, 210, 150, 26);\n        ctx.fill();\n        ctx.textAlign = \"center\";\n        label(\"AVG SCORE\", 865, 284);\n        value(Math.round(getAverageAccuracy()) + \"%\", 865, 345, 52, white);\n        ctx.textAlign = \"left\";\n\n        ctx.fillStyle = muted;\n        ctx.font = \"800 18px Arial\";\n        ctx.fillText(roundsPlayed + \" ROUNDS  •  \" + totalMistakes + \" CHAR ERRORS\", 95, 411);\n\n        /* PRIMARY PERFORMANCE */\n        label(\"CAREER HIGHLIGHTS\", 60, 494);\n        panelRect(60, 516, 460, 172, 26);\n        panelRect(540, 516, 480, 172, 26);\n        label(\"BEST SCORE\", 94, 558);\n        value(bestAccuracy + \"%\", 94, 640, 72, white);\n        label(\"BEST WPM\", 575, 558);\n        value(bestWpm, 575, 640, 72, white);\n\n        /* LANGUAGE RECORDS */\n        label(\"LANGUAGE RECORDS\", 60, 738);\n\n        function languageCard(x, title, data, isActive) {\n            ctx.fillStyle = isActive ? accent + \"18\" : panel;\n            roundRect(ctx, x, 760, 460, 190, 26);\n            ctx.fill();\n            ctx.strokeStyle = isActive ? accent + \"99\" : border;\n            ctx.lineWidth = 2;\n            ctx.stroke();\n            ctx.fillStyle = isActive ? accent : white;\n            ctx.font = \"900 25px Arial\";\n            ctx.fillText(title, x + 30, 805);\n            label(\"ROUNDS\", x + 30, 850);\n            value(data.rounds, x + 30, 897, 34, white);\n            label(\"BEST\", x + 155, 850);\n            value(data.bestAccuracy + \"%\", x + 155, 897, 34, white);\n            label(\"AVERAGE\", x + 300, 850);\n            const average = data.rounds ? Math.round(data.totalAccuracy / data.rounds) : 0;\n            value(average + \"%\", x + 300, 897, 34, white);\n        }\n\n        languageCard(60, \"ENGLISH\", english, language === \"english\");\n        languageCard(560, \"FILIPINO\", filipino, language === \"filipino\");\n\n        /* ACTIVE LOADOUT */\n        panelRect(60, 995, 960, 145, 26);\n        ctx.fillStyle = accent;\n        roundRect(ctx, 60, 995, 9, 145, 5);\n        ctx.fill();\n        label(difficulty === \"nomercy\" ? \"RANKED LOADOUT\" : \"ACTIVE LOADOUT\", 96, 1037);\n        ctx.fillStyle = white;\n        ctx.font = \"900 27px Arial\";\n        ctx.fillText(\n            attitude.toUpperCase() + \"  •  \" + (difficulty === \"nomercy\" ? \"NO MERCY\" : difficulty.toUpperCase()),\n            96,\n            1082\n        );\n        ctx.textAlign = \"right\";\n        label(difficulty === \"nomercy\" ? \"BEST RANKED SCORE\" : \"MODE BEST\", 974, 1037);\n        value(activeModeBest + \"%\", 974, 1090, 42, accent);\n        ctx.textAlign = \"left\";\n\n        /* COMMENT + FOOTER */\n        ctx.fillStyle = accent + \"18\";\n        roundRect(ctx, 60, 1175, 960, 92, 24);\n        ctx.fill();\n        ctx.fillStyle = \"#d8dbe4\";\n        ctx.font = \"700 19px Arial\";\n        const comment = wrapCanvasText(ctx, getProfileComment(), 870).slice(0, 2);\n        comment.forEach(function(line, index) {\n            ctx.fillText(line, 92, 1212 + index * 27);\n        });\n\n        ctx.fillStyle = accent;\n        roundRect(ctx, 60, 1301, 960, 5, 3);\n        ctx.fill();\n        ctx.fillStyle = muted;\n        ctx.font = \"800 16px Arial\";\n        ctx.fillText(\"KEYBOARD WARRIOR SIMULATOR\", 60, 1332);\n        ctx.textAlign = \"right\";\n        ctx.fillText(\"SHARE YOUR DAMAGE REPORT\", 1020, 1332);\n        ctx.textAlign = \"left\";\n\n        return canvas;\n\n    }\n\n\n    /* =========================================================\n       GENERATE SHARE IMAGE\n    ========================================================= */\n\n    let generatedCanvas = null;\n    let generatedImageData = \"\";\n\n\n    function generateShareImage() {\n\n        generatedCanvas =\n            createProfileCard();\n\n        generatedImageData =\n            generatedCanvas.toDataURL(\n                \"image/png\"\n            );\n\n\n        const preview =\n            document.getElementById(\n                \"imagePreview\"\n            );\n\n        const previewCard =\n            document.getElementById(\n                \"imagePreviewCard\"\n            );\n\n        preview.src =\n            generatedImageData;\n\n        previewCard.classList.add(\n            \"show\"\n        );\n\n\n        const popupImage =\n            document.getElementById(\n                \"sharePopupImage\"\n            );\n\n        popupImage.src =\n            generatedImageData;\n\n\n        document\n            .getElementById(\"shareOverlay\")\n            .classList.add(\"show\");\n\n    }\n\n\n    /* =========================================================\n       EXPORT STATS\n    ========================================================= */\n\n    function shareStats() {\n        generateShareImage();\n\n        const status = document.getElementById(\"exportStatus\");\n        if (status) {\n            status.textContent =\n                \"Card generated. Tap Export to save it locally.\";\n        }\n    }\n\n\n    /* =========================================================\n       EXPORT GENERATED IMAGE\n    ========================================================= */\n\n    function exportGeneratedImage() {\n        if (!generatedImageData) {\n            generateShareImage();\n        }\n\n        if (!generatedImageData) return;\n\n        const status = document.getElementById(\"exportStatus\");\n        const filename = \"Keyboard_Warrior_Stats_\" +\n            new Date().toISOString().replace(/[:.]/g, \"-\") + \".png\";\n\n        try {\n            // Android WebView: save directly into the device Photos/Gallery.\n            if (window.AndroidGallery &&\n                typeof window.AndroidGallery.saveImage === \"function\") {\n\n                window.AndroidGallery.saveImage(\n                    generatedImageData,\n                    filename\n                );\n\n                if (status) {\n                    status.textContent =\n                        \"Saved to Photos / Gallery.\";\n                }\n                return;\n            }\n\n            // Browser fallback: download the PNG normally.\n            const link = document.createElement(\"a\");\n            link.href = generatedImageData;\n            link.download = filename;\n            document.body.appendChild(link);\n            link.click();\n            link.remove();\n\n            if (status) {\n                status.textContent =\n                    \"Image exported. Check your Downloads / Photos.\";\n            }\n        } catch (error) {\n            console.error(\"Stats export error:\", error);\n            if (status) {\n                status.textContent =\n                    \"Could not save the stats card.\";\n            }\n        }\n    }\n\n\n    /* =========================================================\n       CLOSE SHARE\n    ========================================================= */\n\n    function closeSharePopup() {\n\n        document\n            .getElementById(\"shareOverlay\")\n            .classList.remove(\"show\");\n\n    }\n\n    document\n        .getElementById(\"shareOverlay\")\n        .addEventListener(\n            \"click\",\n            function(event) {\n\n                if (\n                    event.target === this\n                ) {\n\n                    closeSharePopup();\n\n                }\n\n            }\n        );\n\n    const rankInfoOverlayEl = document.getElementById(\"rankInfoOverlay\");\n    if (rankInfoOverlayEl) {\n        rankInfoOverlayEl.addEventListener(\"click\", function(event) {\n            if (event.target === this) {\n                closeRankInfo();\n            }\n        });\n    }\n\n    const resetDataOverlayEl = document.getElementById(\"resetDataOverlay\");\n    if (resetDataOverlayEl) {\n        resetDataOverlayEl.addEventListener(\"click\", function(event) {\n            if (event.target === this) closeResetDataDialog();\n        });\n    }\n\n    const avatarPickerOverlayEl = document.getElementById(\"avatarPickerOverlay\");\n    if (avatarPickerOverlayEl) {\n        avatarPickerOverlayEl.addEventListener(\"click\", function(event) {\n            if (event.target === this) closeAvatarPicker();\n        });\n    }\n\n    document.addEventListener(\"keydown\", function(event) {\n        if (event.key !== \"Escape\") return;\n        const shareOverlay = document.getElementById(\"shareOverlay\");\n        const rankOverlay = document.getElementById(\"rankInfoOverlay\");\n        const resetOverlay = document.getElementById(\"resetDataOverlay\");\n        const avatarOverlay = document.getElementById(\"avatarPickerOverlay\");\n        if (shareOverlay && getComputedStyle(shareOverlay).display !== \"none\") closeSharePopup();\n        if (rankOverlay && getComputedStyle(rankOverlay).display !== \"none\") closeRankInfo();\n        if (resetOverlay && getComputedStyle(resetOverlay).display !== \"none\") closeResetDataDialog();\n        if (avatarOverlay && getComputedStyle(avatarOverlay).display !== \"none\") closeAvatarPicker();\n    });\n\n\n    /* =========================================================\n       INITIALIZE\n    ========================================================= */\n\n    loadStats();\n\n    applyAccentColor(accentColor);\n\n    /* Restore the saved appearance every time the app opens. */\n    applyTheme();\n\n    document\n        .getElementById(\"languageSelect\")\n        .value =\n            language;\n\n    theme = \"dark\";\n    applyTheme();\n\n    updateSettingsDisplay();\n    updateStatsDisplay();\n    updateProfileDisplay();\n\n\n\n    /* =========================================================\n       FINAL GAME START SAFETY PATCH\n       The game screen is opened first, then the round is prepared.\n       This prevents a setup error from leaving the user stuck on\n       the mode-selection screen.\n    ========================================================= */\n    function startSelectedMode() {\n        if (difficulty === \"freestyle\" || selectedMode === \"freestyle\") {\n            try {\n                startFreestyle();\n            } catch (error) {\n                console.error(\"Freestyle start error:\", error);\n                document.body.className = \"game-active\";\n                showScreen(\"gameScreen\");\n            }\n            return;\n        }\n\n        if (difficulty === \"madlibs\" || difficulty === \"reverse\") {\n            startGame();\n            return;\n        }\n\n        // Always switch to the game screen immediately.\n        document.body.className = \"game-active\";\n        showScreen(\"gameScreen\");\n\n        try {\n            const available =\n                (phrases &&\n                 phrases[language] &&\n                 phrases[language][attitude] &&\n                 phrases[language][attitude].length)\n                    ? phrases[language][attitude]\n                    : phrases.english.friendly;\n\n            phraseIndex = getNextPhraseIndex(language, attitude);\n            currentPhrase = available[phraseIndex];\n            currentPhraseWords = currentPhrase.split(\" \");\n\n            started = false;\n            finished = false;\n            mistakeCount = 0;\n            correctCount = 0;\n            currentErrorCount = 0;\n            typedKeystrokes = 0;\n            incorrectKeystrokes = 0;\n            previousInputValue = \"\";\n            stopTimer();\n\n            // No Mercy needs its countdown limit set up front, otherwise\n            // updateTimer() compares elapsed time against a stale/zero\n            // limit and the round looks like it starts already overtime.\n            noMercyTimeLimit = difficulty === \"nomercy\"\n                ? getNoMercyTimeLimit(currentPhrase)\n                : 0;\n            noMercyOvertime = false;\n\n            const input = document.getElementById(\"typingInput\");\n            const display = document.getElementById(\"phraseDisplay\");\n            const time = document.getElementById(\"liveTime\");\n            const correct = document.getElementById(\"liveCorrect\");\n            const mistakes = document.getElementById(\"liveMistakes\");\n            const progress = document.getElementById(\"progressBar\");\n            const attitudeEl = document.getElementById(\"gameAttitude\");\n            const timeLabel = document.querySelector(\"#gameScreen .stats-row .stat:first-child .stat-label\");\n            const noMercyHint = document.getElementById(\"noMercyRuleHint\");\n\n            if (display) {\n                display.innerHTML = \"\";\n                renderPhrase();\n            }\n\n            if (input) {\n                input.value = \"\";\n                input.disabled = false;\n            }\n\n            if (time) {\n                time.textContent = difficulty === \"nomercy\"\n                    ? formatCountdown(noMercyTimeLimit)\n                    : \"0.0\";\n                time.classList.remove(\"no-mercy-overtime\");\n            }\n            if (timeLabel) {\n                timeLabel.innerHTML = difficulty === \"nomercy\"\n                    ? 'TIME LEFT <span class=\"no-mercy-limit\">' + noMercyTimeLimit + 's</span>'\n                    : \"SECONDS\";\n            }\n            if (noMercyHint) {\n                noMercyHint.style.display = difficulty === \"nomercy\" ? \"block\" : \"none\";\n            }\n            if (correct) correct.textContent = \"0\";\n            if (mistakes) mistakes.textContent = \"0\";\n            if (progress) progress.style.width = \"0%\";\n\n            if (attitudeEl) {\n                attitudeEl.textContent =\n                    attitude === \"friendly\" ? \"FRIENDLY\" : \"ALMIGHTY\";\n            }\n\n            const label =\n                document.querySelector(\"#gameScreen .phrase-label\");\n            if (label) label.textContent = \"Type this\";\n\n            const actions =\n                document.querySelector(\"#gameScreen .game-actions\");\n            if (actions) actions.style.display = \"flex\";\n\n            // Focus after the screen has become visible.\n            setTimeout(function() {\n                if (input) input.focus();\n            }, 100);\n\n        } catch (error) {\n            console.error(\"Game start error:\", error);\n\n            // Last-resort fallback: the game screen remains visible\n            // and a usable phrase is displayed.\n            const fallback =\n                \"You entered the battlefield. Now type faster than your excuses.\";\n\n            currentPhrase = fallback;\n            currentPhraseWords = fallback.split(\" \");\n            started = false;\n            finished = false;\n            mistakeCount = 0;\n            correctCount = 0;\n\n            try {\n                renderPhrase();\n            } catch (renderError) {\n                const display = document.getElementById(\"phraseDisplay\");\n                if (display) display.textContent = fallback;\n            }\n\n            const input = document.getElementById(\"typingInput\");\n            if (input) {\n                input.value = \"\";\n                input.disabled = false;\n                setTimeout(function() { input.focus(); }, 100);\n            }\n        }\n    }\n\n</script>\n\n<script>\n    if (\"serviceWorker\" in navigator) {\n        window.addEventListener(\"load\", function() {\n            navigator.serviceWorker\n                .register(\"./sw.js?v=1\", { updateViaCache: \"none\" })\n                .then(function(registration) { return registration.update(); })\n                .catch(function(error) {\n                    console.warn(\"Keyboard Warrior service worker was not registered:\", error);\n                });\n        });\n    }\n</script>\n\n</body>\n</html>\n","icon":"data:image/png;base64,","favorite":false}}