{"format":"local-hub-app","version":1,"exportedAt":"2026-08-31T08:09:55.172Z","app":{"packageId":"capypera","name":"CapyPera","group":"Finance","html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"theme-color\" content=\"#11130f\"><title>CapyPera</title>\n<style>\n:root{--bg:#11130f;--card:#1b1e18;--card2:#242820;--line:#343a2f;--text:#faf7ef;--muted:#aaa99f;--orange:#f5a524;--green:#61d394;--red:#ff7b7b}*{box-sizing:border-box}html{color-scheme:dark}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}button,input,select{font:inherit}button{cursor:pointer}.app{max-width:500px;min-height:100dvh;margin:auto}.hidden{display:none!important}:focus-visible{outline:3px solid #ffd166;outline-offset:2px}.top{height:68px;padding:env(safe-area-inset-top) 18px 0;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:10;background:#11130fed;backdrop-filter:blur(15px)}.brand{display:flex;align-items:center;gap:9px;font-size:20px;font-weight:900}.brand img{width:37px;height:37px;object-fit:contain;transform-origin:50% 80%;animation:capyNod 3.8s ease-in-out infinite}.brand span{color:var(--orange)}.icon{width:42px;height:42px;border:1px solid var(--line);border-radius:13px;background:var(--card);color:white;font-size:19px}main{padding:14px 18px 105px}.page{display:none}.page.active{display:block}.hello{display:flex;align-items:center;gap:13px;padding:14px 16px;border:1px solid #f5a52440;border-radius:20px;background:linear-gradient(135deg,#2a2116,#191c17);margin-bottom:12px;overflow:hidden}.hello img{width:62px;height:62px;object-fit:contain;transform-origin:50% 100%;filter:drop-shadow(0 8px 8px #0005);animation:capyFloat 3.2s ease-in-out infinite}.hello:hover img,.hello:focus-within img{animation:capyWave .65s ease-in-out 2}.hello h1{font-size:20px;margin:0}.hello p,.sub{font-size:11px;line-height:1.45;color:var(--muted);margin:4px 0 0}.month{display:flex;align-items:center;justify-content:space-between;margin:8px 0}.month button{border:0;background:none;color:var(--muted);padding:10px}.month .today{color:var(--orange);font-size:11px;font-weight:800}.balance{padding:20px;border-radius:23px;background:linear-gradient(145deg,#f7ae33,#dc7e0c);color:#221708;box-shadow:0 15px 35px #f5a5242c}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:900;opacity:.7}.balance h2{font-size:37px;letter-spacing:-1px;margin:5px 0 15px}.stats{display:grid;grid-template-columns:1fr 1fr;gap:9px}.stat{padding:10px 11px;border-radius:13px;background:#fff3}.stat span,.stat b{display:block}.stat span{font-size:10px}.stat b{font-size:15px;margin-top:3px}.bar{height:8px;background:#0002;border-radius:99px;overflow:hidden;margin-top:12px}.bar i{display:block;height:100%;background:white;border-radius:inherit}.bar-label{display:flex;justify-content:space-between;font-size:10px;font-weight:800;margin-top:5px}.actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:12px 0}.action{padding:13px;border:1px solid var(--line);border-radius:15px;background:var(--card);color:white;text-align:left}.action b{display:block;font-size:13px}.action span{display:block;color:var(--muted);font-size:10px;margin-top:3px}.primary{background:var(--orange);border-color:var(--orange);color:#261906}.primary span{color:#5a3b0a}.card{margin-top:12px;padding:16px;border:1px solid var(--line);border-radius:20px;background:var(--card)}.head{display:flex;align-items:center;justify-content:space-between;gap:10px}.head h2,.card h2{font-size:15px;margin:0}.link{border:0;background:none;color:var(--orange);font-size:11px;font-weight:800}.empty{padding:24px 8px;text-align:center;color:var(--muted);font-size:11px}.entry{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid var(--line)}.entry:last-child{border:0}.mark{width:38px;height:38px;flex:none;border-radius:12px;background:#f5a52417;color:var(--orange);display:grid;place-items:center;font-weight:900}.info{flex:1;min-width:0}.info b,.info span{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.info b{font-size:13px}.info span{color:var(--muted);font-size:10px;margin-top:3px}.amt{color:var(--green);font-size:12px;font-weight:900}.menu{border:0;background:none;color:var(--muted);font-size:20px;padding:6px}.toolbar{display:flex;gap:8px;margin:12px 0}.toolbar input,.toolbar select,.field input,.field select,.composer input{border:1px solid var(--line);border-radius:12px;background:#10130f;color:white;padding:12px}.toolbar input{flex:1;min-width:0}.toolbar select{width:125px}.summary{color:var(--muted);font-size:11px}.summary b{color:var(--green)}.field{margin-top:12px}.field label{display:block;color:var(--muted);font-size:10px;font-weight:800;margin-bottom:5px}.field input,.field select{width:100%}.money{position:relative}.money:before{content:'₱';position:absolute;left:12px;top:12px;color:var(--muted)}.money input{padding-left:29px}.error{min-height:14px;color:var(--red);font-size:10px;margin-top:3px}.two{display:grid;grid-template-columns:1fr 1fr;gap:9px}.result{margin-top:14px;padding:14px;border-radius:15px;background:var(--card2)}.result-row{display:flex;justify-content:space-between;padding:5px 0;color:var(--muted);font-size:11px}.result-row b{color:white}.biggreen{font-size:27px;font-weight:900;color:var(--green);margin-top:4px}.explain{border-top:1px dashed var(--line);margin-top:9px;padding-top:9px;color:var(--muted);font-size:10px;line-height:1.5}.goal{padding:14px;border:1px solid var(--line);border-radius:16px;background:var(--card2);margin-top:9px}.goal h3{font-size:13px;margin:0}.goal-top{display:flex;justify-content:space-between;gap:8px}.goal-meta{color:var(--muted);font-size:10px;margin:4px 0 8px}.smallbar{height:7px;background:#11130f;border-radius:99px;overflow:hidden}.smallbar i{display:block;height:100%;background:var(--green)}.mini{border:1px solid var(--line);background:none;color:var(--muted);border-radius:9px;padding:6px 8px;font-size:9px}.tip{padding:10px;margin-top:9px;border-radius:11px;background:#f5a52412;color:#dfcba5;font-size:10px;line-height:1.4}.chat{height:calc(100dvh - 172px);min-height:500px;display:flex;flex-direction:column}.messages{flex:1;overflow:auto;display:flex;flex-direction:column;gap:8px;padding:9px 0}.msg{max-width:91%;padding:11px 13px;border-radius:15px;background:var(--card2);font-size:11px;line-height:1.55;white-space:pre-wrap}.msg.user{align-self:flex-end;background:var(--orange);color:#241805;font-weight:700}.verdict{display:inline-block;padding:4px 7px;border-radius:7px;background:var(--green);color:#102117;font-weight:900;font-size:9px;margin-bottom:4px}.verdict.wait{background:#ffd166;color:#2b1d07}.verdict.no{background:var(--red);color:#2b0d0d}.chips{display:flex;gap:6px;overflow:auto;padding:6px 0}.chips button{white-space:nowrap;border:1px solid var(--line);border-radius:99px;background:var(--card);color:var(--muted);padding:7px 10px;font-size:9px}.composer{display:flex;gap:7px}.composer input{flex:1;min-width:0}.send{width:44px;border:0;border-radius:13px;background:var(--orange);color:#241805}.setting{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:13px 0;border-bottom:1px solid var(--line)}.setting b{font-size:12px}.setting span{display:block;color:var(--muted);font-size:9px;margin-top:3px}.switch{position:relative;width:47px;height:27px;flex:none}.switch input{opacity:0;width:1px}.switch i{position:absolute;inset:0;border-radius:99px;background:#3b4037}.switch i:after{content:'';position:absolute;width:21px;height:21px;left:3px;top:3px;border-radius:50%;background:white;transition:.2s}.switch input:checked+i{background:var(--orange)}.switch input:checked+i:after{transform:translateX(20px)}.settings-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:13px}.secondary{border:1px solid var(--line);border-radius:12px;background:var(--card2);color:white;padding:11px;font-size:10px;font-weight:800}.danger{color:var(--red)}.nav{position:fixed;left:50%;bottom:0;transform:translateX(-50%);width:100%;max-width:500px;height:calc(75px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);display:grid;grid-template-columns:repeat(4,1fr);background:#141712ed;border-top:1px solid var(--line);backdrop-filter:blur(16px)}.nav button{border:0;background:none;color:var(--muted);font-size:9px;font-weight:800;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:3px}.nav button b{font-size:20px}.nav button.active{color:var(--orange)}dialog{width:min(100% - 24px,460px);max-height:88dvh;padding:0;border:1px solid var(--line);border-radius:21px;background:var(--card);color:white}dialog::backdrop{background:#000a;backdrop-filter:blur(4px)}.sheet{padding:19px;max-height:88dvh;overflow:auto}.sheet-head{display:flex;justify-content:space-between;align-items:center}.sheet h2{font-size:17px;margin:0}.close{border:0;background:none;color:var(--muted);font-size:25px}.btnrow{display:flex;gap:8px;margin-top:14px}.save{flex:1;border:0;border-radius:12px;background:var(--orange);color:#261905;padding:12px;font-weight:900}.cancel{border:1px solid var(--line);border-radius:12px;background:none;color:var(--muted);padding:12px}.toast{position:fixed;z-index:50;left:50%;bottom:88px;transform:translate(-50%,12px);padding:10px 14px;border:1px solid var(--line);border-radius:12px;background:#292e25;opacity:0;transition:.2s;font-size:10px}.toast.show{opacity:1;transform:translate(-50%,0)}.onboard{text-align:center}.onboard img{width:105px;transform-origin:50% 100%;animation:capyFloat 3.2s ease-in-out infinite}.onboard p{color:var(--muted);font-size:11px;line-height:1.5}\n.hello>div{flex:1;min-width:0;order:1}.hello>img{order:2;flex:none;margin-left:auto;width:72px;height:72px}@keyframes capyFloat{0%,100%{transform:translateY(0) rotate(-1deg) scale(1)}50%{transform:translateY(-7px) rotate(1.5deg) scale(1.025)}}@keyframes capyNod{0%,76%,100%{transform:rotate(0) translateY(0)}82%{transform:rotate(-7deg) translateY(-2px)}89%{transform:rotate(5deg) translateY(0)}95%{transform:rotate(-2deg)}}@keyframes capyWave{0%,100%{transform:translateY(0) rotate(0) scale(1)}25%{transform:translateY(-8px) rotate(-6deg) scale(1.04)}75%{transform:translateY(-5px) rotate(7deg) scale(1.04)}}\n@media(max-width:370px){.two,.actions{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}.brand img,.hello img,.onboard img{animation:none!important;transform:none!important}}\n</style></head><body><div class=\"app\"><header class=\"top\"><div class=\"brand\"><img src=\"data:image/png;base64,\" alt=\"\">Capy<span>Pera</span></div><button class=\"icon\" data-page=\"settings\" aria-label=\"Settings\">⚙</button></header><main>\n<section id=\"homePage\" class=\"page active\"><div class=\"hello\"><img src=\"data:image/png;base64,\" alt=\"Capy, your allowance buddy\"><div><h1 id=\"helloTitle\">Stay chill, spend wise.</h1><p>Track what you received and see what you can save.</p></div></div><div class=\"month\"><button id=\"prev\" aria-label=\"Previous month\">‹</button><strong id=\"homeMonth\"></strong><button id=\"today\" class=\"today\">Today</button><button id=\"next\" aria-label=\"Next month\">›</button></div><div class=\"balance\"><div class=\"eyebrow\">Allowance received</div><h2 id=\"received\">₱0.00</h2><div class=\"stats\"><div class=\"stat\"><span>Can be saved</span><b id=\"savable\">₱0.00</b></div><div class=\"stat\"><span>Allowances given</span><b id=\"count\">0</b></div></div><div class=\"bar\"><i id=\"rateBar\"></i></div><div class=\"bar-label\"><span>Estimated save rate</span><b id=\"rate\">0%</b></div></div><div class=\"actions\"><button class=\"action primary\" id=\"add\"><b>＋ Add allowance</b><span>Record money received</span></button><button class=\"action\" data-page=\"goals\"><b>◎ Plan savings</b><span>See how much you can keep</span></button></div><div class=\"card\"><div class=\"head\"><h2>Recent allowances</h2><button class=\"link\" data-page=\"history\">View all</button></div><div id=\"recent\"></div></div><div class=\"card\"><div class=\"head\"><h2>Current savings goal</h2><button class=\"link\" data-page=\"goals\">Adjust</button></div><div id=\"homeGoal\"></div></div></section>\n<section id=\"historyPage\" class=\"page\"><div class=\"head\"><div><h2>Allowance history</h2><p class=\"sub\">Edit, find, and browse every allowance.</p></div><button class=\"action primary\" id=\"historyAdd\"><b>＋ Add</b></button></div><div class=\"toolbar\"><input id=\"search\" type=\"search\" placeholder=\"Search giver or note\" aria-label=\"Search allowances\"><select id=\"filterMonth\" aria-label=\"Filter by month\"></select></div><div id=\"historySummary\" class=\"summary\"></div><div id=\"history\" class=\"card\"></div></section>\n<section id=\"goalsPage\" class=\"page\"><h2 style=\"margin:0\">Savings planner</h2><p class=\"sub\">Planned spending is only used to estimate savings. CapyPera does not track expenses.</p><div class=\"card\"><h2>Monthly estimate</h2><div class=\"two\"><div class=\"field\"><label>Allowance received</label><div class=\"money\"><input id=\"pAllowance\" type=\"number\" min=\"0\" step=\".01\"></div></div><div class=\"field\"><label>Planned spending</label><div class=\"money\"><input id=\"pSpending\" type=\"number\" min=\"0\" step=\".01\"></div></div></div><div class=\"two\"><div class=\"field\"><label>Desired savings / month</label><div class=\"money\"><input id=\"pTarget\" type=\"number\" min=\"0\" step=\".01\"></div></div><div class=\"field\"><label>Months</label><input id=\"pMonths\" type=\"number\" min=\"1\" max=\"120\"></div></div><div class=\"result\" aria-live=\"polite\"><div class=\"result-row\"><span>Available after planned spending</span><b id=\"pAvailable\"></b></div><div class=\"result-row\"><span>Realistic monthly savings</span><b id=\"pMonthly\"></b></div><div class=\"sub\">Estimated total savings</div><div id=\"pTotal\" class=\"biggreen\"></div><div id=\"pExplain\" class=\"explain\"></div></div></div><div class=\"card\"><div class=\"head\"><div><h2>Savings goals</h2><p class=\"sub\">Track money intentionally set aside.</p></div><button class=\"link\" id=\"addGoal\">＋ New goal</button></div><div id=\"goals\"></div></div></section>\n<section id=\"advisorPage\" class=\"page\"><h2 style=\"margin:0\">Capy Check</h2><p class=\"sub\">Transparent allowance-based guidance—not professional financial advice.</p><div class=\"chat\"><div id=\"messages\" class=\"messages\" aria-live=\"polite\"></div><div class=\"chips\"><button data-ask=\"Can I buy something for ₱500?\">Can I buy it?</button><button data-ask=\"How much can I save?\">How much can I save?</button><button data-ask=\"Give me an allowance summary\">Allowance summary</button></div><div class=\"composer\"><input id=\"advisorInput\" placeholder=\"Can I buy this for ₱500?\" aria-label=\"Message Capy Check\"><button id=\"send\" class=\"send\" aria-label=\"Send\">➤</button></div></div></section>\n<section id=\"settingsPage\" class=\"page\"><h2 style=\"margin:0\">Settings</h2><p class=\"sub\">Your records stay in this browser unless exported.</p><div class=\"card\"><div class=\"setting\"><div><b>Filipino responses</b><span>Capy Check will answer in Filipino.</span></div><label class=\"switch\"><input id=\"filipino\" type=\"checkbox\" aria-label=\"Filipino responses\"><i></i></label></div><div class=\"settings-actions\"><button class=\"secondary\" id=\"exportJson\">Export backup</button><button class=\"secondary\" id=\"importJson\">Import backup</button><input id=\"file\" class=\"hidden\" type=\"file\" accept=\"application/json\"><button class=\"secondary\" id=\"exportCsv\">Export CSV</button><button class=\"secondary danger\" id=\"reset\">Reset data</button></div></div><div class=\"card\"><h2>About CapyPera</h2><p class=\"sub\">An offline-first allowance tracker for recording money received and planning what can be saved.</p></div></section></main>\n<nav class=\"nav\" aria-label=\"Main navigation\"><button class=\"active\" data-page=\"home\"><b>⌂</b>Home</button><button data-page=\"history\"><b>◷</b>History</button><button data-page=\"goals\"><b>◎</b>Save</button><button data-page=\"advisor\"><b>◌</b>Capy Check</button></nav></div>\n<dialog id=\"allowanceDialog\"><form id=\"allowanceForm\" class=\"sheet\" novalidate><div class=\"sheet-head\"><h2 id=\"allowanceTitle\">Add allowance</h2><button type=\"button\" class=\"close\" data-close aria-label=\"Close\">×</button></div><input id=\"aId\" type=\"hidden\"><div class=\"field\"><label>Amount received</label><div class=\"money\"><input id=\"aAmount\" type=\"number\" min=\".01\" step=\".01\"></div><div id=\"aAmountErr\" class=\"error\"></div></div><div class=\"field\"><label>Given by</label><input id=\"aFrom\" maxlength=\"60\" placeholder=\"Mom, Dad, Guardian…\"><div id=\"aFromErr\" class=\"error\"></div></div><div class=\"field\"><label>Note (optional)</label><input id=\"aNote\" maxlength=\"100\" placeholder=\"Weekly school allowance\"></div><div class=\"field\"><label>Date received</label><input id=\"aDate\" type=\"date\"><div id=\"aDateErr\" class=\"error\"></div></div><div class=\"field\"><label>Repeat</label><select id=\"aRepeat\"><option value=\"none\">Does not repeat</option><option value=\"weekly\">Weekly for 4 weeks</option><option value=\"monthly\">Monthly for 3 months</option></select></div><div class=\"btnrow\"><button type=\"button\" class=\"cancel\" data-close>Cancel</button><button class=\"save\">Save allowance</button></div></form></dialog>\n<dialog id=\"optionsDialog\"><div class=\"sheet\"><div class=\"sheet-head\"><h2>Allowance options</h2><button class=\"close\" data-close>×</button></div><div class=\"btnrow\"><button id=\"editAllowance\" class=\"save\">Edit</button><button id=\"deleteAllowance\" class=\"cancel danger\">Delete</button></div></div></dialog>\n<dialog id=\"goalDialog\"><form id=\"goalForm\" class=\"sheet\" novalidate><div class=\"sheet-head\"><h2 id=\"goalTitle\">New savings goal</h2><button type=\"button\" class=\"close\" data-close>×</button></div><input id=\"gId\" type=\"hidden\"><div class=\"field\"><label>Goal name</label><input id=\"gName\" maxlength=\"60\" placeholder=\"New phone\"><div id=\"gNameErr\" class=\"error\"></div></div><div class=\"two\"><div class=\"field\"><label>Target amount</label><div class=\"money\"><input id=\"gTarget\" type=\"number\" min=\"1\" step=\".01\"></div></div><div class=\"field\"><label>Already saved</label><div class=\"money\"><input id=\"gSaved\" type=\"number\" min=\"0\" step=\".01\"></div></div></div><div class=\"field\"><label>Target date</label><input id=\"gDate\" type=\"date\"></div><div id=\"gAmountErr\" class=\"error\"></div><div class=\"btnrow\"><button type=\"button\" class=\"cancel\" data-close>Cancel</button><button class=\"save\">Save goal</button></div></form></dialog>\n<dialog id=\"onboardDialog\"><form id=\"onboardForm\" class=\"sheet onboard\"><img src=\"data:image/png;base64,\" alt=\"Capy\"><h2>Meet your allowance buddy</h2><p>CapyPera records how much allowance has been given and estimates how much you can save.</p><div class=\"field\" style=\"text-align:left\"><label>What should Capy call you? (optional)</label><input id=\"oName\" maxlength=\"30\"></div><div class=\"field\" style=\"text-align:left\"><label>Usual planned spending per month</label><div class=\"money\"><input id=\"oSpending\" type=\"number\" min=\"0\" step=\".01\"></div></div><button class=\"save\" style=\"width:100%;margin-top:14px\">Start tracking</button></form></dialog><div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n<script>\n'use strict';const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)],KEY='capypera_v2',OLD='capypera_rule_based_v1',D={name:'',allowances:[],goals:[],planner:{spending:0,target:0,months:12},filipino:false,onboarded:false};let data=load(),view=new Date(new Date().getFullYear(),new Date().getMonth(),1),selected=null;\nfunction load(){try{let x=JSON.parse(localStorage.getItem(KEY));if(x)return {...D,...x,planner:{...D.planner,...x.planner}};let o=JSON.parse(localStorage.getItem(OLD));if(o)return {...D,allowances:o.allowances||[],filipino:!!o.filipino,onboarded:true}}catch{}return structuredClone(D)}function save(){localStorage.setItem(KEY,JSON.stringify(data))}function money(n){return Number(n||0).toLocaleString('en-PH',{style:'currency',currency:'PHP'})}function key(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')}function iso(d){return key(d)+'-'+String(d.getDate()).padStart(2,'0')}function mkey(a){return a.month||a.date.slice(0,7)}function esc(s){return String(s||'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]))}function date(s){return new Date(s+'T00:00:00').toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})}function month(k){let [y,m]=k.split('-');return new Date(+y,+m-1).toLocaleDateString('en-PH',{month:'long',year:'numeric'})}function list(k=key(view)){return data.allowances.filter(a=>mkey(a)===k).sort((a,b)=>b.date.localeCompare(a.date))}function sum(x){return x.reduce((s,a)=>s+Number(a.amount),0)}function canSave(r){return Math.max(0,Math.min(r-data.planner.spending,data.planner.target>0?data.planner.target:r-data.planner.spending))}function toast(t){$('#toast').textContent=t;$('#toast').classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>$('#toast').classList.remove('show'),2200)}\nfunction page(n){$$('.page').forEach(x=>x.classList.remove('active'));$('#'+n+'Page').classList.add('active');$$('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===n));scrollTo({top:0,behavior:'smooth'});if(n==='history')renderHistory();if(n==='goals')renderGoals();if(n==='advisor')initChat()}$$('[data-page]').forEach(b=>b.onclick=()=>page(b.dataset.page));function entry(a){return `<div class=\"entry\"><div class=\"mark\">₱</div><div class=\"info\"><b>${esc(a.from)}</b><span>${esc(a.note||'Allowance')} · ${date(a.date)}</span></div><div class=\"amt\">+${money(a.amount)}</div><button class=\"menu\" data-entry=\"${a.id}\" aria-label=\"Allowance options\">⋮</button></div>`}\nfunction bindEntries(){$$('[data-entry]').forEach(b=>b.onclick=()=>{selected=Number(b.dataset.entry);$('#optionsDialog').showModal()})}function renderHome(){let k=key(view),x=list(k),r=sum(x),s=canSave(r),pct=r?Math.round(s/r*100):0;$('#homeMonth').textContent=month(k);$('#today').classList.toggle('hidden',k===key(new Date()));$('#received').textContent=money(r);$('#savable').textContent=money(s);$('#count').textContent=x.length;$('#rate').textContent=pct+'%';$('#rateBar').style.width=Math.min(100,pct)+'%';$('#recent').innerHTML=x.length?x.slice(0,3).map(entry).join(''):'<div class=\"empty\">No allowance recorded this month.</div>';$('#helloTitle').textContent='Stay chill'+(data.name?', '+data.name:'')+'.';let g=data.goals[0];$('#homeGoal').innerHTML=g?`<div class=\"goal\"><div class=\"goal-top\"><h3>${esc(g.name)}</h3><b>${Math.min(100,Math.round(g.saved/g.target*100))}%</b></div><div class=\"goal-meta\">${money(g.saved)} of ${money(g.target)}</div><div class=\"smallbar\"><i style=\"width:${Math.min(100,g.saved/g.target*100)}%\"></i></div></div>`:'<div class=\"empty\">Create a savings goal to see progress here.</div>';bindEntries()}$('#prev').onclick=()=>{view.setMonth(view.getMonth()-1);renderHome()};$('#next').onclick=()=>{view.setMonth(view.getMonth()+1);renderHome()};$('#today').onclick=()=>{let d=new Date();view=new Date(d.getFullYear(),d.getMonth(),1);renderHome()};\nfunction renderHistory(){let sel=$('#filterMonth'),keep=sel.value||'all',keys=[...new Set(data.allowances.map(mkey))].sort().reverse();sel.innerHTML='<option value=\"all\">All months</option>'+keys.map(k=>`<option value=\"${k}\">${month(k)}</option>`).join('');if([...sel.options].some(o=>o.value===keep))sel.value=keep;let x=data.allowances.slice().sort((a,b)=>b.date.localeCompare(a.date)),q=$('#search').value.toLowerCase();if(sel.value!=='all')x=x.filter(a=>mkey(a)===sel.value);if(q)x=x.filter(a=>(a.from+' '+(a.note||'')).toLowerCase().includes(q));$('#historySummary').innerHTML=`${x.length} allowance${x.length===1?'':'s'} · <b>${money(sum(x))} received</b>`;$('#history').innerHTML=x.length?x.map(entry).join(''):'<div class=\"empty\">No matching allowances.</div>';bindEntries()}$('#search').oninput=renderHistory;$('#filterMonth').onchange=renderHistory;\nfunction openAllowance(id){$('#allowanceForm').reset();$('#aId').value=id||'';$('#allowanceTitle').textContent=id?'Edit allowance':'Add allowance';$('#aRepeat').disabled=!!id;$$('.error').forEach(e=>e.textContent='');if(id){let a=data.allowances.find(x=>x.id===id);$('#aAmount').value=a.amount;$('#aFrom').value=a.from;$('#aNote').value=a.note||'';$('#aDate').value=a.date}else $('#aDate').value=iso(new Date());$('#allowanceDialog').showModal()}$('#add').onclick=()=>openAllowance();$('#historyAdd').onclick=()=>openAllowance();$('#editAllowance').onclick=()=>{$('#optionsDialog').close();openAllowance(selected)};$('#deleteAllowance').onclick=()=>{if(confirm('Delete this allowance record?')){data.allowances=data.allowances.filter(a=>a.id!==selected);save();$('#optionsDialog').close();renderAll();toast('Allowance deleted.')}};function plus(d,n,type){let x=new Date(d+'T00:00:00');type==='weekly'?x.setDate(x.getDate()+7*n):x.setMonth(x.getMonth()+n);return iso(x)}$('#allowanceForm').onsubmit=e=>{e.preventDefault();$$('.error').forEach(x=>x.textContent='');let id=Number($('#aId').value),amount=Number($('#aAmount').value),from=$('#aFrom').value.trim(),note=$('#aNote').value.trim(),d=$('#aDate').value,ok=true;if(!(amount>0)){$('#aAmountErr').textContent='Enter an amount greater than zero.';ok=false}if(!from){$('#aFromErr').textContent='Enter who gave it.';ok=false}if(!d){$('#aDateErr').textContent='Choose a date.';ok=false}if(!ok)return;if(id)Object.assign(data.allowances.find(a=>a.id===id),{amount,from,note,date:d,month:d.slice(0,7)});else{let repeat=$('#aRepeat').value,n=repeat==='weekly'?4:repeat==='monthly'?3:1;for(let i=0;i<n;i++){let dd=repeat==='none'?d:plus(d,i,repeat);data.allowances.push({id:Date.now()+i,amount,from,note,date:dd,month:dd.slice(0,7)})}}save();$('#allowanceDialog').close();renderAll();toast(id?'Allowance updated.':'Allowance added.')};\nfunction planner(){let r=Number($('#pAllowance').value)||0,sp=Math.max(0,Number($('#pSpending').value)||0),t=Math.max(0,Number($('#pTarget').value)||0),n=Math.max(1,Number($('#pMonths').value)||1),a=Math.max(0,r-sp),m=t?Math.min(t,a):a;data.planner={spending:sp,target:t,months:n};save();$('#pAvailable').textContent=money(a);$('#pMonthly').textContent=money(m);$('#pTotal').textContent=money(m*n);$('#pExplain').textContent=r?`${money(r)} received − ${money(sp)} planned spending = ${money(a)} available to save.`+(sp>r?' Planned spending is above the allowance received.':t>a?' Your desired savings goal is above the realistic amount.':''):'Record an allowance or enter an amount to begin.';renderHome()}['pAllowance','pSpending','pTarget','pMonths'].forEach(id=>$('#'+id).oninput=planner);\nfunction renderGoals(){$('#pAllowance').value=sum(list(key(view)))||'';$('#pSpending').value=data.planner.spending||'';$('#pTarget').value=data.planner.target||'';$('#pMonths').value=data.planner.months||12;planner();$('#goals').innerHTML=data.goals.length?data.goals.map(g=>{let p=Math.min(100,Math.round(g.saved/g.target*100)),monthsLeft=g.date?Math.max(1,(new Date(g.date+'T00:00:00')-new Date())/26298e5):0,need=monthsLeft?Math.max(0,g.target-g.saved)/monthsLeft:0;return `<div class=\"goal\"><div class=\"goal-top\"><div><h3>${esc(g.name)}</h3><div class=\"goal-meta\">${money(g.saved)} of ${money(g.target)} · ${p}%</div></div><div><button class=\"mini\" data-ge=\"${g.id}\">Edit</button> <button class=\"mini danger\" data-gd=\"${g.id}\">Delete</button></div></div><div class=\"smallbar\"><i style=\"width:${p}%\"></i></div>${g.date?`<div class=\"tip\">Target ${date(g.date)} · Save about ${money(need)} monthly.</div>`:''}</div>`}).join(''):'<div class=\"empty\">No savings goals yet.</div>';$$('[data-ge]').forEach(b=>b.onclick=()=>openGoal(Number(b.dataset.ge)));$$('[data-gd]').forEach(b=>b.onclick=()=>{if(confirm('Delete this savings goal?')){data.goals=data.goals.filter(g=>g.id!==Number(b.dataset.gd));save();renderAll()}})}function openGoal(id){$('#goalForm').reset();$('#gId').value=id||'';$('#goalTitle').textContent=id?'Edit savings goal':'New savings goal';$$('.error').forEach(e=>e.textContent='');if(id){let g=data.goals.find(x=>x.id===id);$('#gName').value=g.name;$('#gTarget').value=g.target;$('#gSaved').value=g.saved;$('#gDate').value=g.date||''}$('#goalDialog').showModal()}$('#addGoal').onclick=()=>openGoal();$('#goalForm').onsubmit=e=>{e.preventDefault();$$('.error').forEach(x=>x.textContent='');let id=Number($('#gId').value),name=$('#gName').value.trim(),target=Number($('#gTarget').value),saved=Number($('#gSaved').value)||0,d=$('#gDate').value,ok=true;if(!name){$('#gNameErr').textContent='Name your goal.';ok=false}if(!(target>0)||saved<0||saved>target){$('#gAmountErr').textContent='Use a valid target; saved cannot exceed it.';ok=false}if(!ok)return;let g={id:id||Date.now(),name,target,saved,date:d};id?Object.assign(data.goals.find(x=>x.id===id),g):data.goals.push(g);save();$('#goalDialog').close();renderAll();toast(id?'Goal updated.':'Goal created.')};\nfunction msg(t,type,html){let d=document.createElement('div');d.className='msg '+type;html?d.innerHTML=t:d.textContent=t;$('#messages').append(d);$('#messages').scrollTop=$('#messages').scrollHeight}function initChat(){if(!$('#messages').children.length)msg(data.filipino?'Sabihin mo ang presyo at ipapakita ko ang allowance math.':'Tell me a price and I’ll show the allowance math.','bot')}function ask(t){msg(t,'user');let r=sum(list(key(new Date()))),avail=Math.max(0,r-data.planner.spending),match=t.replace(/,/g,'').match(/(?:₱|php\\s*)?(\\d+(?:\\.\\d+)?)/i),amount=match?Number(match[1]):null,low=t.toLowerCase();if(amount!==null&&(low.includes('buy')||low.includes('bili')||low.includes('afford'))){let after=avail-amount,pct=r?Math.round(amount/r*100):0,no=amount>avail,wait=!no&&pct>=40,label=no?(data.filipino?'HUWAG MUNA':'DON’T BUY'):wait?(data.filipino?'MAGHINTAY':'WAIT AND THINK'):(data.filipino?'KAYA NAMAN':'LOOKS MANAGEABLE');msg(`<span class=\"verdict ${no?'no':wait?'wait':''}\">${label}</span>\\n${data.filipino?'Presyo':'Price'}: ${money(amount)}\\n${data.filipino?'Allowance na natanggap':'Allowance received'}: ${money(r)}\\n${data.filipino?'Pagkatapos ng planong gastos':'After planned spending'}: ${money(avail)}\\n${data.filipino?'Matitira':'Balance after purchase'}: ${money(Math.max(0,after))}\\n${data.filipino?'Bahagi ng allowance':'Share of allowance'}: ${pct}%`,'bot',true)}else if(low.includes('save')||low.includes('ipon'))msg(data.filipino?`Puwedeng mai-save ang humigit-kumulang ${money(canSave(r))} mula sa ${money(r)} na natanggap.`:`You could save about ${money(canSave(r))} from ${money(r)} received.`,'bot');else msg(data.filipino?`Ngayong buwan: ${money(r)} mula sa ${list(key(new Date())).length} allowance record.`:`This month: ${money(r)} across ${list(key(new Date())).length} allowance records.`,'bot')}$('#send').onclick=()=>{let v=$('#advisorInput').value.trim();if(v){$('#advisorInput').value='';ask(v)}};$('#advisorInput').onkeydown=e=>{if(e.key==='Enter')$('#send').click()};$$('[data-ask]').forEach(b=>b.onclick=()=>ask(b.dataset.ask));\n$('#filipino').checked=data.filipino;$('#filipino').onchange=e=>{data.filipino=e.target.checked;save();$('#messages').innerHTML='';toast(data.filipino?'Filipino enabled.':'English enabled.')};function download(name,text,type){let u=URL.createObjectURL(new Blob([text],{type})),a=document.createElement('a');a.href=u;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)}$('#exportJson').onclick=()=>download('capypera-backup-'+iso(new Date())+'.json',JSON.stringify(data,null,2),'application/json');$('#exportCsv').onclick=()=>download('capypera-allowances-'+iso(new Date())+'.csv',[['Date','Given by','Note','Amount'],...data.allowances.map(a=>[a.date,a.from,a.note||'',a.amount])].map(r=>r.map(v=>'\"'+String(v).replace(/\"/g,'\"\"')+'\"').join(',')).join('\\n'),'text/csv');$('#importJson').onclick=()=>$('#file').click();$('#file').onchange=async e=>{try{let p=JSON.parse(await e.target.files[0].text());if(!Array.isArray(p.allowances))throw 0;if(!confirm('Replace current data with this backup?'))return;data={...D,...p,planner:{...D.planner,...p.planner},onboarded:true};save();renderAll();toast('Backup imported.')}catch{toast('Invalid CapyPera backup.')}e.target.value=''};$('#reset').onclick=()=>{if(confirm('Reset all allowances and goals? Export first if needed.')){data={...structuredClone(D),onboarded:true};save();renderAll();page('home');toast('CapyPera reset.')}};\n$$('[data-close]').forEach(b=>b.onclick=()=>b.closest('dialog').close());$$('dialog').forEach(d=>d.onclick=e=>{if(e.target===d)d.close()});$('#onboardForm').onsubmit=e=>{e.preventDefault();data.name=$('#oName').value.trim();data.planner.spending=Math.max(0,Number($('#oSpending').value)||0);data.onboarded=true;save();$('#onboardDialog').close();renderAll();toast('Welcome to CapyPera!')};function renderAll(){renderHome();renderHistory();renderGoals();$('#filipino').checked=data.filipino}renderAll();if(!data.onboarded)setTimeout(()=>$('#onboardDialog').showModal(),100);\n</script></body></html>\n","icon":"data:image/png;base64,","favorite":false}}