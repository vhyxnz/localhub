{"format":"local-hub-app","version":1,"exportedAt":"2026-08-31T08:09:55.209Z","app":{"packageId":"flappy","name":"Flappy","group":"Games","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n    <title>Flappy</title>\n    <style>\n        *{box-sizing:border-box}\n        :root{\n         --ui-accent:#8d4cff;\n         --ui-accent2:#5d22d8;\n         --ui-panel-alpha:.94;\n         --ui-overlay-alpha:.40;\n         --ui-blur:3px;\n         --ui-radius:26px;\n        }\n        html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#70c6cf;touch-action:none}\n        body{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",Arial,sans-serif;user-select:none;-webkit-user-select:none}\n        button{font:inherit;-webkit-tap-highlight-color:transparent;cursor:pointer}\n        #game{position:fixed;inset:0;overflow:hidden}\n        #canvas{position:absolute;inset:0;width:100%;height:100%;display:block;z-index:1}\n        #score{position:absolute;top:27px;left:50%;transform:translateX(-50%);z-index:20;color:#fff;font-size:50px;line-height:1;font-weight:900;text-shadow:0 3px 0 rgba(0,0,0,.65);pointer-events:none}\n\n        /* Pixel Pause Button */\n        #pauseButton{\n         position:absolute;right:14px;top:14px;width:52px;height:52px;z-index:60;\n         border:2px solid rgba(255,255,255,.2);border-radius:10px;\n         background:rgba(12,25,34,0.85);backdrop-filter:blur(4px);\n         display:none;align-items:center;justify-content:center;gap:6px;\n         box-shadow:0 6px 16px rgba(0,0,0,.2);transition:transform .08s ease;\n         pointer-events:auto;\n        }\n        #pauseButton:active{transform:scale(.94)}\n        .pauseBar{width:6px;height:20px;background:#fff;border-radius:2px}\n\n        /* Top Header Buttons on Home Screen */\n        .homeHeaderBtn{position:absolute;top:16px;width:48px;height:48px;z-index:60;border:2px solid rgba(255,255,255,.2);border-radius:10px;background:rgba(12,25,34,0.85);backdrop-filter:blur(4px);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 6px 16px rgba(0,0,0,.2);transition:transform .08s ease;}\n        .homeHeaderBtn:active{transform:scale(.94)}\n        #homeAnalyticsBtn{left:16px;}\n        #homeAchievementsBtn{left:74px;}\n        #homeSettingsBtn{right:16px;}\n\n        .screen{position:absolute;inset:0;z-index:50;display:none;align-items:center;justify-content:center;padding:22px;background:rgba(5,18,24,var(--ui-overlay-alpha));backdrop-filter:blur(var(--ui-blur));-webkit-backdrop-filter:blur(var(--ui-blur));pointer-events:auto}\n        .panel,.pausePanel,.analyticsPanel,.settingsPanel,.achievementsPanel{width:min(92%,390px);padding:26px 22px;background:rgba(12,25,34,var(--ui-panel-alpha));border:2px solid rgba(255,255,255,.2);border-radius:var(--ui-radius);box-shadow:0 22px 60px rgba(0,0,0,.38),inset 0 1px 0 rgba(255,255,255,.07);color:#fff;position:relative;z-index:2}\n        .panel{text-align:center}.pausePanel{text-align:center}.analyticsPanel,.achievementsPanel{max-height:88vh;overflow:auto}\n\n        /* Floating Logo Animation */\n        @keyframes floatLogo {\n         0%, 100% { transform: translateY(0); }\n         50% { transform: translateY(-8px); }\n        }\n        .logo{display:block;width:min(74%,290px);height:auto;margin:0 auto 13px;animation:floatLogo 3s ease-in-out infinite;}\n\n        .subtitle{color:rgba(255,255,255,.68);font-size:15px;line-height:1.4;margin:0 0 18px}\n\n        /* Glowing Play Button Animation */\n        @keyframes buttonGlow {\n         0%, 100% { box-shadow: 0 8px 20px rgba(0,0,0,.20), inset 0 1px 0 rgba(255,255,255,.10), 0 0 12px rgba(141,76,255,0.4); }\n         50% { box-shadow: 0 8px 25px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.20), 0 0 24px rgba(141,76,255,0.85); }\n        }\n\n        .uiBtn{width:100%;height:56px;margin:10px 0 0;border:2px solid rgba(255,255,255,.15);border-radius:12px;color:#fff;font-weight:850;font-size:16px;letter-spacing:.4px;display:flex;align-items:center;justify-content:center;gap:10px;box-shadow:0 8px 20px rgba(0,0,0,.20),inset 0 1px 0 rgba(255,255,255,.10);transition:transform .08s ease,filter .08s ease;touch-action:manipulation}\n        .uiBtn:active{transform:scale(.975);filter:brightness(.92)}\n        .primary{background:linear-gradient(135deg,var(--ui-accent),var(--ui-accent2));animation:buttonGlow 2.5s infinite;}\n        .secondary{background:rgba(255,255,255,.075)}\n        .icon{width:25px;height:25px;display:inline-flex;align-items:center;justify-content:center;font-size:22px;font-weight:900}\n        .pauseTitle{font-size:31px;font-weight:900;margin-bottom:7px}\n        .resultCard{margin:14px 0 8px;padding:16px;border-radius:14px;background:rgba(255,255,255,.055);border:2px solid rgba(255,255,255,.12)}\n        .resultLabel{font-size:11px;letter-spacing:1.3px;color:rgba(255,255,255,.55);text-transform:uppercase}.resultValue{font-size:38px;font-weight:900;margin-top:3px}.best{font-size:14px;color:#a970ff;margin-top:2px;font-weight:800}\n        .analyticsHeader{display:flex;align-items:center;gap:10px;margin-bottom:4px}.analyticsTitle{font-size:29px;font-weight:900}.analyticsSub{font-size:14px;color:rgba(255,255,255,.55);margin:2px 0 18px}\n        .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.card{background:rgba(255,255,255,.055);border:2px solid rgba(255,255,255,.12);border-radius:12px;padding:14px 7px;text-align:center}.value{font-size:25px;font-weight:900;color:#fff}.label{font-size:10px;font-weight:800;color:rgba(255,255,255,.5);margin-top:5px;letter-spacing:.6px;text-transform:uppercase}\n        .action{width:100%;height:52px;margin-top:12px;border:2px solid rgba(255,255,255,.15);border-radius:12px;color:#fff;background:rgba(255,255,255,.075);font-size:15px;font-weight:850;touch-action:manipulation}.action.reset{color:#ffb28d}\n\n        /* Achievement & Challenge Styles */\n        .achievementItem{display:flex;flex-direction:column;align-items:stretch;background:rgba(255,255,255,.055);border:2px solid rgba(255,255,255,.12);border-radius:12px;padding:12px 14px;margin-bottom:8px}\n        .achievementRow{display:flex;align-items:center;justify-content:space-between;width:100%}\n        .achievementItem.unlocked{border-color:var(--ui-accent);background:rgba(141,76,255,.12)}\n        .achInfo{display:flex;flex-direction:column;gap:3px;text-align:left}\n        .achTitle{font-weight:850;font-size:14px}\n        .achDesc{font-size:11px;color:rgba(255,255,255,.5)}\n        .achStatus{font-size:12px;font-weight:900;padding:4px 8px;border-radius:6px;background:rgba(255,255,255,.08)}\n        .achievementItem.unlocked .achStatus{background:var(--ui-accent);color:#fff}\n\n        /* Progress Bar Styles */\n        .challengeProgressContainer{width:100%;background:rgba(255,255,255,.1);border-radius:6px;height:8px;margin-top:8px;overflow:hidden;position:relative}\n        .challengeProgressBar{height:100%;background:var(--ui-accent);width:0%;border-radius:6px;transition:width 0.3s ease}\n\n        /* Streak Banner Style */\n        .streakBanner{background:linear-gradient(135deg,rgba(255,159,67,0.2),rgba(228,111,0,0.2));border:2px solid rgba(255,159,67,0.4);border-radius:12px;padding:12px;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between}\n        .streakCount{font-size:20px;font-weight:900;color:#ff9f43}\n\n        #hint{position:absolute;bottom:28px;left:0;width:100%;z-index:15;text-align:center;color:#fff;font-weight:800;text-shadow:0 2px 4px rgba(0,0,0,.5);pointer-events:none}\n        #flashOverlay{position:absolute;inset:0;z-index:45;background:#fff;opacity:0;pointer-events:none}\n        @keyframes scorePop{\n         0%{transform:translateX(-50%) scale(1);}\n         35%{transform:translateX(-50%) scale(1.38);}\n         62%{transform:translateX(-50%) scale(.90);}\n         100%{transform:translateX(-50%) scale(1);}\n        }\n        #score.scorePop{animation:scorePop .38s cubic-bezier(.34,1.56,.64,1);}\n\n        .settingsPanel{max-height:88vh;overflow:auto}\n        .settingsHeaderTop{display:flex;align-items:center;justify-content:space-between;margin-bottom:2px;cursor:pointer}\n        .settingsTitle{font-size:29px;font-weight:900;margin:0}\n        .closeIconButton{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.08);border:2px solid rgba(255,255,255,.15);color:#fff;font-size:18px;display:flex;align-items:center;justify-content:center}\n        .settingsSub{font-size:14px;color:rgba(255,255,255,.55);margin:4px 0 18px}\n        .settingGroup{padding:14px 0;border-top:2px solid rgba(255,255,255,.12)}\n        .settingGroup:first-of-type{border-top:0}\n        .settingRow{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:10px 0}\n        .settingName{font-size:15px;font-weight:800}\n        .settingDesc{font-size:11px;color:rgba(255,255,255,.48);margin-top:3px}\n        .switch{position:relative;width:50px;height:29px;flex:0 0 auto}\n        .switch input{opacity:0;width:0;height:0}\n        .slider{position:absolute;inset:0;border-radius:6px;background:#39444b;transition:.18s}\n        .slider:before{content:\"\";position:absolute;width:21px;height:21px;left:4px;top:4px;border-radius:4px;background:#fff;transition:.18s;box-shadow:0 2px 5px rgba(0,0,0,.25)}\n        .switch input:checked+.slider{background:var(--ui-accent)}\n        .switch input:checked+.slider:before{transform:translateX(21px)}\n        .rangeWrap{width:100%;margin-top:8px}\n        .rangeWrap input{width:100%;accent-color:var(--ui-accent)}\n        .rangeValue{text-align:right;font-size:12px;color:rgba(255,255,255,.55);margin-top:3px}\n        .choiceGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}\n        .choiceGrid2{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:10px}\n        .choice{height:42px;border-radius:10px;border:2px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);color:#fff;font-weight:800;font-size:12px}\n        .choice.active{border-color:var(--ui-accent);background:rgba(141,76,255,.20);box-shadow:inset 0 0 0 1px var(--ui-accent)}\n        .colorGrid{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}\n        .colorChoice{width:32px;height:32px;border-radius:6px;border:2px solid rgba(255,255,255,.28);padding:0}\n        .colorChoice.active{outline:2px solid #fff;outline-offset:2px}\n        .settingsFooter{display:flex;gap:9px;margin-top:12px}\n        .settingsFooter button{flex:1}\n        .lightMode .panel,.lightMode .pausePanel,.lightMode .analyticsPanel,.lightMode .settingsPanel,.lightMode .achievementsPanel{background:rgba(248,250,252,var(--ui-panel-alpha));color:#17202a;border-color:rgba(0,0,0,.15)}\n        .lightMode .subtitle,.lightMode .settingsSub,.lightMode .settingDesc,.lightMode .rangeValue,.lightMode .achDesc{color:rgba(23,32,42,.60)}\n        .lightMode .secondary,.lightMode .choice,.lightMode .closeIconButton,.lightMode .homeHeaderBtn,.lightMode #pauseButton,.lightMode .achievementItem,.lightMode .achStatus{background:rgba(0,0,0,.055);color:#17202a;border-color:rgba(0,0,0,.15)}\n        .lightMode .pauseBar{background:#17202a}\n        .lightMode .settingGroup{border-color:rgba(0,0,0,.12)}\n\n        @media(max-height:620px){.panel,.pausePanel,.analyticsPanel,.achievementsPanel{padding:18px}.logo{width:210px;margin-bottom:7px}.uiBtn{height:48px;margin-top:7px}.subtitle{margin-bottom:9px}}\n    </style>\n</head>\n\n<body>\n<div id=\"game\">\n    <canvas id=\"canvas\"></canvas>\n    <div id=\"flashOverlay\"></div>\n    <div id=\"score\">0</div>\n\n    <!-- Pixel Pause Button -->\n    <button id=\"pauseButton\" aria-label=\"Pause\">\n        <div class=\"pauseBar\"></div>\n        <div class=\"pauseBar\"></div>\n    </button>\n\n    <!-- Top Corner Header Buttons on Home Screen -->\n    <button id=\"homeAnalyticsBtn\" class=\"homeHeaderBtn\" aria-label=\"Analytics\">📊</button>\n    <button id=\"homeAchievementsBtn\" class=\"homeHeaderBtn\" aria-label=\"Achievements\">🏆</button>\n    <button id=\"homeSettingsBtn\" class=\"homeHeaderBtn\" aria-label=\"Settings\">⚙</button>\n\n    <div id=\"startScreen\" class=\"screen\" style=\"display:flex\">\n        <div class=\"panel\">\n            <img class=\"logo\" src=\"data:image/png;base64,\" alt=\"Flappy\">\n            <div class=\"streakBanner\">\n                <div style=\"text-align:left\"><div style=\"font-size:11px;font-weight:800;color:rgba(255,255,255,.6);text-transform:uppercase\">Daily Streak</div><div style=\"font-size:13px;font-weight:800\">Keep it going!</div></div>\n                <div class=\"streakCount\"><span id=\"streakDisplay\">1</span> 🔥</div>\n            </div>\n            <div class=\"subtitle\">Navigate through the pipes, and survive.</div>\n            <button id=\"playButton\" class=\"uiBtn primary\"><span class=\"icon\">▶</span> PLAY</button>\n        </div>\n        <div id=\"hint\">TAP TO FLAP</div>\n    </div>\n\n    <div id=\"gameOver\" class=\"screen\">\n        <div class=\"panel\">\n            <div style=\"font-size:13px;font-weight:900;letter-spacing:2px;color:#a970ff;margin-bottom:7px\">FLAPPY</div>\n            <div style=\"font-size:32px;font-weight:950\">GAME OVER</div>\n            <div class=\"resultCard\">\n                <div class=\"resultLabel\">Score</div>\n                <div class=\"resultValue\"><span id=\"finalScore\">0</span></div>\n                <div class=\"best\">BEST <span id=\"bestScore\">0</span></div>\n            </div>\n            <button id=\"restartButton\" class=\"uiBtn primary\"><span class=\"icon\">⟲</span> PLAY AGAIN</button>\n            <button id=\"gameOverAnalyticsButton\" class=\"uiBtn secondary\">VIEW SCORE</button>\n            <button id=\"homeButton\" class=\"uiBtn secondary\">HOME</button>\n        </div>\n    </div>\n\n    <div id=\"pauseScreen\" class=\"screen\">\n        <div class=\"pausePanel\">\n            <div style=\"font-size:12px;font-weight:900;letter-spacing:1.8px;color:#a970ff;margin-bottom:5px\">RUN PAUSED</div>\n            <div class=\"pauseTitle\">PAUSED</div>\n            <div class=\"subtitle\">Take a breath. Your run is waiting.</div>\n            <button id=\"resumeButton\" class=\"uiBtn primary\"><span class=\"icon\">▶</span> RESUME</button>\n            <button id=\"pauseSettingsButton\" class=\"uiBtn secondary\"><span class=\"icon\">⚙</span> SETTINGS</button>\n            <button id=\"quitButton\" class=\"uiBtn secondary\"><span class=\"icon\">⌂</span> QUIT</button>\n        </div>\n    </div>\n\n    <div id=\"analyticsScreen\" class=\"screen\">\n        <div class=\"analyticsPanel\">\n            <div class=\"analyticsHeader\"><div style=\"font-size:22px;color:#a970ff\">📊</div><div class=\"analyticsTitle\">ANALYTICS</div></div>\n            <div class=\"analyticsSub\">Your Flappy performance</div>\n            <div class=\"grid\">\n                <div class=\"card\"><div id=\"gamesPlayed\" class=\"value\">0</div><div class=\"label\">Games Played</div></div>\n                <div class=\"card\"><div id=\"bestAnalytics\" class=\"value\">0</div><div class=\"label\">Best Score</div></div>\n                <div class=\"card\"><div id=\"totalScore\" class=\"value\">0</div><div class=\"label\">Total Score</div></div>\n                <div class=\"card\"><div id=\"averageScore\" class=\"value\">0</div><div class=\"label\">Average Score</div></div>\n                <div class=\"card\"><div id=\"totalPipes\" class=\"value\">0</div><div class=\"label\">Pipes Passed</div></div>\n                <div class=\"card\"><div id=\"totalFlaps\" class=\"value\">0</div><div class=\"label\">Total Flaps</div></div>\n            </div>\n            <button id=\"closeAnalyticsButton\" class=\"action\">CLOSE</button>\n        </div>\n    </div>\n\n    <div id=\"achievementsScreen\" class=\"screen\">\n        <div class=\"achievementsPanel\">\n            <div class=\"analyticsHeader\"><div style=\"font-size:22px;color:#ff9f43\">🏆</div><div class=\"analyticsTitle\">ACHIEVEMENTS</div></div>\n            <div class=\"analyticsSub\">Complete milestones and daily challenges</div>\n            <div id=\"achievementsList\">\n                <!-- Dynamically populated items -->\n            </div>\n            <button id=\"closeAchievementsButton\" class=\"action\">CLOSE</button>\n        </div>\n    </div>\n</div>\n\n<div id=\"settingsScreen\" class=\"screen\">\n    <div class=\"settingsPanel\">\n        <div class=\"settingsHeaderTop\" id=\"secretHeaderTrigger\">\n            <div class=\"settingsTitle\">SETTINGS</div>\n            <button id=\"headerCloseSettingsButton\" class=\"closeIconButton\" aria-label=\"Close Settings\">✕</button>\n        </div>\n        <div class=\"settingsSub\">Customize the look and feel of your game.</div>\n\n        <!-- Secret Cheat Code Input Panel (Hidden by default) -->\n        <div id=\"secretCheatPanel\" class=\"settingGroup\" style=\"display:none; background:rgba(141,76,255,0.1); border:2px dashed var(--ui-accent); border-radius:12px; padding:12px; margin-bottom:12px;\">\n            <div class=\"settingName\" style=\"color:#a970ff;\">🔒 Secret Cheat Terminal</div>\n            <div class=\"settingDesc\">Enter override code below:</div>\n            <div style=\"display:flex; gap:8px; margin-top:8px;\">\n                <input id=\"secretCodeInput\" type=\"text\" placeholder=\"Enter code...\" style=\"flex:1; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.2); border-radius:8px; padding:8px; color:#fff; font-family:inherit;\">\n                <button id=\"submitSecretCode\" class=\"action\" style=\"margin-top:0; width:90px; background:var(--ui-accent);\">UNLOCK</button>\n            </div>\n        </div>\n\n        <!-- Background Theme Setting -->\n        <div class=\"settingGroup\">\n            <div class=\"settingName\">Background Theme</div>\n            <div class=\"settingDesc\">Choose between day or night skies.</div>\n            <div class=\"choiceGrid2\">\n                <button class=\"choice\" data-theme=\"day\">☀️ Day Sky</button>\n                <button class=\"choice\" data-theme=\"night\">🌙 Night Sky</button>\n            </div>\n        </div>\n\n        <!-- Pipe Color Setting -->\n        <div class=\"settingGroup\">\n            <div class=\"settingName\">Pipe Color Style</div>\n            <div class=\"settingDesc\">Select your preferred pipe color theme.</div>\n            <div class=\"choiceGrid2\">\n                <button class=\"choice\" data-pipecolor=\"green\">🟢 Classic Green</button>\n                <button class=\"choice\" data-pipecolor=\"blue\">🔵 Neon Blue</button>\n                <button class=\"choice\" data-pipecolor=\"red\">🔴 Crimson Red</button>\n                <button class=\"choice\" data-pipecolor=\"gold\">🟡 Golden Yellow</button>\n            </div>\n        </div>\n\n        <div class=\"settingGroup\">\n            <div class=\"settingRow\">\n                <div>\n                    <div class=\"settingName\">Dark Mode</div>\n                    <div class=\"settingDesc\">Use the dark modern interface.</div>\n                </div>\n                <label class=\"switch\">\n                    <input id=\"darkModeToggle\" type=\"checkbox\">\n                    <span class=\"slider\"></span>\n                </label>\n            </div>\n\n            <div class=\"settingRow\">\n                <div>\n                    <div class=\"settingName\">Glass Transparency</div>\n                    <div class=\"settingDesc\">Make menus more or less transparent.</div>\n                </div>\n            </div>\n            <div class=\"rangeWrap\">\n                <input id=\"transparencyRange\" type=\"range\" min=\"20\" max=\"98\" value=\"94\">\n                <div id=\"transparencyValue\" class=\"rangeValue\">94%</div>\n            </div>\n\n            <div class=\"settingRow\">\n                <div>\n                    <div class=\"settingName\">Background Blur</div>\n                    <div class=\"settingDesc\">Adjust the blur behind menus.</div>\n                </div>\n            </div>\n            <div class=\"rangeWrap\">\n                <input id=\"blurRange\" type=\"range\" min=\"0\" max=\"14\" value=\"3\">\n                <div id=\"blurValue\" class=\"rangeValue\">3 px</div>\n            </div>\n        </div>\n\n        <div class=\"settingGroup\">\n            <div class=\"settingName\">Accent Color</div>\n            <div class=\"settingDesc\">Changes buttons and selected controls.</div>\n            <div class=\"colorGrid\">\n                <button class=\"colorChoice\" data-accent=\"#8d4cff\" data-accent2=\"#5d22d8\" style=\"background:linear-gradient(135deg,#8d4cff,#5d22d8)\" aria-label=\"Purple\"></button>\n                <button class=\"colorChoice\" data-accent=\"#1687ff\" data-accent2=\"#0756b8\" style=\"background:linear-gradient(135deg,#1687ff,#0756b8)\" aria-label=\"Blue\"></button>\n                <button class=\"colorChoice\" data-accent=\"#00b894\" data-accent2=\"#007d66\" style=\"background:linear-gradient(135deg,#00b894,#007d66)\" aria-label=\"Green\"></button>\n                <button class=\"colorChoice\" data-accent=\"#ff9f43\" data-accent2=\"#e46f00\" style=\"background:linear-gradient(135deg,#ff9f43,#e46f00)\" aria-label=\"Orange\"></button>\n                <button class=\"colorChoice\" data-accent=\"#ff4d7d\" data-accent2=\"#c71f50\" style=\"background:linear-gradient(135deg,#ff4d7d,#c71f50)\" aria-label=\"Pink\"></button>\n                <button class=\"colorChoice\" data-accent=\"#00b8d9\" data-accent2=\"#007f9b\" style=\"background:linear-gradient(135deg,#00b8d9,#007f9b)\" aria-label=\"Cyan\"></button>\n            </div>\n        </div>\n\n        <div class=\"settingGroup\">\n            <div class=\"settingName\">Panel Style</div>\n            <div class=\"settingDesc\">Choose how rounded the interface feels.</div>\n            <div class=\"choiceGrid\">\n                <button class=\"choice\" data-radius=\"14px\">Compact</button>\n                <button class=\"choice\" data-radius=\"22px\">Modern</button>\n                <button class=\"choice\" data-radius=\"30px\">Rounded</button>\n            </div>\n        </div>\n\n        <div class=\"settingGroup\">\n            <div class=\"settingName\">Sound &amp; Haptics</div>\n            <div class=\"settingDesc\">Control audio and vibration feedback.</div>\n\n            <div class=\"settingRow\">\n                <div>\n                    <div class=\"settingName\">Sound Effects</div>\n                    <div class=\"settingDesc\">Flap, score, and crash sounds.</div>\n                </div>\n                <label class=\"switch\">\n                    <input id=\"soundToggle\" type=\"checkbox\">\n                    <span class=\"slider\"></span>\n                </label>\n            </div>\n\n            <div class=\"settingRow\">\n                <div>\n                    <div class=\"settingName\">Music</div>\n                    <div class=\"settingDesc\">Looping background track.</div>\n                </div>\n                <label class=\"switch\">\n                    <input id=\"musicToggle\" type=\"checkbox\">\n                    <span class=\"slider\"></span>\n                </label>\n            </div>\n\n            <div class=\"settingRow\">\n                <div>\n                    <div class=\"settingName\">Haptics</div>\n                    <div class=\"settingDesc\">Vibrate on flap, score, and crash.</div>\n                </div>\n                <label class=\"switch\">\n                    <input id=\"hapticsToggle\" type=\"checkbox\">\n                    <span class=\"slider\"></span>\n                </label>\n            </div>\n        </div>\n\n        <!-- Secret Unlocked Cheat Section (Hidden initially) -->\n        <div id=\"cheatSettingGroup\" class=\"settingGroup\" style=\"display:none; border-color:var(--ui-accent);\">\n            <div class=\"settingRow\">\n                <div>\n                    <div class=\"settingName\" style=\"color:#a970ff;\">🌟 God Mode (No Pipe Death)</div>\n                    <div class=\"settingDesc\">Pass straight through pipes safely.</div>\n                </div>\n                <label class=\"switch\">\n                    <input id=\"godModeToggle\" type=\"checkbox\">\n                    <span class=\"slider\"></span>\n                </label>\n            </div>\n            <button id=\"lockCheatButton\" class=\"action\" style=\"margin-top:12px; background:rgba(255,75,75,0.2); border-color:rgba(255,75,75,0.4); color:#ffb28d;\">LOCK &amp; HIDE GOD MODE</button>\n        </div>\n\n        <div class=\"settingsFooter\">\n            <button id=\"closeSettingsButton\" class=\"action\">DONE</button>\n        </div>\n    </div>\n</div>\n\n<script>\n    (function(){\n    \"use strict\";\n\n    const canvas=document.getElementById(\"canvas\");\n    const ctx=canvas.getContext(\"2d\",{alpha:false});\n    const scoreEl=document.getElementById(\"score\");\n    const pauseButton=document.getElementById(\"pauseButton\");\n    const flashOverlay=document.getElementById(\"flashOverlay\");\n\n    const startScreen=document.getElementById(\"startScreen\");\n    const gameOverScreen=document.getElementById(\"gameOver\");\n    const pauseScreen=document.getElementById(\"pauseScreen\");\n    const analyticsScreen=document.getElementById(\"analyticsScreen\");\n    const achievementsScreen=document.getElementById(\"achievementsScreen\");\n    const settingsScreen=document.getElementById(\"settingsScreen\");\n    const homeAnalyticsBtn=document.getElementById(\"homeAnalyticsBtn\");\n    const homeAchievementsBtn=document.getElementById(\"homeAchievementsBtn\");\n    const homeSettingsBtn=document.getElementById(\"homeSettingsBtn\");\n\n    let W=0,H=0,dpr=1;\n    let groundH=88;\n\n    const STATE={\n     MENU:\"menu\",\n     PLAYING:\"playing\",\n     PAUSED:\"paused\",\n     GAMEOVER:\"gameover\"\n    };\n    let state=STATE.MENU;\n\n    let animationId=0;\n    let loopActive=false;\n    let lastTime=0;\n\n    let score=0;\n    let flaps=0;\n    let highScore=0;\n\n    // Game-over tumble/bounce variables\n    let deathPhase=\"alive\"; // alive -> falling -> bouncing -> finished\n    let deathVy=0;\n    let deathAngle=0;\n    let groundBounceCount=0;\n\n    const bird={\n     x:0,y:0,w:58,h:50,\n     velocity:0,\n     gravity:1450,\n     flapVelocity:-460,\n     rotation:0,\n     frame:\"data:image/png;base64,\",\n     flapAnim:99,\n     dead:false\n    };\n    const flapAnimDuration=0.16;\n\n    const particles=[];\n    function spawnBurst(x,y,count,opts){\n     opts=opts||{};\n     for(let i=0;i<count;i++){\n      const baseAngle=opts.angle!=null?opts.angle:Math.random()*Math.PI*2;\n      const spread=opts.spread!=null?opts.spread:Math.PI*2;\n      const angle=baseAngle+(Math.random()-0.5)*spread;\n      const minSpeed=opts.minSpeed!=null?opts.minSpeed:60;\n      const maxSpeed=opts.maxSpeed!=null?opts.maxSpeed:160;\n      const speed=minSpeed+Math.random()*(maxSpeed-minSpeed);\n      const minSize=opts.minSize!=null?opts.minSize:3;\n      const maxSize=opts.maxSize!=null?opts.maxSize:6;\n      let color=opts.color||\"#ffffff\";\n      if(opts.colors)color=opts.colors[Math.floor(Math.random()*opts.colors.length)];\n      particles.push({\n       x:x,y:y,\n       vx:Math.cos(angle)*speed,\n       vy:Math.sin(angle)*speed,\n       life:0,\n       maxLife:opts.life||0.6,\n       size:minSize+Math.random()*(maxSize-minSize),\n       color:color,\n       gravity:opts.gravity!=null?opts.gravity:220,\n       shape:opts.shape||\"circle\",\n       spin:(Math.random()-0.5)*8\n      });\n     }\n    }\n    function updateParticles(dt){\n     for(let i=particles.length-1;i>=0;i--){\n      const p=particles[i];\n      p.life+=dt;\n      if(p.life>=p.maxLife){particles.splice(i,1);continue;}\n      p.vy+=p.gravity*dt;\n      p.x+=p.vx*dt;\n      p.y+=p.vy*dt;\n     }\n    }\n    function drawParticles(){\n     for(let i=0;i<particles.length;i++){\n      const p=particles[i];\n      const t=p.life/p.maxLife;\n      const alpha=Math.max(0,1-t);\n      ctx.save();\n      ctx.globalAlpha=alpha;\n      ctx.fillStyle=p.color;\n      if(p.shape===\"feather\"){\n       ctx.translate(p.x,p.y);\n       ctx.rotate(Math.atan2(p.vy,p.vx)+p.spin*t);\n       ctx.beginPath();\n       ctx.rect(-p.size*0.85, -p.size*0.4, p.size*1.7, p.size*0.8);\n       ctx.fill();\n      }else{\n       ctx.fillRect(p.x-p.size/2, p.y-p.size/2, p.size, p.size);\n      }\n      ctx.restore();\n     }\n    }\n\n    let shakeTimer=0,shakeDuration=0,shakeMagnitude=0;\n    function triggerShake(duration,magnitude){\n     shakeDuration=duration;shakeTimer=duration;shakeMagnitude=magnitude;\n    }\n    function updateShake(dt){\n     if(shakeTimer>0)shakeTimer=Math.max(0,shakeTimer-dt);\n    }\n    function getShakeOffset(){\n     if(shakeTimer<=0||shakeDuration<=0)return{x:0,y:0};\n     const t=shakeTimer/shakeDuration;\n     const mag=shakeMagnitude*t*t;\n     return{x:(Math.random()*2-1)*mag,y:(Math.random()*2-1)*mag};\n    }\n\n    let flashTimer=0;\n    const flashDuration=0.28;\n    function triggerFlash(){flashTimer=flashDuration;}\n    function updateFlash(dt){\n     if(flashTimer>0){\n      flashTimer=Math.max(0,flashTimer-dt);\n      flashOverlay.style.opacity=((flashTimer/flashDuration)*0.85).toFixed(3);\n     }else{\n      flashOverlay.style.opacity=0;\n     }\n    }\n\n    function popScore(){\n     scoreEl.classList.remove(\"scorePop\");\n     void scoreEl.offsetWidth;\n     scoreEl.classList.add(\"scorePop\");\n    }\n\n    let audioCtx=null;\n    let audioUnlocked=false;\n\n    function ensureAudio(){\n     if(!audioCtx){\n      try{audioCtx=new(window.AudioContext||window.webkitAudioContext)();}catch(e){}\n     }\n     if(audioCtx && audioCtx.state===\"suspended\"){\n      audioCtx.resume();\n     }\n    }\n\n    function unlockAudioOnce(){\n     if(audioUnlocked)return;\n     audioUnlocked=true;\n     ensureAudio();\n     if(uiSettings.musicOn)startMusic();\n    }\n\n    function vibrate(pattern){\n     if(!uiSettings.hapticsOn)return;\n     if(navigator.vibrate){\n      try{navigator.vibrate(pattern);}catch(e){}\n     }\n    }\n\n    function beep(freq,duration,type,peakGain,delay){\n     if(!uiSettings.soundOn||!audioCtx)return;\n     const t0=audioCtx.currentTime+(delay||0);\n     const osc=audioCtx.createOscillator();\n     const gain=audioCtx.createGain();\n     osc.type=type||\"sine\";\n     osc.frequency.setValueAtTime(freq,t0);\n     gain.gain.setValueAtTime(0,t0);\n     gain.gain.linearRampToValueAtTime(peakGain||0.22,t0+0.008);\n     gain.gain.exponentialRampToValueAtTime(0.0001,t0+duration);\n     osc.connect(gain).connect(audioCtx.destination);\n     osc.start(t0);\n     osc.stop(t0+duration+0.03);\n    }\n\n    function playFlap(){\n     ensureAudio();\n     if(!uiSettings.soundOn||!audioCtx)return;\n     const t0=audioCtx.currentTime;\n     const osc=audioCtx.createOscillator();\n     const gain=audioCtx.createGain();\n     osc.type=\"sine\";\n     osc.frequency.setValueAtTime(560,t0);\n     osc.frequency.exponentialRampToValueAtTime(230,t0+0.12);\n     gain.gain.setValueAtTime(0.20,t0);\n     gain.gain.exponentialRampToValueAtTime(0.0001,t0+0.13);\n     osc.connect(gain).connect(audioCtx.destination);\n     osc.start(t0);\n     osc.stop(t0+0.15);\n    }\n\n    function playPoint(){\n     ensureAudio();\n     if(!uiSettings.soundOn||!audioCtx)return;\n     beep(880,0.09,\"square\",0.16,0);\n     beep(1320,0.13,\"square\",0.13,0.06);\n    }\n\n    function playCrash(){\n     ensureAudio();\n     if(!uiSettings.soundOn||!audioCtx)return;\n     const t0=audioCtx.currentTime;\n     const bufferSize=Math.floor(audioCtx.sampleRate*0.3);\n     const buffer=audioCtx.createBuffer(1,bufferSize,audioCtx.sampleRate);\n     const data=buffer.getChannelData(0);\n     for(let i=0;i<bufferSize;i++){\n      data[i]=(Math.random()*2-1)*(1-i/bufferSize);\n     }\n     const noise=audioCtx.createBufferSource();\n     noise.buffer=buffer;\n     const filter=audioCtx.createBiquadFilter();\n     filter.type=\"lowpass\";\n     filter.frequency.setValueAtTime(900,t0);\n     const gain=audioCtx.createGain();\n     gain.gain.setValueAtTime(0.45,t0);\n     gain.gain.exponentialRampToValueAtTime(0.0001,t0+0.3);\n     noise.connect(filter).connect(gain).connect(audioCtx.destination);\n     noise.start(t0);\n     beep(90,0.25,\"sine\",0.28,0);\n    }\n\n    function playBlip(){\n     ensureAudio();\n     if(!uiSettings.soundOn||!audioCtx)return;\n     beep(660,0.06,\"sine\",0.13,0);\n    }\n\n    let musicNodes=null;\n    function startMusic(){\n     ensureAudio();\n     if(!audioCtx||musicNodes||!uiSettings.musicOn)return;\n     const master=audioCtx.createGain();\n     master.gain.value=0.035;\n     master.connect(audioCtx.destination);\n\n     const melody=[\n      261.63, 329.63, 392.00, 523.25, 440.00, 392.00, 329.63, 392.00,\n      523.25, 659.25, 523.25, 392.00, 329.63, 293.66, 329.63, 261.63\n     ];\n\n     let step=0;\n     const interval=setInterval(function(){\n      if(!audioCtx||!uiSettings.musicOn)return;\n      const t=audioCtx.currentTime;\n      const freq=melody[step%melody.length];\n\n      const osc=audioCtx.createOscillator();\n      const gain=audioCtx.createGain();\n      osc.type=\"triangle\";\n      osc.frequency.setValueAtTime(freq,t);\n\n      gain.gain.setValueAtTime(0,t);\n      gain.gain.linearRampToValueAtTime(0.25,t+0.02);\n      gain.gain.exponentialRampToValueAtTime(0.0001,t+0.22);\n\n      osc.connect(gain).connect(master);\n      osc.start(t);\n      osc.stop(t+0.25);\n\n      step++;\n     },160);\n\n     musicNodes={master:master,interval:interval};\n    }\n\n    function stopMusic(){\n     if(!musicNodes)return;\n     clearInterval(musicNodes.interval);\n     try{musicNodes.master.disconnect();}catch(e){}\n     musicNodes=null;\n    }\n\n    const pipes=[];\n    const pipeWidth=64;\n    const pipeGap=165;\n    const pipeSpeed=175;\n    let pipeSpawnTimer=0;\n    const pipeSpawnEvery=1.45;\n\n    const images={};\n    const imageNames=[\n     \"data:image/png;base64,\",\n     \"data:image/png;base64,\",\n     \"data:image/png;base64,\",\n     \"data:image/png;base64,\"\n    ];\n\n    imageNames.forEach(function(name){\n     const im=new Image();\n     im.decoding=\"async\";\n     im.src=name;\n     images[name]=im;\n    });\n\n    let analytics={\n     gamesPlayed:0,\n     totalScore:0,\n     totalPipes:0,\n     totalFlaps:0,\n     bestScore:0,\n     streak:1,\n     lastPlayDate:\"\",\n     dailyChallengeDate:\"\",\n     dailyPipesPassed:0,\n     dailyFlapsMade:0\n    };\n\n    function loadData(){\n     try{\n      const a=JSON.parse(localStorage.getItem(\"flappyAnalytics\")||\"null\");\n      if(a && typeof a===\"object\"){\n       analytics={\n        gamesPlayed:Number(a.gamesPlayed)||0,\n        totalScore:Number(a.totalScore)||0,\n        totalPipes:Number(a.totalPipes)||0,\n        totalFlaps:Number(a.totalFlaps)||0,\n        bestScore:Number(a.bestScore)||0,\n        streak:Number(a.streak)||1,\n        lastPlayDate:a.lastPlayDate||\"\",\n        dailyChallengeDate:a.dailyChallengeDate||\"\",\n        dailyPipesPassed:Number(a.dailyPipesPassed)||0,\n        dailyFlapsMade:Number(a.dailyFlapsMade)||0\n       };\n      }\n      highScore=Number(localStorage.getItem(\"flappyHighScore\")||0)||0;\n\n      const todayStr = new Date().toDateString();\n      if(analytics.lastPlayDate !== todayStr){\n       const yesterday = new Date();\n       yesterday.setDate(yesterday.getDate()-1);\n       if(analytics.lastPlayDate === yesterday.toDateString()){\n        analytics.streak++;\n       } else if(analytics.lastPlayDate !== \"\"){\n        analytics.streak = 1;\n       }\n       analytics.lastPlayDate = todayStr;\n       saveData();\n      }\n\n      if(analytics.dailyChallengeDate !== todayStr){\n       analytics.dailyChallengeDate = todayStr;\n       analytics.dailyPipesPassed = 0;\n       analytics.dailyFlapsMade = 0;\n       saveData();\n      }\n     }catch(e){}\n     document.getElementById(\"streakDisplay\").textContent = analytics.streak;\n    }\n    function saveData(){\n     try{\n      localStorage.setItem(\"flappyAnalytics\",JSON.stringify(analytics));\n      localStorage.setItem(\"flappyHighScore\",String(highScore));\n     }catch(e){}\n    }\n    loadData();\n\n    function resize(){\n     W=Math.max(1,window.innerWidth);\n     H=Math.max(1,window.innerHeight);\n\n     dpr=Math.min(window.devicePixelRatio||1,1.5);\n\n     canvas.width=Math.floor(W*dpr);\n     canvas.height=Math.floor(H*dpr);\n     canvas.style.width=W+\"px\";\n     canvas.style.height=H+\"px\";\n\n     ctx.setTransform(dpr,0,0,dpr,0,0);\n     groundH=Math.max(78,Math.min(105,H*.105));\n\n     if(state===STATE.MENU){\n      bird.x=W*.28;\n      bird.y=H*.42;\n     }\n    }\n    window.addEventListener(\"resize\",resize);\n    resize();\n\n    function hideAllScreens(){\n     startScreen.style.display=\"none\";\n     gameOverScreen.style.display=\"none\";\n     pauseScreen.style.display=\"none\";\n     analyticsScreen.style.display=\"none\";\n     achievementsScreen.style.display=\"none\";\n     settingsScreen.style.display=\"none\";\n     homeAnalyticsBtn.style.display=\"none\";\n     homeAchievementsBtn.style.display=\"none\";\n     homeSettingsBtn.style.display=\"none\";\n    }\n\n    function resetGame(){\n     score=0;\n     flaps=0;\n     pipes.length=0;\n     pipeSpawnTimer=0;\n\n     bird.x=W*.28;\n     bird.y=H*.43;\n     bird.velocity=0;\n     bird.rotation=0;\n     bird.frame=\"data:image/png;base64,\";\n     bird.flapAnim=99;\n     bird.dead=false;\n\n     deathPhase=\"alive\";\n     deathVy=0;\n     deathAngle=0;\n     groundBounceCount=0;\n\n     particles.length=0;\n     shakeTimer=0;\n     flashTimer=0;\n     flashOverlay.style.opacity=0;\n\n     scoreEl.textContent=\"0\";\n    }\n\n    function startGame(){\n     unlockAudioOnce();\n     stopLoop();\n\n     resetGame();\n\n     state=STATE.PLAYING;\n\n     hideAllScreens();\n\n     scoreEl.style.display=\"block\";\n     pauseButton.style.display=\"flex\";\n     pauseButton.style.pointerEvents=\"auto\";\n\n     flap();\n\n     startLoop();\n    }\n\n    function flap(){\n     if(state!==STATE.PLAYING || bird.dead)return;\n\n     bird.velocity=bird.flapVelocity;\n     bird.flapAnim=0;\n     flaps++;\n     analytics.dailyFlapsMade++;\n     saveData();\n\n     playFlap();\n     vibrate(12);\n     spawnBurst(bird.x-bird.w*0.32,bird.y+bird.h*0.18,4,{\n      angle:Math.PI,spread:1.1,minSpeed:35,maxSpeed:100,\n      life:0.4,color:\"#ffffff\",gravity:240,minSize:3,maxSize:5,shape:\"feather\"\n     });\n    }\n\n    function pauseGame(){\n     if(state!==STATE.PLAYING)return;\n\n     state=STATE.PAUSED;\n     playBlip();\n\n     pauseScreen.style.display=\"flex\";\n     pauseButton.style.pointerEvents=\"none\";\n\n     stopLoop();\n     draw();\n    }\n\n    function resumeGame(){\n     if(state!==STATE.PAUSED)return;\n     playBlip();\n\n     pauseScreen.style.display=\"none\";\n     state=STATE.PLAYING;\n     pauseButton.style.pointerEvents=\"auto\";\n\n     startLoop();\n    }\n\n    function quitToHome(){\n     playBlip();\n     stopLoop();\n\n     state=STATE.MENU;\n     resetGame();\n\n     pauseButton.style.display=\"none\";\n     pauseButton.style.pointerEvents=\"none\";\n     scoreEl.style.display=\"none\";\n\n     hideAllScreens();\n     startScreen.style.display=\"flex\";\n     homeAnalyticsBtn.style.display=\"flex\";\n     homeAchievementsBtn.style.display=\"flex\";\n     homeSettingsBtn.style.display=\"flex\";\n\n     startLoop();\n    }\n\n    function triggerDeath(){\n     if(bird.dead)return;\n\n     bird.dead=true;\n     deathPhase=\"falling\";\n     deathVy=-300;\n     deathAngle=bird.rotation;\n     groundBounceCount=0;\n\n     triggerShake(0.4,14);\n     triggerFlash();\n     playCrash();\n     vibrate([25,20,55]);\n     spawnBurst(bird.x,bird.y,20,{\n      minSpeed:110,maxSpeed:300,life:0.7,\n      colors:[\"#ffffff\",\"#f2f2f2\",\"#ffe9c7\"],\n      gravity:360,minSize:3,maxSize:7,shape:\"feather\"\n     });\n    }\n\n    function finalizeGameOver(){\n     if(state!==STATE.PLAYING)return;\n\n     state=STATE.GAMEOVER;\n     stopLoop();\n\n     if(score>highScore)highScore=score;\n\n     analytics.gamesPlayed++;\n     analytics.totalScore+=score;\n     analytics.totalPipes+=score;\n     analytics.totalFlaps+=flaps;\n     analytics.bestScore=Math.max(analytics.bestScore,score);\n\n     saveData();\n\n     document.getElementById(\"finalScore\").textContent=score;\n     document.getElementById(\"bestScore\").textContent=highScore;\n\n     pauseButton.style.display=\"none\";\n     pauseButton.style.pointerEvents=\"none\";\n\n     gameOverScreen.style.display=\"flex\";\n     draw();\n    }\n\n    function startLoop(){\n     if(loopActive)return;\n\n     loopActive=true;\n     lastTime=performance.now();\n     animationId=requestAnimationFrame(loop);\n    }\n\n    function stopLoop(){\n     loopActive=false;\n\n     if(animationId){\n      cancelAnimationFrame(animationId);\n      animationId=0;\n     }\n    }\n\n    function loop(now){\n     if(!loopActive){\n      loopActive=false;\n      animationId=0;\n      return;\n     }\n\n     let dt=(now-lastTime)/1000;\n     lastTime=now;\n\n     if(!Number.isFinite(dt) || dt<0)dt=0;\n     if(dt>0.035)dt=0.035;\n\n     update(dt);\n     draw();\n\n     if(loopActive){\n      animationId=requestAnimationFrame(loop);\n     }else{\n      loopActive=false;\n      animationId=0;\n     }\n    }\n\n    function spawnPipe(){\n     const minTop=55;\n     const maxTop=Math.max(\n      minTop+1,\n      H-groundH-pipeGap-70\n     );\n\n     const top=minTop+Math.random()*(maxTop-minTop);\n\n     pipes.push({\n      x:W+20,\n      top:top,\n      bottom:top+pipeGap,\n      passed:false\n     });\n    }\n\n    function updateDeathSequence(dt){\n     deathVy+=1600*dt;\n     bird.y+=deathVy*dt;\n     deathAngle+=8*dt;\n     bird.rotation=deathAngle;\n\n     const groundLevel=H-groundH-bird.h/2;\n     if(bird.y>=groundLevel){\n      bird.y=groundLevel;\n      if(groundBounceCount<1){\n       groundBounceCount++;\n       deathVy=-380;\n       playBlip();\n       spawnBurst(bird.x,bird.y+bird.h/2,8,{minSpeed:40,maxSpeed:120,life:0.3,color:\"#d8bd74\",gravity:200});\n      }else{\n       deathPhase=\"finished\";\n       finalizeGameOver();\n      }\n     }\n\n     updateParticles(dt);\n     updateShake(dt);\n     updateFlash(dt);\n    }\n\n    function update(dt){\n     for(let i=0;i<clouds.length;i++){\n      clouds[i].x -= clouds[i].speed * dt;\n      if(clouds[i].x < -180){\n       clouds[i].x = W + 150;\n       clouds[i].y = 40 + Math.random() * (H * 0.45);\n      }\n     }\n\n     if(state===STATE.MENU){\n      pipeSpawnTimer+=dt;\n      if(pipeSpawnTimer>=pipeSpawnEvery){\n       pipeSpawnTimer-=pipeSpawnEvery;\n       spawnPipe();\n      }\n      for(let i=pipes.length-1;i>=0;i--){\n       pipes[i].x-=pipeSpeed*dt;\n       if(pipes[i].x+pipeWidth<-100){\n        pipes.splice(i,1);\n       }\n      }\n      updateParticles(dt);\n      return;\n     }\n\n     if(bird.dead){\n      updateDeathSequence(dt);\n      return;\n     }\n\n     bird.velocity+=bird.gravity*dt;\n     bird.y+=bird.velocity*dt;\n\n     bird.rotation=Math.max(\n      -0.45,\n      Math.min(1.15,bird.velocity/650)\n     );\n\n     if(bird.flapAnim<flapAnimDuration)bird.flapAnim+=dt;\n\n     if(bird.velocity<-160){\n      bird.frame=\"data:image/png;base64,\";\n     }else if(bird.velocity>170){\n      bird.frame=\"data:image/png;base64,\";\n     }else{\n      bird.frame=\"data:image/png;base64,\";\n     }\n\n     pipeSpawnTimer+=dt;\n\n     if(pipeSpawnTimer>=pipeSpawnEvery){\n      pipeSpawnTimer-=pipeSpawnEvery;\n      spawnPipe();\n     }\n\n     for(let i=pipes.length-1;i>=0;i--){\n      const p=pipes[i];\n\n      p.x-=pipeSpeed*dt;\n\n      if(!p.passed && p.x+pipeWidth<bird.x){\n       p.passed=true;\n       score++;\n       analytics.dailyPipesPassed++;\n       saveData();\n       scoreEl.textContent=String(score);\n       popScore();\n       playPoint();\n       vibrate(18);\n       spawnBurst(bird.x,bird.y,14,{\n        minSpeed:80,maxSpeed:220,life:0.5,\n        colors:[\"#ffd93d\",\"#ffffff\",\"#6dd5ff\"],\n        gravity:140,minSize:2,maxSize:4,shape:\"circle\"\n       });\n      }\n\n      if(p.x+pipeWidth<-100){\n       pipes.splice(i,1);\n       continue;\n      }\n\n      if(checkPipeCollision(p)){\n       if(!uiSettings.godMode){\n        triggerDeath();\n        break;\n       }\n      }\n     }\n\n     if(!bird.dead){\n      const birdTop=bird.y-bird.h*.34;\n      const birdBottom=bird.y+bird.h*.34;\n\n      if(birdTop<=0 || birdBottom>=H-groundH){\n       if(!uiSettings.godMode){\n        triggerDeath();\n       } else {\n        if(birdTop<=0) bird.y = bird.h*.34;\n        if(birdBottom>=H-groundH) bird.y = H - groundH - bird.h*.34;\n       }\n      }\n     }\n\n     updateParticles(dt);\n     updateShake(dt);\n     updateFlash(dt);\n    }\n\n    function checkPipeCollision(p){\n     const left=bird.x-bird.w*.34;\n     const right=bird.x+bird.w*.34;\n     const top=bird.y-bird.h*.34;\n     const bottom=bird.y+bird.h*.34;\n\n     if(right<=p.x || left>=p.x+pipeWidth)return false;\n\n     return top<p.top || bottom>p.bottom;\n    }\n\n    function drawBackground(){\n     const g=ctx.createLinearGradient(0,0,0,H);\n     if(uiSettings.theme===\"night\"){\n      g.addColorStop(0,\"#091226\");\n      g.addColorStop(0.7,\"#1b2a4a\");\n      g.addColorStop(1,\"#2d3e5f\");\n     } else {\n      g.addColorStop(0,\"#4baac4\");\n      g.addColorStop(0.7,\"#70c6cf\");\n      g.addColorStop(1,\"#c8e6df\");\n     }\n     ctx.fillStyle=g;\n     ctx.fillRect(0,0,W,H);\n    }\n\n    const clouds=[\n     {x:100,y:90,speed:38},\n     {x:420,y:160,speed:28},\n     {x:750,y:70,speed:46}\n    ];\n\n    const pixelCloudMatrix = [\n     \"  @@@@@@  \",\n     \" @@@@@@@@@@ \",\n     \"@@@@@@@@@@@@\"\n    ];\n    const pixelSize = 10;\n\n    function drawClouds(){\n     ctx.save();\n     ctx.fillStyle = uiSettings.theme===\"night\" ? \"rgba(200, 215, 240, 0.65)\" : \"rgba(255, 255, 255, 0.9)\";\n     for(let i=0; i<clouds.length; i++){\n      const c = clouds[i];\n      const startX = Math.floor(c.x);\n      const startY = Math.floor(c.y);\n\n      for(let r=0; r<pixelCloudMatrix.length; r++){\n       const row = pixelCloudMatrix[r];\n       for(let col=0; col<row.length; col++){\n        if(row[col]==='@'){\n         ctx.fillRect(startX + (col * pixelSize), startY + (r * pixelSize), pixelSize, pixelSize);\n        }\n       }\n      }\n     }\n     ctx.restore();\n    }\n\n    function pipeGradient(x,w,type){\n     const g=ctx.createLinearGradient(x,0,x+w,0);\n     if(type===\"blue\"){\n      g.addColorStop(0,\"#082440\");g.addColorStop(.10,\"#104478\");\n      g.addColorStop(.27,\"#227cc4\");g.addColorStop(.45,\"#34a4ff\");\n      g.addColorStop(.58,\"#1f88de\");g.addColorStop(.82,\"#115194\");\n      g.addColorStop(1,\"#062038\");\n     }else if(type===\"red\"){\n      g.addColorStop(0,\"#400808\");g.addColorStop(.10,\"#781010\");\n      g.addColorStop(.27,\"#c42222\");g.addColorStop(.45,\"#ff3434\");\n      g.addColorStop(.58,\"#de1f1f\");g.addColorStop(.82,\"#941111\");\n      g.addColorStop(1,\"#380606\");\n     }else if(type===\"gold\"){\n      g.addColorStop(0,\"#403508\");g.addColorStop(.10,\"#786410\");\n      g.addColorStop(.27,\"#c4a822\");g.addColorStop(.45,\"#ffd334\");\n      g.addColorStop(.58,\"#deb21f\");g.addColorStop(.82,\"#947711\");\n      g.addColorStop(1,\"#382f06\");\n     }else{\n      g.addColorStop(0,\"#173f0b\");g.addColorStop(.10,\"#2f7210\");\n      g.addColorStop(.27,\"#62aa1b\");g.addColorStop(.45,\"#8dcc2b\");\n      g.addColorStop(.58,\"#5aa416\");g.addColorStop(.82,\"#31750e\");\n      g.addColorStop(1,\"#123e09\");\n     }\n     return g;\n    }\n\n    function getCapThemeColors(type){\n     if(type===\"blue\") return {dark:\"#061a2e\", mid:\"#227cc4\", bright:\"#34a4ff\", border:\"#04101c\"};\n     if(type===\"red\") return {dark:\"#2e0606\", mid:\"#c42222\", bright:\"#ff3434\", border:\"#1c0404\"};\n     if(type===\"gold\") return {dark:\"#2e2706\", mid:\"#c4a822\", bright:\"#ffd334\", border:\"#1c1804\"};\n     return {dark:\"#103908\", mid:\"#82c325\", bright:\"#9bd632\", border:\"#092505\"};\n    }\n\n    function drawPipeBody(x,y,h,colorType){\n     if(h<=0)return;\n     ctx.save();\n     ctx.fillStyle=pipeGradient(x,pipeWidth,colorType);\n     ctx.fillRect(x,y,pipeWidth,h);\n     const hi=ctx.createLinearGradient(x+pipeWidth*.18,0,x+pipeWidth*.42,0);\n     hi.addColorStop(0,\"rgba(255,255,220,.30)\");hi.addColorStop(.55,\"rgba(255,255,220,.08)\");hi.addColorStop(1,\"rgba(255,255,220,0)\");\n     ctx.fillStyle=hi;ctx.fillRect(x+pipeWidth*.15,y,pipeWidth*.27,h);\n     const sh=ctx.createLinearGradient(x+pipeWidth*.68,0,x+pipeWidth,0);\n     sh.addColorStop(0,\"rgba(0,0,0,0)\");sh.addColorStop(1,\"rgba(0,0,0,.30)\");\n     ctx.fillStyle=sh;ctx.fillRect(x+pipeWidth*.68,y,pipeWidth*.32,h);\n     ctx.strokeStyle=\"rgba(10,38,5,.9)\";ctx.lineWidth=2;ctx.strokeRect(x+1,y+1,pipeWidth-2,Math.max(0,h-2));\n     ctx.restore();\n    }\n    function drawPipeCap(x,y,w,h,colorType){\n     const lipW=w+12, lipX=x-6;\n     const tc=getCapThemeColors(colorType);\n     ctx.save();\n     ctx.fillStyle=tc.dark;ctx.fillRect(lipX,y,lipW,h);\n     const g=ctx.createLinearGradient(lipX,0,lipX+lipW,0);\n     g.addColorStop(0,tc.dark);g.addColorStop(.25,tc.mid);\n     g.addColorStop(.42,tc.bright);g.addColorStop(.75,tc.mid);g.addColorStop(1,tc.dark);\n     ctx.fillStyle=g;ctx.fillRect(lipX+2,y+2,lipW-4,h-4);\n     ctx.fillStyle=\"rgba(255,255,200,.28)\";ctx.fillRect(lipX+lipW*.20,y+3,lipW*.12,h-6);\n     ctx.fillStyle=\"rgba(0,0,0,.24)\";ctx.fillRect(lipX+2,y+h-5,lipW-4,3);\n     ctx.strokeStyle=tc.border;ctx.lineWidth=1.5;ctx.strokeRect(lipX+1,y+1,lipW-2,h-2);\n     ctx.restore();\n    }\n    function drawPipe(p){\n     const capH=27, overlap=2;\n     const ct=uiSettings.pipeColor;\n     drawPipeBody(p.x,0,Math.max(0,p.top-capH+overlap),ct);\n     drawPipeCap(p.x,p.top-capH,pipeWidth,capH,ct);\n     drawPipeCap(p.x,p.bottom,pipeWidth,capH,ct);\n     drawPipeBody(p.x,p.bottom+capH-overlap,Math.max(0,H-groundH-(p.bottom+capH-overlap)),ct);\n    }\n\n    function drawGround(){\n     const im=images[\"data:image/png;base64,\"];\n     const y=H-groundH;\n\n     if(im.complete && im.naturalWidth>0){\n      ctx.drawImage(im,0,y,W,groundH);\n     }else{\n      ctx.fillStyle=uiSettings.theme===\"night\" ? \"#42573d\" : \"#d8bd74\";\n      ctx.fillRect(0,y,W,groundH);\n     }\n    }\n\n    function squashStretchScale(t){\n     if(t>=1)return{x:1,y:1};\n     const s=Math.sin(t*Math.PI);\n     return{x:1+s*0.20,y:1-s*0.24};\n    }\n\n    function drawBird(){\n     const im=images[bird.frame];\n\n     if(!im.complete || !im.naturalWidth)return;\n\n     ctx.save();\n\n     ctx.translate(bird.x,bird.y);\n     ctx.rotate(bird.rotation);\n\n     const t=bird.flapAnim/flapAnimDuration;\n     const scale=squashStretchScale(t);\n     ctx.scale(scale.x,scale.y);\n\n     if(uiSettings.godMode){\n      ctx.shadowColor=\"#8d4cff\";\n      ctx.shadowBlur=15;\n     }\n\n     ctx.drawImage(\n      im,\n      -bird.w/2,\n      -bird.h/2,\n      bird.w,\n      bird.h\n     );\n\n     ctx.restore();\n    }\n\n    function draw(){\n     const shakeOff=getShakeOffset();\n\n     ctx.save();\n     ctx.translate(shakeOff.x,shakeOff.y);\n\n     drawBackground();\n     drawClouds();\n\n     for(let i=0;i<pipes.length;i++){\n      drawPipe(pipes[i]);\n     }\n\n     drawGround();\n     if(state!==STATE.MENU || bird.dead)drawBird();\n     drawParticles();\n\n     ctx.restore();\n    }\n\n    function handleFlapInput(e){\n     if(e && e.cancelable)e.preventDefault();\n\n     if(state===STATE.PLAYING){\n      flap();\n     }\n    }\n\n    canvas.addEventListener(\"pointerdown\",handleFlapInput,{passive:false});\n\n    document.addEventListener(\"keydown\",function(e){\n     if(e.code===\"Space\" || e.code===\"ArrowUp\"){\n      e.preventDefault();\n      handleFlapInput(e);\n     }\n\n     if(e.code===\"KeyP\"){\n      if(state===STATE.PLAYING)pauseGame();\n      else if(state===STATE.PAUSED)resumeGame();\n     }\n    });\n\n    const defaultSettings={\n     darkMode:true,\n     transparency:94,\n     blur:3,\n     accent:\"#8d4cff\",\n     accent2:\"#5d22d8\",\n     radius:\"26px\",\n     soundOn:true,\n     musicOn:true,\n     hapticsOn:true,\n     theme:\"day\",\n     pipeColor:\"green\",\n     godMode:false,\n     cheatUnlocked:false\n    };\n    let uiSettings=Object.assign({},defaultSettings);\n\n    function applyUISettings(){\n     document.documentElement.style.setProperty(\"--ui-panel-alpha\",(uiSettings.transparency/100).toFixed(2));\n     document.documentElement.style.setProperty(\"--ui-overlay-alpha\",Math.min(.62,Math.max(.18,(100-uiSettings.transparency)/100+.18)).toFixed(2));\n     document.documentElement.style.setProperty(\"--ui-blur\",uiSettings.blur+\"px\");\n     document.documentElement.style.setProperty(\"--ui-accent\",uiSettings.accent);\n     document.documentElement.style.setProperty(\"--ui-accent2\",uiSettings.accent2);\n     document.documentElement.style.setProperty(\"--ui-radius\",uiSettings.radius);\n\n     document.body.classList.toggle(\"lightMode\",!uiSettings.darkMode);\n     document.getElementById(\"darkModeToggle\").checked=uiSettings.darkMode;\n     document.getElementById(\"transparencyRange\").value=uiSettings.transparency;\n     document.getElementById(\"transparencyValue\").textContent=uiSettings.transparency+\"%\";\n     document.getElementById(\"blurRange\").value=uiSettings.blur;\n     document.getElementById(\"blurValue\").textContent=uiSettings.blur+\" px\";\n\n     document.getElementById(\"soundToggle\").checked=uiSettings.soundOn;\n     document.getElementById(\"musicToggle\").checked=uiSettings.musicOn;\n     document.getElementById(\"hapticsToggle\").checked=uiSettings.hapticsOn;\n     document.getElementById(\"godModeToggle\").checked=uiSettings.godMode;\n\n     if(uiSettings.cheatUnlocked){\n      document.getElementById(\"cheatSettingGroup\").style.display=\"block\";\n     }else{\n      document.getElementById(\"cheatSettingGroup\").style.display=\"none\";\n     }\n\n     document.querySelectorAll(\".colorChoice\").forEach(function(el){\n       el.classList.toggle(\"active\",el.dataset.accent===uiSettings.accent);\n     });\n     document.querySelectorAll(\".choice[data-radius]\").forEach(function(el){\n       el.classList.toggle(\"active\",el.dataset.radius===uiSettings.radius);\n     });\n     document.querySelectorAll(\".choice[data-theme]\").forEach(function(el){\n       el.classList.toggle(\"active\",el.dataset.theme===uiSettings.theme);\n     });\n     document.querySelectorAll(\".choice[data-pipecolor]\").forEach(function(el){\n       el.classList.toggle(\"active\",el.dataset.pipecolor===uiSettings.pipeColor);\n     });\n    }\n\n    function loadUISettings(){\n     try{\n       const saved=JSON.parse(localStorage.getItem(\"flappyUISettings\")||\"null\");\n       if(saved && typeof saved===\"object\"){\n         uiSettings=Object.assign({},defaultSettings,saved);\n       }\n     }catch(e){}\n     applyUISettings();\n    }\n\n    function saveUISettings(){\n     try{localStorage.setItem(\"flappyUISettings\",JSON.stringify(uiSettings));}catch(e){}\n     applyUISettings();\n    }\n\n    function showSettings(){\n     playBlip();\n     hideAllScreens();\n     settingsScreen.style.display=\"flex\";\n     pauseButton.style.display=\"none\";\n     pauseButton.style.pointerEvents=\"none\";\n     applyUISettings();\n    }\n\n    function closeSettings(){\n     playBlip();\n     settingsScreen.style.display=\"none\";\n     if(state===STATE.MENU){\n       startScreen.style.display=\"flex\";\n       homeAnalyticsBtn.style.display=\"flex\";\n       homeAchievementsBtn.style.display=\"flex\";\n       homeSettingsBtn.style.display=\"flex\";\n     }else if(state===STATE.GAMEOVER){\n       gameOverScreen.style.display=\"flex\";\n     }else if(state===STATE.PAUSED){\n       pauseScreen.style.display=\"flex\";\n     }else{\n       startScreen.style.display=\"flex\";\n       homeAnalyticsBtn.style.display=\"flex\";\n       homeAchievementsBtn.style.display=\"flex\";\n       homeSettingsBtn.style.display=\"flex\";\n     }\n    }\n\n    loadUISettings();\n\n    function bindButton(id,fn){\n     const el=document.getElementById(id);\n     if(!el)return;\n     let locked=false;\n     function activate(e){\n      if(e){\n       if(e.cancelable)e.preventDefault();\n       e.stopPropagation();\n      }\n      if(locked)return;\n      locked=true;\n      fn();\n      setTimeout(function(){locked=false;},180);\n     }\n     el.addEventListener(\"click\",activate,false);\n     el.addEventListener(\"pointerup\",activate,false);\n    }\n\n    bindButton(\"playButton\",startGame);\n    bindButton(\"restartButton\",startGame);\n    bindButton(\"resumeButton\",resumeGame);\n    bindButton(\"pauseSettingsButton\",showSettings);\n    bindButton(\"quitButton\",quitToHome);\n    bindButton(\"homeButton\",quitToHome);\n    bindButton(\"homeAnalyticsBtn\",showAnalytics);\n    bindButton(\"homeAchievementsBtn\",showAchievements);\n    bindButton(\"homeSettingsBtn\",showSettings);\n    bindButton(\"gameOverAnalyticsButton\",showAnalytics);\n    bindButton(\"closeSettingsButton\",closeSettings);\n    bindButton(\"headerCloseSettingsButton\",closeSettings);\n\n    // Secret trigger counter setup (Toggles open/close every 5 clicks)\n    let headerClickCount = 0;\n    document.getElementById(\"secretHeaderTrigger\").addEventListener(\"click\", function(){\n     headerClickCount++;\n     if(headerClickCount >= 11){\n      const cheatPanel = document.getElementById(\"secretCheatPanel\");\n\n      if(cheatPanel.style.display === \"none\" || cheatPanel.style.display === \"\"){\n       cheatPanel.style.display = \"block\";\n       playPoint();\n      } else {\n       cheatPanel.style.display = \"none\";\n       document.getElementById(\"secretCodeInput\").value = \"\";\n       playBlip();\n      }\n\n      headerClickCount = 0;\n     }\n    });\n\n    document.getElementById(\"submitSecretCode\").addEventListener(\"click\", function(){\n     const val = document.getElementById(\"secretCodeInput\").value.trim().toLowerCase();\n     if(val === \"doublecheeseburger\"){\n      uiSettings.cheatUnlocked = true;\n      saveUISettings();\n      document.getElementById(\"secretCheatPanel\").style.display = \"none\";\n      document.getElementById(\"cheatSettingGroup\").style.display = \"block\";\n      playPoint();\n      vibrate([50,50,50]);\n      alert(\"CHEAT UNLOCKED: God Mode option is now available in settings!\");\n     } else {\n      playCrash();\n      alert(\"Invalid Code!\");\n     }\n    });\n\n    // Lock & Hide God Mode button action\n    document.getElementById(\"lockCheatButton\").addEventListener(\"click\", function(){\n     uiSettings.cheatUnlocked = false;\n     uiSettings.godMode = false;\n     saveUISettings();\n\n     document.getElementById(\"cheatSettingGroup\").style.display = \"none\";\n     document.getElementById(\"secretCodeInput\").value = \"\";\n     headerClickCount = 0;\n\n     playBlip();\n     alert(\"God Mode has been disabled and hidden from settings.\");\n    });\n\n    bindButton(\"closeAnalyticsButton\",function(){\n     playBlip();\n     analyticsScreen.style.display=\"none\";\n     if(state===STATE.MENU){\n       startScreen.style.display=\"flex\";\n       homeAnalyticsBtn.style.display=\"flex\";\n       homeAchievementsBtn.style.display=\"flex\";\n       homeSettingsBtn.style.display=\"flex\";\n     }\n     else if(state===STATE.GAMEOVER)gameOverScreen.style.display=\"flex\";\n    });\n\n    bindButton(\"closeAchievementsButton\",function(){\n     playBlip();\n     achievementsScreen.style.display=\"none\";\n     if(state===STATE.MENU){\n       startScreen.style.display=\"flex\";\n       homeAnalyticsBtn.style.display=\"flex\";\n       homeAchievementsBtn.style.display=\"flex\";\n       homeSettingsBtn.style.display=\"flex\";\n     }\n     else if(state===STATE.GAMEOVER)gameOverScreen.style.display=\"flex\";\n    });\n\n    pauseButton.addEventListener(\"pointerup\",function(e){\n     if(e.cancelable)e.preventDefault();\n     e.stopPropagation();\n     if(state===STATE.PLAYING)pauseGame();\n    },false);\n\n    pauseButton.addEventListener(\"click\",function(e){\n     e.preventDefault();\n     e.stopPropagation();\n     if(state===STATE.PLAYING)pauseGame();\n    },false);\n\n    document.getElementById(\"darkModeToggle\").addEventListener(\"change\",function(){\n     uiSettings.darkMode=this.checked;\n     saveUISettings();\n    });\n    document.getElementById(\"transparencyRange\").addEventListener(\"input\",function(){\n     uiSettings.transparency=Number(this.value);\n     saveUISettings();\n    });\n    document.getElementById(\"blurRange\").addEventListener(\"input\",function(){\n     uiSettings.blur=Number(this.value);\n     saveUISettings();\n    });\n\n    document.getElementById(\"soundToggle\").addEventListener(\"change\",function(){\n     uiSettings.soundOn=this.checked;\n     saveUISettings();\n    });\n    document.getElementById(\"musicToggle\").addEventListener(\"change\",function(){\n     uiSettings.musicOn=this.checked;\n     saveUISettings();\n     if(uiSettings.musicOn){\n      startMusic();\n     }else{\n      stopMusic();\n     }\n    });\n    document.getElementById(\"hapticsToggle\").addEventListener(\"change\",function(){\n     uiSettings.hapticsOn=this.checked;\n     saveUISettings();\n     if(uiSettings.hapticsOn) vibrate(20);\n    });\n\n    document.getElementById(\"godModeToggle\").addEventListener(\"change\",function(){\n     uiSettings.godMode=this.checked;\n     saveUISettings();\n    });\n\n    document.querySelectorAll(\".colorChoice\").forEach(function(el){\n     el.addEventListener(\"click\",function(e){\n       e.preventDefault();\n       uiSettings.accent=this.dataset.accent;\n       uiSettings.accent2=this.dataset.accent2;\n       saveUISettings();\n     });\n    });\n    document.querySelectorAll(\".choice[data-radius]\").forEach(function(el){\n     el.addEventListener(\"click\",function(e){\n       e.preventDefault();\n       uiSettings.radius=this.dataset.radius;\n       saveUISettings();\n     });\n    });\n    document.querySelectorAll(\".choice[data-theme]\").forEach(function(el){\n     el.addEventListener(\"click\",function(e){\n       e.preventDefault();\n       uiSettings.theme=this.dataset.theme;\n       saveUISettings();\n     });\n    });\n    document.querySelectorAll(\".choice[data-pipecolor]\").forEach(function(el){\n     el.addEventListener(\"click\",function(e){\n       e.preventDefault();\n       uiSettings.pipeColor=this.dataset.pipecolor;\n       saveUISettings();\n     });\n    });\n\n    function updateAnalytics(){\n     document.getElementById(\"gamesPlayed\").textContent=analytics.gamesPlayed;\n     document.getElementById(\"bestAnalytics\").textContent=analytics.bestScore;\n     document.getElementById(\"totalScore\").textContent=analytics.totalScore;\n     document.getElementById(\"averageScore\").textContent=\n      analytics.gamesPlayed\n      ? (analytics.totalScore/analytics.gamesPlayed).toFixed(1)\n      : \"0\";\n     document.getElementById(\"totalPipes\").textContent=analytics.totalPipes;\n     document.getElementById(\"totalFlaps\").textContent=analytics.totalFlaps;\n    }\n\n    function showAnalytics(){\n     playBlip();\n     stopLoop();\n     updateAnalytics();\n\n     startScreen.style.display=\"none\";\n     gameOverScreen.style.display=\"none\";\n     pauseScreen.style.display=\"none\";\n     achievementsScreen.style.display=\"none\";\n     analyticsScreen.style.display=\"flex\";\n     homeAnalyticsBtn.style.display=\"none\";\n     homeAchievementsBtn.style.display=\"none\";\n     homeSettingsBtn.style.display=\"none\";\n\n     pauseButton.style.display=\"none\";\n     pauseButton.style.pointerEvents=\"none\";\n    }\n\n    function updateAchievements(){\n     const listEl = document.getElementById(\"achievementsList\");\n\n     const dailyPipeTarget = 30;\n     const dailyFlapTarget = 120;\n     const pipesDone = Math.min(analytics.dailyPipesPassed, dailyPipeTarget);\n     const flapsDone = Math.min(analytics.dailyFlapsMade, dailyFlapTarget);\n\n     const pipePercent = Math.floor((pipesDone / dailyPipeTarget) * 100);\n     const flapPercent = Math.floor((flapsDone / dailyFlapTarget) * 100);\n\n     const achievementsDefs = [\n      {title:\"📅 Daily: Pipe Navigator\", desc:\"Pass \" + dailyPipeTarget + \" pipes today (\" + pipesDone + \"/\" + dailyPipeTarget + \")\", unlocked: analytics.dailyPipesPassed >= dailyPipeTarget, progress: pipePercent},\n      {title:\"📅 Daily: Flap Frenzy\", desc:\"Make \" + dailyFlapTarget + \" flaps today (\" + flapsDone + \"/\" + dailyFlapTarget + \")\", unlocked: analytics.dailyFlapsMade >= dailyFlapTarget, progress: flapPercent},\n      {title:\"First Flight\", desc:\"Play your very first game\", unlocked: analytics.gamesPlayed >= 1, progress: analytics.gamesPlayed >= 1 ? 100 : 0},\n      {title:\"Pipe Master\", desc:\"Pass 50 pipes total across all runs\", unlocked: analytics.totalPipes >= 50, progress: Math.min(100, Math.floor((analytics.totalPipes / 50) * 100))},\n      {title:\"Century Club\", desc:\"Pass 250 pipes total across all runs\", unlocked: analytics.totalPipes >= 250, progress: Math.min(100, Math.floor((analytics.totalPipes / 250) * 100))},\n      {title:\"Pipe Overlord\", desc:\"Pass 500 pipes total across all runs\", unlocked: analytics.totalPipes >= 500, progress: Math.min(100, Math.floor((analytics.totalPipes / 500) * 100))},\n      {title:\"Sharp Shooter\", desc:\"Score 25 or higher in a single run\", unlocked: analytics.bestScore >= 25, progress: Math.min(100, Math.floor((analytics.bestScore / 25) * 100))},\n      {title:\"Flappy Legend\", desc:\"Score 50 or higher in a single run\", unlocked: analytics.bestScore >= 50, progress: Math.min(100, Math.floor((analytics.bestScore / 50) * 100))},\n      {title:\"Godlike Flapper\", desc:\"Score 100 or higher in a single run\", unlocked: analytics.bestScore >= 100, progress: Math.min(100, Math.floor((analytics.bestScore / 100) * 100))},\n      {title:\"Dedicated Flapper\", desc:\"Reach a 3-day daily streak\", unlocked: analytics.streak >= 3, progress: Math.min(100, Math.floor((analytics.streak / 3) * 100))},\n      {title:\"Unstoppable Streak\", desc:\"Reach a 7-day daily streak\", unlocked: analytics.streak >= 7, progress: Math.min(100, Math.floor((analytics.streak / 7) * 100))}\n     ];\n\n     let html = \"\";\n     for(let i=0; i<achievementsDefs.length; i++){\n      const ach = achievementsDefs[i];\n      html += '<div class=\"achievementItem ' + (ach.unlocked ? 'unlocked' : '') + '\">';\n      html += '<div class=\"achievementRow\">';\n      html += '<div class=\"achInfo\"><div class=\"achTitle\">' + ach.title + '</div><div class=\"achDesc\">' + ach.desc + '</div></div>';\n      html += '<div class=\"achStatus\">' + (ach.unlocked ? 'COMPLETED' : ach.progress + '%') + '</div>';\n      html += '</div>';\n      html += '<div class=\"challengeProgressContainer\"><div class=\"challengeProgressBar\" style=\"width:' + ach.progress + '%\"></div></div>';\n      html += '</div>';\n     }\n     listEl.innerHTML = html;\n    }\n\n    function showAchievements(){\n     playBlip();\n     stopLoop();\n     updateAchievements();\n\n     startScreen.style.display=\"none\";\n     gameOverScreen.style.display=\"none\";\n     pauseScreen.style.display=\"none\";\n     analyticsScreen.style.display=\"none\";\n     achievementsScreen.style.display=\"flex\";\n     homeAnalyticsBtn.style.display=\"none\";\n     homeAchievementsBtn.style.display=\"none\";\n     homeSettingsBtn.style.display=\"none\";\n\n     pauseButton.style.display=\"none\";\n     pauseButton.style.pointerEvents=\"none\";\n    }\n\n    window.addEventListener(\"blur\",function(){\n     if(state===STATE.PLAYING)pauseGame();\n    });\n\n    document.addEventListener(\"visibilitychange\",function(){\n     if(document.hidden && state===STATE.PLAYING){\n      pauseGame();\n     }\n    });\n\n    resetGame();\n    state=STATE.MENU;\n\n    scoreEl.style.display=\"none\";\n    pauseButton.style.display=\"none\";\n    pauseButton.style.pointerEvents=\"none\";\n\n    hideAllScreens();\n    startScreen.style.display=\"flex\";\n    homeAnalyticsBtn.style.display=\"flex\";\n    homeAchievementsBtn.style.display=\"flex\";\n    homeSettingsBtn.style.display=\"flex\";\n\n    startLoop();\n\n    })();\n</script>\n</body>\n</html>","icon":"data:image/png;base64,","favorite":false}}