{"format":"local-hub-app","version":1,"exportedAt":"2026-08-31T08:09:55.318Z","app":{"packageId":"squish","name":"Squish!","group":"Games","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#b9a8ff\">\n<meta name=\"application-name\" content=\"Squish!\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Squish!\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"description\" content=\"A soft, satisfying squishy toy game with playful creatures, sounds, and haptics.\">\n<link rel=\"manifest\" href=\"data:application/manifest+json;base64,\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"data:image/png;base64,\">\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"data:image/png;base64,\">\n<title>Squish! — Random Squish Test</title>\n<style>\n:root {\n  --ink:#49337d;\n  --purple:#8b5cff;\n  --purple-dark:#6a42e8;\n  --blue:#5babff;\n  --pink:#ff7fbe;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%}\nbody{\n  min-height:100vh;display:grid;place-items:center;padding:18px;overflow-x:hidden;\n  font-family:ui-rounded,\"SF Pro Rounded\",\"Nunito\",system-ui,sans-serif;\n  color:var(--ink);background:#d8cef8\n}\nbutton{font:inherit}\n.app{\n  position:relative;width:min(100%,880px);min-height:92vh;overflow:hidden;\n  border:3px solid rgba(255,255,255,.85);border-radius:44px;\n  background:\n    radial-gradient(circle at 50% 43%,rgba(255,177,226,.72),transparent 27%),\n    radial-gradient(circle at 82% 15%,rgba(83,178,255,.42),transparent 28%),\n    radial-gradient(circle at 12% 28%,rgba(255,255,255,.55),transparent 20%),\n    linear-gradient(180deg,#8bbdff 0%,#c3b7ff 48%,#f2defd 100%);\n  box-shadow:0 30px 90px rgba(74,49,135,.28),inset 0 0 0 8px rgba(255,255,255,.23)\n}\n.app::before,.app::after{\n  content:\"\";position:absolute;border-radius:50%;filter:blur(22px);pointer-events:none;opacity:.46\n}\n.app::before{width:250px;height:180px;left:-100px;top:180px;background:#fff}\n.app::after{width:280px;height:190px;right:-110px;top:260px;background:#fff}\n.topbar{position:relative;z-index:30;display:flex;justify-content:space-between;gap:12px;padding:24px 26px 0}\n.badge{\n  display:flex;align-items:center;gap:9px;min-height:58px;padding:11px 19px;border:3px solid rgba(255,255,255,.64);\n  border-radius:999px;color:#fff;font-size:clamp(15px,2.4vw,22px);font-weight:950;\n  box-shadow:0 9px 24px rgba(68,50,145,.22),inset 0 3px 8px rgba(255,255,255,.25);\n  text-shadow:0 2px 4px rgba(63,48,135,.26)\n}\n.badge.left{background:linear-gradient(180deg,#a985ff,#7959eb)}\n.badge.right{background:linear-gradient(180deg,#6bc0ff,#4e98ed)}\n.title{\n  position:relative;z-index:20;margin:14px 0 -12px;text-align:center;font-size:clamp(48px,8vw,82px);\n  font-weight:1000;letter-spacing:-3px;color:#fff;-webkit-text-stroke:5px #be61dc;paint-order:stroke fill;\n  text-shadow:0 7px 0 #8646c7,0 15px 32px rgba(102,49,172,.24);transform:rotate(-2deg)\n}\n.stage{\n  position:relative;z-index:5;min-height:470px;display:flex;align-items:flex-end;justify-content:center;padding:30px 26px 54px\n}\n.platform{\n  position:absolute;bottom:45px;width:min(620px,84%);height:78px;border-radius:50%;\n  background:linear-gradient(180deg,#ffd0fb,#bd88ef);\n  box-shadow:0 24px 34px rgba(92,49,151,.18),inset 0 10px 13px rgba(255,255,255,.45)\n}\n.platform::after{\n  content:\"\";position:absolute;left:12%;right:12%;top:10px;height:18px;border-radius:50%;\n  background:rgba(255,255,255,.23);filter:blur(5px)\n}\n.spark{position:absolute;font-size:32px;pointer-events:none;filter:drop-shadow(0 3px 5px rgba(115,65,170,.2));animation:float 3s ease-in-out infinite alternate}\n.spark1{left:11%;top:25%} .spark2{right:11%;top:38%;animation-delay:-1s}\n.spark3{left:19%;bottom:22%;animation-delay:-2s} .spark4{right:19%;bottom:27%;animation-delay:-.7s}\n@keyframes float{to{transform:translateY(-13px) rotate(9deg)}}\n.toy-button{\n  position:relative;z-index:10;width:min(620px,92%);height:380px;padding:0;border:0;outline:none;background:transparent;\n  cursor:pointer;touch-action:none;-webkit-tap-highlight-color:transparent\n}\n.hero-img{\n  position:absolute;left:50%;bottom:0;width:100%;height:100%;object-fit:contain;object-position:center bottom;\n  transform:translateX(-50%) scaleX(1) scaleY(1);transform-origin:50% 88%;\n  filter:drop-shadow(0 24px 20px rgba(74,43,115,.22));\n  transition:filter .18s ease,opacity .22s ease;\n  will-change:transform,filter;pointer-events:none;user-select:none\n}\n.toy-button.squish-horizontal .hero-img{transform:translateX(-50%) translateY(58px) scaleX(1.75) scaleY(.28)}\n.toy-button.squish-vertical .hero-img{transform:translateX(-50%) translateY(-26px) scaleX(.60) scaleY(1.48)}\n.toy-button.squish-left .hero-img{transform:translateX(-61%) translateY(34px) rotate(-11deg) scaleX(1.38) scaleY(.55)}\n.toy-button.squish-right .hero-img{transform:translateX(-39%) translateY(34px) rotate(11deg) scaleX(1.38) scaleY(.55)}\n.toy-button.squish-diagonal .hero-img{transform:translateX(-50%) translateY(28px) rotate(-16deg) scaleX(1.46) scaleY(.47)}\n.toy-button.squish-tall .hero-img{transform:translateX(-50%) translateY(-35px) scaleX(.72) scaleY(1.55)}\n.toy-button.squish-wide .hero-img{transform:translateX(-50%) translateY(48px) scaleX(1.58) scaleY(.39)}\n.toy-button.squish-twist .hero-img{transform:translateX(-50%) translateY(30px) rotate(16deg) skewX(-10deg) scaleX(1.34) scaleY(.50)}\n.toy-button.squish-tiny .hero-img{transform:translateX(-50%) translateY(44px) scaleX(.62) scaleY(.62)}\n.toy-button.squish-puff .hero-img{transform:translateX(-50%) translateY(-10px) scaleX(1.28) scaleY(1.22)}\n.toy-button[class*=\"squish-\"] .hero-img{\n  filter:drop-shadow(0 7px 6px rgba(74,43,115,.12)) saturate(1.08)\n}\n.squish-shadow{\n  position:absolute;z-index:7;bottom:48px;left:50%;width:45%;height:34px;transform:translateX(-50%);\n  border-radius:50%;background:rgba(91,54,131,.22);filter:blur(13px);transition:.32s ease\n}\n.toy-button.is-squishing + .squish-shadow{width:72%;height:21px;opacity:.64}\n.pop-text{\n  position:absolute;z-index:50;left:50%;top:148px;transform:translateX(-50%);opacity:0;pointer-events:none;\n  color:#fff;font-size:34px;font-weight:1000;-webkit-text-stroke:3px #cc67d7;paint-order:stroke fill\n}\n.pop-text.show{animation:popText .75s ease-out}\n@keyframes popText{\n  0%{opacity:0;transform:translate(-50%,18px) scale(.65)}\n  25%{opacity:1}\n  100%{opacity:0;transform:translate(-50%,-42px) scale(1.18)}\n}\n.particle{position:absolute;z-index:60;pointer-events:none;font-size:28px;animation:particlePop .8s ease-out forwards}\n@keyframes particlePop{\n  0%{opacity:0;transform:translate(-50%,-50%) scale(.3)}\n  22%{opacity:1}\n  100%{opacity:0;transform:translate(calc(-50% + var(--moveX)),calc(-50% - 108px)) scale(1.32) rotate(var(--rotate))}\n}\n.hint{\n  position:relative;z-index:20;width:min(760px,88%);margin:-20px auto 18px;padding:16px 22px;text-align:center;\n  font-size:clamp(14px,2vw,19px);font-weight:900;background:rgba(255,255,255,.84);\n  border:3px dashed #bc8feb;border-radius:27px;box-shadow:0 9px 26px rgba(90,60,152,.12);backdrop-filter:blur(10px)\n}\n.selector{\n  position:relative;z-index:20;display:flex;gap:10px;margin:0 20px;padding:14px;overflow-x:auto;\n  border:2px solid rgba(255,255,255,.86);border-radius:28px;background:rgba(255,255,255,.72);\n  box-shadow:0 11px 30px rgba(79,53,142,.16);backdrop-filter:blur(14px);scrollbar-width:none\n}\n.selector::-webkit-scrollbar{display:none}\n.toy-card{\n  flex:0 0 128px;padding:7px 7px 10px;border:2px solid transparent;border-radius:20px;\n  background:rgba(255,255,255,.62);color:#433578;font-weight:950;cursor:pointer;transition:.18s ease\n}\n.toy-card:hover{transform:translateY(-3px)} .toy-card:active{transform:scale(.96)}\n.toy-card.active{border-color:#38a6ff;background:#fff;box-shadow:0 0 0 4px rgba(58,163,255,.16),0 10px 18px rgba(70,70,156,.14)}\n.thumb-wrap{height:95px;display:grid;place-items:center;overflow:hidden;border-radius:15px;background:linear-gradient(180deg,rgba(255,255,255,.72),rgba(244,238,255,.68))}\n.toy-card img{width:100%;height:100%;object-fit:contain;pointer-events:none;filter:drop-shadow(0 7px 7px rgba(81,55,128,.16))}\n.toy-name{display:block;margin-top:6px;white-space:nowrap}\n.controls{position:relative;z-index:20;display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;padding:18px 22px 26px}\n.control{\n  min-height:64px;border:2px solid rgba(255,255,255,.85);border-radius:24px;font-size:18px;font-weight:950;cursor:pointer;\n  box-shadow:0 9px 19px rgba(77,55,145,.18),inset 0 3px 7px rgba(255,255,255,.36);transition:.16s ease\n}\n.control:active{transform:translateY(2px) scale(.99)}\n.sound-button{background:rgba(255,255,255,.89);color:#332b78}\n.reset-button{background:linear-gradient(180deg,#9c6cff,#7043ec);color:#fff;text-shadow:0 2px 3px rgba(60,30,120,.25)}\n@media(max-width:650px){\n  body{padding:0;background:#c5baf8} .app{min-height:100vh;border:0;border-radius:0}\n  .topbar{padding:15px 12px 0} .badge{min-height:46px;padding:8px 12px;border-width:2px}\n  .title{margin-top:8px} .stage{min-height:390px;padding:20px 8px 48px}\n  .toy-button{width:98%;height:315px} .hint{width:94%;margin-top:-10px}\n  .selector{margin-inline:9px;padding:10px} .toy-card{flex-basis:106px} .thumb-wrap{height:78px}\n  .controls{padding-inline:11px;gap:10px} .control{min-height:58px;font-size:16px} .pop-text{top:122px}\n}\n@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}\n\n/* =============================\n   EXTRA CONTROLS\n============================= */\n\n.extra-controls{\n  position:relative;\n  z-index:20;\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:12px;\n  padding:0 22px 2px;\n}\n\n.extra-button:disabled{\n  cursor:not-allowed;\n  opacity:.48;\n  transform:none;\n}\n\n@media(max-width:650px){\n  .extra-controls{grid-template-columns:1fr}\n}\n\n.extra-button{\n  min-height:58px;\n  border:2px solid rgba(255,255,255,.88);\n  border-radius:22px;\n  font-weight:950;\n  font-size:16px;\n  cursor:pointer;\n  color:#403171;\n  background:rgba(255,255,255,.82);\n  box-shadow:\n    0 8px 18px rgba(77,55,145,.14),\n    inset 0 3px 7px rgba(255,255,255,.4);\n  transition:transform .16s ease, box-shadow .16s ease, background .16s ease;\n}\n\n.extra-button:active{\n  transform:translateY(2px) scale(.99);\n}\n\n.extra-button.active{\n  color:#fff;\n  background:linear-gradient(180deg,#ff89c8,#9a62ff);\n  box-shadow:\n    0 0 0 4px rgba(255,255,255,.22),\n    0 10px 22px rgba(87,51,155,.22);\n}\n\n.upload-note{\n  position:relative;\n  z-index:20;\n  margin:8px 22px 0;\n  text-align:center;\n  font-size:12px;\n  font-weight:800;\n  color:rgba(68,48,118,.72);\n}\n\n.toy-card.custom-card{\n  border-style:dashed;\n}\n\n.toy-card.custom-card.has-image{\n  border-style:solid;\n}\n\n.toy-card.custom-card .thumb-wrap{\n  position:relative;\n}\n\n.toy-card.custom-card:not(.has-image) .thumb-wrap::after{\n  content:\"+\";\n  position:absolute;\n  inset:0;\n  display:grid;\n  place-items:center;\n  font-size:42px;\n  font-weight:1000;\n  color:#8b65d6;\n  background:rgba(255,255,255,.52);\n}\n\n.mode-pill{\n  display:inline-flex;\n  align-items:center;\n  gap:6px;\n}\n\n@media(max-width:650px){\n  .extra-controls{\n    padding-inline:11px;\n    gap:10px;\n  }\n\n  .extra-button{\n    min-height:54px;\n    font-size:14px;\n  }\n\n  .upload-note{\n    margin-inline:12px;\n  }\n}\n\n\n/* =============================\n   SOFT MATERIAL PHYSICS\n============================= */\n\n.toy-button.material-press .hero-img{\n  filter:\n    drop-shadow(0 8px 8px rgba(74,43,115,.12))\n    saturate(1.06);\n}\n\n.toy-button.material-press + .squish-shadow{\n  width:76%;\n  height:18px;\n  opacity:.62;\n}\n\n.toy-button.material-gel .hero-img{\n  will-change:transform,filter;\n}\n\n.toy-button.material-gel{\n  cursor:grab;\n}\n\n.toy-button.material-gel:active{\n  cursor:grabbing;\n}\n\n\n/* Prevent long-press/tap text or image selection around the squishy */\n.app,\n.stage,\n.toy-button,\n.hero-img,\n.platform,\n.spark,\n.pop-text,\n.hint,\n.badge,\n.title {\n  -webkit-user-select: none;\n  user-select: none;\n  -webkit-touch-callout: none;\n}\n\n.toy-button,\n.hero-img {\n  -webkit-user-drag: none;\n  user-drag: none;\n}\n\n.toy-button {\n  touch-action: none;\n}\n\n\n.gesture-guide{\n  position:relative;\n  z-index:20;\n  width:min(760px,92%);\n  margin:8px auto 14px;\n  display:flex;\n  flex-wrap:wrap;\n  justify-content:center;\n  gap:8px;\n}\n\n.gesture-chip{\n  padding:8px 11px;\n  border-radius:999px;\n  background:rgba(255,255,255,.66);\n  border:1px solid rgba(255,255,255,.88);\n  font-size:12px;\n  font-weight:900;\n  color:#594785;\n  box-shadow:0 5px 12px rgba(82,55,143,.09);\n}\n\n.toy-button.gesture-active .hero-img{\n  transition:none!important;\n}\n\n\n@media(max-width:650px){\n  .controls{\n    grid-template-columns:1fr 1fr;\n  }\n  #vibrateButton{\n    grid-column:1 / -1;\n  }\n}\n\n\n/* =============================\n   LIQUID / GEL SQUISH UPGRADE\n============================= */\n\n.hero-img{\n  transform-origin:50% 86%;\n  will-change:transform,filter;\n}\n\n.toy-button.gesture-active .hero-img{\n  transition:none !important;\n}\n\n.squish-shadow{\n  width:44%;\n  height:30px;\n  opacity:.28;\n  background:rgba(74,43,115,.26);\n  filter:blur(14px);\n  transform:translateX(-50%) scaleX(1) scaleY(1);\n  transform-origin:center;\n  will-change:transform,opacity,filter,width,height;\n}\n\n.stage.liquid-active .squish-shadow{\n  transition:none;\n}\n\n.hero-glow{\n  position:absolute;\n  z-index:8;\n  left:50%;\n  bottom:88px;\n  width:42%;\n  height:110px;\n  transform:translateX(-50%);\n  border-radius:50%;\n  background:radial-gradient(circle,rgba(255,255,255,.22),rgba(255,255,255,0) 68%);\n  filter:blur(18px);\n  opacity:.35;\n  pointer-events:none;\n  transition:opacity .2s ease,transform .2s ease;\n}\n\n.stage.liquid-active .hero-glow{\n  opacity:.18;\n}\n\n@media(max-width:650px){\n  .hero-glow{\n    bottom:76px;\n    height:88px;\n  }\n}\n\n\n/* =============================\n   CENTER TORSION TWIST\n   The toy is split into horizontal visual slices.\n   During twist, slices shear in opposite directions\n   while the center remains anchored.\n============================= */\n\n.twist-layers{\n  position:absolute;\n  inset:0;\n  left:0;\n  bottom:0;\n  z-index:11;\n  pointer-events:none;\n  opacity:0;\n  transform-origin:50% 86%;\n}\n\n.twist-layer{\n  position:absolute;\n  left:50%;\n  bottom:0;\n  width:100%;\n  height:100%;\n  object-fit:contain;\n  object-position:center bottom;\n  transform:translateX(-50%);\n  transform-origin:50% 50%;\n  pointer-events:none;\n  user-select:none;\n  -webkit-user-select:none;\n  -webkit-user-drag:none;\n  will-change:transform;\n  filter:drop-shadow(0 24px 20px rgba(74,43,115,.22));\n}\n\n.twist-layer.t1{ clip-path:inset(0 0 80% 0); }\n.twist-layer.t2{ clip-path:inset(20% 0 60% 0); }\n.twist-layer.t3{ clip-path:inset(40% 0 40% 0); }\n.twist-layer.t4{ clip-path:inset(60% 0 20% 0); }\n.twist-layer.t5{ clip-path:inset(80% 0 0 0); }\n\n.toy-button.center-twisting .hero-img{\n  opacity:0;\n}\n\n.toy-button.center-twisting .twist-layers{\n  opacity:1;\n}\n\n\n/* =============================\n   SIMPLE TWIST + STRETCH MARKS\n============================= */\n\n.twist-layers{\n  display:none !important;\n}\n\n.toy-button.center-twisting .hero-img{\n  opacity:0 !important;\n}\n\n.twist-canvas{\n  display:block;\n  position:absolute;\n  inset:0;\n  z-index:12;\n  width:100%;\n  height:100%;\n  pointer-events:none;\n  opacity:0;\n  transition:opacity .22s ease;\n  filter:drop-shadow(0 24px 20px rgba(74,43,115,.22));\n}\n\n.toy-button.center-twisting .twist-canvas{\n  opacity:1;\n}\n\n.twist-marks{\n  position:absolute;\n  z-index:13;\n  left:50%;\n  bottom:36px;\n  width:56%;\n  height:62%;\n  transform:translateX(-50%);\n  pointer-events:none;\n  opacity:0;\n  transition:opacity .12s ease;\n}\n\n.toy-button.center-twisting .twist-marks{\n  opacity:1;\n}\n\n.twist-mark{\n  position:absolute;\n  left:50%;\n  width:48%;\n  height:18px;\n  border-top:3px solid rgba(255,255,255,.62);\n  border-radius:50%;\n  filter:drop-shadow(0 1px 2px rgba(120,65,160,.22));\n  transform-origin:center;\n  opacity:.85;\n}\n\n.twist-mark.m1{ top:24%; }\n.twist-mark.m2{ top:38%; width:58%; }\n.twist-mark.m3{ top:52%; width:62%; }\n.twist-mark.m4{ top:66%; width:52%; }\n\n.twist-mark::after{\n  content:\"\";\n  position:absolute;\n  inset:-5px 0 auto 0;\n  height:10px;\n  border-top:1px solid rgba(135,75,175,.18);\n  border-radius:50%;\n}\n\n.twist-center-pin{\n  position:absolute;\n  left:50%;\n  top:50%;\n  width:18px;\n  height:18px;\n  transform:translate(-50%,-50%);\n  border-radius:50%;\n  background:rgba(255,255,255,.18);\n  box-shadow:0 0 18px rgba(255,255,255,.26);\n  opacity:0;\n}\n\n.toy-button.center-twisting .twist-center-pin{\n  opacity:.7;\n}\n\n\n/* Firmer squishy resistance */\n.toy-button.stretch-tension .twist-marks{\n  opacity:.72;\n}\n.toy-button.stretch-tension .twist-mark{\n  opacity:.52;\n  border-top-width:2px;\n}\n\n</style>\n</head>\n<body>\n<main class=\"app\">\n  <div class=\"topbar\">\n    <div class=\"badge left\">✨ <span><b id=\"count\">0</b> squishes</span></div>\n    <div class=\"badge right\">☁️ <span>Super soft</span></div>\n  </div>\n\n  <div class=\"title\">squish!</div>\n  <div class=\"pop-text\" id=\"popText\">squish!</div>\n\n  <section class=\"stage\" id=\"stage\">\n    <span class=\"spark spark1\">⭐</span>\n    <span class=\"spark spark2\">💗</span>\n    <span class=\"spark spark3\">✨</span>\n    <span class=\"spark spark4\">💖</span>\n\n    <div class=\"platform\"></div>\n\n    <button class=\"toy-button material-gel\" id=\"toyButton\" aria-label=\"Press and hold to squish\">\n      <img id=\"hero\" class=\"hero-img\" src=\"data:image/png;base64,\" alt=\"Bunbun squishy\" draggable=\"false\">\n\n      <div class=\"twist-layers\" id=\"twistLayers\" aria-hidden=\"true\">\n        <img class=\"twist-layer t1\" id=\"twist1\" draggable=\"false\">\n        <img class=\"twist-layer t2\" id=\"twist2\" draggable=\"false\">\n        <img class=\"twist-layer t3\" id=\"twist3\" draggable=\"false\">\n        <img class=\"twist-layer t4\" id=\"twist4\" draggable=\"false\">\n        <img class=\"twist-layer t5\" id=\"twist5\" draggable=\"false\">\n      </div>\n      <canvas class=\"twist-canvas\" id=\"twistCanvas\" aria-hidden=\"true\"></canvas>\n\n    </button>\n\n    <div class=\"squish-shadow\" id=\"squishShadow\"></div>\n    <div class=\"hero-glow\" id=\"heroGlow\"></div>\n  </section>\n\n  <div class=\"hint\">\n    A real squishy has resistance: <b>hold or stretch to feel pressure pulses</b> that strengthen as the material gets more compressed or tense. 💖\n  </div>\n\n<div class=\"gesture-guide\">\n  <span class=\"gesture-chip\">👆 Tap = jelly pop</span>\n  <span class=\"gesture-chip\">✋ Hold = deep squish</span>\n  <span class=\"gesture-chip\">↔️ Drag = wide stretch</span>\n  <span class=\"gesture-chip\">↕️ Drag = tall stretch</span>\n  <span class=\"gesture-chip\">🎯 Drag from edge toward center = center pinch</span>\n</div>\n\n  <div class=\"selector\">\n    <button type=\"button\" class=\"toy-card custom-card\" id=\"customToyCard\" data-toy=\"custom\">\n      <span class=\"thumb-wrap\">\n        <img id=\"customThumb\" alt=\"Custom squishy\" style=\"display:none\">\n      </span>\n      <span class=\"toy-name\" id=\"customToyName\">➕ Add custom</span>\n    </button>\n\n    <button class=\"toy-card active\" data-toy=\"bunny\">\n      <span class=\"thumb-wrap\"><img src=\"data:image/png;base64,\" alt=\"Bunbun\"></span>\n      <span class=\"toy-name\">🐰 Bunbun</span>\n    </button>\n<button class=\"toy-card\" data-toy=\"bear\">\n      <span class=\"thumb-wrap\"><img src=\"data:image/png;base64,\" alt=\"Mochi\"></span>\n      <span class=\"toy-name\">🐻 Mochi</span>\n    </button>\n<button class=\"toy-card\" data-toy=\"frog\">\n      <span class=\"thumb-wrap\"><img src=\"data:image/png;base64,\" alt=\"Matcha\"></span>\n      <span class=\"toy-name\">🐸 Matcha</span>\n    </button>\n<button class=\"toy-card\" data-toy=\"cat\">\n      <span class=\"thumb-wrap\"><img src=\"data:image/png;base64,\" alt=\"Mimi\"></span>\n      <span class=\"toy-name\">🐱 Mimi</span>\n    </button>\n<button class=\"toy-card\" data-toy=\"panda\">\n      <span class=\"thumb-wrap\"><img src=\"data:image/png;base64,\" alt=\"Panda\"></span>\n      <span class=\"toy-name\">🐼 Panda</span>\n    </button>\n<button class=\"toy-card\" data-toy=\"axolotl\">\n      <span class=\"thumb-wrap\"><img src=\"data:image/png;base64,\" alt=\"Axol\"></span>\n      <span class=\"toy-name\">🩷 Axol</span>\n    </button>\n\n  </div>\n\n  <input type=\"file\" id=\"imageUpload\" accept=\"image/*\" hidden>\n\n  <div class=\"extra-controls\">\n    <button type=\"button\" class=\"extra-button\" id=\"uploadButton\">🖼️ Upload squishy</button>\n    <button type=\"button\" class=\"extra-button\" id=\"modeButton\"><span class=\"mode-pill\">🫧 Mode: Bounce</span></button>\n    <button type=\"button\" class=\"extra-button\" id=\"restoreButton\" disabled>↩️ Slow restore</button>\n  </div>\n\n  <div class=\"upload-note\">Transparent PNGs look best, but any image will work for testing.</div>\n  <div id=\"modeStatus\" style=\"\n    position:relative;\n    z-index:20;\n    width:min(760px,88%);\n    margin:8px auto 0;\n    padding:10px 14px;\n    text-align:center;\n    font-size:13px;\n    font-weight:900;\n    color:#54407f;\n    background:rgba(255,255,255,.62);\n    border:1px solid rgba(255,255,255,.8);\n    border-radius:999px;\n  \">Current mode: Bounce — release returns to normal.</div>\n\n\n  <div class=\"controls\">\n    <button class=\"control sound-button\" id=\"soundButton\" aria-pressed=\"true\">🔊 Soft sounds · ON</button>\n    <button class=\"control sound-button\" id=\"vibrateButton\" aria-pressed=\"true\">📳 Vibration · ON</button>\n    <button class=\"control reset-button\" id=\"resetButton\">↻ Fresh start</button>\n  </div>\n</main>\n\n<script>\nconst ASSETS = {\"bunny\": \"data:image/png;base64,\", \"bear\": \"data:image/png;base64,\", \"frog\": \"data:image/png;base64,\", \"cat\": \"data:image/png;base64,\", \"panda\": \"data:image/png;base64,\", \"axolotl\": \"data:image/png;base64,\"};\nconst NAMES = {\"bunny\":\"Bunbun\",\"bear\":\"Mochi\",\"frog\":\"Matcha\",\"cat\":\"Mimi\",\"panda\":\"Panda\",\"axolotl\":\"Axol\",\"custom\":\"Custom\"};\n\nconst squishStyles = [\n  \"squish-horizontal\",\n  \"squish-vertical\",\n  \"squish-left\",\n  \"squish-right\",\n  \"squish-diagonal\",\n  \"squish-tall\",\n  \"squish-wide\",\n  \"squish-tiny\",\n  \"squish-puff\"\n];\n\nconst squishMessages = {\n  \"squish-horizontal\":\"PANCAKE! 🥞\",\n  \"squish-vertical\":\"STRETCH! ↕️\",\n  \"squish-left\":\"squoosh left! 💗\",\n  \"squish-right\":\"squoosh right! 💗\",\n  \"squish-diagonal\":\"WOBBLE! ✨\",\n  \"squish-tall\":\"TALL BOI! 😆\",\n  \"squish-wide\":\"SO WIDE! 💖\",\n  \"squish-tiny\":\"tiny squish! 🤏\",\n  \"squish-puff\":\"PUFF! ☁️\"\n};\n\nconst hero = document.getElementById(\"hero\");\nconst toyButton = document.getElementById(\"toyButton\");\nconst stage = document.getElementById(\"stage\");\nconst countElement = document.getElementById(\"count\");\nconst popText = document.getElementById(\"popText\");\nconst soundButton = document.getElementById(\"soundButton\");\nconst vibrateButton = document.getElementById(\"vibrateButton\");\nconst resetButton = document.getElementById(\"resetButton\");\nconst squishShadow = document.getElementById(\"squishShadow\");\nconst heroGlow = document.getElementById(\"heroGlow\");\nconst twistLayers = document.getElementById(\"twistLayers\");\nconst twistCanvas = document.getElementById(\"twistCanvas\");\nconst twistContext = twistCanvas.getContext(\"2d\");\nconst twistMarks = document.getElementById(\"twistMarks\");\nconst twistMarkEls = [...document.querySelectorAll(\".twist-mark\")];\nconst twistSliceEls = [\n  document.getElementById(\"twist1\"),\n  document.getElementById(\"twist2\"),\n  document.getElementById(\"twist3\"),\n  document.getElementById(\"twist4\"),\n  document.getElementById(\"twist5\")\n];\n\nconst uploadButton = document.getElementById(\"uploadButton\");\nconst imageUpload = document.getElementById(\"imageUpload\");\nconst modeButton = document.getElementById(\"modeButton\");\nconst restoreButton = document.getElementById(\"restoreButton\");\nconst customToyCard = document.getElementById(\"customToyCard\");\nconst customThumb = document.getElementById(\"customThumb\");\nconst customToyName = document.getElementById(\"customToyName\");\nconst modeStatus = document.getElementById(\"modeStatus\");\n\n\nlet squishCount = 0;\nlet isSquishing = false;\nlet holdTimer = null;\nlet bounceAnimation = null;\nlet soundEnabled = true;\nlet vibrationEnabled = true;\nlet lastHapticPulse = 0;\nlet lastHapticGesture = \"\";\n\nlet audioContext = null;\nlet currentSquishStyle = null;\nlet squishMode = \"bounce\";\nlet customImageData = null;\n\n/* Persistent deformation values */\nlet deformX = 1;\nlet deformY = 1;\nlet deformRotate = 0;\nlet deformSkew = 0;\nlet deformOffsetX = 0;\nlet deformOffsetY = 0;\nlet deformRestoreRAF = null;\n\n/* Soft-material press physics */\nlet pressStartTime = 0;\nlet pressRAF = null;\nlet pressure = 0;\nlet targetPressure = 0;\nlet wobblePhase = 0;\nlet lastPressPointerX = 0;\nlet lastPressPointerY = 0;\nlet gestureStartX = 0;\nlet gestureStartY = 0;\nlet gestureLastX = 0;\nlet gestureLastY = 0;\nlet gestureStartTime = 0;\nlet gestureMoved = false;\nlet gestureAxisLock = null;\nlet activeGesture = \"tap\";\nlet twistAngle = 0;\nlet previousTwistPointerAngle = null;\nlet twistReleaseTimer = null;\nlet twistRecoveryRAF = null;\nlet currentTwistStrength = 0;\nlet currentTwistDirection = 1;\nlet displayedPinchStrength = 0;\nlet tapImpulsePending = false;\n\nlet liquidVelocityX = 0;\nlet liquidVelocityY = 0;\nlet liquidWobble = 0;\nlet lastGestureTime = performance.now();\nlet fluidRAF = null;\nlet fluidLastTime = performance.now();\nlet slowReleaseStart = 0;\nlet slowReleaseFrom = null;\nconst slowReleaseDuration = 5000;\n\nconst fluidState = {\n  sx: 1, sy: 1, tx: 0, ty: 0, rot: 0, skew: 0,\n  shadowX: 1, shadowY: 1, shadowOpacity: .28,\n  glowX: 1, glowY: 1, glowOpacity: .35\n};\n\nconst fluidTarget = {\n  sx: 1, sy: 1, tx: 0, ty: 0, rot: 0, skew: 0,\n  shadowX: 1, shadowY: 1, shadowOpacity: .28,\n  glowX: 1, glowY: 1, glowOpacity: .35\n};\n\nconst fluidVelocity = {\n  sx: 0, sy: 0, tx: 0, ty: 0, rot: 0, skew: 0,\n  shadowX: 0, shadowY: 0, shadowOpacity: 0,\n  glowX: 0, glowY: 0, glowOpacity: 0\n};\n\nconst CUSTOM_TOY_DB = \"squish-custom-toys\";\nconst CUSTOM_TOY_STORE = \"saved-images\";\nconst CUSTOM_TOY_KEY = \"active-custom-toy\";\n\nfunction openCustomToyDatabase() {\n  return new Promise((resolve, reject) => {\n    if (!window.indexedDB) return reject(new Error(\"IndexedDB unavailable\"));\n    const request = indexedDB.open(CUSTOM_TOY_DB, 1);\n    request.onupgradeneeded = () => {\n      if (!request.result.objectStoreNames.contains(CUSTOM_TOY_STORE)) {\n        request.result.createObjectStore(CUSTOM_TOY_STORE);\n      }\n    };\n    request.onsuccess = () => resolve(request.result);\n    request.onerror = () => reject(request.error);\n  });\n}\n\nasync function saveCustomToy(data) {\n  try {\n    const database = await openCustomToyDatabase();\n    await new Promise((resolve, reject) => {\n      const transaction = database.transaction(CUSTOM_TOY_STORE, \"readwrite\");\n      transaction.objectStore(CUSTOM_TOY_STORE).put(data, CUSTOM_TOY_KEY);\n      transaction.oncomplete = resolve;\n      transaction.onerror = () => reject(transaction.error);\n    });\n    database.close();\n    return true;\n  } catch (error) {\n    try {\n      localStorage.setItem(CUSTOM_TOY_KEY, data);\n      return true;\n    } catch (fallbackError) {\n      console.warn(\"Could not persist the custom toy image.\", fallbackError);\n      return false;\n    }\n  }\n}\n\nasync function loadSavedCustomToy() {\n  try {\n    const database = await openCustomToyDatabase();\n    const data = await new Promise((resolve, reject) => {\n      const transaction = database.transaction(CUSTOM_TOY_STORE, \"readonly\");\n      const request = transaction.objectStore(CUSTOM_TOY_STORE).get(CUSTOM_TOY_KEY);\n      request.onsuccess = () => resolve(request.result || null);\n      request.onerror = () => reject(request.error);\n    });\n    database.close();\n    return data;\n  } catch (error) {\n    try {\n      return localStorage.getItem(CUSTOM_TOY_KEY);\n    } catch (fallbackError) {\n      return null;\n    }\n  }\n}\n\nfunction showSavedCustomToy(data) {\n  if (!data) return;\n  customImageData = data;\n  customThumb.src = data;\n  customThumb.style.display = \"block\";\n  customToyCard.classList.add(\"has-image\");\n  customToyName.textContent = \"💾 My Squishy\";\n}\n\n\n\n\n\n\nconst reducedMotion =\n  window.matchMedia &&\n  window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n\nfunction vibrate(pattern = 18) {\n  if (!vibrationEnabled) return;\n  if (!(\"vibrate\" in navigator)) return;\n\n  try {\n    navigator.vibrate(pattern);\n  } catch (error) {}\n}\n\nfunction gestureVibration(kind) {\n  if (kind === \"tap\") vibrate(14);\n  else if (kind === \"hold\") vibrate([22, 28, 16]);\n  else if (kind === \"horizontal\") vibrate([12, 18, 12]);\n  else if (kind === \"vertical\") vibrate([16, 18, 20]);\n  else if (kind === \"inward\") vibrate([10, 14, 10, 14, 10]);\n  else vibrate(16);\n}\n\nfunction continuousSquishHaptic(kind, intensity = 0) {\n  if (!vibrationEnabled || !(\"vibrate\" in navigator)) return;\n\n  const now = performance.now();\n  const amount = clamp(intensity, 0, 1);\n\n  /* Stronger pressure = slightly longer pulse.\n     Keep pulses spaced apart so it feels like resistance,\n     not a constant buzzing motor. */\n  let interval = 120;\n  let duration = 10;\n\n  if (kind === \"hold\") {\n    interval = 105 - amount * 28;\n    duration = 10 + amount * 18;\n  } else if (kind === \"horizontal\" || kind === \"vertical\") {\n    interval = 92 - amount * 24;\n    duration = 8 + amount * 15;\n  } else if (kind === \"inward\") {\n    interval = 100;\n    duration = 9 + amount * 12;\n  }\n\n  if (kind !== lastHapticGesture) {\n    lastHapticPulse = 0;\n    lastHapticGesture = kind;\n  }\n\n  if (now - lastHapticPulse >= interval) {\n    try {\n      navigator.vibrate(Math.round(duration));\n      lastHapticPulse = now;\n    } catch (error) {}\n  }\n}\n\n\nfunction playSquishSound(frequency = 150) {\n  if (!soundEnabled) return;\n  try {\n    audioContext =\n      audioContext ||\n      new (window.AudioContext || window.webkitAudioContext)();\n\n    if (audioContext.state === \"suspended\") audioContext.resume();\n\n    const oscillator = audioContext.createOscillator();\n    const gain = audioContext.createGain();\n\n    oscillator.type = \"sine\";\n    oscillator.frequency.setValueAtTime(frequency, audioContext.currentTime);\n    oscillator.frequency.exponentialRampToValueAtTime(75, audioContext.currentTime + .16);\n\n    gain.gain.setValueAtTime(.045, audioContext.currentTime);\n    gain.gain.exponentialRampToValueAtTime(.001, audioContext.currentTime + .20);\n\n    oscillator.connect(gain).connect(audioContext.destination);\n    oscillator.start();\n    oscillator.stop(audioContext.currentTime + .21);\n  } catch (error) {}\n}\n\nfunction makeParticles(mega = false) {\n  const stageBox = stage.getBoundingClientRect();\n  const toyBox = hero.getBoundingClientRect();\n\n  const centerX = toyBox.left - stageBox.left + toyBox.width / 2;\n  const centerY = toyBox.top - stageBox.top + toyBox.height * .55;\n\n  const symbols = mega\n    ? [\"💖\",\"✨\",\"♡\",\"⭐\",\"✦\",\"💗\",\"✨\",\"♡\"]\n    : [\"♡\",\"✦\",\"💗\",\"·\",\"✨\"];\n\n  symbols.forEach(symbol => {\n    const particle = document.createElement(\"span\");\n    particle.className = \"particle\";\n    particle.textContent = symbol;\n    particle.style.left = centerX + \"px\";\n    particle.style.top = centerY + \"px\";\n    particle.style.setProperty(\"--moveX\", (-95 + Math.random() * 190) + \"px\");\n    particle.style.setProperty(\"--rotate\", (-42 + Math.random() * 84) + \"deg\");\n    stage.appendChild(particle);\n    setTimeout(() => particle.remove(), 850);\n  });\n}\n\nfunction clearSquishStyles() {\n  squishStyles.forEach(style => toyButton.classList.remove(style));\n  toyButton.classList.remove(\"is-squishing\");\n}\n\nfunction chooseSquishStyle() {\n  clearSquishStyles();\n\n  let nextStyle;\n  do {\n    nextStyle = squishStyles[Math.floor(Math.random() * squishStyles.length)];\n  } while (nextStyle === currentSquishStyle && squishStyles.length > 1);\n\n  currentSquishStyle = nextStyle;\n  toyButton.classList.add(currentSquishStyle, \"is-squishing\");\n}\n\nfunction squishFeedback() {\n  squishCount++;\n  countElement.textContent = squishCount;\n\n  const mega = squishCount % 10 === 0;\n\n  popText.textContent = mega\n    ? \"MEGA SQUISH! 💖\"\n    : (squishMode === \"deform\" ? \"STAY SQUISHED! 🫠\" : \"soft squish! 🫧\");\n\n  popText.classList.remove(\"show\");\n  void popText.offsetWidth;\n  popText.classList.add(\"show\");\n\n  makeParticles(mega);\n  playSquishSound(mega ? 125 : 150);\n}\n\n\nfunction clamp(value, min, max) {\n  return Math.max(min, Math.min(max, value));\n}\n\nfunction applyPersistentDeform() {\n  const transform =\n    `translateX(calc(-50% + ${deformOffsetX}px)) ` +\n    `translateY(${deformOffsetY}px) ` +\n    `rotate(${deformRotate}deg) ` +\n    `skewX(${deformSkew}deg) ` +\n    `scaleX(${deformX}) scaleY(${deformY})`;\n  hero.style.transform = transform;\n}\n\nfunction cancelDeformRestore() {\n  if (deformRestoreRAF) {\n    cancelAnimationFrame(deformRestoreRAF);\n    deformRestoreRAF = null;\n  }\n  restoreButton.textContent = \"↩️ Slow restore\";\n  restoreButton.disabled = squishMode !== \"deform\";\n}\n\nfunction resetDeformation() {\n  cancelDeformRestore();\n  deformX = 1;\n  deformY = 1;\n  deformRotate = 0;\n  deformSkew = 0;\n  deformOffsetX = 0;\n  deformOffsetY = 0;\n\n  hero.style.transform = \"\";\n  hero.style.transition = \"\";\n}\n\nfunction slowlyRestoreDeformation() {\n  if (squishMode !== \"deform\") return;\n\n  cancelDeformRestore();\n  const started = performance.now();\n  const from = {\n    x:deformX, y:deformY, rotate:deformRotate, skew:deformSkew,\n    offsetX:deformOffsetX, offsetY:deformOffsetY\n  };\n\n  restoreButton.disabled = true;\n  restoreButton.textContent = \"Restoring…\";\n\n  const frame = now => {\n    const progress = clamp((now - started) / slowReleaseDuration, 0, 1);\n    const eased = progress * progress * (3 - 2 * progress);\n    const toward = (value, neutral) => value + (neutral - value) * eased;\n\n    deformX = toward(from.x, 1);\n    deformY = toward(from.y, 1);\n    deformRotate = toward(from.rotate, 0);\n    deformSkew = toward(from.skew, 0);\n    deformOffsetX = toward(from.offsetX, 0);\n    deformOffsetY = toward(from.offsetY, 0);\n    hero.style.transition = \"none\";\n    applyPersistentDeform();\n\n    if (progress < 1) {\n      deformRestoreRAF = requestAnimationFrame(frame);\n    } else {\n      deformRestoreRAF = null;\n      restoreButton.disabled = false;\n      restoreButton.textContent = \"↩️ Slow restore\";\n      modeStatus.textContent = \"Current mode: Deform — restored and ready to squish again.\";\n    }\n  };\n\n  deformRestoreRAF = requestAnimationFrame(frame);\n}\n\nfunction stackDeformation() {\n  const type = currentSquishStyle;\n\n  if (type === \"squish-horizontal\" || type === \"squish-wide\") {\n    deformX += .14 + Math.random() * .08;\n    deformY -= .09 + Math.random() * .05;\n    deformOffsetY += 5;\n  }\n\n  else if (type === \"squish-vertical\" || type === \"squish-tall\") {\n    deformX -= .07 + Math.random() * .04;\n    deformY += .12 + Math.random() * .08;\n    deformOffsetY -= 4;\n  }\n\n  else if (type === \"squish-left\") {\n    deformX += .07;\n    deformY -= .05;\n    deformRotate -= 4 + Math.random() * 4;\n    deformOffsetX -= 8;\n  }\n\n  else if (type === \"squish-right\") {\n    deformX += .07;\n    deformY -= .05;\n    deformRotate += 4 + Math.random() * 4;\n    deformOffsetX += 8;\n  }\n\n  else if (type === \"squish-diagonal\") {\n    deformX += .08;\n    deformY -= .06;\n    deformRotate -= 5 + Math.random() * 5;\n    deformSkew -= 2;\n  }\n\n  else if (type === \"squish-twist\") {\n    deformRotate += (Math.random() > .5 ? 1 : -1) * (7 + Math.random() * 6);\n    deformSkew += (Math.random() > .5 ? 1 : -1) * 4;\n    deformY -= .035;\n  }\n\n  else if (type === \"squish-tiny\") {\n    deformX -= .08;\n    deformY -= .08;\n    deformOffsetY += 3;\n  }\n\n  else if (type === \"squish-puff\") {\n    deformX += .08;\n    deformY += .08;\n    deformOffsetY -= 2;\n  }\n\n  deformX = clamp(deformX, .32, 2.25);\n  deformY = clamp(deformY, .25, 2.10);\n  deformRotate = clamp(deformRotate, -38, 38);\n  deformSkew = clamp(deformSkew, -24, 24);\n  deformOffsetX = clamp(deformOffsetX, -90, 90);\n  deformOffsetY = clamp(deformOffsetY, -55, 95);\n\n  hero.style.transition = \"transform .28s cubic-bezier(.18,.82,.22,1)\";\n  applyPersistentDeform();\n}\n\n\nfunction easeOutCubic(t) {\n  return 1 - Math.pow(1 - t, 3);\n}\n\nfunction materialTransformFromPressure(p, wobble = 0) {\n  const eased = easeOutCubic(clamp(p, 0, 1));\n\n  /* Rubber/gel behavior:\n     - gets wider as it compresses\n     - loses height progressively\n     - settles slightly downward\n     - tiny side shear/wobble prevents it from looking rigid\n  */\n  const scaleX = 1 + eased * .72;\n  const scaleY = 1 - eased * .64;\n  const translateY = eased * 54;\n  const rotate = Math.sin(wobble) * eased * 1.8;\n  const skew = Math.sin(wobble * 1.35) * eased * 2.2;\n\n  return (\n    `translateX(-50%) ` +\n    `translateY(${translateY}px) ` +\n    `rotate(${rotate}deg) ` +\n    `skewX(${skew}deg) ` +\n    `scaleX(${scaleX}) ` +\n    `scaleY(${scaleY})`\n  );\n}\n\nfunction runMaterialPress() {\n  if (!isSquishing) return;\n\n  const heldFor = performance.now() - pressStartTime;\n\n  /* Build pressure slowly so it feels compressible, not instant. */\n  targetPressure = clamp(heldFor / 720, 0, 1);\n\n  /* Smooth pressure toward target. */\n  pressure += (targetPressure - pressure) * .18;\n\n  wobblePhase += .10;\n\n  hero.style.transform = materialTransformFromPressure(\n    pressure,\n    wobblePhase\n  );\n\n  pressRAF = requestAnimationFrame(runMaterialPress);\n}\n\nfunction startMaterialPress() {\n  pressStartTime = performance.now();\n  pressure = 0;\n  targetPressure = 0;\n  wobblePhase = 0;\n\n  toyButton.classList.add(\"material-press\", \"material-gel\");\n\n  if (pressRAF) {\n    cancelAnimationFrame(pressRAF);\n  }\n\n  pressRAF = requestAnimationFrame(runMaterialPress);\n}\n\nfunction stopMaterialPress() {\n  if (pressRAF) {\n    cancelAnimationFrame(pressRAF);\n    pressRAF = null;\n  }\n\n  toyButton.classList.remove(\"material-press\");\n}\n\nfunction playMaterialRelease() {\n  if (reducedMotion || !hero.animate) {\n    hero.style.transform = \"\";\n    return;\n  }\n\n  if (bounceAnimation) bounceAnimation.cancel();\n\n  const p = clamp(pressure, .12, 1);\n  const wide = 1 + p * .72;\n  const flat = 1 - p * .64;\n  const down = p * 54;\n\n  bounceAnimation = hero.animate([\n    {\n      transform:\n        `translateX(-50%) translateY(${down}px) scaleX(${wide}) scaleY(${flat})`,\n      offset: 0\n    },\n    {\n      transform:\n        `translateX(-50%) translateY(${-12 * p}px) scaleX(${1 - .12 * p}) scaleY(${1 + .22 * p})`,\n      offset: .18\n    },\n    {\n      transform:\n        `translateX(-50%) translateY(${5 * p}px) scaleX(${1 + .13 * p}) scaleY(${1 - .08 * p})`,\n      offset: .38\n    },\n    {\n      transform:\n        `translateX(-50%) translateY(${-3 * p}px) scaleX(${1 - .055 * p}) scaleY(${1 + .07 * p})`,\n      offset: .58\n    },\n    {\n      transform:\n        `translateX(-50%) translateY(${1.5 * p}px) scaleX(${1 + .025 * p}) scaleY(${1 - .025 * p})`,\n      offset: .78\n    },\n    {\n      transform:\n        \"translateX(-50%) translateY(0px) scaleX(1) scaleY(1)\",\n      offset: 1\n    }\n  ], {\n    duration: 820 + p * 260,\n    easing: \"cubic-bezier(.16,.78,.2,1)\"\n  });\n\n  bounceAnimation.onfinish = () => {\n    hero.style.transform = \"\";\n  };\n}\n\nfunction stackSoftDeformation() {\n  /* Permanent mode uses smaller, organic increments rather than harsh preset jumps. */\n  const direction = Math.random() > .5 ? 1 : -1;\n\n  deformX += .045 + Math.random() * .045;\n  deformY -= .028 + Math.random() * .032;\n  deformRotate += direction * (1.2 + Math.random() * 2.6);\n  deformSkew += direction * (.8 + Math.random() * 1.8);\n  deformOffsetY += 2.5 + Math.random() * 2.5;\n  deformOffsetX += direction * (Math.random() * 3.5);\n\n  deformX = clamp(deformX, .5, 2.15);\n  deformY = clamp(deformY, .3, 1.85);\n  deformRotate = clamp(deformRotate, -28, 28);\n  deformSkew = clamp(deformSkew, -18, 18);\n  deformOffsetX = clamp(deformOffsetX, -55, 55);\n  deformOffsetY = clamp(deformOffsetY, -30, 80);\n\n  hero.style.transition = \"transform .24s cubic-bezier(.18,.82,.22,1)\";\n  applyPersistentDeform();\n}\n\n\nfunction setGestureLabel(text) {\n  popText.textContent = text;\n}\n\n\nfunction setFluidTarget(values) {\n  Object.keys(values).forEach(key => {\n    if (key in fluidTarget && Number.isFinite(values[key])) {\n      fluidTarget[key] = values[key];\n    }\n  });\n}\n\nfunction springStep(key, dt, stiffness, damping) {\n  const x = fluidState[key];\n  const target = fluidTarget[key];\n  let v = fluidVelocity[key];\n\n  const force = (target - x) * stiffness;\n  v += force * dt;\n  v *= Math.pow(damping, dt * 60);\n\n  fluidState[key] = x + v * dt;\n  fluidVelocity[key] = v;\n}\n\nfunction renderFluidState() {\n  /* The spring loop runs continuously for the shadow/glow. In Deform mode,\n     however, the hero transform belongs to applyPersistentDeform(); allowing\n     the spring to write here would erase the stacked deformation every frame. */\n  if (squishMode !== \"deform\") {\n    const transform =\n      `translateX(calc(-50% + ${fluidState.tx}px)) ` +\n      `translateY(${fluidState.ty}px) ` +\n      `rotate(${fluidState.rot}deg) ` +\n      `skewX(${fluidState.skew}deg) ` +\n      `scaleX(${fluidState.sx}) scaleY(${fluidState.sy})`;\n    hero.style.transform = transform;\n  }\n\n  if (squishShadow) {\n    squishShadow.style.transform =\n      `translateX(-50%) scaleX(${fluidState.shadowX}) scaleY(${fluidState.shadowY})`;\n    squishShadow.style.opacity = fluidState.shadowOpacity;\n    squishShadow.style.filter =\n      `blur(${12 + Math.max(0, fluidState.shadowX - 1) * 5}px)`;\n  }\n\n  if (heroGlow) {\n    heroGlow.style.transform =\n      `translateX(-50%) scaleX(${fluidState.glowX}) scaleY(${fluidState.glowY})`;\n    heroGlow.style.opacity = fluidState.glowOpacity;\n  }\n}\n\nfunction fluidLoop(now) {\n  const dt = Math.min((now - fluidLastTime) / 1000, .032);\n  fluidLastTime = now;\n\n  /* A held toy follows a fixed slow recovery path. This deliberately ignores\n     stored spring velocity, which otherwise makes the first frame snap back. */\n  if (!isSquishing && slowReleaseFrom) {\n    const progress = clamp((now - slowReleaseStart) / slowReleaseDuration, 0, 1);\n    const eased = progress * progress * (3 - 2 * progress);\n\n    [\"sx\", \"sy\", \"tx\", \"ty\", \"rot\", \"skew\"].forEach(key => {\n      fluidState[key] = slowReleaseFrom[key] + (fluidTarget[key] - slowReleaseFrom[key]) * eased;\n      fluidVelocity[key] = 0;\n    });\n\n    if (progress >= 1) slowReleaseFrom = null;\n  } else {\n    /* Slightly underdamped springs for taps and active gestures. */\n    springStep(\"sx\", dt, 145, .76);\n    springStep(\"sy\", dt, 145, .76);\n    springStep(\"tx\", dt, 150, .77);\n    springStep(\"ty\", dt, 150, .77);\n    springStep(\"rot\", dt, 120, .78);\n    springStep(\"skew\", dt, 120, .78);\n  }\n\n  springStep(\"shadowX\", dt, 90, .82);\n  springStep(\"shadowY\", dt, 90, .82);\n  springStep(\"shadowOpacity\", dt, 95, .82);\n  springStep(\"glowX\", dt, 82, .84);\n  springStep(\"glowY\", dt, 82, .84);\n  springStep(\"glowOpacity\", dt, 82, .84);\n\n  renderFluidState();\n  fluidRAF = requestAnimationFrame(fluidLoop);\n}\n\nfunction ensureFluidLoop() {\n  if (fluidRAF) return;\n  fluidLastTime = performance.now();\n  fluidRAF = requestAnimationFrame(fluidLoop);\n}\n\nfunction settleFluidToNormal() {\n  setFluidTarget({\n    sx:1, sy:1, tx:0, ty:0, rot:0, skew:0,\n    shadowX:1, shadowY:1, shadowOpacity:.28,\n    glowX:1, glowY:1, glowOpacity:.35\n  });\n}\n\n\n\nfunction syncTwistLayerSource() {\n  const src = hero.currentSrc || hero.src;\n  twistSliceEls.forEach(img => {\n    if (img.src !== src) img.src = src;\n  });\n}\n\nfunction renderCenterTorsion(strength) {\n  const requestedStrength = clamp(strength, 0, 1);\n  displayedPinchStrength += (requestedStrength - displayedPinchStrength) * .20;\n  strength = displayedPinchStrength;\n  const dir = 1;\n\n  if (twistReleaseTimer) {\n    clearTimeout(twistReleaseTimer);\n    twistReleaseTimer = null;\n  }\n  if (twistRecoveryRAF) {\n    cancelAnimationFrame(twistRecoveryRAF);\n    twistRecoveryRAF = null;\n  }\n\n  toyButton.classList.add(\"center-twisting\");\n  currentTwistStrength = strength;\n  currentTwistDirection = dir;\n\n  /* Keep the underlying spring centered while the visible horizontal slices\n     form a strong hourglass: wide ends, a pinched waist, and opposing shear. */\n  setFluidTarget({\n    sx: 1,\n    sy: 1,\n    tx: 0,\n    ty: 0,\n    rot: 0,\n    skew: 0\n  });\n\n  drawTwistCanvas(strength, dir);\n\n  const offsets = [-1.2, -.45, .45, 1.2];\n\n  twistMarkEls.forEach((mark, i) => {\n    const w = offsets[i];\n\n    const x = dir * w * strength * 18;\n    const r = dir * w * strength * 7;\n    const scaleX = 1 + strength * (.10 + Math.abs(w) * .04);\n\n    mark.style.transform =\n      `translateX(calc(-50% + ${x}px)) rotate(${r}deg) scaleX(${scaleX})`;\n  });\n}\n\nfunction drawTwistCanvas(strength, dir) {\n  if (!hero.complete || !hero.naturalWidth) return;\n\n  const rect = toyButton.getBoundingClientRect();\n  const ratio = Math.min(window.devicePixelRatio || 1, 2);\n  const width = Math.max(1, Math.round(rect.width * ratio));\n  const height = Math.max(1, Math.round(rect.height * ratio));\n\n  if (twistCanvas.width !== width || twistCanvas.height !== height) {\n    twistCanvas.width = width;\n    twistCanvas.height = height;\n  }\n\n  twistContext.clearRect(0, 0, width, height);\n\n  const naturalWidth = hero.naturalWidth;\n  const naturalHeight = hero.naturalHeight;\n  const contain = Math.min(width / naturalWidth, height / naturalHeight);\n  const baseWidth = naturalWidth * contain;\n  const baseHeight = naturalHeight * contain;\n  const baseX = (width - baseWidth) / 2;\n  const baseY = height - baseHeight;\n  const stripHeight = 2;\n\n  for (let y = 0; y < baseHeight; y += stripHeight) {\n    const normalized = y / baseHeight;\n    const signed = normalized * 2 - 1;\n    const edge = Math.pow(Math.abs(signed), .72);\n    const scaleX = 1 - strength * (1 - edge) * .90 + strength * edge * .06;\n    const sourceY = normalized * naturalHeight;\n    const sourceHeight = Math.min(naturalHeight - sourceY, stripHeight / contain + 1);\n\n    /* Scale each tiny strip around the same center. Adjacent strips overlap\n       slightly, producing one continuous hourglass pinch with no twist. */\n    twistContext.save();\n    twistContext.translate(width / 2, baseY + y + stripHeight / 2);\n    twistContext.scale(scaleX, 1);\n    twistContext.drawImage(\n      hero,\n      0, sourceY, naturalWidth, sourceHeight,\n      -baseWidth / 2, -stripHeight, baseWidth, stripHeight + 3\n    );\n    twistContext.restore();\n  }\n}\n\nfunction releaseCenterTorsion() {\n  const start = performance.now();\n  const fromStrength = currentTwistStrength;\n  const direction = currentTwistDirection;\n\n  const recover = now => {\n    const progress = clamp((now - start) / slowReleaseDuration, 0, 1);\n    const eased = progress * progress * (3 - 2 * progress);\n    drawTwistCanvas(fromStrength * (1 - eased), direction);\n\n    if (progress < 1) {\n      twistRecoveryRAF = requestAnimationFrame(recover);\n    } else {\n      twistRecoveryRAF = null;\n      clearCenterTorsion();\n    }\n  };\n\n  twistRecoveryRAF = requestAnimationFrame(recover);\n}\n\nfunction clearCenterTorsion() {\n  if (twistReleaseTimer) {\n    clearTimeout(twistReleaseTimer);\n    twistReleaseTimer = null;\n  }\n  if (twistRecoveryRAF) {\n    cancelAnimationFrame(twistRecoveryRAF);\n    twistRecoveryRAF = null;\n  }\n\n  toyButton.classList.remove(\"stretch-tension\");\n  toyButton.classList.remove(\"center-twisting\");\n  currentTwistStrength = 0;\n  displayedPinchStrength = 0;\n\n  twistSliceEls.forEach(slice => {\n    slice.style.transition = \"none\";\n    slice.style.transform = \"translateX(-50%)\";\n  });\n\n  if (typeof twistMarkEls !== \"undefined\") {\n    twistMarkEls.forEach(mark => {\n      mark.style.transform = \"translateX(-50%)\";\n    });\n  }\n}\n\nfunction normalizeAngleDelta(delta) {\n  while (delta > Math.PI) delta -= Math.PI * 2;\n  while (delta < -Math.PI) delta += Math.PI * 2;\n  return delta;\n}\n\nfunction updateTwistAngle(currentX, currentY) {\n  const rect = toyButton.getBoundingClientRect();\n  const cx = rect.left + rect.width / 2;\n  const cy = rect.top + rect.height / 2;\n\n  const angle = Math.atan2(currentY - cy, currentX - cx);\n\n  if (previousTwistPointerAngle !== null) {\n    const delta = normalizeAngleDelta(angle - previousTwistPointerAngle);\n    twistAngle += delta * 180 / Math.PI;\n  }\n\n  previousTwistPointerAngle = angle;\n}\n\nfunction applyGestureTransform(dx, dy, heldMs) {\n  const absX = Math.abs(dx);\n  const absY = Math.abs(dy);\n  const distance = Math.hypot(dx, dy);\n\n  const dragAmount = clamp(distance / 180, 0, 1);\n  const holdAmount = clamp(heldMs / 850, 0, 1);\n  const now = performance.now();\n  const toyRect = toyButton.getBoundingClientRect();\n  const centerX = toyRect.left + toyRect.width / 2;\n  const centerY = toyRect.top + toyRect.height / 2;\n  const startRadius = Math.hypot(gestureStartX - centerX, gestureStartY - centerY);\n  const currentRadius = Math.hypot(gestureLastX - centerX, gestureLastY - centerY);\n  const inwardAmount = Math.max(0, startRadius - currentRadius);\n\n  if (!gestureAxisLock && distance >= 16) {\n    if (startRadius > Math.min(toyRect.width, toyRect.height) * .2 && inwardAmount >= 8) {\n      gestureAxisLock = \"inward\";\n    } else if (absX >= absY) {\n      gestureAxisLock = \"horizontal\";\n    } else {\n      gestureAxisLock = \"vertical\";\n    }\n  }\n\n  const dt = Math.max(16, now - lastGestureTime);\n  lastGestureTime = now;\n\n  liquidVelocityX += ((dx * .018) - liquidVelocityX) * .14;\n  liquidVelocityY += ((dy * .018) - liquidVelocityY) * .14;\n  liquidWobble += .12 + Math.min(.18, distance / 1000);\n\n  let sx = 1;\n  let sy = 1;\n  let tx = 0;\n  let ty = 0;\n  let rot = 0;\n  let skew = 0;\n  let shadowX = 1;\n  let shadowY = 1;\n  let shadowOpacity = .28;\n  let label = \"squish!\";\n\n  /* Once a drag direction is established, keep one renderer for the entire\n     gesture instead of swapping between stretch and pinch mid-drag. */\n  if (gestureAxisLock !== \"inward\") {\n    clearCenterTorsion();\n  }\n\n  /* HOLD: body slowly spreads and sinks like gel/foam */\n  if (!gestureAxisLock && distance < 14 && heldMs > 170) {\n    activeGesture = \"hold\";\n\n    const p = easeOutCubic(holdAmount);\n    const jelly = Math.sin(liquidWobble) * (1 - p) * 1.5;\n\n    sx = 1 + p * .82 + Math.sin(liquidWobble * .7) * .012;\n    sy = 1 - p * .88 + Math.cos(liquidWobble * .9) * .006;\n    ty = p * 76;\n    tx = jelly;\n    rot = Math.sin(liquidWobble * .55) * p * 1.4;\n    skew = Math.sin(liquidWobble * .8) * p * 1.8;\n\n    shadowX = 1 + p * .92;\n    shadowY = 1 - p * .68;\n    shadowOpacity = .28 + p * .24;\n\n    label = p > .94 ? \"MAX SQUISH! 🫠\" : (p > .55 ? \"MELTY SQUISH! 🫠\" : \"soft gel... 🫧\");\n  }\n\n  /* HORIZONTAL DRAG: mass stretches sideways and thins */\n  else if (gestureAxisLock === \"horizontal\") {\n    activeGesture = \"horizontal\";\n\n    const dir = Math.sign(dx) || 1;\n    const p = easeOutCubic(dragAmount);\n\n    sx = 1 + p * .34;\n    sy = 1 - p * .20;\n    tx = dir * p * 14;\n    ty = p * 12;\n    rot = dir * p * 1.8;\n    skew = dir * p * 2.8;\n\n    shadowX = 1 + p * .40;\n    shadowY = 1 - p * .25;\n    shadowOpacity = .30 + p * .12;\n\n    label = \"LIQUID STRETCH ↔️\";\n  }\n\n  /* VERTICAL DRAG */\n  else if (gestureAxisLock === \"vertical\") {\n    activeGesture = \"vertical\";\n\n    const p = easeOutCubic(dragAmount);\n\n    if (dy < 0) {\n      /* pull up: tall gooey stretch */\n      sx = 1 - p * .16;\n      sy = 1 + p * .30;\n      ty = -p * 18;\n      skew = Math.sin(liquidWobble) * p * 2;\n\n      shadowX = 1 - p * .18;\n      shadowY = 1 + p * .10;\n      shadowOpacity = .24;\n\n      label = \"GOOEY STRETCH ↕️\";\n    } else {\n      /* push down: wide pancake compression */\n      sx = 1 + p * .38;\n      sy = 1 - p * .42;\n      ty = p * 42;\n      rot = Math.sin(liquidWobble) * p * .8;\n\n      shadowX = 1 + p * .55;\n      shadowY = 1 - p * .38;\n      shadowOpacity = .32 + p * .14;\n\n      label = \"SQUISH DOWN ⬇️\";\n    }\n  }\n\n  /* INWARD DRAG: pull the material from an outer point toward its center. */\n  else if (gestureAxisLock === \"inward\") {\n    activeGesture = \"inward\";\n\n    const p = easeOutCubic(clamp(inwardAmount / Math.max(70, startRadius * .72), 0, 1));\n\n    /* Keep the main body centered instead of rotating the entire image. */\n    sx = 1 + p * .07;\n    sy = 1 - p * .05;\n    tx = clamp(dx * .05, -12, 12);\n    ty = clamp(dy * .04, -10, 12);\n    rot = 0;\n    skew = 0;\n\n    renderCenterTorsion(p);\n\n    shadowX = 1 + p * .20;\n    shadowY = 1 - p * .06;\n    shadowOpacity = .30;\n\n    label = p >= .78\n      ? \"BIG PINCH! 🤏\"\n      : \"PINCH! 🤏\";\n  }\n\n  /* TAP */\n  else {\n    activeGesture = \"tap\";\n\n    const pulse = clamp(heldMs / 90, 0, 1);\n    sx = 1 + pulse * .12;\n    sy = 1 - pulse * .16;\n    ty = pulse * 7;\n\n    shadowX = 1 + pulse * .22;\n    shadowY = 1 - pulse * .18;\n    shadowOpacity = .32;\n\n    label = \"jelly tap ✨\";\n  }\n\n  /* tiny inertia wobble makes movement less mechanical */\n  tx += liquidVelocityX * .9;\n  ty += liquidVelocityY * .25;\n\n  setFluidTarget({\n    sx, sy, tx, ty, rot, skew,\n    shadowX,\n    shadowY,\n    shadowOpacity,\n    glowX: 1 + (sx - 1) * .25,\n    glowY: 1 + (sy - 1) * .12,\n    glowOpacity: clamp(.34 - Math.max(0, 1 - sy) * .22, .10, .35)\n  });\n\n  ensureFluidLoop();\n  stage.classList.add(\"liquid-active\");\n\n  const tensionAmount = Math.max(\n    Math.abs(sx - 1),\n    Math.abs(sy - 1)\n  );\n\n  /* Pressure/resistance haptics while the finger is still interacting. */\n  let hapticIntensity = tensionAmount / .34;\n  if (activeGesture === \"hold\") {\n    hapticIntensity = clamp(heldMs / 850, 0, 1);\n  } else if (activeGesture === \"inward\") {\n    hapticIntensity = clamp(inwardAmount / Math.max(70, startRadius * .72), 0, 1);\n  }\n\n  if (activeGesture === \"hold\" ||\n      activeGesture === \"horizontal\" ||\n      activeGesture === \"vertical\" ||\n      activeGesture === \"inward\") {\n    continuousSquishHaptic(activeGesture, hapticIntensity);\n  }\n\n  if ((activeGesture === \"horizontal\" || activeGesture === \"vertical\") && tensionAmount > .12) {\n    toyButton.classList.add(\"stretch-tension\");\n\n    const dir = Math.sign(dx || -dy || 1);\n    twistMarkEls.forEach((mark, i) => {\n      const offsets = [-1.0, -.35, .35, 1.0];\n      const w = offsets[i];\n      const amount = clamp(tensionAmount / .34, 0, 1);\n      mark.style.transform =\n        `translateX(calc(-50% + ${dir * w * amount * 8}px)) ` +\n        `rotate(${dir * w * amount * 3}deg) scaleX(${1 + amount * .08})`;\n    });\n  } else if (activeGesture !== \"inward\") {\n    toyButton.classList.remove(\"stretch-tension\");\n  }\n\n  setGestureLabel(label);\n}\n\nfunction playTapPop() {\n  /* Immediate visible squash, then spring back through the same physics loop. */\n  fluidState.sx = Math.max(fluidState.sx, 1.12);\n  fluidState.sy = Math.min(fluidState.sy, .84);\n  fluidState.ty = Math.max(fluidState.ty, 7);\n\n  fluidVelocity.sx += .95;\n  fluidVelocity.sy -= 1.25;\n  fluidVelocity.ty += 22;\n\n  setFluidTarget({\n    sx:1, sy:1, tx:0, ty:0, rot:0, skew:0,\n    shadowX:1, shadowY:1, shadowOpacity:.28,\n    glowX:1, glowY:1, glowOpacity:.35\n  });\n\n  ensureFluidLoop();\n}\n\n\nfunction resetLiquidShadow() {\n  stage.classList.remove(\"liquid-active\");\n\n  setFluidTarget({\n    shadowX:1,\n    shadowY:1,\n    shadowOpacity:.28,\n    glowX:1,\n    glowY:1,\n    glowOpacity:.35\n  });\n\n  ensureFluidLoop();\n}\n\nfunction animateLiquidShadowRelease(strength = 1) {\n  setFluidTarget({\n    shadowX:1,\n    shadowY:1,\n    shadowOpacity:.28,\n    glowX:1,\n    glowY:1,\n    glowOpacity:.35\n  });\n  ensureFluidLoop();\n}\n\nfunction playGestureRelease(kind) {\n  toyButton.classList.remove(\"stretch-tension\");\n  lastHapticGesture = \"\";\n  lastHapticPulse = 0;\n  /* Every gesture captures its exact released shape and takes the same\n     five seconds to recover, without momentum causing an initial snap. */\n  slowReleaseStart = performance.now();\n  slowReleaseFrom = {\n    sx: fluidState.sx, sy: fluidState.sy,\n    tx: fluidState.tx, ty: fluidState.ty,\n    rot: fluidState.rot, skew: fluidState.skew\n  };\n  [\"sx\", \"sy\", \"tx\", \"ty\", \"rot\", \"skew\"].forEach(key => {\n    fluidVelocity[key] = 0;\n  });\n\n  if (kind === \"inward\") {\n    releaseCenterTorsion();\n  }\n\n  settleFluidToNormal();\n  ensureFluidLoop();\n}\n\nfunction updateGesture(event) {\n  if (!isSquishing || squishMode === \"deform\") return;\n\n  gestureLastX = event.clientX;\n  gestureLastY = event.clientY;\n\n  updateTwistAngle(gestureLastX, gestureLastY);\n\n  const dx = gestureLastX - gestureStartX;\n  const dy = gestureLastY - gestureStartY;\n  const heldMs = performance.now() - gestureStartTime;\n\n  if (Math.hypot(dx,dy) > 8) {\n    gestureMoved = true;\n  }\n\n  applyGestureTransform(dx, dy, heldMs);\n}\n\nfunction beginSquish(event) {\n  if (isSquishing) return;\n\n  isSquishing = true;\n  slowReleaseFrom = null;\n  if (squishMode === \"deform\") cancelDeformRestore();\n\n  if (bounceAnimation) {\n    bounceAnimation.cancel();\n    bounceAnimation = null;\n  }\n\n  clearSquishStyles();\n  toyButton.classList.add(\"gesture-active\");\n\n  gestureStartTime = performance.now();\n  clearCenterTorsion();\n  ensureFluidLoop();\n  lastGestureTime = performance.now();\n  liquidVelocityX = 0;\n  liquidVelocityY = 0;\n  liquidWobble = 0;\n  gestureMoved = false;\n  gestureAxisLock = null;\n  activeGesture = \"tap\";\n\n  if (event) {\n    gestureStartX = event.clientX;\n    gestureStartY = event.clientY;\n    gestureLastX = event.clientX;\n    gestureLastY = event.clientY;\n\n    twistAngle = 0;\n    previousTwistPointerAngle = null;\n    updateTwistAngle(event.clientX, event.clientY);\n  }\n\n  if (squishMode === \"deform\") {\n    toyButton.classList.add(\"material-press\", \"material-gel\");\n    stackSoftDeformation();\n    squishFeedback();\n\n    holdTimer = setInterval(() => {\n      if (!isSquishing) return;\n      stackSoftDeformation();\n      makeParticles(false);\n      playSquishSound(122);\n    }, 420);\n\n    return;\n  }\n\n  setFluidTarget({sx:1.10, sy:.88, tx:0, ty:5, rot:0, skew:0, shadowX:1.16, shadowY:.88, shadowOpacity:.32});\n  setGestureLabel(\"tap! ✨\");\n  squishFeedback();\n  vibrate(12);\n\n  holdTimer = setInterval(() => {\n    if (!isSquishing) return;\n\n    const heldMs = performance.now() - gestureStartTime;\n    const dx = gestureLastX - gestureStartX;\n    const dy = gestureLastY - gestureStartY;\n\n    applyGestureTransform(dx, dy, heldMs);\n\n    if (heldMs > 250) {\n      makeParticles(false);\n      playSquishSound(132);\n    }\n  }, 80);\n}\n\nfunction endSquish() {\n  if (!isSquishing) return;\n\n  isSquishing = false;\n\n  if (holdTimer) {\n    clearInterval(holdTimer);\n    holdTimer = null;\n  }\n\n  stopMaterialPress();\n  clearSquishStyles();\n  toyButton.classList.remove(\"gesture-active\");\n\n  if (squishMode === \"deform\") {\n    applyPersistentDeform();\n    vibrate([18, 22, 12]);\n    playSquishSound(110);\n    return;\n  }\n\n  const elapsed = performance.now() - gestureStartTime;\n\n  previousTwistPointerAngle = null;\n\n  if (!gestureMoved && elapsed < 180) {\n    activeGesture = \"tap\";\n  } else if (!gestureMoved && elapsed >= 180) {\n    activeGesture = \"hold\";\n  }\n\n  playGestureRelease(activeGesture);\n  gestureVibration(activeGesture);\n  playSquishSound(activeGesture === \"tap\" ? 220 : 190);\n}\n\n\ntoyButton.addEventListener(\"contextmenu\", event => {\n  event.preventDefault();\n});\n\nhero.addEventListener(\"contextmenu\", event => {\n  event.preventDefault();\n});\n\nhero.addEventListener(\"dragstart\", event => {\n  event.preventDefault();\n});\n\nstage.addEventListener(\"selectstart\", event => {\n  event.preventDefault();\n});\n\ntoyButton.addEventListener(\"pointerdown\", event => {\n  event.preventDefault();\n  toyButton.setPointerCapture?.(event.pointerId);\n  beginSquish(event);\n});\n\n\ntoyButton.addEventListener(\"pointermove\", event => {\n  if (!isSquishing) return;\n  event.preventDefault();\n  updateGesture(event);\n});\n\ntoyButton.addEventListener(\"pointerup\", endSquish);\ntoyButton.addEventListener(\"pointercancel\", endSquish);\ntoyButton.addEventListener(\"lostpointercapture\", endSquish);\n\ntoyButton.addEventListener(\"keydown\", event => {\n  if ((event.key === \" \" || event.key === \"Enter\") && !isSquishing) {\n    event.preventDefault();\n    beginSquish();\n  }\n});\n\ntoyButton.addEventListener(\"keyup\", event => {\n  if (event.key === \" \" || event.key === \"Enter\") endSquish();\n});\n\ndocument.querySelectorAll(\".toy-card\").forEach(card => {\n  card.addEventListener(\"click\", () => {\n    endSquish();\n\n    document.querySelectorAll(\".toy-card\").forEach(button =>\n      button.classList.remove(\"active\")\n    );\n\n    card.classList.add(\"active\");\n\n    const key = card.dataset.toy;\n\n    if (key === \"custom\") {\n      if (!customImageData) {\n        imageUpload.click();\n        return;\n      }\n      hero.src = customImageData;\n    } else {\n      hero.src = ASSETS[key];\n    }\n\n    hero.alt = NAMES[key] + \" squishy\";\n    syncTwistLayerSource();\n    resetDeformation();\n  clearCenterTorsion();\n    settleFluidToNormal();\n    resetLiquidShadow();\n\n    if (!reducedMotion && hero.animate) {\n      hero.animate([\n        {transform:\"translateX(-50%) scale(.72) rotate(-4deg)\", opacity:.2},\n        {transform:\"translateX(-50%) scale(1.18) rotate(3deg)\", opacity:1},\n        {transform:\"translateX(-50%) scale(.96) rotate(-1deg)\", opacity:1},\n        {transform:\"translateX(-50%) scale(1)\", opacity:1}\n      ], {\n        duration:540,\n        easing:\"cubic-bezier(.2,.84,.2,1)\"\n      });\n    }\n  });\n});\n\n\nuploadButton.addEventListener(\"click\", () => {\n  imageUpload.click();\n});\n\nimageUpload.addEventListener(\"change\", event => {\n  const file = event.target.files && event.target.files[0];\n  if (!file) return;\n\n  if (!file.type.startsWith(\"image/\")) {\n    alert(\"Please choose an image file.\");\n    return;\n  }\n\n  const reader = new FileReader();\n\n  reader.onload = async () => {\n    customImageData = reader.result;\n\n    customThumb.src = customImageData;\n    customThumb.style.display = \"block\";\n    customToyCard.classList.add(\"has-image\");\n    customToyName.textContent = \"💾 My Squishy\";\n\n    document.querySelectorAll(\".toy-card\").forEach(card =>\n      card.classList.remove(\"active\")\n    );\n\n    customToyCard.classList.add(\"active\");\n\n    hero.src = customImageData;\n    hero.alt = \"Custom squishy\";\n    syncTwistLayerSource();\n\n    resetDeformation();\n\n    const saved = await saveCustomToy(customImageData);\n\n    popText.textContent = saved ? \"custom squishy saved! 💾\" : \"custom squishy! 🖼️\";\n    popText.classList.remove(\"show\");\n    void popText.offsetWidth;\n    popText.classList.add(\"show\");\n  };\n\n  reader.readAsDataURL(file);\n});\n\nmodeButton.addEventListener(\"click\", () => {\n  endSquish();\n\n  squishMode = squishMode === \"bounce\" ? \"deform\" : \"bounce\";\n\n  if (squishMode === \"deform\") {\n    modeButton.classList.add(\"active\");\n    modeButton.innerHTML = '<span class=\"mode-pill\">🫠 Mode: Deform</span>';\n    modeStatus.textContent = \"Current mode: Deform — every squish permanently stacks deformation.\";\n    restoreButton.disabled = false;\n    popText.textContent = \"STAY SQUISHED! 🫠\";\n  } else {\n    modeButton.classList.remove(\"active\");\n    modeButton.innerHTML = '<span class=\"mode-pill\">🫧 Mode: Bounce</span>';\n    modeStatus.textContent = \"Current mode: Bounce — release returns to normal.\";\n    resetDeformation();\n    restoreButton.disabled = true;\n    popText.textContent = \"BOUNCE BACK! 🫧\";\n  }\n\n  popText.classList.remove(\"show\");\n  void popText.offsetWidth;\n  popText.classList.add(\"show\");\n});\n\nrestoreButton.addEventListener(\"click\", slowlyRestoreDeformation);\n\n\nvibrateButton.addEventListener(\"click\", () => {\n  vibrationEnabled = !vibrationEnabled;\n\n  vibrateButton.setAttribute(\"aria-pressed\", String(vibrationEnabled));\n  vibrateButton.textContent = vibrationEnabled\n    ? \"📳 Vibration · ON\"\n    : \"📴 Vibration · OFF\";\n\n  if (vibrationEnabled) {\n    vibrate(20);\n  } else if (\"vibrate\" in navigator) {\n    try {\n      navigator.vibrate(0);\n    } catch (error) {}\n  }\n});\n\nsoundButton.addEventListener(\"click\", () => {\n  soundEnabled = !soundEnabled;\n  soundButton.setAttribute(\"aria-pressed\", String(soundEnabled));\n  soundButton.textContent = soundEnabled\n    ? \"🔊 Soft sounds · ON\"\n    : \"🔇 Soft sounds · OFF\";\n});\n\nresetButton.addEventListener(\"click\", () => {\n  endSquish();\n  clearSquishStyles();\n  resetDeformation();\n\n  squishCount = 0;\n  countElement.textContent = \"0\";\n\n  popText.textContent = \"fresh start ♡\";\n  popText.classList.remove(\"show\");\n  void popText.offsetWidth;\n  popText.classList.add(\"show\");\n});\n\nsyncTwistLayerSource();\nloadSavedCustomToy().then(showSavedCustomToy);\nensureFluidLoop();\n\nif (\"serviceWorker\" in navigator) {\n  window.addEventListener(\"load\", () => {\n    navigator.serviceWorker.register(\"data:text/javascript;base64,\").catch(error => {\n      console.warn(\"Squish service worker registration failed:\", error);\n    });\n  });\n}\n\n</script>\n</body>\n</html>\n","icon":"data:image/png;base64,","favorite":false}}